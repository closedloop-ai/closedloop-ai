{
  "name": "@repo/document-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./extensions": "./src/extensions.ts",
    "./liveblocks": "./src/liveblocks.ts",
    "./markdown": "./src/markdown.ts",
    "./mermaid": "./src/mermaid.ts",
    "./inline-image": "./src/inline-image.ts",
    "./inline-image-layout": "./src/inline-image-layout.ts",
    "./link-uri-policy": "./src/link-uri-policy.ts",
    "./collaboration-field": "./src/collaboration-field.ts",
    "./comment-anchor": "./src/comment-anchor.ts",
    "./comment-anchor-flatten": "./src/comment-anchor-flatten.ts",
    "./comment-anchor-selector": "./src/comment-anchor-selector.ts",
    "./yjs-comment-marks": "./src/yjs-comment-marks.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist *.tsbuildinfo node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false --incremental --tsBuildInfoFile ./tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@repo/realtime-contract": "workspace:*",
    "@tiptap/core": "~3.31.3",
    "@tiptap/extension-list": "~3.31.3",
    "@tiptap/extension-table": "~3.31.3",
    "@tiptap/extension-table-cell": "~3.31.3",
    "@tiptap/extension-table-header": "~3.31.3",
    "@tiptap/extension-table-row": "~3.31.3",
    "@tiptap/markdown": "~3.31.3",
    "@tiptap/pm": "~3.31.3",
    "@tiptap/starter-kit": "~3.31.3",
    "jsdom": "^30.1.1",
    "lib0": "^0.2.99",
    "marked": "^17.0.1",
    "yjs": "^13.6.33",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@tiptap/y-tiptap": "^3.0.9",
    "@types/node": "^25.9.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
