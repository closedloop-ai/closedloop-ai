# Read by the Prisma CLI (`pnpm migrate`, `prisma studio`), which loads `.env`
# rather than `.env.local`. Must match the DATABASE_URL the app servers use.
#
# Prefer the single-file setup: `cp local.env.example local.env && pnpm env:local`
# links one root file here and into every app, so this cannot drift from apps/api.
#
# The database name matches POSTGRES_DB in docker-compose.yml, so
# `docker compose up -d` is enough — no manual createdb.
DATABASE_URL="postgresql://postgres:password@localhost:5432/closedloop_ai?schema=public"
