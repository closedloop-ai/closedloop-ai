// =============================================================================
// PENSERO INTEGRATION
// =============================================================================

/// One organization's Pensero delivery-metrics credential (ISS-8007).
///
/// Replaces the deployment-wide `PENSERO_API_TOKEN` env var as the primary
/// source: a row here WINS over the env var, which is retained as the
/// deployment-wide default for self-hosted installs. The precedence rule and
/// its rationale live in `packages/pensero/credential.ts`
/// (`resolvePenseroCredential`) so exactly one implementation decides it.
///
/// SECURITY: `apiTokenEncrypted` holds a KMS ciphertext of a
/// `tk_<public>:sk_<secret>` credential — the secret half never rests in
/// plaintext here, and the plaintext is NEVER returned to a client. The
/// Integrations screen renders presence plus `apiTokenLastFour` only, which is
/// a fingerprint and not a recoverable prefix of the secret.
///
/// Unlike the Linear/Slack/Google integration models this one DOES carry an
/// `organization` relation with `onDelete: Cascade`. Those rows are orphaned
/// when an org is deleted; leaving an encrypted live credential behind is a
/// worse outcome than the small inconsistency of diverging from them here.
model PenseroIntegration {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  /// KMS-encrypted `tk_<public>:sk_<secret>` credential. Never read to a client.
  apiTokenEncrypted String @map("api_token_encrypted") @db.Text
  /// Last four characters of the token, for display as a fingerprint only.
  apiTokenLastFour  String @map("api_token_last_four")

  /// Optional per-org base-URL override. https:// only — org-supplied values do
  /// NOT get the env var's loopback exemption (see `isSecureHttpsUrl`). Null
  /// means "inherit the deployment default".
  baseUrl String? @map("base_url")

  /// Pensero team identifiers this org's poll is narrowed to (ISS-8761).
  ///
  /// EMPTY MEANS "DO NOT NARROW", not "no teams". An empty list omits the
  /// `team_identifiers` query parameter entirely and accepts the provider's
  /// all-teams response; sending an empty parameter would ask Pensero to scope
  /// to nothing and return an empty window that is indistinguishable from a
  /// quiet day. These are the PROVIDER's own identifiers — they are never
  /// derived from ClosedLoop `Team` names, which name a different population.
  teamIdentifiers String[] @default([]) @map("team_identifiers")

  /// When the current credential was written, surfaced on the settings card so
  /// an admin can tell a stale credential from a fresh one.
  setAt     DateTime @default(now()) @map("set_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("pensero_integrations")
}

/// One organization/day attempt of the Pensero delivery backfill (ISS-8761).
///
/// AN ATTEMPT LEDGER, NOT A COMPLETENESS LEDGER. There is deliberately no
/// `complete` column and no row here ever claims one: the delivery endpoint
/// returns no `hasMore`, no cursor and no total, so a short window is
/// byte-for-byte indistinguishable from a quiet period (see
/// `SegmentCompleteness` in `packages/pensero/delivery-client.ts`). What this
/// table records is what we DID — when we last asked, when we last got an
/// answer without a transport or parse failure, and what went wrong when we
/// did not — which is knowable. Whether the provider gave us everything is not.
///
/// `lastSuccessAt` non-null therefore means "a fetch returned without error",
/// including a fetch that returned zero rows. It does not mean the day is done,
/// which is exactly why the recheck cursor revisits every attempted day forever.
model PenseroBackfillDay {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// The calendar day (UTC) this attempt covered.
  day DateTime @map("day") @db.Date

  /// When this day was last asked for, successfully or not. Always set.
  lastAttemptAt DateTime @map("last_attempt_at")
  /// When a fetch for this day last completed without a transport/parse
  /// failure. Null means every attempt so far has failed.
  lastSuccessAt DateTime? @map("last_success_at")
  /// The failure from the most recent attempt, or null when it succeeded.
  /// Cleared on success so a stale reason cannot outlive the failure.
  lastFailureReason String? @map("last_failure_reason")
  /// Total attempts, successful or not. Monotonic; never reset.
  attemptCount Int @default(0) @map("attempt_count")
  /// Rows the most recent successful attempt persisted. Zero is a real
  /// measurement of a quiet day, not an absence of one.
  lastRowsWritten Int @default(0) @map("last_rows_written")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // No separate `@@index([organizationId, day])`: the UNIQUE above is a btree
  // on exactly those columns in that order, so it already serves both the
  // per-org day scan and the point lookup the upsert keys on. A second index
  // over the same tuple would be write amplification for no read.
  @@unique([organizationId, day])
  // ISS-9930 (whitlockk, #7539): `hasFailedPenseroBackfillDay` filters
  // `organization_id = $1 AND last_success_at IS NULL` on every eligible branch
  // detail. The UNIQUE above cannot serve the second column, so the healthy case
  // — no failed day — read this org's WHOLE slice, which grows by a row per day
  // forever. `last_success_at` second bounds it: the scan seeks straight to the
  // NULL group and stops, so the healthy case touches no heap row at all.
  @@index([organizationId, lastSuccessAt])
  @@map("pensero_backfill_days")
}

/// Where one organization's Pensero backfill has got to (ISS-8761).
///
/// TWO CURSORS, because they answer two different questions and collapsing them
/// would starve one of them:
///
///   * `backwardCursor` is the OLDEST day already attempted. The next backward
///     day is the day before it, forever — there is no historical cutoff and no
///     total cap, so history is discovered continuously rather than bounded to
///     a window somebody guessed at.
///   * `recheckCursor` is a round-robin position over days ALREADY attempted.
///     The next recheck day is the smallest attempted day strictly greater than
///     it, wrapping to the smallest attempted day at the end. A day whose feed
///     was quiet the first time is therefore asked again, which is the only
///     defence against an unverifiable segment being mistaken for a quiet one.
///
/// Today is refreshed on every run and is not governed by either cursor.
///
/// Both are nullable: null means "no day has been attempted yet", which the
/// planner reads as "start at today" for the backward walk and "nothing to
/// recheck" for the round robin. A sentinel date would be a lie about an
/// attempt that never happened.
model PenseroBackfillCursor {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  /// Oldest day attempted so far. The backward walk resumes below it.
  backwardCursor DateTime? @map("backward_cursor") @db.Date
  /// Round-robin position over attempted days. See the model docstring.
  recheckCursor DateTime? @map("recheck_cursor") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("pensero_backfill_cursors")
}

