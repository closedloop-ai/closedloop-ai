// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
  // ISS-7476: partial indexes shipped in 7.4 and are STILL preview-gated as of
  // 7.10.0 (re-confirmed on the bump: `prisma validate` reports no graduation
  // warning for this flag).
  // With the flag off the differ cannot see a partial index at all, so every one
  // of them had to be hand-carried in raw migration SQL and was invisible to
  // `migrate dev`. They are declared below with `where: raw("...")`; the CI
  // "Verify Prisma dev drift" job now fails any that is added without one.
  //
  // ISS-8267 / prisma/orm#30178: declaring these makes native `upsert` capable
  // of arbitrating ON CONFLICT on a PARTIAL unique's columns instead of the
  // total unique named in `where` — 42P10 on every call. Prisma is pinned
  // ~7.10.0 (ISS-8556) while that holds. NOTE what the bump did and did not
  // establish: the arbiter probes were re-run green on 7.10.0, so every
  // sanctioned statement still arbitrates on its total unique and the
  // workarounds still hold. Whether orm#30178 itself is FIXED upstream was not
  // retested, so the gate and the workarounds stay until someone checks.
  // The no-partial-unique-upsert source gate bans
  // unprobed upserts on these models, and any Prisma bump must re-run
  // apps/api/__tests__/integration/partial-unique-upsert-arbiter-realdb.test.ts
  // (enforced by scripts/lint/partial-unique-upsert-prisma-version-contract.test.ts)
  // to re-evaluate the call-site workarounds against the upstream fix.
  //
  // ISS-8554: `typedSql` is what `prisma generate --sql` is gated behind. It is
  // still PREVIEW at 7.10.0 — ISS-8556 originally recorded it as going GA there
  // and that was wrong (the gate string is in `build/cli.js`; grepping the
  // 110-byte `build/index.js` launcher finds nothing on 7.10+). So this flag is
  // load-bearing, not a leftover: remove it and every `sql` import stops
  // resolving.
  previewFeatures = ["partialIndexes", "typedSql"]
}

datasource db {
  provider = "postgresql"
}

