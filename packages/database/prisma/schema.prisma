model GitHubInstallation {
  id                       String                   @id @default(uuid(7)) @db.Uuid
  organizationId           String?                  @unique @map("organization_id") @db.Uuid
  installationId           String                   @unique @map("installation_id")
  accountId                String                   @map("account_id")
  accountLogin             String                   @map("account_login")
  accountType              String                   @map("account_type")
  senderLogin              String                   @map("sender_login")
  senderId                 String                   @map("sender_id")
  status                   GitHubInstallationStatus @default(PENDING_CLAIM)
  permissions              Json?
  events                   Json?
  repositorySelection      String?                  @map("repository_selection")
  suspendedAt              DateTime?                @map("suspended_at")
  suspendedBy              String?                  @map("suspended_by")
  claimedAt                DateTime?                @map("claimed_at")
  claimedByUserId          String?                  @map("claimed_by_user_id") @db.Uuid
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  // PLN-634: set on the prior UNINSTALLED row when an OAuth callback detects
  // a different-account reconnect. The confirm-reset endpoint reads this
  // value to determine which new installation to claim, so a user-controlled
  // body cannot redirect the claim to an attacker's installation.
  pendingNewInstallationId String?                  @map("pending_new_installation_id")
  // FEA-3874 (parent FEA-3801, PLN-1457 S2/S3): provider-neutrality discriminator
  // on the auth/connection record. Existing rows backfill to 'github'. The
  // GitHub-specific columns (installationId, accountId, status, ...) are unchanged
  // and remain the live install/suspend/uninstall/claim write path in this slice.
  // The read-only `VcsConnection` projection (Slice 3) is derived from this row in
  // @repo/api; there is NO new physical connection table and NO dual-write here —
  // `provider`/`providerDetail` are the only additions, recording the host and any
  // provider-specific auth fields (typed via VcsConnectionProviderDetail).
  provider                 String                   @default("github") @db.VarChar(32)
  providerDetail           Json?                    @map("provider_detail")

  // Relations
  organization Organization?                  @relation(fields: [organizationId], references: [id])
  repositories GitHubInstallationRepository[]

  @@index([status])
  @@index([accountId])
  @@map("github_installations")
}

model GitHubInstallationRepository {
  id             String    @id @default(uuid(7)) @db.Uuid
  installationId String    @map("installation_id") @db.Uuid
  githubRepoId   String    @map("github_repo_id")
  fullName       String    @map("full_name")
  name           String
  owner          String
  private        Boolean
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastPushedAt   DateTime? @map("last_pushed_at")
  // ISS-5826: nullable/no-default authority group. Historical rows remain null;
  // consumers normalize that state conservatively rather than fabricating a
  // repository default or rewriting existing data.
  defaultBranchName              String?   @map("default_branch_name")
  defaultBranchAvailability      String?   @map("default_branch_availability") @db.VarChar(32)
  defaultBranchCompleteness      String?   @map("default_branch_completeness") @db.VarChar(32)
  defaultBranchReason            String?   @map("default_branch_reason") @db.VarChar(64)
  defaultBranchSource            String?   @map("default_branch_source") @db.VarChar(64)
  defaultBranchMechanism         String?   @map("default_branch_mechanism") @db.VarChar(32)
  defaultBranchTrigger           String?   @map("default_branch_trigger") @db.VarChar(32)
  defaultBranchCredentialType    String?   @map("default_branch_credential_type") @db.VarChar(32)
  defaultBranchCredentialOwnerId String?   @map("default_branch_credential_owner_id") @db.Uuid
  defaultBranchObservationKey    String?   @map("default_branch_observation_key")
  defaultBranchObservedAt        DateTime? @map("default_branch_observed_at")
  defaultBranchEventAt           DateTime? @map("default_branch_event_at")
  // Soft-tombstone marker set when a repo disappears from the installation
  // during a disconnect/reinstall window (PLN-634). Tombstoned rows are
  // filtered from active-pool reads (getRepositories, etc.) but remain
  // resolvable by FK so historical BranchDetail / PullRequestDetail records
  // can still render. Cleared if the same githubRepoId reappears on reconnect.
  removedAt      DateTime? @map("removed_at")

  // Relations
  installation       GitHubInstallation      @relation(fields: [installationId], references: [id], onDelete: Cascade)
  branchDetails      BranchDetail[]
  pullRequestDetails PullRequestDetail[]
  teamRepositories   TeamRepository[]
  dirtyScopeNudges   GitHubDirtyScopeNudge[]

  @@unique([installationId, githubRepoId])
  // NOTE: github_installation_repositories_inst_lower_full_name_idx is a PARTIAL
  // EXPRESSION index on (installation_id, lower(full_name)) WHERE removed_at IS
  // NULL (ISS-6452, migration 20260815120000), for the session-ingest authority
  // read in apps/api/app/agent-sessions/service/artifact-links/shared.ts. That
  // query does not filter installation_id directly — it arrives from the joined
  // installation, which is one row per org because organizationId is unique on
  // GitHubInstallation. Prisma's DSL can express neither an expression nor a
  // partial index, so it lives only in that migration.
  @@map("github_installation_repositories")
}

// Symphony's GitHub OAuth callback persists these per organization/user rows.
// The connection is not inferred from Clerk's social account metadata, and it
// intentionally does not fan out to every User row with the same clerkId: a
// write-capable GitHub token is scoped to the org where the user connected it.
model GitHubUserConnection {
  id                    String    @id @default(uuid(7)) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  githubUserId          String    @map("github_user_id")
  githubNodeId          String?   @map("github_node_id")
  login                 String
  normalizedLogin       String    @map("normalized_login")
  avatarUrl             String?   @map("avatar_url")
  profileUrl            String?   @map("profile_url")
  accessTokenEncrypted  String    @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?   @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime? @map("token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scopes                String[]  @default([])
  revokedAt             DateTime? @map("revoked_at")
  lastUsedAt            DateTime? @map("last_used_at")
  // PLN-1525: observed GET /rate_limit core.limit for this token — a property
  // of (user x app), not of any target, which is why it lives here and not on
  // the capability row.
  rateLimitTier         Int?      @map("rate_limit_tier")
  // PLN-1525 v3 sync-lane pool state (PLN-1535 D9). Budget is a property of
  // the token, so it lives on the connection. Updated at reconciler-tick
  // frequency from observed GraphQL `rateLimit` responses; `remaining` is the
  // user's GLOBAL bucket (shared with their own gh CLI/apps), so reserve
  // floors computed from it yield automatically to the user's own workload.
  observedLimit         Int?      @map("observed_limit")
  observedRemaining     Int?      @map("observed_remaining")
  observedResetAt       DateTime? @map("observed_reset_at")
  // Our own spend (sum of observed `cost`) within the current observed rate
  // window; resets when `observedResetAt` advances to a new window.
  windowSpend           Int       @default(0) @map("window_spend")
  backoffUntil          DateTime? @map("backoff_until")
  // GitHubSyncHealthState contract const (healthy | backoff | unhealthy).
  // String, not a Prisma enum — new states must not need a migration.
  healthState           String    @default("healthy") @map("health_state")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilities GitHubAccessCapability[]

  @@unique([organizationId, userId])
  @@unique([organizationId, githubUserId])
  @@index([organizationId, normalizedLogin])
  @@index([revokedAt])
  @@map("github_user_connections")
}

/// PLN-1525: cached per-(connection x target) GitHub access verdict. Hangs off
/// the connection so disconnect cascades are free invalidation and the 401
/// handler (set `revokedAt` + delete capabilities) is one transaction on one
/// aggregate. `not_connected` needs no row — absence of the parent is the
/// answer. `organizationId` is denormalized so queries can scope by org
/// directly, per the service org-scoping rule.
model GitHubAccessCapability {
  id                     String   @id @default(uuid(7)) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  githubUserConnectionId String   @map("github_user_connection_id") @db.Uuid

  targetOwner            String   @map("target_owner")
  normalizedTargetOwner  String   @map("normalized_target_owner")
  // Verdict granularity matches probe granularity (both lanes): non-null =
  // repo-level verdict for a repo-bearing target; NULL = owner-level verdict,
  // written only for owner-only (repo-less) interactive targets. Normalized
  // (lowercased) — see normalizeGitHubName.
  targetRepo             String?  @map("target_repo")

  // GitHubCredentialKind contract const; String, not a Prisma enum, so new
  // kinds/reasons never need a migration.
  credentialKind         String   @map("credential_kind")
  // GitHubAccessDenialReason contract const; NULL = positive verdict.
  denialReason           String?  @map("denial_reason")
  installationId         String?  @map("installation_id")

  checkedAt              DateTime @map("checked_at")
  expiresAt              DateTime @map("expires_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   GitHubUserConnection @relation(fields: [githubUserConnectionId], references: [id], onDelete: Cascade)

  // NOTE: row identity is enforced by TWO partial unique indexes maintained in
  // migration SQL (Prisma cannot express partial uniques): one on
  // (github_user_connection_id, normalized_target_owner) WHERE target_repo IS
  // NULL, one on (github_user_connection_id, normalized_target_owner,
  // target_repo) WHERE target_repo IS NOT NULL. A plain @@unique over the
  // nullable column would NOT enforce owner-level uniqueness (Postgres treats
  // NULLs as distinct). Writes go through the capability-store helper's
  // create-catch-P2002-update path, not Prisma `upsert`.
  @@index([githubUserConnectionId])
  @@index([organizationId])
  @@index([normalizedTargetOwner])
  @@index([expiresAt])
  @@map("github_access_capabilities")
}

/// PLN-1535 M1: per-(org x repo) sync-state for the cloud PR-projection
/// reconciler. `tier` decides fill strategy + cadence (installed = webhook-fed,
/// slow gap-repair only; user_token = server-side pull, ~15m for active repos;
/// unsyncable = nobody connected, CTA only). `watermark` is the recency boundary
/// the sweep advances; `cursor` resumes a truncated backlog drain across ticks so
/// a large first sweep catches up fully without stranding older PRs. Repo
/// identity is normalized
/// `owner/name` (normalizeRepoFullName) — uniform with
/// PullRequestDetail.repositoryFullName and the sync-read pool target — because
/// tier is evaluated PER REPO, not per org (one org can hold all three tiers at
/// once as installation `repositorySelection` subsets and user tokens see
/// different slices).
model GitHubRepoSyncState {
  id                      String    @id @default(uuid(7)) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  // Normalized owner/name — the producer-independent repo identity.
  repositoryFullName      String    @map("repository_full_name")
  // GitHubRepoSyncTier contract const (installed | user_token | unsyncable);
  // String, not a Prisma enum, so a new tier never needs a migration (mirrors
  // GitHubUserConnection.healthState).
  tier                    String    @default("unsyncable")
  // Recency boundary: the greatest GitHub PR `updated_at` the reconciler has
  // refreshed. It fetches UPDATED_AT DESC (bounded pages) and post-filters to
  // rows newer than this, then advances it — it is NOT pushed into the query as
  // an early-stop.
  watermark               DateTime?
  // Continuation cursor for an in-progress backlog drain: on a truncated read the
  // reconciler stores GitHub's nextCursor here and resumes from it (fetching
  // older PRs, refreshing every fetched row) on the following ticks until the
  // history is exhausted. Null between sweeps.
  cursor                  String?
  lastSweptAt             DateTime? @map("last_swept_at")
  // When `tier` was last classified (installation coverage / connected-user set
  // can change out from under a stale tier).
  lastTierEvaluatedAt     DateTime? @map("last_tier_evaluated_at")
  // Consecutive failed sweeps; drives exponential back-off, reset on success.
  consecutiveFailureCount Int       @default(0) @map("consecutive_failure_count")
  nextRetryAt             DateTime? @map("next_retry_at")
  // GitHubRepoSyncDeferralReason contract const when the last tick could not
  // proceed (e.g. `budget` = the tier-2 pool was all-floored). Null = not
  // deferred. Surfaced by the coverage stat as `deferred: budget`, kept distinct
  // from a tier-3 unsyncable gap.
  deferredReason          String?   @map("deferred_reason")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, repositoryFullName])
  // No secondary index on (tier, last_swept_at): the due query filters
  // `tier <> unsyncable` (a leading-column inequality) and orders by
  // last_swept_at NULLS FIRST, which a (tier, last_swept_at) btree cannot serve
  // as an ordered stream anyway — Postgres sorts regardless. At this table's
  // scale a small scan+sort is free; a partial index on last_swept_at WHERE the
  // tier is syncable is the scale-time follow-up (Prisma can't express it, so it
  // would be raw-migration SQL).
  @@map("github_repo_sync_state")
}

model PublicRepository {
