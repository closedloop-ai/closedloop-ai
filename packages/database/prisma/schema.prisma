model Loop {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  status         LoopStatus  @default(PENDING)
  command        LoopCommand

  // Optional relationships
  artifactId   String? @map("artifact_id") @db.Uuid
  parentLoopId String? @map("parent_loop_id") @db.Uuid

  // Execution context
  prompt          String? @db.Text
  repo            Json? // { fullName: string, branch: string }
  additionalRepos Json?   @map("additional_repos") // Array<{ fullName: string, branch: string }>
  contextRefs     Json?   @map("context_refs") // Array<{ sourceId, sourceType, include }>

  // Harness selection — which AI harness to use for this loop
  harness String @default("claude")

  // Compute target (local machine) — null for cloud/legacy runs
  computeTargetId String? @map("compute_target_id") @db.Uuid

  // Container tracking
  containerId      String?   @map("container_id") // ECS task ARN
  s3StateKey       String?   @map("s3_state_key") // S3 prefix for state
  // Set by the loop-state retention sweep once this loop's S3 state (conversation
  // history, context-pack, logs) has been purged. Marks the loop done so the
  // daily cron skips it on subsequent runs. Null = state not yet purged.
  s3StateCleanedAt DateTime? @map("s3_state_cleaned_at")

  // PR and session tracking (populated by harness agent on completion)
  prUrl      String? @map("pr_url")
  prNumber   Int?    @map("pr_number")
  branchName String? @map("branch_name")
  sessionId  String? @map("session_id")

  // The SESSION-typed Artifact that materializes this loop in the unified
  // Sessions list (FEA-1718). Unique → at most one Session per loop.
  sessionArtifactId String? @unique @map("session_artifact_id") @db.Uuid

  // Cost tracking
  tokensInput   Int      @default(0) @map("tokens_input")
  tokensOutput  Int      @default(0) @map("tokens_output")
  tokensByModel Json?    @map("tokens_by_model") // { "claude-opus-4": { input, output }, ... }
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(10, 6)

  // Timing
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Revival tracking
  revivalCount  Int       @default(0) @map("revival_count")
  lastRevivalAt DateTime? @map("last_revival_at")

  // Error info
  error Json? // { code: string, message: string }

  // Artifact version at loop creation time — used to detect stale evaluations
  // when a new document version is published while an evaluation is in flight.
  artifactVersion Int? @map("artifact_version")

  // Extensible metadata
  metadata          Json  @default("{}") @map("metadata")
  uploadedArtifacts Json? @map("uploaded_artifacts")

  // Runner token lifecycle — JTI pin-or-compare enforcement
  activeTokenJti        String?   @map("active_token_jti")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  lastRunnerHeartbeatAt DateTime? @map("last_runner_heartbeat_at")
  runnerCapabilities    Json?     @map("runner_capabilities")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization                    Organization                         @relation(fields: [organizationId], references: [id])
  user                            User                                 @relation(fields: [userId], references: [id])
  artifact                        Artifact?                            @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  sessionArtifact                 Artifact?                            @relation("LoopSessionArtifact", fields: [sessionArtifactId], references: [id], onDelete: SetNull)
  computeTarget                   ComputeTarget?                       @relation(fields: [computeTargetId], references: [id])
  parentLoop                      Loop?                                @relation("LoopParent", fields: [parentLoopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childLoops                      Loop[]                               @relation("LoopParent")
  evaluations                     ArtifactEvaluation[]
  events                          LoopEvent[]
  tokenRefreshes                  LoopTokenRefresh[]
  executionCredentialConsumptions LoopExecutionCredentialConsumption[]
  tagLoops                        TagLoop[]

  // NOTE: A partial unique index on (artifact_id, command, artifact_version)
  // WHERE status IN ('PENDING', 'CLAIMED', 'RUNNING') is maintained via raw migrations.
  // Prisma cannot express partial indexes. Prisma 7.4+ falsely flags this as drift —
  // we pin to 7.3.0 until resolved. Do NOT drop it.
  // Only applies when both artifactId and artifactVersion are non-null (Postgres
  // treats NULL != NULL in unique indexes, so nullable rows never conflict).
  // Terminal loops (COMPLETED/FAILED/CANCELLED/TIMED_OUT) allow re-runs of the same
  // artifact+command+version without conflict.
  //
  // NOTE: A second partial unique index `loops_blocked_artifact_command_key` on
  // (artifact_id, command) WHERE status = 'BLOCKED' is maintained via raw
  // migration 20260624120000_add_partial_unique_blocked_loop_artifact_command.
  // It enforces at most one deferred (BLOCKED) loop per artifact+command, closing
  // a TOCTOU race in the dispatch idempotency guard. Prisma cannot express partial
  // indexes — do NOT drop it.
  @@index([artifactId, command, artifactVersion])
  @@index([organizationId, status])
  // Covers the (organizationId, artifactId, command) dispatch/idempotency lookups
  // (and the (organizationId, artifactId) prefix lookups). The leading column is
  // organizationId so the index is usable for org-scoped queries, unlike the
  // artifactId-leading index above.
  @@index([organizationId, artifactId, command])
  @@index([organizationId, userId, createdAt])
  @@index([parentLoopId])
  @@index([computeTargetId])
  // Serves the loop-state retention sweep (apps/api/app/cron/cleanup-loop-state):
  // `WHERE status IN (terminal) AND completedAt < cutoff ORDER BY completedAt`,
  // so the daily scan for purgeable terminal loops is an index scan rather than a
  // sequential scan that grows with the loops table.
  @@index([status, completedAt])
  @@map("loops")
}

// Unified-search full-text projection (FEA-3857 / parent FEA-3800, PLN-1456
// Slice 1). ADDITIVE / SHIPS DARK — no read or write path yet: rows are written
// only by the one-shot backfill (scripts/backfill-search-documents.ts); the
// write-time indexing hooks (Slice 2) and the `GET /search` FTS query (Slice 3)
// land later. One row denormalizes a searchable entity (Phase-1 corpus:
// Document/Feature Artifacts, Projects, Loops) into title/body plus the
// visibility keys a later per-hit re-authorization needs.
//
// The `tsv` full-text column is a Postgres GENERATED column
// (`to_tsvector('english', title || ' ' || body)`) that Prisma's schema DSL
// cannot express, so it is modeled as `Unsupported("tsvector")?` and OWNED by
// the raw migration (20260722010000). The GIN index on `tsv` likewise cannot be
// declared here (Prisma will not index an `Unsupported` column); it lives only
// in the CONCURRENTLY migration (20260722010001). The btree + unique indexes
// below ARE Prisma-managed by name, but built CONCURRENTLY in that same file to
// avoid a write-blocking lock — the CREATE TABLE migration deliberately omits
// their DDL (see each migration's header).
model SearchDocument {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  // Discriminator — `SearchEntityType` const-object enum in
  // packages/api/src/types/search.ts (Phase-1 members: document|project|loop).
  entityType String @map("entity_type")
  // The source row's primary key (Artifact.id / Project.id / Loop.id).
  entityId   String @map("entity_id") @db.Uuid

  title String  @db.Text
  body  String? @db.Text

  // Visibility keys the later per-hit re-authorization filters on. `projectId`
  // is the source entity's owning project (null for unparented entities);
  // `assigneeId` mirrors the source assignee where one exists. Neither is a FK —
  // the projection is a denormalized mirror, not a relational child, so a
  // deleted source never dangles a constraint here (the backfill/reconcile
  // owns removal).
  projectId  String? @map("project_id") @db.Uuid
  assigneeId String? @map("assignee_id") @db.Uuid

  // Structured-filter columns (FEA-3930). The source entity's own lifecycle
  // status and priority, mirrored as plain TEXT so the `:status`/`:priority`
  // query-language filters resolve without joining back to the source table.
  // Deliberately NOT bound to a DB enum: the `status` column carries whichever
  // vocabulary the source uses (FeatureStatus / DocumentStatus / ProjectStatus /
  // LoopStatus) as its raw string. Null where the source has no such field
  // (a loop has no priority). `priority` is compared by the ordinal in
  // packages/api/src/types/search-query.ts (LOW < MEDIUM < HIGH < URGENT).
  status   String? @map("status")
  priority String? @map("priority")

  // Route-building fields (Phase-2 navigation slice, parent FEA-3800). Nullable
  // and additive — the web app deep-links documents by TYPE + SLUG
  // (`/prds|/features/<slug>`) and projects team-scoped
  // (`/teams/<teamId>/projects/<projectId>`), so a raw entity UUID alone cannot
  // build a routable link. `slug` is the source entity's URL handle;
  // `entitySubtype` is the document `type` (PRD/IMPLEMENTATION_PLAN/FEATURE) for
  // documents (null for projects/loops); `teamId` is a project's owning team
  // (null for documents/loops). All three are best-effort mirrors backfilled and
  // kept fresh by the write hooks; a hit missing them degrades to a non-link row.
  slug          String? @db.Text
  entitySubtype String? @map("entity_subtype") @db.Text
  teamId        String? @map("team_id") @db.Uuid

  // Route ANCHOR (FEA-3930 comment/PR/branch corpus slice). Nullable & additive.
  // For hits whose navigation target is a DIFFERENT entity than `entityId`, this
  // carries that target's id: a `pull_request` row routes to its owning branch
  // (anchor = branch artifact id); a `comment` row routes to the artifact it is
  // anchored on (anchor = that artifact's id, with the anchor artifact's TYPE
  // carried in `entitySubtype` so the route helper picks session vs branch).
  // Null for document/project/loop/session/branch rows, which route off
  // `entityId`. Not part of the generated `tsv` vector or any index.
  anchorEntityId String? @map("anchor_entity_id") @db.Uuid

  // Mirror of the source entity's own updatedAt (NOT this row's write time), so
  // recency ranking and since/until windows reflect the entity, not the
  // projection refresh.
  updatedAt DateTime @map("updated_at")

  // GENERATED ALWAYS ... STORED column — the Postgres full-text vector, OWNED by
  // the raw migration (20260722010000) and never written by the client. Prisma's
  // DSL has no `GENERATED` syntax, so it is modeled as `Unsupported("tsvector")`
  // with `@default(dbgenerated(...))` carrying the EXACT expression Postgres
  // stores it as (regconfig-cast, COALESCE-guarded). That default string is what
  // Prisma introspects the generated column back to, so `prisma migrate dev`
  // sees no change and reports no drift on this column.
  tsv Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(body, ''::text)))"))

  // Idempotent upsert key for the backfill and the Slice-2 write hooks.
  @@unique([organizationId, entityType, entityId])
  // Serves the org-scoped, type-faceted, recency-ordered candidate scan the
  // Slice-3 query leads with before the GIN full-text match refines it.
  @@index([organizationId, entityType, updatedAt])
  // GIN full-text index on the generated `tsv` column (the Slice-3
  // `tsv @@ websearch_to_tsquery(...)` match). Declared so Prisma tracks it by
  // name and does not try to drop it as an unknown DB index; built CONCURRENTLY
  // in migration 20260722010001 rather than by Prisma's plain-index DDL.
  @@index([tsv], type: Gin, map: "search_document_tsv_gin_idx")
  // FEA-3930 exact ID/slug lookup (search-fts-service.ts#runExactLookupQuery).
  // The UUID branch (`organization_id = ? AND entity_id = ?`) is served by this
  // Prisma-managed btree, built CONCURRENTLY in migration 20260724010000.
  @@index([organizationId, entityId], map: "search_document_organization_id_entity_id_idx")
  // The slug branch (`organization_id = ? AND lower(slug) = ?`) is served by an
  // UNMANAGED partial EXPRESSION index `search_document_org_lower_slug_idx`
  // (`(organization_id, lower(slug)) WHERE slug IS NOT NULL`). Prisma's DSL
  // cannot declare a functional index, so it lives only in migration
  // 20260724010000 and is noted here so its absence from the schema is
  // intentional, not drift.
  @@map("search_document")
}

