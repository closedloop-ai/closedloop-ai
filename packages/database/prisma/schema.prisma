model CustomFieldValue {
  id             String                @id @default(uuid(7)) @db.Uuid
  customFieldId  String                @map("custom_field_id") @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  entityType     CustomFieldEntityType @map("entity_type")
  entityId       String                @map("entity_id") @db.Uuid

  // Type-specific value columns (only one populated per row)
  textValue String? @map("text_value")
  // NUMBER values. When the field's `numberFormat` is DURATION the number is an
  // elapsed span IN MILLISECONDS (see the NumberFormat enum) — never seconds.
  numberValue       Float?    @map("number_value")
  dateValue         DateTime? @map("date_value")
  enumValueId       String?   @map("enum_value_id") @db.Uuid
  multiEnumValueIds String[]  @map("multi_enum_value_ids")
  peopleValueIds    String[]  @map("people_value_ids")

  // Cached display string (updated on write)
  displayValue String? @map("display_value")

  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  // Relations
  customField CustomField            @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  enumValue   CustomFieldEnumOption? @relation(fields: [enumValueId], references: [id], onDelete: SetNull)
  updatedBy   User?                  @relation(fields: [updatedById], references: [id])
  references  CustomFieldValueReference[]

  @@unique([customFieldId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  // ISS-7211: the two indexes above serve "find the values OF an entity"; a
  // facet asks the opposite — "find the entities WHERE field X holds value Y" —
  // and neither serves it. Measured on 30k artifacts / 180k values, the facet
  // read walked all 25,000 index entries for the field and discarded
  // 21,875-24,900 by filter; with these it discards none (73ms -> 2.8ms, TEXT).
  // The trailing column is the one the field's TYPE selects, so a given field
  // only populates one of them.
  @@index([customFieldId, entityType, textValue])
  @@index([customFieldId, entityType, numberValue])
  @@index([customFieldId, entityType, dateValue])
  @@index([customFieldId, entityType, enumValueId])
  // MULTI_ENUM/PEOPLE match by array overlap, which a btree cannot answer.
  @@index([multiEnumValueIds], type: Gin)
  @@index([peopleValueIds], type: Gin)
  @@map("custom_field_values")
}

// One row per artifact a REFERENCE / REFERENCE_MULTI value points at (ISS-7208).
//
// A child table with a real FK rather than an id array on `CustomFieldValue`,
// because `onDelete: Cascade` on `targetArtifactId` is what makes "deleting a
// target leaves no dangling reference value" a storage invariant instead of a
// cleanup job that can lag or fail. An id array has no referential integrity and
// would accumulate ids pointing at deleted rows.
//
// The target is `Artifact`, which covers all four ReferenceTargetSource
// populations: SESSION and BRANCH are Artifact rows, and ISSUE is a DOCUMENT
// artifact carrying `subtype = ISSUE`.
model CustomFieldValueReference {
  id                 String   @id @default(uuid(7)) @db.Uuid
  customFieldValueId String   @map("custom_field_value_id") @db.Uuid
  targetArtifactId   String   @map("target_artifact_id") @db.Uuid
  // Preserves the caller's ordering for REFERENCE_MULTI; always 0 for REFERENCE.
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")

  customFieldValue CustomFieldValue @relation(fields: [customFieldValueId], references: [id], onDelete: Cascade)
  targetArtifact   Artifact         @relation("CustomFieldReferenceTarget", fields: [targetArtifactId], references: [id], onDelete: Cascade)

  @@unique([customFieldValueId, targetArtifactId])
  @@index([targetArtifactId])
  @@map("custom_field_value_references")
}

