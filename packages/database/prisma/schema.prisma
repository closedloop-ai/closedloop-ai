/// One-time OAuth authorization code for the desktop authorization-code + PKCE
/// loopback flow (FEA-2409 / PLN-843 Amendment 1). Minted by the Clerk-authed
/// authorize endpoint, bound to the resolved user/org, the desktop device
/// public key (PoP), the PKCE S256 challenge, and the exact loopback redirect
/// URI. Redeemed exactly once (`redeemedAt`) at the token endpoint, within a
/// short `expiresAt` window, in exchange for a first-party desktop session.
/// userId/organizationId are stored as plain columns (no FK relation), matching
/// DesktopOnboardingAttempt — the row is ephemeral and single-use.
model DesktopAuthorizationCode {
  id             String    @id @default(uuid(7)) @db.Uuid
  codeHash       String    @unique @map("code_hash")
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  gatewayId      String    @map("gateway_id")
  boundPublicKey String    @map("bound_public_key")
  codeChallenge  String    @map("code_challenge")
  redirectUri    String    @map("redirect_uri")
  expiresAt      DateTime  @map("expires_at")
  redeemedAt     DateTime? @map("redeemed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("desktop_authorization_codes")
}

/// ISS-10966 (PLN-2095 Slice 1): the one-time code minted for a freshly
/// signed-up user who has NO organization yet, so a Desktop-originated signup
/// returns to Desktop instead of finishing organization setup in the browser.
///
/// Deliberately a separate table from DesktopAuthorizationCode rather than that
/// model with its ownership columns made nullable. There is no internal `user`
/// row to point at: `apps/api/lib/auth/find-or-create-user.ts` resolves users
/// only as (clerkUserId, clerkOrgId) pairs, so neither `userId` nor
/// `organizationId` has a value at mint time. Nulling the sibling's columns
/// would also be a constraint-RELAXING change, which `packages/database/
/// AGENTS.md` requires be split across merges; an added table cannot be split
/// and needs no window.
///
/// `clerkUserId` is the ONLY identity this row carries, and it is the raw Clerk
/// subject rather than a foreign key, because the internal rows it would
/// reference are materialized later, by the org-create bridge (Slice 5).
model DesktopBootstrapCode {
  id             String    @id @default(uuid(7)) @db.Uuid
  codeHash       String    @unique @map("code_hash")
  clerkUserId    String    @map("clerk_user_id")
  gatewayId      String    @map("gateway_id")
  boundPublicKey String    @map("bound_public_key")
  codeChallenge  String    @map("code_challenge")
  redirectUri    String    @map("redirect_uri")
  expiresAt      DateTime  @map("expires_at")
  redeemedAt     DateTime? @map("redeemed_at")
  consumedAt     DateTime? @map("consumed_at")
  organizationClerkId String? @map("organization_clerk_id")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("desktop_bootstrap_codes")
}

