}

model OAuthAuthorizationCode {
  id                  String    @id @default(uuid(7)) @db.Uuid
  // FEA-3275 CONTRACT phase, completing FEA-2775's expand/contract pair: the
  // plaintext `code` column is gone and the SHA-256 fingerprint is now the only
  // way a row is addressed, so a DB read (backup, replica, or SQL injection
  // elsewhere) cannot surface a usable authorization code. Mirrors
  // oauth_refresh_tokens.token_fingerprint and desktop_authorization_codes.code_hash.
  codeFingerprint     String    @unique @map("code_fingerprint")
  encryptedApiKey     String    @map("encrypted_api_key")
  keyId               String    @map("key_id")
  userId              String    @map("user_id") @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  clientId            String    @map("client_id")
  redirectUri         String    @map("redirect_uri")
  scopes              String[]
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @map("code_challenge_method")
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([consumedAt])
  @@map("oauth_authorization_codes")
}

