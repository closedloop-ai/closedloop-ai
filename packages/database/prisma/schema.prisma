  acknowledgedAt   DateTime? @map("acknowledged_at")
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message      SessionMeshMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient    User               @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  @@unique([messageId, recipientAgentId])
  @@index([organizationId, recipientUserId, recipientAgentId, status])
  @@index([organizationId, queuedAt])
  @@index([organizationId, attemptedAt])
  @@index([organizationId, deliveredAt])
  @@index([organizationId, acknowledgedAt])
  @@map("session_mesh_deliveries")
}

