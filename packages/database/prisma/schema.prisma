// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

// Relationship types between entities (source → target, where source is the origin/cause)
enum LinkType {
  PRODUCES // source produces target (PRD → Plan, Plan → PR, PR → Preview)
  BLOCKS // source blocks target (Feature blocks Feature)
  RELATES_TO // bidirectional association (Feature ↔ Feature)
}

// Advisory only — not bound to any column (Artifact.status is a freeform
// String). Documents are PRD/IMPLEMENTATION_PLAN/TEMPLATE subtypes; their
// authoring/approval lifecycle. SSOT: @closedloop-ai/loops-api/document. PRD-495.
enum DocumentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  EXECUTED
  OBSOLETE
}

// Advisory only — not bound to any column. Features (subtype = FEATURE); their
// delivery / issue-tracker lifecycle. SSOT: @closedloop-ai/loops-api/document.
enum FeatureStatus {
  TRIAGE
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELED
}

enum EvaluationReportType {
  PLAN
  CODE
  PRD
  FEATURE
}

enum EvalStatus {
  FAILED
  NEEDS_IMPROVEMENT
  PASSED
}

enum PromptType {
  AGENT
  JUDGE
}

enum ApproverRole {
  PM
  DESIGNER
  TECH_LEAD
  ENGINEER
  STAKEHOLDER
}

enum GitHubPRState {
  OPEN
  MERGED
  CLOSED
}

enum ChecksStatus {
  UNKNOWN
  PENDING
  PASSING
  FAILING
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
  DISMISSED
}

enum GitHubInstallationStatus {
  PENDING_CLAIM
  ACTIVE
  SUSPENDED
  UNINSTALLED
}

// Distinguishes manually created API keys from desktop-managed bootstrap keys.
enum ApiKeySource {
  USER_CREATED
  DESKTOP_MANAGED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum LoopStatus {
  PENDING
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
  // Deferred at dispatch because a linked blocking artifact is still
  // non-terminal. Re-evaluated by the loop reconciliation cron, which
  // transitions BLOCKED -> PENDING once every blocker resolves. Non-claimable
  // (the orchestrator only claims PENDING loops) and non-terminal.
  BLOCKED
}

enum LoopCommand {
  PLAN
  EXECUTE
  CHAT
  EXPLORE
  REQUEST_CHANGES
  DECOMPOSE
  EVALUATE_PRD
  GENERATE_PRD
  EVALUATE_PLAN
  EVALUATE_CODE
  REQUEST_PRD_CHANGES
  BOOTSTRAP
  MANUAL
  EVALUATE_FEATURE
}

// Discriminates how a SessionDetail row was produced: a synced desktop agent
// run (DESKTOP_SYNC) vs. a materialized orchestration Loop (LOOP). Lets the
// unified Sessions list tell the two apart. See FEA-1718 / PLN-921.
enum SessionOrigin {
  DESKTOP_SYNC
  LOOP
}

enum CustomFieldType {
  TEXT
  NUMBER
  ENUM
  MULTI_ENUM
  DATE
  PEOPLE
}

enum CustomFieldEntityType {
  PROJECT
  DOCUMENT
}

enum NumberFormat {
  NONE
  CURRENCY
  PERCENTAGE
  CUSTOM
}

enum LabelPosition {
  PREFIX
  SUFFIX
}

enum ThreadSource {
  NATIVE
  LIVEBLOCKS
  GITHUB
}

enum ThreadStatus {
  OPEN
  RESOLVED
}

enum ExternalCommentProvider {
  GITHUB
}

enum GitHubCommentThreadKind {
  REVIEW_THREAD
  ISSUE_COMMENT
}

enum GitHubDiffSide {
  LEFT
  RIGHT
}

enum GitHubLegacyCommentState {
  PENDING
  ADDRESSED
  DISMISSED
}

enum PreferredComputeMode {
  LOCAL
  CLOUD
}

// Kinds of first-class artifacts tracked in the `artifacts` parent table.
// Added in Chunk 2a of PLN-321 alongside the Artifact/DocumentDetail models.
enum ArtifactType {
  DOCUMENT
  BRANCH
  DEPLOYMENT
  SESSION
}

// Narrower classification for DOCUMENT-typed artifacts (carries values that
// used to live on the legacy DocumentType enum). Null for PRs and deployments.
//
// FEA-3956 (PRD-560 Phase 3): `ISSUE` is the canonical value for the Feature →
// Issue rename, ADDED here (additive, non-destructive) so the column accepts it
// from a skewed newer client. Per PRD-560 decision 2 existing rows are NOT
// migrated — they stay stored as `FEATURE`, and the API/wire boundary maps the
// canonical `ISSUE` input back to the persisted `FEATURE` in code
// (`normalizeArtifactSubtype`). `FEATURE` remains a permanent compat alias;
// removing it is Phase 4 (FEA-3957) and needs explicit human approval.
enum ArtifactSubtype {
  PRD
  IMPLEMENTATION_PLAN
  TEMPLATE
  FEATURE
  DOC
  ISSUE
}

// =============================================================================
// ROUTINES (FEA-4365 / PRD-566)
// =============================================================================
// Cloud/web-side persistence for scheduled Routines and their run history, so
// Web and cross-machine surfaces have an org/team-scoped source of truth that
// the desktop SQLite store (unreachable from cloud) can sync up to. The shapes
// below are a SUPERSET mapping of the desktop crewd `ScheduledTask`/`RunRecord`
// model (packages/crewd/src/model.ts) and are faithful to the frozen Routines
// prototype (apps/prototypes/app/p/routines/mock.ts). Sibling FEA-4349 owns the
// `@repo/app/routines` domain model; when that lands, the string enums here map
// 1:1 to its const objects (see the RoutineProvider/RoutineStatus/etc. below).

// Harness/provider that drives a routine. Superset of the prototype's
// RoutineProvider (claude/codex); `opencode` is included to reconcile with the
// crewd HarnessName enum so a desktop-origin routine on any crewd harness can
// sync up without a lossy mapping.
enum RoutineProvider {
  CLAUDE
  CODEX
  OPENCODE
}

// Where a routine executes when it fires. Mirrors the prototype's RunsOn.
enum RoutineRunsOn {
  LOCAL
  CLOUD
}

// How a routine came to exist: built by hand in the UI, or discovered already
// configured on a teammate's dev machine and reported up centrally. Mirrors the
// prototype's RoutineOrigin.
enum RoutineOrigin {
  CREATED
  DISCOVERED
}

// Lifecycle status of a routine. Mirrors the prototype's RoutineStatus.
enum RoutineStatus {
  ACTIVE
  PAUSED
  DRAFT
}

// The kind of recurrence the schedule expresses. Mirrors the prototype's
// ScheduleKind; `scheduleDetail`/`cron` carry the concrete timing.
enum RoutineScheduleKind {
  MANUAL
  HOURLY
  DAILY
  WEEKDAYS
  WEEKLY
  CUSTOM
}

// When to notify on a run. Mirrors the prototype's NotifyMode.
enum RoutineNotifyMode {
  ALL_RUNS
  FAILED_RUNS_ONLY
}

// Codex-only "Runs in" choice (continue an existing chat vs start a fresh one).
// Mirrors the prototype's RunsIn; null for Claude/opencode routines.
enum RoutineRunsIn {
  NEW_CHAT
  EXISTING_CHAT
}

// Outcome of a single routine run. Superset of the prototype's implicit run
// states and the crewd RunStatus enum, so a desktop RunRecord maps 1:1.
enum RoutineRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  TIMEOUT
  CANCELED
}

// The kind of a component a routine run invoked, so a run can drill down into
// the Agents & Skills inventory. Mirrors the prototype's ComponentKind.
enum RoutineComponentKind {
  SUBAGENT
  COMMAND
  SKILL
}

// =============================================================================
// CORE ENTITIES
// =============================================================================

model PreviewSchema {
  schemaName String   @id @map("schema_name")
  branch     String?
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@map("preview_schemas")
}

model PreviewSchemaObservation {
  schemaName      String   @id @map("schema_name")
  firstObservedAt DateTime @default(now()) @map("first_observed_at") @db.Timestamptz

  @@map("preview_schemas_observations")
}

model Organization {
  id                    String    @id @default(uuid(7)) @db.Uuid
  clerkId               String    @unique @map("clerk_id")
  active                Boolean   @default(true) @map("active")
  name                  String
  slug                  String    @unique
  claudeApiKeyEncrypted String?   @map("claude_api_key_encrypted")
  claudeApiKeyLastFour  String?   @map("claude_api_key_last_four")
  claudeApiKeySetAt     DateTime? @map("claude_api_key_set_at")
  settings              Json      @default("{}") // settings.computeMode deprecated -- use User.preferredComputeMode instead
  // Privacy gate for unified search over AI session transcript CONTENT (FEA-3930,
  // parent FEA-3800). Default false: transcript text (which can carry source,
  // secrets, and prompts) is NOT indexed into `search_document` or returned by the
  // FTS query unless an org admin opts in. Both the write-time indexer and the
  // query path check this flag, so flipping it off stops new indexing and hides
  // any `agent_session` rows left from when it was on.
  searchIncludeTranscripts Boolean @default(false) @map("search_include_transcripts")
  // FEA-4169: server-owned ORG POLICY gating whether local desktop session data
  // (session metadata + transcripts) may sync to the cloud at all. This is the
  // OUTER gate ABOVE per-device sync consent (PRD-542/FEA-4103) — when false, NO
  // session data egresses from any of the org's desktops regardless of the tier a
  // user picked locally. Default false (privacy-safe): an org must be explicitly
  // enabled before any session data leaves the machine. Enabled for the internal
  // Closedloop org by data migration. Surfaced to the desktop through
  // `GET /desktop/identity`; older desktops that don't read it degrade to the
  // prior device-consent behavior (the field is additive/optional on the wire).
  sessionSyncPolicyEnabled Boolean @default(false) @map("session_sync_policy_enabled")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  users                     User[]
  teams                     Team[]
  artifactRatings           ArtifactRating[]
  projects                  Project[]
  artifacts                 Artifact[]
  githubInstallation        GitHubInstallation?
  loops                     Loop[]
  prompts                   Prompt[]
  computeTargets            ComputeTarget[]
  computeTargetHealthChecks ComputeTargetHealthCheck[]
  sessionTranscripts        SessionTranscript[]
  chatSessions              ChatSession[]
  judgeHumanScores          JudgeHumanScore[]
  customFields              CustomField[]
  commentThreads            CommentThread[]
  agents                    Agent[]
  repoBootstrapConfigs      RepoBootstrapConfig[]
  userPublicKeys            UserPublicKey[]
  agentComponents           AgentComponent[]
  agentComponentVersions    AgentComponentVersion[]
  definitionVersions        DefinitionVersion[]
  sourceOccurrences         SourceOccurrence[]
  catalogItems              CatalogItem[]
  distributions             Distribution[]
  publicRepositories        PublicRepository[]
  externalCommentAuthors    ExternalCommentAuthor[]
  githubUserConnections     GitHubUserConnection[]
  githubAccessCapabilities  GitHubAccessCapability[]
  githubRepoSyncStates      GitHubRepoSyncState[]
  tags                      Tag[]
  linearSubtasks            LinearSubtask[]
  desktopSessions           DesktopSession[]
  githubDirtyScopeNudges    GitHubDirtyScopeNudge[]
  branchDetails             BranchDetail[]
  branchActivityAtoms       BranchActivityAtom[]
  pullRequestDetails        PullRequestDetail[]
  repositoryDefaultObservationReceipts RepositoryDefaultObservationReceipt[]
  commitDetails             CommitDetail[]
  auditEntries              AuditEntry[]
  auditOutboxEntries        AuditOutbox[]
  routines                  Routine[]
  routineRuns               RoutineRun[]
  deploymentEvents          DeploymentEvent[]

  @@map("organizations")
}

model User {
  id                       String                @id @default(uuid(7)) @db.Uuid
  clerkId                  String                @map("clerk_id")
  organizationId           String                @map("organization_id") @db.Uuid
  active                   Boolean               @default(true) @map("active")
  email                    String
  firstName                String?               @map("first_name")
  lastName                 String?               @map("last_name")
  avatarUrl                String?               @map("avatar_url")
  phoneNumber              String?               @map("phone_number")
  role                     ApproverRole          @default(ENGINEER)
  linearId                 String?               @map("linear_id")
  slackId                  String?               @map("slack_id")
  githubUsername           String?               @map("github_username")
  claudeApiKeyEncrypted    String?               @map("claude_api_key_encrypted")
  claudeApiKeyLastFour     String?               @map("claude_api_key_last_four")
  claudeApiKeySetAt        DateTime?             @map("claude_api_key_set_at")
  preferredComputeMode     PreferredComputeMode? @map("preferred_compute_mode")
  preferredComputeTargetId String?               @map("preferred_compute_target_id") @db.Uuid
  preferredHarness         String?               @map("preferred_harness")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  // Relations
  organization                Organization                        @relation(fields: [organizationId], references: [id])
  preferredComputeTarget      ComputeTarget?                      @relation("UserPreferredComputeTarget", fields: [preferredComputeTargetId], references: [id])
  teamMemberships             TeamMember[]
  artifactRatings             ArtifactRating[]
  favoriteProjects            FavoriteProject[]
  favoriteArtifacts           FavoriteArtifact[]
  assignedProjects            Project[]                           @relation("ProjectAssignee")
  createdProjects             Project[]                           @relation("ProjectCreatedBy")
  assignedArtifacts           Artifact[]                          @relation("ArtifactAssignee")
  createdArtifacts            Artifact[]                          @relation("ArtifactCreatedBy")
  approvedDocumentDetails     DocumentDetail[]                    @relation("DocumentDetailApprover")
  loops                       Loop[]
  computeTargets              ComputeTarget[]
  sessionDetails              SessionDetail[]
  chatSessions                ChatSession[]
  judgeHumanScores            JudgeHumanScore[]
  createdCustomFields         CustomField[]
  updatedCustomFieldValues    CustomFieldValue[]
  dismissedGenerationStatuses DocumentGenerationStatusDismissal[]
  createdAgents               Agent[]                             @relation("AgentCreatedBy")
  agentVersionChanges         AgentVersion[]                      @relation("AgentVersionChangedBy")
  publicKeys                  UserPublicKey[]
  externalCommentAuthors      ExternalCommentAuthor[]
  githubUserConnections       GitHubUserConnection[]
  createdTags                 Tag[]                               @relation("TagCreatedBy")
  desktopSessions             DesktopSession[]
  createdCatalogItems         CatalogItem[]                       @relation("CatalogItemCreatedBy")
  changedCatalogItemVersions  CatalogItemVersion[]                @relation("CatalogItemVersionChangedBy")
  createdDistributions        Distribution[]                      @relation("DistributionCreatedBy")
  withdrawnDistributions      Distribution[]                      @relation("DistributionWithdrawnBy")
  distributionTargetStatuses  DistributionTargetStatus[]          @relation("DistributionTargetStatusUser")
  definitionVersionEdits      DefinitionVersionEditor[]           @relation("DefinitionVersionEditor")
  ownedRoutines               Routine[]                           @relation("RoutineOwner")

  @@unique([organizationId, email])
  @@unique([clerkId, organizationId])
  @@index([clerkId])
  @@index([linearId])
  @@index([slackId])
  @@index([githubUsername])
  @@map("users")
}

model UserPublicKey {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  publicKeyBase64 String   @map("public_key_base64")
  fingerprint     String
  createdAt       DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([organizationId])
  @@map("user_public_keys")
}

model ComputeTarget {
  id                     String    @id @default(uuid(7)) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  machineName            String    @map("machine_name")
  platform               String
  capabilities           Json      @default("{}")
  supportedOperations    Json      @default("[]") @map("supported_operations")
  lastSeenAt             DateTime  @default(now()) @map("last_seen_at")
  // ISS-4678: the LANDED-DATA watermark. Advances ONLY when session rows
  // actually persisted, so an accepted empty / all-foreign-chunk batch leaves it
  // alone. Read as "last INGEST" — not "last successful sync" (ISS-4828).
  lastAgentSessionSyncAt DateTime? @map("last_agent_session_sync_at")
  // ISS-4827: the ATTEMPT watermark. Stamped on EVERY accepted session batch,
  // including the zero-row batches `lastAgentSessionSyncAt` deliberately
  // ignores. Together the pair separates a desktop that is reaching the cloud
  // but whose data is not landing (attempt fresh, ingest stale => STALLED) from
  // one that is merely open and idle (both stale => QUIET). `lastSeenAt` cannot
  // do this: it is refreshed by registration/heartbeat/online check-ins on a
  // ~30-90s cadence with no ingest attempt behind it.
  lastAgentSessionSyncAttemptAt DateTime? @map("last_agent_session_sync_attempt_at")
  isOnline               Boolean   @default(false) @map("is_online")
  isSharedWithOrg        Boolean   @default(false) @map("is_shared_with_org")
  // FEA-2923 (Gap A): marks a synthetic per-org "cloud" compute target that
  // owns cloud-authored AgentComponent rows (org-custom agents backfilled from
  // catalog_items). These rows have NO real device. The sentinel keeps
  // AgentComponent.computeTargetId a non-null FK without a nullable-FK ripple
  // through desktop sync / listing / analytics, and its distinct id guarantees
  // device sync upserts (keyed by the real device computeTargetId) never
  // collide with cloud rows. Device-facing listings filter it out
  // (isCloudSentinel = false). See migration
  // 20260712000000_add_compute_target_cloud_sentinel_and_backfill_agent_components.
  isCloudSentinel        Boolean   @default(false) @map("is_cloud_sentinel")
  gatewayId              String?   @map("gateway_id")
  selectedHarness        String    @default("claude") @map("selected_harness")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization                        Organization                         @relation(fields: [organizationId], references: [id])
  user                                User                                 @relation(fields: [userId], references: [id])
  preferringUsers                     User[]                               @relation("UserPreferredComputeTarget")
  desktopCommands                     DesktopCommand[]
  loopExecutionCredentialConsumptions LoopExecutionCredentialConsumption[]
  loops                               Loop[]
  sessionDetails                      SessionDetail[]
  sessionTranscripts                  SessionTranscript[]
  githubDirtyScopeNudges              GitHubDirtyScopeNudge[]
  healthCheck                         ComputeTargetHealthCheck?
  agentComponents                     AgentComponent[]
  sourceOccurrences                   SourceOccurrence[]
  distributionTargetStatuses          DistributionTargetStatus[]
  distributionTargetingEntries        DistributionTargetingEntry[]

  @@unique([userId, machineName])
  @@index([organizationId, userId])
  // NOTE: A partial unique index on gateway_id WHERE gateway_id IS NOT NULL is
  // maintained via raw migration. Prisma cannot express partial indexes. Do NOT
  // add @@unique([gatewayId]) here; it would reject multiple NULL rows.
  // See migration: add_compute_targets_gateway_id_unique
  @@index([organizationId, userId, gatewayId])
  @@index([userId, isOnline])
  @@index([organizationId, isSharedWithOrg])
  // NOTE (ISS-4543): two PARTIAL indexes on (organizationId,
  // lastAgentSessionSyncAt) and (organizationId), each scoped by
  // is_cloud_sentinel + a last_agent_session_sync_at IS [NOT] NULL predicate,
  // back the /cron/sample-session-ingestion-health scan. Prisma cannot express
  // partial indexes, so they are maintained via raw migration and are NOT
  // declared as @@index here (a full @@index would not match, causing drift).
  // See migration: 20260731130000_iss4543_compute_target_ingestion_health_scan_index
  // NOTE (ISS-4832): a third PARTIAL index on (organizationId, lastSeenAt)
  // INCLUDE (lastAgentSessionSyncAttemptAt) WHERE is_cloud_sentinel = false
  // backs the same cron's per-org presence/attempt scan (`loadPresenceByOrg`).
  // Also raw-migration-maintained for the same partial-index reason.
  // See migration: 20260802190000_iss4832_compute_target_heartbeat_group_index
  @@map("compute_targets")
}

model ComputeTargetHealthCheck {
  id                      String   @id @default(uuid(7)) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  computeTargetId         String   @unique @map("compute_target_id") @db.Uuid
  checkedAt               DateTime @map("checked_at")
  expectedMcpUrl          String?  @map("expected_mcp_url")
  latestVersion           String?  @map("latest_version")
  pluginAutoUpdateEnabled Boolean  @default(false) @map("plugin_auto_update_enabled")
  result                  Json
  allRequiredPassed       Boolean  @map("all_required_passed")
  requiredFailureIds      Json     @default("[]") @map("required_failure_ids")
  schemaVersion           Int      @default(1) @map("schema_version")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  computeTarget ComputeTarget @relation(fields: [computeTargetId], references: [id], onDelete: Cascade)

  @@index([organizationId, checkedAt])
  @@map("compute_target_health_checks")
}

// Type-specific detail for SESSION-typed artifacts (captured agent/session
// runs synced from the desktop). 1:1 with `Artifact` via shared `artifact_id`
// primary key, mirroring document_detail / branch_detail / deployment_detail.
// Hoisted to the parent `artifacts` row: organizationId, projectId, name,
// status. The raw harness status string is stored on `artifacts.status`
// (free-form TEXT) — the curated session lifecycle is a deferred follow-up.
model SessionDetail {
  artifactId         String        @id @map("artifact_id") @db.Uuid
  // Session owner. Nullable + SetNull so a session survives its creator's
  // deletion as an org-owned artifact (matches assignee_id/created_by_id).
  userId             String?       @map("user_id") @db.Uuid
  computeTargetId    String        @map("compute_target_id") @db.Uuid
  externalSessionId  String        @map("external_session_id")
  harness            String        @default("unknown")
  // How this session row was produced: synced desktop run vs. materialized Loop
  // (FEA-1718). Existing rows default to DESKTOP_SYNC.
  origin             SessionOrigin @default(DESKTOP_SYNC)
  // Per-session billing mode resolved by the desktop (subscription vs. API-key
  // plan, from the desktop's billing_mode column). Opaque string; the usage
  // cost split classifies it for DESKTOP_SYNC sessions that have no source Loop.
  billingMode        String?       @map("billing_mode")
  // ISS-4586: whether the desktop run ended on an unrecovered error (the
  // desktop's `ends_with_error` flag, synced additively). The stale-session
  // reaper reads it to declare an orphaned still-active session ERROR vs INACTIVE
  // without re-deriving from events. Nullable: absent for pre-ISS-4586 rows and
  // for older desktop builds that don't sync it (treated as not-error → INACTIVE).
  endsWithError      Boolean?      @map("ends_with_error")
  cwd                String?
  repositoryFullName String?       @map("repository_full_name")
  worktreePath       String?       @map("worktree_path")
  model              String?
  deviceTimeZone     String?       @map("device_time_zone")
  sessionStartedAt   DateTime      @map("session_started_at")
  sessionUpdatedAt   DateTime      @map("session_updated_at")
  // Genuine-activity timestamp: MAX(agent_session_events.event_created_at)
  // floored at sessionStartedAt. Unlike sessionUpdatedAt (bumped by desktop
  // OTEL ingest / enrichment / sync bookkeeping) this advances only on real
  // agent activity, and is the default sort for the Sessions list. Nullable for
  // pre-backfill rows; readers fall back to sessionStartedAt.
  lastActivityAt     DateTime?     @map("last_activity_at")
  sessionEndedAt     DateTime?     @map("session_ended_at")
  awaitingInputSince DateTime?     @map("awaiting_input_since")
  sourceArtifactId   String?       @map("source_artifact_id")
  sourceLoopId       String?       @map("source_loop_id")
  baseBranch         String?       @map("base_branch")
  state              String?
  branch             String?
  pullRequests       Json?         @map("pull_requests")
  wallClock          String?       @map("wall_clock")
  activeAgent        String?       @map("active_agent")
  waitingUser        String?       @map("waiting_user")
  linesAdded         Int?          @map("lines_added")
  linesRemoved       Int?          @map("lines_removed")
  filesChanged       Int?          @map("files_changed")
  // Provenance of the lines_*/files_changed scalars: "git" when the desktop
  // sent source-tagged gitDiffStats, null when only heuristic/agent-estimated
  // scalars were synced. Readers rehydrate gitDiffStats from this marker.
  locSource          String?       @map("loc_source")
  // Branch-level LOC (working-branch changes vs the author's contributed lines):
  // a distinct metric from the authored gitDiffStats scalars, so it lives in its
  // own columns. Readers rehydrate branchDiffStats from these; branch_loc_source
  // records its provenance independently of loc_source.
  branchLinesAdded   Int?          @map("branch_lines_added")
  branchLinesRemoved Int?          @map("branch_lines_removed")
  branchFilesChanged Int?          @map("branch_files_changed")
  branchLocSource    String?       @map("branch_loc_source")
  turns              Int?
  steeringEpisodes   Int?          @map("steering_episodes")
  autonomy           Int?
  activityBuckets    Json?         @map("activity_buckets")
  sessionSpan        Json?         @map("session_span")
  markers            Json?
  throttles          Json?
  tracePhaseSources  Json?         @map("trace_phase_sources")
  throttleSources    Json?         @map("throttle_sources")
  correctionSources  Json?         @map("correction_sources")
  phases             Json?
  phaseIterations    Json?         @map("phase_iterations")
  phaseLoopbacks     Json?         @map("phase_loopbacks")
  inputTokens        BigInt        @default(0) @map("input_tokens")
  outputTokens       BigInt        @default(0) @map("output_tokens")
  cacheReadTokens    BigInt        @default(0) @map("cache_read_tokens")
  cacheWriteTokens   BigInt        @default(0) @map("cache_write_tokens")
  estimatedCost      Decimal       @default(0) @map("estimated_cost") @db.Decimal(14, 6)
  agentCount         Int           @default(0) @map("agent_count")
  toolUseCount       Int           @default(0) @map("tool_use_count")
  errorCount         Int           @default(0) @map("error_count")
  metadata           Json?
  agents             Json          @default("[]")
  // FEA-3928: raw, UNBOUNDED additive frustration signal computed by the desktop
  // (frustration words + shouting + pleading punctuation + nearby errors +
  // steering/corrections/loopbacks/throttles). Stored raw — NOT a pre-normalized
  // 0–100 score — because the 0..max→0..100 normalization is done at Insights
  // aggregation time against the org population's observed max, which drifts as
  // more sessions land. frustrationScoreVersion records the scorer version that
  // produced the value. Both nullable, no default: an existing/unscored row is
  // NULL ("not computed").
  frustrationRaw          Int?      @map("frustration_raw")
  frustrationScoreVersion Int?      @map("frustration_score_version")
  dataRevision       Int?          @map("data_revision")
  // FEA-3474 (PRD-536 D3): staged identity of an in-progress chunked-apply
  // sequence, recorded by the FIRST chunk's delete-replace and cleared when the
  // matching LAST chunk commits the revision. Makes the chunked apply atomic and
  // all-or-nothing:
  //   - pendingChunkRevision — the dataRevision chunk 0 started rebuilding. The
  //     last chunk commits dataRevision ONLY when its own revision equals this
  //     marker (the same sequence chunk 0 opened), so a stale/out-of-order chunk
  //     from a DIFFERENT revision can never satisfy the commit and leave a
  //     half-session masquerading as a complete revision.
  //   - pendingChunkTotal — that sequence's chunk count (`chunk.total`).
  //   - pendingChunkReceived — the highest CONTIGUOUS chunk index seen + 1 (how
  //     many leading chunks arrived), so a dropped interior chunk keeps this
  //     below total and the last chunk cannot commit over a gap.
  // All three are NULL when no chunked sequence is mid-apply (the steady state
  // and every unchunked session).
  pendingChunkRevision Int?        @map("pending_chunk_revision")
  pendingChunkTotal    Int?        @map("pending_chunk_total")
  pendingChunkReceived Int?        @map("pending_chunk_received")
  lastSyncedAt       DateTime      @default(now()) @map("last_synced_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  artifact              Artifact                             @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user                  User?                                @relation(fields: [userId], references: [id], onDelete: SetNull)
  computeTarget         ComputeTarget                        @relation(fields: [computeTargetId], references: [id], onDelete: Restrict)
  tokenUsageByModel     AgentSessionTokenUsage[]
  events                AgentSessionEvent[]
  tokenEvents           AgentSessionTokenEvent[]
  usageRollup           AgentSessionUsageRollup?
  sessionTranscripts    SessionTranscript[]
  componentUsages       AgentComponentSessionUsage[]
  invocationGenerations AgentComponentInvocationGeneration[]
  activitySegmentRows   AgentSessionActivitySegment[]

  @@unique([computeTargetId, externalSessionId])
  @@index([sessionStartedAt])
  @@index([userId, sessionStartedAt])
  @@index([harness, sessionStartedAt])
  // FEA-4303: the Sessions Model filter adds `WHERE model IN (...)` to the
  // session-list query (see query-builder.ts), combined with the
  // session_started_at sort/window. Mirrors the equality-facet shape of
  // @@index([harness, sessionStartedAt]) so the planner drives from the model
  // predicate with the start-date range on the same index instead of a
  // sequential scan as session_detail grows.
  @@index([model, sessionStartedAt], map: "session_detail_model_started_at_idx")
  @@index([computeTargetId, sessionUpdatedAt])
  @@index([computeTargetId, lastActivityAt])
  @@index([lastActivityAt])
  @@index([repositoryFullName])
  // Sessions-list autonomy-tier and cost-bucket facets filter these columns with
  // range predicates (gte/lt), unlike the equality-based harness facet. A range
  // predicate can't share a composite index with the lastActivityAt sort column
  // (the range breaks the ordering), so single-column indexes on each filtered
  // column are the useful shape — mirroring the single-column repositoryFullName
  // facet index. autonomy is nullable ("unknown" tier = IS NULL). (FEA-2504)
  @@index([autonomy])
  @@index([estimatedCost])
  // FEA-3638 (insights perf, Tier-1): the org-scope session / cost / runtime / tool
  // aggregations join session_detail → artifacts (for the org predicate) and window
  // on session_started_at. Today only @@index([sessionStartedAt]) (org-blind) and
  // @@index([userId, sessionStartedAt]) (me-scope) exist, so the org-scope planner
  // scans the whole time window across ALL orgs then filters by org post-join. This
  // additive composite lets the planner drive from the org's artifacts (artifact_id
  // is the PK) with the session_started_at range on the same index, serving the
  // session→artifact two-hop that also underlies the agent token-usage aggregates.
  // Additive / no-result-change; direction to be confirmed by EXPLAIN on a seeded DB.
  @@index([artifactId, sessionStartedAt])
  // FEA-1718 back-link: `source_loop_id` is the ONLY column recording which Loop
  // a session came from, and every reverse read of that lineage — "which session
  // materialized loop X" — had no index at all, so each lookup sequentially
  // scanned session_detail. The one-time `Loop.session_artifact_id` backfill
  // groups the whole table by this column, and the loops-list read path resolves
  // it per page (up to 1000 loops), so the scan cost is paid repeatedly rather
  // than once. Single-column (not composite with a date) because every reader is
  // an equality lookup on the loop id, matching the repositoryFullName facet
  // shape above. Nullable: a desktop-only session carries NULL and is simply not
  // in the index's useful population.
  @@index([sourceLoopId], map: "session_detail_source_loop_id_idx")
  @@map("session_detail")
}

/// Cloud-side metadata for a raw session transcript archived to S3 (FEA-2714).
/// One row per transcript FILE: a logical session owns one `main` transcript
/// plus zero or more `subagent:{fileId}` sidechain files, discriminated by
/// `fileKey`. Metadata only — transcript bytes live in the S3 transcripts
/// bucket and never transit apps/api (PLN-1285 decision 2).
model SessionTranscript {
  id                     String    @id @default(uuid(7)) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  computeTargetId        String    @map("compute_target_id") @db.Uuid
  externalSessionId      String    @map("external_session_id")
  // Resolved from (computeTargetId, externalSessionId); nullable because a
  // transcript can arrive before the metadata lane creates the SessionDetail
  // row. FK targets SessionDetail.artifactId (its primary key). Subagent rows
  // share the parent session's sessionDetailId. Both routes attempt resolution
  // while unset.
  sessionDetailId        String?   @map("session_detail_id") @db.Uuid
  // Harness that produced the transcript: `claude_code`, `codex`, …
  sourceHarness          String    @map("source_harness")
  // `main` for the session transcript, `subagent:{fileId}` for sidechain files.
  fileKey                String    @map("file_key")
  objectStorageKey       String    @map("object_storage_key")
  // pending | uploading | uploaded | failed | skipped
  // `skipped` (FEA-3476) is a terminal, non-retryable state: the desktop
  // deterministically will not upload this file (e.g. it exceeds the local size
  // cap). The read path derives `failedPermanent` from it (vs the retryable
  // `failed` -> `failedTransient`), so a never-coming transcript stops showing
  // as "syncing". The reason lives on `permanentFailureReason`.
  uploadStatus           String    @default("pending") @map("upload_status")
  // FEA-3476: why a `skipped` row is permanently absent (e.g. `too_large`).
  // Null for every non-`skipped` row. Free-text TEXT matching the
  // `TranscriptSkipReason` contract enum in @repo/api.
  permanentFailureReason String?   @map("permanent_failure_reason")
  // Archive identity (client-computed sha256); set once verified on complete.
  rawSha256              String?   @map("raw_sha256")
  // S3-verified full-object CRC64NVME checksum; set on complete.
  crc64nvme              String?   @map("crc64nvme")
  rawByteSize            BigInt?   @map("raw_byte_size")
  // Current-version ETag, used as If-Match on the next copy-append.
  storedEtag             String?   @map("stored_etag")
  // Last VERIFIED byte offset — advances only on a successful complete
  // (recovery invariant 1). Clients recompute their delta from this.
  syncedByteOffset       BigInt    @default(0) @map("synced_byte_offset")
  sourceMtime            DateTime? @map("source_mtime")
  // Hash of the local file path — no raw local paths in cloud (PRD security req).
  sourcePathHash         String?   @map("source_path_hash")
  // In-flight multipart upload id + start time, for resume and staleness abort.
  pendingUploadId        String?   @map("pending_upload_id")
  pendingUploadStartedAt DateTime? @map("pending_upload_started_at")
  firstSeenAt            DateTime  @default(now()) @map("first_seen_at")
  lastObservedAt         DateTime  @default(now()) @map("last_observed_at")
  uploadedAt             DateTime? @map("uploaded_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  computeTarget ComputeTarget  @relation(fields: [computeTargetId], references: [id], onDelete: Restrict)
  sessionDetail SessionDetail? @relation(fields: [sessionDetailId], references: [artifactId], onDelete: SetNull)

  // Session identity (matches SessionDetail) plus the per-file discriminator.
  @@unique([computeTargetId, externalSessionId, fileKey])
  // NOTE: the standalone @@index([organizationId]) was dropped in
  // 20260722000001_prd536_g7_drop_redundant_org_index — the PRD-536 G7 composite
  // below leads with organizationId, so any org-only-prefixed query is served by
  // the composite's leading column, making a separate single-column org index
  // redundant write/storage overhead on this hot table.
  @@index([sessionDetailId])
  // PRD-536 G7: the transcript identity read (transcript-read-service /
  // agent-sessions service, via `sessionTranscriptIdentityWhere`) filters on
  // (organizationId, computeTargetId, externalSessionId) and orders by fileKey.
  // The unique key leads with computeTargetId, so it can't org-prefix this read
  // and large orgs scan. This composite leads with organizationId and co-locates
  // the full predicate + sort so the read is index-served.
  @@index([organizationId, computeTargetId, externalSessionId, fileKey])
  @@map("session_transcript")
}

// FEA-2718: conversation turn text left the database. The `summary` and `data`
// columns (turn/tool content) were dropped — the cloud transcript archive
// (FEA-2717) is the sole source of turn/tool detail. Only columnar metadata
// used by the timeline/markers/analytics remains here.
model AgentSessionEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  agentSessionId  String   @map("agent_session_id") @db.Uuid
  externalEventId String   @map("external_event_id")
  agentExternalId String?  @map("agent_external_id")
  eventType       String   @map("event_type")
  toolName        String?  @map("tool_name")
  eventCreatedAt  DateTime @map("event_created_at")
  createdAt       DateTime @default(now()) @map("created_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@unique([agentSessionId, externalEventId])
  @@index([agentSessionId, eventCreatedAt])
  @@map("agent_session_events")
}

model AgentSessionTokenUsage {
  id               String   @id @default(uuid(7)) @db.Uuid
  agentSessionId   String   @map("agent_session_id") @db.Uuid
  model            String
  inputTokens      BigInt   @default(0) @map("input_tokens")
  outputTokens     BigInt   @default(0) @map("output_tokens")
  cacheReadTokens  BigInt   @default(0) @map("cache_read_tokens")
  cacheWriteTokens BigInt   @default(0) @map("cache_write_tokens")
  /// FEA-3419: cache-write TTL subdivision (5-minute vs 1-hour ephemeral
  /// writes). NULL = the desktop never reported a breakdown (legacy sessions,
  /// non-Claude harnesses, pre-TTL builds); explicit 0 = reported zero.
  cacheWrite5mTokens BigInt? @map("cache_write_5m_tokens")
  cacheWrite1hTokens BigInt? @map("cache_write_1h_tokens")
  estimatedCost    Decimal  @default(0) @map("estimated_cost") @db.Decimal(14, 6)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@unique([agentSessionId, model])
  @@index([model])
  @@map("agent_session_token_usage")
}

/// FEA-2730 (PRD-510 FR4 G1): raw per-event token usage synced from the
/// desktop's keep-all `token_events` log (retention/rollup deferred, Q3).
/// Append-only and idempotent: `externalEventId` is the provider-neutral stable
/// transport identity. The unique constraint is the replay boundary; immutable
/// content collisions fail closed while mutable provenance/cost enrichment may
/// advance on a fresh replay.
///
/// D4 (PRD-510) decision — this table is JOIN-REACHED, so it carries NO
/// `organizationId` and no org-wide index. Org isolation is enforced through the
/// `session → artifact.organizationId` relation, exactly as its sibling
/// `AgentSessionTokenUsage` already is; every cloud read enters through a
/// SessionDetail join (getSessionTokenEvents, the insights/usage aggregations).
/// `SessionDetail` itself has no `organizationId` (org lives on the parent
/// `Artifact`). The `[agentSessionId, eventCreatedAt]` index covers the
/// per-session, optionally date-bounded focus-page reads. Revisit only if a
/// future read must scan token events org-wide WITHOUT entering through
/// SessionDetail (e.g. "every token event for the org in a time window") — that
/// would justify adding `organizationId` + an `[organizationId, eventCreatedAt]`
/// index in a follow-up migration. No such read exists today.
model AgentSessionTokenEvent {
  id               String   @id @default(uuid(7)) @db.Uuid
  agentSessionId   String   @map("agent_session_id") @db.Uuid
  externalEventId  String   @map("external_event_id")
  agentExternalId  String?  @map("agent_external_id")
  model            String
  inputTokens      BigInt   @default(0) @map("input_tokens")
  outputTokens     BigInt   @default(0) @map("output_tokens")
  cacheReadTokens  BigInt   @default(0) @map("cache_read_tokens")
  cacheWriteTokens BigInt   @default(0) @map("cache_write_tokens")
  estimatedCost    Decimal? @map("estimated_cost") @db.Decimal(14, 6)
  sourceIdentity   Json?    @map("source_identity")
  costCompleteness String?  @map("cost_completeness")
  costCompletenessReason String? @map("cost_completeness_reason")
  subscriptionEquivalentCost Decimal? @map("subscription_equivalent_cost") @db.Decimal(14, 6)
  apiEstimatedCost Decimal? @map("api_estimated_cost") @db.Decimal(14, 6)
  eventCreatedAt   DateTime @map("event_created_at")
  createdAt        DateTime @default(now()) @map("created_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@unique([agentSessionId, externalEventId])
  @@index([agentSessionId, eventCreatedAt])
  @@map("agent_session_token_events")
}

/// FEA-3568 (PLN-1398 T2): the desktop-local activity-segment tiling
/// (`session_lis`, FEA-2267) replicated to the cloud so the web /
/// authenticated-parity surfaces (FEA-2275 / FEA-2276) can read per-activity
/// attribution. Rows are stored VERBATIM — the cloud NEVER re-classifies
/// (PLN-1398 design decision 4). Ingestion is replace-all per session inside the
/// session upsert transaction (design decision 3), so no reader ever sees a
/// mixed-version tiling; `classifierVersion` rides per row as the re-derivation
/// key.
///
/// No `organizationId`: this table is JOIN-REACHED — org isolation is enforced
/// through the `session → artifact.organizationId` relation, exactly as its
/// sibling `AgentSessionTokenEvent` (D4 precedent). Every cloud read enters
/// through a SessionDetail join. `start_ms`/`end_ms` are absolute epoch-ms and so
/// are `BigInt` (int8) — epoch-ms overflows int4. The unique
/// `[agentSessionId, startMs]` is the natural key under a complete,
/// non-overlapping tiling; the `[agentSessionId]` index covers the per-session
/// read and the replace-all delete.
model AgentSessionActivitySegment {
  id                String   @id @default(uuid(7)) @db.Uuid
  agentSessionId    String   @map("agent_session_id") @db.Uuid
  phase             String
  startMs           BigInt   @map("start_ms")
  endMs             BigInt   @map("end_ms")
  confidence        Float
  /// Ranked evidence-layer names ("declared"/"structural"); empty for `idle` and
  /// evidence-free `other` spans. Layer names only — no prose on this lane.
  evidenceLayers    Json     @map("evidence_layers")
  classifierVersion Int      @map("classifier_version")
  workItemRef       String?  @map("work_item_ref")
  subagentId        String?  @map("subagent_id")
  createdAt         DateTime @default(now()) @map("created_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@unique([agentSessionId, startMs])
  @@index([agentSessionId])
  @@map("agent_session_activity_segments")
}

/// FEA-2730 (PRD-510 FR4 G10): the desktop's one-row-per-session usage rollup
/// (source table `session_analytics`), synced as-is and authoritative (Q16). 1:1
/// with SessionDetail — the PK IS the session's artifact id, so re-sync upserts
/// in place. Token columns are widened to BigInt and cost to Decimal(14,6) for
/// numeric fidelity (FEA-2728), though the desktop rollup stores them narrower;
/// `isHuman` is a boolean cloud-side (0/1 on the desktop). No `organizationId`
/// (join-reached via the session, per the D4 decision on AgentSessionTokenEvent
/// above). Named `UsageRollup` rather than `Analytics` to avoid colliding with
/// the unrelated org-wide `AgentSessionAnalytics` viewer-analytics API type.
model AgentSessionUsageRollup {
  artifactId       String    @id @map("artifact_id") @db.Uuid
  startedAt        DateTime? @map("started_at")
  startedDay       String?   @map("started_day")
  status           String?
  harness          String?
  isHuman          Boolean   @default(false) @map("is_human")
  humanTurns       Int       @default(0) @map("human_turns")
  agentTurns       Int       @default(0) @map("agent_turns")
  eventCount       Int       @default(0) @map("event_count")
  toolInvocations  Int       @default(0) @map("tool_invocations")
  errorEvents      Int       @default(0) @map("error_events")
  inputTokens      BigInt    @default(0) @map("input_tokens")
  outputTokens     BigInt    @default(0) @map("output_tokens")
  cacheReadTokens  BigInt    @default(0) @map("cache_read_tokens")
  cacheWriteTokens BigInt    @default(0) @map("cache_write_tokens")
  estimatedCost    Decimal   @default(0) @map("estimated_cost") @db.Decimal(14, 6)
  runtimeMs        BigInt?   @map("runtime_ms")
  // When the desktop last recomputed this rollup (distinct from the cloud's own
  // updatedAt bookkeeping below).
  rollupUpdatedAt  DateTime? @map("rollup_updated_at")
  lastSyncedAt     DateTime  @default(now()) @map("last_synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [artifactId], references: [artifactId], onDelete: Cascade)

  @@map("agent_session_usage_rollups")
}

model DesktopCommand {
  id                 String    @id @default(uuid(7)) @db.Uuid
  computeTargetId    String    @map("compute_target_id") @db.Uuid
  idempotencyKey     String?   @map("idempotency_key")
  requestFingerprint String    @map("request_fingerprint")
  operationId        String    @map("operation_id")
  requestPayload     Json      @map("request_payload")
  status             String
  error              String?
  lastSequenceAcked  Int       @default(0) @map("last_sequence_acked")
  queuedTimeoutMs    Int?      @map("queued_timeout_ms")
  runningTimeoutMs   Int?      @map("running_timeout_ms")
  createdAt          DateTime  @default(now()) @map("created_at")
  startedAt          DateTime? @map("started_at")
  finishedAt         DateTime? @map("finished_at")

  computeTarget                      ComputeTarget                       @relation(fields: [computeTargetId], references: [id], onDelete: Cascade)
  events                             DesktopCommandEvent[]
  loopExecutionCredentialConsumption LoopExecutionCredentialConsumption?

  // NOTE: A partial unique index on (compute_target_id, idempotency_key) WHERE
  // idempotency_key IS NOT NULL is maintained via raw migrations. Prisma cannot
  // express partial indexes. Prisma 7.4+ falsely flags this as drift — we pin
  // to 7.3.0 until resolved. Do NOT drop it.
  // See: https://github.com/prisma/prisma/issues/29289
  @@index([computeTargetId, status, createdAt])
  @@index([operationId])
  @@map("desktop_commands")
}

model LoopExecutionCredentialConsumption {
  commandId       String   @id @map("command_id") @db.Uuid
  loopId          String   @map("loop_id") @db.Uuid
  computeTargetId String   @map("compute_target_id") @db.Uuid
  gatewayId       String   @map("gateway_id")
  action          String
  consumedAt      DateTime @default(now()) @map("consumed_at")

  command       DesktopCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  computeTarget ComputeTarget  @relation(fields: [computeTargetId], references: [id], onDelete: Cascade)
  loop          Loop           @relation(fields: [loopId], references: [id], onDelete: Cascade)

  @@index([loopId])
  @@index([computeTargetId, gatewayId], map: "loop_execution_credential_consumptions_compute_target_id_gatewa")
  @@map("loop_execution_credential_consumptions")
}

model DesktopCommandEvent {
  commandId    String   @map("command_id") @db.Uuid
  sequence     Int
  eventType    String   @map("event_type")
  eventPayload Json     @map("event_payload")
  createdAt    DateTime @default(now()) @map("created_at")

  command DesktopCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@id([commandId, sequence])
  @@map("desktop_command_events")
}

model GitHubDirtyScopeNudge {
  id                             String    @id @default(uuid(7)) @db.Uuid
  organizationId                 String    @map("organization_id") @db.Uuid
  githubInstallationRepositoryId String    @map("github_installation_repository_id") @db.Uuid
  computeTargetId                String    @map("compute_target_id") @db.Uuid
  windowStartedAt                DateTime  @map("window_started_at")
  dirtyScopes                    Json      @map("dirty_scopes")
  genericRefresh                 Boolean   @default(false) @map("generic_refresh")
  scheduledDispatchAt            DateTime  @map("scheduled_dispatch_at")
  dispatchClaimedAt              DateTime? @map("dispatch_claimed_at")
  dispatchedAt                   DateTime? @map("dispatched_at")
  expiresAt                      DateTime  @map("expires_at")
  deliveryResult                 Json?     @map("delivery_result")
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")

  organization  Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository    GitHubInstallationRepository @relation(fields: [githubInstallationRepositoryId], references: [id], onDelete: Cascade)
  computeTarget ComputeTarget                @relation(fields: [computeTargetId], references: [id], onDelete: Cascade)

  @@unique([organizationId, githubInstallationRepositoryId, computeTargetId, windowStartedAt], map: "github_dirty_scope_nudges_org_repo_target_window_key")
  @@index([scheduledDispatchAt, dispatchedAt], map: "github_dirty_scope_nudges_dispatch_due_idx")
  @@index([dispatchClaimedAt], map: "github_dirty_scope_nudges_dispatch_claim_idx")
  @@index([expiresAt], map: "github_dirty_scope_nudges_expires_idx")
  @@index([organizationId, githubInstallationRepositoryId], map: "github_dirty_scope_nudges_org_repo_idx")
  @@map("github_dirty_scope_nudges")
}

// =============================================================================
// DESKTOP SESSION AUTH (FEA-1514 / FEA-2215)
// First-party desktop sessions. Short-lived access tokens are stateless JWTs
// (see packages/auth/desktop-session-jwt.ts); only the rotating refresh-token
// family is persisted here, and only as a hash. Session + refresh-token family
// are bound to the desktop device public key so a stolen refresh token alone
// cannot mint a new access token.
// =============================================================================

model DesktopSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  gatewayId      String    @map("gateway_id")
  boundPublicKey String    @map("bound_public_key")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  expiresAt      DateTime  @map("expires_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens DesktopRefreshToken[]

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  // Supports findActiveDeviceSession (PRD-532 PR-K): newest live session for a
  // given user/org/gateway. Leading equality columns userId/organizationId/
  // gatewayId; revokedAt narrows to non-revoked rows.
  @@index([userId, organizationId, gatewayId, revokedAt])
  @@map("desktop_sessions")
}

model DesktopRefreshToken {
  id                 String    @id @default(uuid(7)) @db.Uuid
  sessionId          String    @map("session_id") @db.Uuid
  familyId           String    @map("family_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  expiresAt          DateTime  @map("expires_at")
  lastUsedAt         DateTime? @map("last_used_at")
  revokedAt          DateTime? @map("revoked_at")
  replacedByTokenId  String?   @map("replaced_by_token_id") @db.Uuid
  rotatedFromTokenId String?   @map("rotated_from_token_id") @db.Uuid

  session DesktopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("desktop_refresh_tokens")
}

model Project {
