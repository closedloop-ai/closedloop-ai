model ComputeTarget {
  id                     String    @id @default(uuid(7)) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  machineName            String    @map("machine_name")
  platform               String
  capabilities           Json      @default("{}")
  supportedOperations    Json      @default("[]") @map("supported_operations")
  lastSeenAt             DateTime  @default(now()) @map("last_seen_at")
  // ISS-4678: the LANDED-DATA watermark. Advances ONLY when session rows
  // actually persisted, so an accepted empty / all-foreign-chunk batch leaves it
  // alone. Read as "last INGEST" — not "last successful sync" (ISS-4828).
  lastAgentSessionSyncAt DateTime? @map("last_agent_session_sync_at")
  // ISS-4827: the ATTEMPT watermark. Stamped on EVERY accepted session batch,
  // including the zero-row batches `lastAgentSessionSyncAt` deliberately
  // ignores. Together the pair separates a desktop that is reaching the cloud
  // but whose data is not landing (attempt fresh, ingest stale => STALLED) from
  // one that is merely open and idle (both stale => QUIET). `lastSeenAt` cannot
  // do this: it is refreshed by registration/heartbeat/online check-ins on a
  // ~30-90s cadence with no ingest attempt behind it.
  lastAgentSessionSyncAttemptAt DateTime? @map("last_agent_session_sync_attempt_at")
  // ISS-8897: the PRESENCE clock, and nothing else. Stamped only by
  // `handlePresence` — the relay `presence` frame — because that frame is the
  // one signal that drives `emitPresenceFleetCapacityMetrics`, which wakes a
  // connected target's command backlog every 30s. `lastSeenAt` above is NOT
  // this: it also moves for registration, the direct Socket.IO server's own 30s
  // timer, and the SSE stream's online mark, none of which drains anything. The idle drain read
  // `lastSeenAt` as "the presence trigger owns this target", so a desktop
  // checking in on any of those other transports looked covered while nothing
  // drained its backlog.
  //
  // NULL means the relay presence trigger has NEVER covered this target — not
  // "recently present". The drain therefore treats NULL as ELIGIBLE and measures
  // its silence from `createdAt`, a true lower bound on presence (a target
  // cannot have sent a frame before it existed) rather than a stand-in value.
  // Reading NULL the other way would strand such a target forever, which is the
  // defect this column exists to fix. Migration
  // 20260911130000_iss8897_presence_clock_and_drain_lease seeds the pre-existing
  // fleet from `lastSeenAt` and says why.
  presenceAt             DateTime? @map("presence_at")
  // ISS-8896: the cross-instance lease held for the duration of one queued-
  // command release. `releaseQueuedCommands` reads the declared ceiling, counts
  // in-flight commands and dispatches the difference; that read-modify-write was
  // serialized only by a process-local map, so N API instances each passed their
  // own gate and each dispatched a full `ceiling - inFlight` against one ceiling.
  // NULL is "no release in progress"; a value in the past is an expired lease,
  // which is what stops a crashed instance holding a target forever.
  commandDrainLeaseUntil DateTime? @map("command_drain_lease_until")
  isOnline               Boolean   @default(false) @map("is_online")
  // ISS-12617 retired target sharing; nothing reads or writes the column.
  // ISS-12450 drops it and its index in a later deploy.
  isSharedWithOrg        Boolean   @default(false) @map("is_shared_with_org") @ignore
  // FEA-2923 (Gap A): marks a synthetic per-org "cloud" compute target that
  // owns cloud-authored AgentComponent rows (org-custom agents backfilled from
  // catalog_items). These rows have NO real device. The sentinel keeps
  // AgentComponent.computeTargetId a non-null FK without a nullable-FK ripple
  // through desktop sync / listing / analytics, and its distinct id guarantees
  // device sync upserts (keyed by the real device computeTargetId) never
  // collide with cloud rows. Device-facing listings filter it out
  // (isCloudSentinel = false). See migration
  // 20260712000000_add_compute_target_cloud_sentinel_and_backfill_agent_components.
  isCloudSentinel        Boolean   @default(false) @map("is_cloud_sentinel")
  gatewayId              String?   @unique(map: "compute_targets_gateway_id_unique_idx", where: raw("(gateway_id IS NOT NULL)")) @map("gateway_id")
  selectedHarness        String    @default("claude") @map("selected_harness")
  // ISS-8674: this target's live queued-command depth, so the five-minute
  // queue-depth sampler reads one bounded page of targets instead of
  // aggregating every queued row in `desktop_commands` to find the deepest.
  // NOT maintained by application code — the
  // `desktop_commands_queued_count_sync` trigger owns every write to it, so no
  // dispatch path can forget it and no value here can disagree with the rows.
  // A 0 is always a measurement, never a placeholder: the migration backfills
  // the true count and a newly registered target genuinely has no commands.
  queuedCommandCount     Int       @default(0) @map("queued_command_count")
  // ISS-8674: the queue-depth sampler's ROTATION KEY, not a measurement and
  // never reported as one. The cron gauges a bounded page per tick, oldest key
  // first, and stamps what it gauged — so every target is swept before any is
  // swept twice and none can be permanently omitted by a per-tick cap.
  // NOT NULL defaulting to the epoch rather than nullable, because "never
  // swept" must sort FIRST and Postgres puts NULLs last in an ascending btree,
  // which PSL cannot override. A freshly registered target therefore sorts to
  // the head and is gauged on the very next tick.
  queuedDepthSweptAt     DateTime  @default("1970-01-01T00:00:00.000Z") @map("queued_depth_swept_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization                        Organization                         @relation(fields: [organizationId], references: [id])
  user                                User                                 @relation(fields: [userId], references: [id])
  preferringUsers                     User[]                               @relation("UserPreferredComputeTarget") @ignore
  desktopCommands                     DesktopCommand[]
  loopExecutionCredentialConsumptions LoopExecutionCredentialConsumption[]
  loops                               Loop[]
  sessionDetails                      SessionDetail[]
  sessionTranscripts                  SessionTranscript[]
  githubDirtyScopeNudges              GitHubDirtyScopeNudge[]
  healthCheck                         ComputeTargetHealthCheck?
  agentComponents                     AgentComponent[]
  sourceOccurrences                   SourceOccurrence[]
  distributionTargetStatuses          DistributionTargetStatus[]
  distributionTargetingEntries        DistributionTargetingEntry[]
  claudeCodeSignalDropCounters        ClaudeCodeSignalDropCounter[]

  @@unique([userId, machineName])
  @@index([organizationId, userId])
  @@index([organizationId, userId, gatewayId])
  @@index([userId, isOnline])
  @@index([organizationId, isSharedWithOrg])
  // ISS-4543: the two halves of the /cron/sample-session-ingestion-health scan —
  // targets that have ingested (ordered by staleness) and targets that never have.
  @@index([organizationId, lastAgentSessionSyncAt], map: "compute_targets_ingest_group_idx", where: raw("((is_cloud_sentinel = false) AND (last_agent_session_sync_at IS NOT NULL))"))
  @@index([organizationId], map: "compute_targets_never_ingested_idx", where: raw("((is_cloud_sentinel = false) AND (last_agent_session_sync_at IS NULL))"))
  // ISS-4832: the same cron's per-org presence/attempt scan (`loadPresenceByOrg`).
  // The database index carries last_agent_session_sync_attempt_at as an INCLUDE
  // payload, which PSL cannot express; introspection reports it as a third key
  // column and the differ accepts that as a match, so this declaration ADOPTS the
  // covering index rather than rebuilding it. Migration
  // 20260802190000_iss4832_compute_target_heartbeat_group_index remains the only
  // place the INCLUDE form is written.
  @@index([organizationId, lastSeenAt, lastAgentSessionSyncAttemptAt], map: "compute_targets_presence_group_idx", where: raw("(is_cloud_sentinel = false)"))
  // ISS-8674: the seek behind `countQueuedCommandsByTarget`. It reads the
  // deepest backlogs first and stops at a constant, so descending depth with
  // `id` as the tiebreak serves the whole ORDER BY … LIMIT from the index with
  // no sort — which is what makes the sampler's per-tick work a constant rather
  // than a function of the fleet. Partial on `> 0` so the index stays the size
  // of the targets currently HOLDING a backlog, a small self-draining set,
  // rather than of every target ever registered, a set that never drains.
  @@index([queuedCommandCount(sort: Desc), id], map: "compute_targets_queued_depth_idx", where: raw("((is_cloud_sentinel = false) AND (queued_command_count > 0))"))
  // ISS-8674: the rotation the completeness sweep reads — oldest key first, so
  // the per-tick page is an index scan of exactly its own size rather than a
  // sort of the whole fleet. Partial on the same non-sentinel predicate as its
  // sibling above, which is the fleet every other read here scopes to.
  @@index([queuedDepthSweptAt, id], map: "compute_targets_queued_depth_sweep_idx", where: raw("(is_cloud_sentinel = false)"))
  @@map("compute_targets")
}

model ComputeTargetHealthCheck {
  id                      String   @id @default(uuid(7)) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  computeTargetId         String   @unique @map("compute_target_id") @db.Uuid
  checkedAt               DateTime @map("checked_at")
  expectedMcpUrl          String?  @map("expected_mcp_url")
  latestVersion           String?  @map("latest_version")
  pluginAutoUpdateEnabled Boolean  @default(false) @map("plugin_auto_update_enabled")
  result                  Json
  allRequiredPassed       Boolean  @map("all_required_passed")
  requiredFailureIds      Json     @default("[]") @map("required_failure_ids")
  schemaVersion           Int      @default(1) @map("schema_version")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id])
  computeTarget ComputeTarget @relation(fields: [computeTargetId], references: [id], onDelete: Cascade)

  @@index([organizationId, checkedAt])
  @@map("compute_target_health_checks")
}

// Type-specific detail for SESSION-typed artifacts (captured agent/session
// runs synced from the desktop). 1:1 with `Artifact` via shared `artifact_id`
// primary key, mirroring document_detail / branch_detail / deployment_detail.
// Hoisted to the parent `artifacts` row: organizationId, projectId, name,
// status. The raw harness status string is stored on `artifacts.status`
// (free-form TEXT) — the curated session lifecycle is a deferred follow-up.
//
// NO organization_id ON THIS TABLE. This is an accepted decision, not a gap.
// The org lives only on `artifacts`, and every Sessions list sort key lives
// here (or, for priority/status, on a second `artifacts` alias). So the
// org-scoped Sessions list is a parent ⨝ detail hash join and then a top-N
// Sort, and no index can emit that order per org. We know this. It is fine:
//   - The org side is exact. The org predicate is an Index Cond on an
//     org-leading `artifacts` index and reads no other tenant's rows.
//   - The Sort is a top-N heapsort over (this org ∩ the date window), not over
//     the table. Measured 2026-09-23 on PostgreSQL 16: ~2.5 ms at 10,000 rows,
//     20–25 ms for page 1 at 100,000 rows with a 5% tenant share.
//   - The fix costs more than the Sort. It needs a backfill, a second org write
//     on every sync, and then `(organization_id, <key>, artifact_id)`
//     composites: two per nullable key, because NULLS LAST in both directions
//     defeats a backward scan. branch_detail copies the org only because its
//     D2 unique index cannot span the join (PRD-510 FR13). A sort is not that.
// Decided 2026-06-10 by Kerensa Whitlock in PLN-854 (scope decision 1: full CTI, "no
// duplicated columns"; FEA-1699, PR #1492). PLN-854 named this cost before it
// shipped: "org-scoped, time-ordered session lists become a parent⨝detail join
// sort". Re-measured and upheld 2026-09-23 by Tamsin Bramley in ISS-9478. The
// plan-shape guard is apps/api/app/agent-sessions/service/
// session-list-sort-plan.integration.test.ts.
// Do not file a ticket to denormalize organization_id here or to add sort
// composites for the org-scoped list. Reopen only on production query
// evidence (pg_stat_statements), never on a seeded EXPLAIN.
model SessionDetail {
  artifactId         String        @id @map("artifact_id") @db.Uuid
  // ISS-8717: the owner's chosen session name. `artifacts.name` is the
  // COLLECTOR's derivation and is rewritten on every re-import, so a rename
  // stored there vanishes on the next sync; this column is never written by
  // ingest unless the payload carries one, and the read projection prefers it.
  // NULL means "no rename" — the collected placeholder in `artifacts.name`
  // stands, and stays recoverable for a renamed session too.
  nameOverride       String?       @map("name_override")
  // Null on legacy rows and rows created by an older API revision: their past
  // metadata edits may not have activity receipts. New writers set this only
  // on creation, giving Collaborators positive complete-empty editor evidence.
  metadataActivityCoverageStartedAt DateTime? @map("metadata_activity_coverage_started_at")
  computeTargetId    String        @map("compute_target_id") @db.Uuid
  externalSessionId  String        @map("external_session_id")
  harness            String        @default("unknown")
  // How this session row was produced: synced desktop run vs. materialized Loop
  // (FEA-1718). Existing rows default to DESKTOP_SYNC.
  origin             SessionOrigin @default(DESKTOP_SYNC)
  // Per-session billing mode resolved by the desktop (subscription vs. API-key
  // plan, from the desktop's billing_mode column). Opaque string; the usage
  // cost split classifies it for DESKTOP_SYNC sessions that have no source Loop.
  billingMode        String?       @map("billing_mode")
  // ISS-4586: whether the desktop run ended on an unrecovered error (the
  // desktop's `ends_with_error` flag, synced additively). The stale-session
  // reaper reads it to declare an orphaned still-active session ERROR vs INACTIVE
  // without re-deriving from events. Nullable: absent for pre-ISS-4586 rows and
  // for older desktop builds that don't sync it (treated as not-error → INACTIVE).
  endsWithError      Boolean?      @map("ends_with_error")
  // ISS-7265: whether the last payload that reported on this session's activity
  // tiling shipped WITHOUT it — the desktop's bounded old-server fallback drops
  // the whole tiling so the rest of the session can sync. Nullable and THREE-
  // valued on purpose: NULL means no payload has ever reported (a pre-ISS-7265
  // row, or a desktop too old to send the flag), which is NOT the same claim as
  // `false`. Collapsing the two would recreate the exact conflation this column
  // exists to break — a dropped tiling reading identically to one never classified.
  activitySegmentRowsStripped Boolean? @map("activity_segment_rows_stripped")
  cwd                String?
  repositoryFullName String?       @map("repository_full_name")
  worktreePath       String?       @map("worktree_path")
  model              String?
  deviceTimeZone     String?       @map("device_time_zone")
  // ISS-7516: the data-sync level the recording machine reported on its MOST
  // RECENT sync of this session (DataSyncLevel contract const: off | metadata |
  // redacted | full). Last-write-wins, so a resync or backfill after the user
  // changes their level restamps it — read it as the device's current posture,
  // NOT as a historical fact about when the session ran.
  //
  // Only `full` queues transcripts, so this is what tells a permanently
  // absent transcript (consent) apart from one still in flight (lag) — on the
  // web, where the setting itself is not visible, and for any audit of transcript
  // incidence, which counts consent as defect without it (ISS-7427 part 2).
  // Nullable: NULL for every row synced before this shipped and for older
  // desktop builds that don't send it. NULL means "no level reported" and must
  // never be read as a level.
  dataSyncLevel      String?       @map("data_sync_level")
  sessionStartedAt   DateTime      @map("session_started_at")
  sessionUpdatedAt   DateTime      @map("session_updated_at")
  // Genuine-activity timestamp: MAX(agent_session_events.event_created_at)
  // floored at sessionStartedAt. Unlike sessionUpdatedAt (bumped by desktop
  // OTEL ingest / enrichment / sync bookkeeping) this advances only on real
  // agent activity, and is the default sort for the Sessions list.
  //
  // NOT NULL since ISS-6463. The single writer floors it at the NOT NULL
  // session_started_at inside the same transaction that creates the row, and the
  // PLN-1034 backfill covered the whole table, so no reader needs a fallback.
  lastActivityAt     DateTime      @map("last_activity_at")
  sessionEndedAt     DateTime?     @map("session_ended_at")
  awaitingInputSince DateTime?     @map("awaiting_input_since")
  // ISS-11427: WHEN the cloud's monitored-activity hold on this session STARTED
  // — the first delivery that withheld the session from `acceptedSessionIds`
  // and has not been released since. The hold ceiling in
  // `monitored-activity-hold-ceiling.ts` measures from this, never from the
  // session row's own `created_at`: an old session's first monitored candidate,
  // or a catch-up delivery after an offline period, would otherwise be past the
  // ceiling on the delivery that first held it and be abandoned with zero
  // retries (#8064 review, whitlockk/tamsinb).
  //
  // NULL means NOT HELD — either nothing has ever held, or the last delivery
  // released the hold. The single writer sets it on the first held delivery and
  // clears it the moment a delivery no longer needs a retry, so it can never
  // carry a stale start across a released-then-re-held hold.
  monitoredActivityHeldSince DateTime? @map("monitored_activity_held_since")
  // ISS-12031: whether any part of the CURRENT multi-part split delivery has
  // retained the monitored-activity hold — reset on part 0, OR-ed after — so
  // only the split's last part may release `monitoredActivityHeldSince`, and
  // only when no part retained. NULL until a split delivery first writes it;
  // unsplit deliveries never read or write it.
  monitoredActivityHoldPartRetained Boolean? @map("monitored_activity_hold_part_retained")
  sourceArtifactId   String?       @map("source_artifact_id")
  sourceLoopId       String?       @map("source_loop_id") @ignore
  // ISS-12435: the usage cost-split ledger (subscription, metered, unknown) a
  // loop-originated session was classified into while Loops existed, written
  // once by the Loops data-step migration so the split survives the removal of
  // `loops.metadata.apiKeySource`. NULL for every other session, which the
  // classifier reads by `billingMode` as before.
  legacyLoopCostLedger String?     @map("legacy_loop_cost_ledger")
  baseBranch         String?       @map("base_branch")
  // INERT: nothing writes this column and nothing reads it. It is retained, not
  // dropped, because any API revision older than the one that stopped selecting
  // it still names it — a pod mid-rollout, or a rollback target — and a dropped
  // column cannot be un-dropped. That window, not an external client, is the
  // compatibility surface, which is why this is not dead code. Dropping it requires
  // the removal gate in `docs/session-status-vocabulary.md` (ISS-8489), which
  // names the evidence and the approval. `scripts/lint/session-detail-state-
  // inventory.test.ts` re-derives the no-reader/no-writer claim on every CI run
  // so it cannot quietly stop being true. Do not re-key a status derivation onto
  // it: `artifacts.status` owns that axis.
  state              String?
  // ISS-4742: physical compatibility column retained until the follow-up
  // destructive migration; keep it out of the generated Prisma client.
  branch             String?       @ignore
  pullRequests       Json?         @map("pull_requests")
  wallClock          String?       @map("wall_clock")
  activeAgent        String?       @map("active_agent")
  waitingUser        String?       @map("waiting_user")
  linesAdded         Int?          @map("lines_added")
  linesRemoved       Int?          @map("lines_removed")
  filesChanged       Int?          @map("files_changed")
  // Provenance of the lines_*/files_changed scalars: "git" when the desktop
  // sent source-tagged gitDiffStats, null when only heuristic/agent-estimated
  // scalars were synced. Readers rehydrate gitDiffStats from this marker.
  locSource          String?       @map("loc_source")
  // Branch-level LOC (working-branch changes vs the author's contributed lines):
  // a distinct metric from the authored gitDiffStats scalars, so it lives in its
  // own columns. Readers rehydrate branchDiffStats from these; branch_loc_source
  // records its provenance independently of loc_source.
  branchLinesAdded   Int?          @map("branch_lines_added")
  branchLinesRemoved Int?          @map("branch_lines_removed")
  branchFilesChanged Int?          @map("branch_files_changed")
  branchLocSource    String?       @map("branch_loc_source")
  turns              Int?
  steeringEpisodes   Int?          @map("steering_episodes")
  autonomy           Int?
  activityBuckets    Json?         @map("activity_buckets")
  sessionSpan        Json?         @map("session_span")
  markers            Json?
  throttles          Json?
  tracePhaseSources  Json?         @map("trace_phase_sources")
  throttleSources    Json?         @map("throttle_sources")
  correctionSources  Json?         @map("correction_sources")
  phases             Json?
  phaseIterations    Json?         @map("phase_iterations")
  phaseLoopbacks     Json?         @map("phase_loopbacks")
  inputTokens        BigInt        @default(0) @map("input_tokens")
  outputTokens       BigInt        @default(0) @map("output_tokens")
  cacheReadTokens    BigInt        @default(0) @map("cache_read_tokens")
  cacheWriteTokens   BigInt        @default(0) @map("cache_write_tokens")
  estimatedCost      Decimal?      @map("estimated_cost") @db.Decimal(14, 6)
  // ISS-7229: CLAUDE'S OWN reported cost (`result.total_cost_usd`). The desktop's
  // OTel capture syncs it into this column, which is the only source the detail
  // read uses; ISS-12435 backfilled the retired loop-event figures into it.
  // Fleet-wide estimator drift is
  // `estimated_cost - authoritative_cost_usd` in SQL instead of a JSON extraction
  // per row. NOT a second opinion of `estimated_cost` and never a substitute for
  // it: different producer, different pricing engine, and the two are the two
  // OPERANDS of that delta, so summing or coalescing them blends two accounting
  // systems (the ISS-4435 overlap ruling on ISS-7229, 2026-08-20).
  //
  // NULLABLE WITH NO DEFAULT, deliberately. `null` means "Claude reported no
  // cost", which is the majority of rows — the `result` envelope exists only for
  // harness stdout captures. A `0` here is a REPORTED zero and a real
  // measurement, so no reader may treat null and 0 alike, and no writer may
  // default this to 0.
  authoritativeCostUsd Decimal?    @map("authoritative_cost_usd") @db.Decimal(14, 6)
  agentCount         Int           @default(0) @map("agent_count")
  toolUseCount       Int           @default(0) @map("tool_use_count")
  errorCount         Int           @default(0) @map("error_count")
  // ISS-5801: row count of the ACTIVE invocation generation, folded by the cloud
  // at generation activation (like tool_use_count, derived from persisted
  // children — never trusted from a payload). Lets the substantive/idle SQL twin
  // classify invocation-only (slash/skill/subagent/hook) sessions without a join.
  componentInvocationCount Int     @default(0) @map("component_invocation_count")
  metadata           Json?
  agents             Json          @default("[]")
  // FEA-3928: raw, UNBOUNDED additive frustration signal computed by the desktop
  // (frustration words + shouting + pleading punctuation + nearby errors +
  // steering/corrections/loopbacks/throttles). Stored raw — NOT a pre-normalized
  // 0–100 score — because the 0..max→0..100 normalization is done at Insights
  // aggregation time against the org population's observed max, which drifts as
  // more sessions land. frustrationScoreVersion records the scorer version that
  // produced the value. Both nullable, no default: an existing/unscored row is
  // NULL ("not computed").
  frustrationRaw          Int?      @map("frustration_raw")
  frustrationScoreVersion Int?      @map("frustration_score_version")
  dataRevision       Int?          @map("data_revision")
  // FEA-3474 (PRD-536 D3): staged identity of an in-progress chunked-apply
  // sequence, recorded by the FIRST chunk's delete-replace and cleared when the
  // matching LAST chunk commits the revision. Makes the chunked apply atomic and
  // all-or-nothing:
  //   - pendingChunkRevision — the dataRevision chunk 0 started rebuilding. The
  //     last chunk commits dataRevision ONLY when its own revision equals this
  //     marker (the same sequence chunk 0 opened), so a stale/out-of-order chunk
  //     from a DIFFERENT revision can never satisfy the commit and leave a
  //     half-session masquerading as a complete revision.
  //   - pendingChunkTotal — that sequence's chunk count (`chunk.total`).
  //   - pendingChunkReceived — the highest CONTIGUOUS chunk index seen + 1 (how
  //     many leading chunks arrived), so a dropped interior chunk keeps this
  //     below total and the last chunk cannot commit over a gap.
  //   - pendingChunkAckContract — ISS-8602: which acknowledgement contract the
  //     producer that OPENED this sequence speaks, so the cron TTL sweep can
  //     tell whether freeing the marker costs that client a re-send or its only
  //     copy of the tail. NULL also means every row staged before this column
  //     existed, and the sweep declines all of them; see
  //     `service/pending-chunk-ack-contract.ts` for the domain and the fail-safe.
  // All FOUR are NULL when no chunked sequence is mid-apply (the steady state
  // and every unchunked session).
  pendingChunkRevision    Int?     @map("pending_chunk_revision")
  pendingChunkTotal       Int?     @map("pending_chunk_total")
  pendingChunkReceived    Int?     @map("pending_chunk_received")
  pendingChunkAckContract String?  @map("pending_chunk_ack_contract")
  // ISS-11427: TRUE when the sequence-assembling hold ceiling applied a
  // revision-less payload on top of the children, so they no longer equal the
  // committed `dataRevision`. The next payload AT that revision replaces them
  // instead of re-opening without a delete (ISS-6167), and the delete-replace
  // clears this. NULL/FALSE: the children are the committed revision's.
  dataRevisionDiverged    Boolean? @map("data_revision_diverged")
  lastSyncedAt       DateTime      @default(now()) @map("last_synced_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  artifact              Artifact                             @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  computeTarget         ComputeTarget                        @relation(fields: [computeTargetId], references: [id], onDelete: Restrict)
  tokenUsageByModel     AgentSessionTokenUsage[]
  events                AgentSessionEvent[]
  tokenEvents           AgentSessionTokenEvent[]
  usageRollup           AgentSessionUsageRollup?
  sessionTranscripts    SessionTranscript[]
  componentUsages       AgentComponentSessionUsage[]
  invocationGenerations AgentComponentInvocationGeneration[]
  activitySegmentRows   AgentSessionActivitySegment[]
  activityMetrics       AgentSessionActivityMetrics?
  operationEvidence              AgentSessionOperationEvidence[]
  operationEvidenceSnapshot      AgentSessionOperationEvidenceSnapshot?
  branchAnalyticsSessionRollups BranchAnalyticsSessionRollup[]
  claudeCodeTelemetry   ClaudeCodeSessionTelemetry?
  claudeCodeComponentTelemetry ClaudeCodeComponentTelemetry[]
  claudeCodeActiveTimeTelemetry ClaudeCodeActiveTimeTelemetry[]
  claudeCodeLinesOfCodeTelemetry ClaudeCodeLinesOfCodeTelemetry[]

  @@unique([computeTargetId, externalSessionId])
  // Historical invocation replay resolves a session across machines.
  @@index([externalSessionId], map: "session_detail_external_session_id_idx")
  @@index([sessionStartedAt])
  @@index([harness, sessionStartedAt])
  // FEA-4303: the Sessions Model filter adds `WHERE model IN (...)` to the
  // session-list query (see query-builder.ts), combined with the
  // session_started_at sort/window. Mirrors the equality-facet shape of
  // @@index([harness, sessionStartedAt]) so the planner drives from the model
  // predicate with the start-date range on the same index instead of a
  // sequential scan as session_detail grows.
  @@index([model, sessionStartedAt], map: "session_detail_model_started_at_idx")
  @@index([computeTargetId, sessionUpdatedAt])
  @@index([computeTargetId, lastActivityAt])
  @@index([lastActivityAt])
  // ISS-10171: the phantom sweep walks candidates
  // `ORDER BY last_activity_at ASC, artifact_id ASC` under a `take`, so the
  // single-column index above can order only the LEADING key and Postgres must
  // Incremental-Sort each tied group to produce the terminal one — work bounded
  // by the largest tie, paid inside the batch's interactive transaction. This
  // composite emits the walk's order directly, so `LIMIT` stops the scan at the
  // page boundary with no sort node. `artifactId` is this model's `@id`, which
  // is what makes the ordering total.
  @@index([lastActivityAt, artifactId], map: "session_detail_last_activity_at_artifact_id_idx")
  @@index([repositoryFullName])
  // Sessions-list autonomy-tier and cost-bucket facets filter these columns with
  // range predicates (gte/lt), unlike the equality-based harness facet. A range
  // predicate can't share a composite index with the lastActivityAt sort column
  // (the range breaks the ordering), so single-column indexes on each filtered
  // column are the useful shape — mirroring the single-column repositoryFullName
  // facet index. autonomy is nullable ("unknown" tier = IS NULL). (FEA-2504)
  @@index([autonomy])
  @@index([estimatedCost])
  // FEA-3638 (insights perf, Tier-1): the org-scope aggregations join
  // session_detail → artifacts (for the org predicate) and window on a session
  // timestamp. Only @@index([sessionStartedAt]) (org-blind) and
  // @@index([userId, sessionStartedAt]) (me-scope) existed, so the org-scope
  // planner scanned the whole time window across ALL orgs then filtered by org
  // post-join. This additive composite lets it drive from the org's artifacts
  // (artifact_id is the PK) with the range on the same index, serving the
  // session→artifact two-hop that also underlies the agent token-usage
  // aggregates. Additive / no-result-change; direction to be confirmed by
  // EXPLAIN on a seeded DB.
  //
  // ISS-10541 NARROWED WHICH READS THIS SERVES, and the correction is recorded
  // here rather than left implied. The session COUNT, COST and RUNTIME
  // aggregations now window on last_activity_at, not session_started_at
  // (apps/api/app/insights/service/session-queries.ts, sessionWindowColumn), so
  // this composite no longer applies to them: neither @@index([lastActivityAt])
  // nor @@index([lastActivityAt, artifactId]) prunes org and range at once, and
  // @@index([computeTargetId, lastActivityAt]) needs a predicate those reads do
  // not carry. The reads still on session_started_at — the tool-run aggregates
  // above, the export fold, heatmap, frustration, lost-work, tokenops-waste,
  // agent-pipeline and agents-spend — keep it.
  //
  // ISS-10886 MEASURED THE MOVED READS AND DID NOT ADD
  // @@index([artifactId, lastActivityAt]) (#7678 review, tamsinb). Postgres
  // 16.15, 1,000,000 sessions plus 500,000 other artifacts over 200 orgs (Zipf,
  // largest org 213k sessions); the four org-scope reads (fetchSessionRollup,
  // fetchSessionActivity, and the SQL Prisma emits for countSessions and
  // sumSessionCost) at 7/30/90-day windows across five org sizes, the index
  // dropped and kept in alternating transactions, median of 15 warm runs each:
  //   - The largest org's plans are identical with and without it: a hash join
  //     of the range scan on @@index([lastActivityAt, artifactId]) against
  //     artifacts(organization_id, id). Medians within noise.
  //   - The rollup and cost reads never pick it at any org size. They need heap
  //     columns (estimated_cost, session_ended_at, artifacts.status), so with a
  //     heap fetch per session either way the planner keeps the range scan, or
  //     drives from the org into the artifact_id PK with the range as a heap
  //     filter, which it already does without this index.
  //   - Only COUNT and the day series switch, and only for orgs of at most
  //     ~36k sessions on 30/90-day windows: a nested loop whose Index Cond is
  //     (artifact_id = a.id AND last_activity_at range), index only. That IS
  //     the org-and-range prune, but it saves 0-32 ms on reads that already run
  //     in 2-41 ms. (BUFFERS rises, 3,412 -> 163,642 at 36k sessions / 90 d, but
  //     that counts every nested-loop probe, mostly re-hits on the same btree
  //     root and inner pages, and every run was warm: cold cost NOT measured.)
  // The slow reads (the largest org; rollup and cost at every size) are bound
  // by heap fetches over the whole window, which no session_detail index
  // without the org in it can prune. The index would add a 39 MB btree (at 1M
  // rows) maintained on every last_activity_at update and help none of them.
  // ORG SCOPE ONLY. The Me and Team scopes were NOT measured: sessionScopeSql
  // adds a.created_by_id and drives from artifacts(organization_id,
  // created_by_id), so their population is one user's sessions, the small
  // regime where this index won most (597 sessions: 17.2 -> 2.1 ms). Re-run
  // EXPLAIN for those scopes before treating this as settled for them.
  @@index([artifactId, sessionStartedAt])
  // FEA-1718 back-link: `source_loop_id` is the ONLY column recording which Loop
  // a session came from, and every reverse read of that lineage — "which session
  // materialized loop X" — had no index at all, so each lookup sequentially
  // scanned session_detail. The one-time `Loop.session_artifact_id` backfill
  // groups the whole table by this column, and the loops-list read path resolves
  // it per page (up to 1000 loops), so the scan cost is paid repeatedly rather
  // than once. Single-column (not composite with a date) because every reader is
  // an equality lookup on the loop id, matching the repositoryFullName facet
  // shape above. Nullable: a desktop-only session carries NULL and is simply not
  // in the index's useful population.
  @@index([sourceLoopId], map: "session_detail_source_loop_id_idx")
  @@map("session_detail")
}

/// Cloud-side metadata for a raw session transcript archived to S3 (FEA-2714).
/// One row per transcript FILE: a logical session owns one `main` transcript
/// plus zero or more `subagent:{fileId}` sidechain files, discriminated by
/// `fileKey`. Metadata only — transcript bytes live in the S3 transcripts
/// bucket and never transit apps/api (PLN-1285 decision 2).
model SessionTranscript {
  id                     String    @id @default(uuid(7)) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  computeTargetId        String    @map("compute_target_id") @db.Uuid
  externalSessionId      String    @map("external_session_id")
  // Resolved from (computeTargetId, externalSessionId); nullable because a
  // transcript can arrive before the metadata lane creates the SessionDetail
  // row. FK targets SessionDetail.artifactId (its primary key). Subagent rows
  // share the parent session's sessionDetailId. Both routes attempt resolution
  // while unset.
  sessionDetailId        String?   @map("session_detail_id") @db.Uuid
  // Harness that produced the transcript: `claude_code`, `codex`, …
  sourceHarness          String    @map("source_harness")
  // `main` for the session transcript, `subagent:{fileId}` for sidechain files.
  fileKey                String    @map("file_key")
  objectStorageKey       String    @map("object_storage_key")
  // pending | uploading | uploaded | failed | skipped
  // `skipped` (FEA-3476) is a terminal, non-retryable state: the desktop
  // deterministically will not upload this file (e.g. it exceeds the local size
  // cap). The read path derives `failedPermanent` from it (vs the retryable
  // `failed` -> `failedTransient`), so a never-coming transcript stops showing
  // as "syncing". The reason lives on `permanentFailureReason`.
  uploadStatus           String    @default("pending") @map("upload_status")
  // FEA-3476: why a `skipped` row is permanently absent (e.g. `too_large`).
  // Null for every non-`skipped` row. Free-text TEXT matching the
  // `TranscriptSkipReason` contract enum in @repo/api.
  permanentFailureReason String?   @map("permanent_failure_reason")
  // Archive identity (client-computed sha256); set once verified on complete.
  rawSha256              String?   @map("raw_sha256")
  // S3-verified full-object CRC64NVME checksum; set on complete.
  crc64nvme              String?   @map("crc64nvme")
  rawByteSize            BigInt?   @map("raw_byte_size")
  // Current-version ETag, used as If-Match on the next copy-append.
  storedEtag             String?   @map("stored_etag")
  // Last VERIFIED byte offset — advances only on a successful complete
  // (recovery invariant 1). Clients recompute their delta from this.
  syncedByteOffset       BigInt    @default(0) @map("synced_byte_offset")
  sourceMtime            DateTime? @map("source_mtime")
  // Hash of the local file path — no raw local paths in cloud (PRD security req).
  sourcePathHash         String?   @map("source_path_hash")
  // In-flight multipart upload id + start time, for resume and staleness abort.
  pendingUploadId        String?   @map("pending_upload_id")
  pendingUploadStartedAt DateTime? @map("pending_upload_started_at")
  firstSeenAt            DateTime  @default(now()) @map("first_seen_at")
  lastObservedAt         DateTime  @default(now()) @map("last_observed_at")
  uploadedAt             DateTime? @map("uploaded_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  computeTarget ComputeTarget  @relation(fields: [computeTargetId], references: [id], onDelete: Restrict)
  sessionDetail SessionDetail? @relation(fields: [sessionDetailId], references: [artifactId], onDelete: SetNull)

  // Session identity (matches SessionDetail) plus the per-file discriminator.
  @@unique([computeTargetId, externalSessionId, fileKey])
  // NOTE: the standalone @@index([organizationId]) was dropped in
  // 20260722000001_prd536_g7_drop_redundant_org_index — the PRD-536 G7 composite
  // below leads with organizationId, so any org-only-prefixed query is served by
  // the composite's leading column, making a separate single-column org index
  // redundant write/storage overhead on this hot table.
  @@index([sessionDetailId])
  // PRD-536 G7: the transcript identity read (transcript-read-service /
  // agent-sessions service, via `sessionTranscriptIdentityWhere`) filters on
  // (organizationId, computeTargetId, externalSessionId) and orders by fileKey.
  // The unique key leads with computeTargetId, so it can't org-prefix this read
  // and large orgs scan. This composite leads with organizationId and co-locates
  // the full predicate + sort so the read is index-served.
  @@index([organizationId, computeTargetId, externalSessionId, fileKey])
  @@map("session_transcript")
}

// FEA-2718: conversation turn text left the database. The `summary` and `data`
// columns (turn/tool content) were dropped — the cloud transcript archive
// (FEA-2717) is the sole source of turn/tool detail. Only columnar metadata
// used by the timeline/markers/analytics remains here.
model AgentSessionEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  agentSessionId  String   @map("agent_session_id") @db.Uuid
  externalEventId String   @map("external_event_id")
  agentExternalId String?  @map("agent_external_id")
  eventType       String   @map("event_type")
  toolName        String?  @map("tool_name")
  eventCreatedAt  DateTime @map("event_created_at")
  createdAt       DateTime @default(now()) @map("created_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@unique([agentSessionId, externalEventId])
  /// ISS-7513 added this for the insights reads when they windowed on
  /// event_created_at alone and joined out to the org. #8602 moved those reads
  /// to per-session probes on the covering index below, but production still
  /// scans this one after ISS-12776 shipped, so ISS-12825 kept it.
  @@index([eventCreatedAt, agentSessionId])
  /// The insights event reads (`app/insights/service/event-queries.ts`) probe
  /// the per-session range once per session in scope, bounded to sessions
  /// whose last_activity_at reaches the window (#8602). ISS-12776 carried
  /// event_type and tool_name so the by-type and by-tool reads run index-only;
  /// ISS-12825 dropped the (agent_session_id, event_created_at) prefix index,
  /// so the count, daily-volume, page and per-session count reads plan here too.
  @@index([agentSessionId, eventCreatedAt, eventType, toolName], map: "agent_session_events_session_time_cover_idx")
  @@map("agent_session_events")
}

model AgentSessionTokenUsage {
  id               String   @id @default(uuid(7)) @db.Uuid
  agentSessionId   String   @map("agent_session_id") @db.Uuid
  model            String
  inputTokens      BigInt   @default(0) @map("input_tokens")
  outputTokens     BigInt   @default(0) @map("output_tokens")
  cacheReadTokens  BigInt   @default(0) @map("cache_read_tokens")
  cacheWriteTokens BigInt   @default(0) @map("cache_write_tokens")
  /// FEA-3419: cache-write TTL subdivision (5-minute vs 1-hour ephemeral
  /// writes). NULL = the desktop never reported a breakdown (legacy sessions,
  /// non-Claude harnesses, pre-TTL builds); explicit 0 = reported zero.
  cacheWrite5mTokens BigInt? @map("cache_write_5m_tokens")
  cacheWrite1hTokens BigInt? @map("cache_write_1h_tokens")
  estimatedCost    Decimal  @default(0) @map("estimated_cost") @db.Decimal(14, 6)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@unique([agentSessionId, model])
  @@index([model])
  @@map("agent_session_token_usage")
}

/// FEA-2730 (PRD-510 FR4 G1): raw per-event token usage synced from the
/// desktop's keep-all `token_events` log (retention/rollup deferred, Q3).
/// Append-only and idempotent: `externalEventId` is the provider-neutral stable
/// transport identity. The unique constraint is the replay boundary; immutable
/// content collisions fail closed while mutable provenance/cost enrichment may
/// advance on a fresh replay.
///
/// D4 (PRD-510) decision — this table is JOIN-REACHED, so it carries NO
/// `organizationId` and no org-wide index. Org isolation is enforced through the
/// `session → artifact.organizationId` relation, exactly as its sibling
/// `AgentSessionTokenUsage` already is; every cloud read enters through a
/// SessionDetail join (getSessionTokenEvents, the insights/usage aggregations).
/// `SessionDetail` itself has no `organizationId` (org lives on the parent
/// `Artifact`). The `[agentSessionId, eventCreatedAt]` index covers the
/// per-session, optionally date-bounded focus-page reads. Revisit only if a
/// future read must scan token events org-wide WITHOUT entering through
/// SessionDetail (e.g. "every token event for the org in a time window") — that
/// would justify adding `organizationId` + an `[organizationId, eventCreatedAt]`
/// index in a follow-up migration. No such read exists today.
model AgentSessionTokenEvent {
  id               String   @id @default(uuid(7)) @db.Uuid
  agentSessionId   String   @map("agent_session_id") @db.Uuid
  externalEventId  String   @map("external_event_id")
  agentExternalId  String?  @map("agent_external_id")
  model            String
  inputTokens      BigInt   @default(0) @map("input_tokens")
  outputTokens     BigInt   @default(0) @map("output_tokens")
  cacheReadTokens  BigInt   @default(0) @map("cache_read_tokens")
  cacheWriteTokens BigInt   @default(0) @map("cache_write_tokens")
  estimatedCost    Decimal? @map("estimated_cost") @db.Decimal(14, 6)
  sourceIdentity   Json?    @map("source_identity")
  costCompleteness String?  @map("cost_completeness")
  costCompletenessReason String? @map("cost_completeness_reason")
  subscriptionEquivalentCost Decimal? @map("subscription_equivalent_cost") @db.Decimal(14, 6)
  apiEstimatedCost Decimal? @map("api_estimated_cost") @db.Decimal(14, 6)
  eventCreatedAt   DateTime @map("event_created_at")
  createdAt        DateTime @default(now()) @map("created_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@unique([agentSessionId, externalEventId])
  @@index([agentSessionId, eventCreatedAt])
  @@index([agentSessionId, createdAt])
  /// ISS-12552 (AC-020): allocation finds the sessions holding one source
  /// usage by jsonb equality. Hash, because an identity can carry 64 ids of up
  /// to 2048 characters, past a btree entry's size limit.
  @@index([sourceIdentity], type: Hash)
  @@map("agent_session_token_events")
}

/// FEA-3568 (PLN-1398 T2): the desktop-local activity-segment tiling
/// (`session_lis`, FEA-2267) replicated to the cloud so the web /
/// authenticated-parity surfaces (FEA-2275 / FEA-2276) can read per-activity
/// attribution. Rows are stored VERBATIM — the cloud NEVER re-classifies
/// (PLN-1398 design decision 4). Ingestion is replace-all per session inside the
/// session upsert transaction (design decision 3), so no reader ever sees a
/// mixed-version tiling; `classifierVersion` rides per row as the re-derivation
/// key.
///
/// No `organizationId`: this table is JOIN-REACHED — org isolation is enforced
/// through the `session → artifact.organizationId` relation, exactly as its
/// sibling `AgentSessionTokenEvent` (D4 precedent). Every cloud read enters
/// through a SessionDetail join. `start_ms`/`end_ms` are absolute epoch-ms and so
/// are `BigInt` (int8) — epoch-ms overflows int4. The unique
/// `[agentSessionId, startMs]` is the natural key under a complete,
/// non-overlapping tiling; the `[agentSessionId]` index covers the per-session
/// read and the replace-all delete.
model AgentSessionActivitySegment {
  id                String   @id @default(uuid(7)) @db.Uuid
  agentSessionId    String   @map("agent_session_id") @db.Uuid
  phase             String
  startMs           BigInt   @map("start_ms")
  endMs             BigInt   @map("end_ms")
  confidence        Float
  /// Ranked evidence-layer names ("declared"/"structural"); empty for `idle` and
  /// evidence-free `other` spans. Layer names only — no prose on this lane.
  evidenceLayers    Json     @map("evidence_layers")
  classifierVersion Int      @map("classifier_version")
  workItemRef       String?  @map("work_item_ref")
  subagentId        String?  @map("subagent_id")
  createdAt         DateTime @default(now()) @map("created_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@unique([agentSessionId, startMs])
  @@index([agentSessionId])
  @@map("agent_session_activity_segments")
}

/// ISS-10721: the cloud twin of the desktop's `session_activity_metrics` rollup
/// — the autonomy band, the spend split by attribution confidence, and the
/// segment coverage counts. Before this the desktop computed all three and only
/// its own Diagnostics tab could read them, so no web surface could state how
/// much of a session's cost figure is a guess.
///
/// 1:1 with SessionDetail (the PK IS the session's artifact id, matching
/// `AgentSessionUsageRollup`), so a re-sync upserts in place. No
/// `organizationId`: join-reached through the session, per the D4 decision the
/// sibling child tables follow.
///
/// EVERY MEASURE IS NULLABLE AND NULL MEANS UNKNOWN. A session whose rollup has
/// never run holds no row at all, and a row written by a producer that could
/// compute only some of these holds NULL for the rest. `0` coverage, a `0`
/// segment count and the bottom autonomy band are real measurements, so a
/// column default would state one of them for every unmeasured session — the
/// exact conflation the ISS-10721 read contract exists to break. The desktop
/// source columns are NOT NULL with `0` defaults for its own historical
/// reasons; the mapping into this table drops an unmeasured value rather than
/// carrying that zero across.
///
/// The three spend columns partition the ATTRIBUTED spend only — out-of-segment
/// spend belongs to no confidence tier and is deliberately absent, so their sum
/// is not the session's total cost. They are written together or not at all.
///
/// `autonomyBand` is free-text TEXT holding an `AutonomyBand` contract member
/// (`@repo/api/src/types/session-activity-metrics`), matching how every other
/// synced vocabulary column on this lane is stored; the read narrows it and an
/// unrecognized value reads unknown rather than crashing a version-skewed peer.
model AgentSessionActivityMetrics {
  agentSessionId      String   @id @map("agent_session_id") @db.Uuid
  autonomyBand        String?  @map("autonomy_band")
  coverage            Float?
  spendLowConfUsd     Decimal? @map("spend_low_conf_usd") @db.Decimal(14, 6)
  spendMediumConfUsd  Decimal? @map("spend_medium_conf_usd") @db.Decimal(14, 6)
  spendHighConfUsd    Decimal? @map("spend_high_conf_usd") @db.Decimal(14, 6)
  segmentCount        Int?     @map("segment_count")
  coveredSegmentCount Int?     @map("covered_segment_count")
  /// The producer's ACTIVITY_CLASSIFIER_VERSION and ATTRIBUTION_METRIC_VERSION,
  /// carried so a reader can tell a stale rollup from a current one without
  /// re-deriving. Nullable for a producer that reports neither.
  classifierVersion   Int?     @map("classifier_version")
  metricVersion       Int?     @map("metric_version")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@map("agent_session_activity_metrics")
}

/// FEA-2730 (PRD-510 FR4 G10): the desktop's one-row-per-session usage rollup
/// (source table `session_analytics`), synced as-is and authoritative (Q16). 1:1
/// with SessionDetail — the PK IS the session's artifact id, so re-sync upserts
/// in place. Token columns are widened to BigInt and cost to Decimal(14,6) for
/// numeric fidelity (FEA-2728), though the desktop rollup stores them narrower;
/// `isHuman` is a boolean cloud-side (0/1 on the desktop). No `organizationId`
/// (join-reached via the session, per the D4 decision on AgentSessionTokenEvent
/// above). Named `UsageRollup` rather than `Analytics` to avoid colliding with
/// the unrelated org-wide `AgentSessionAnalytics` viewer-analytics API type.
model AgentSessionUsageRollup {
  artifactId       String    @id @map("artifact_id") @db.Uuid
  startedAt        DateTime? @map("started_at")
  startedDay       String?   @map("started_day")
  status           String?
  harness          String?
  isHuman          Boolean   @default(false) @map("is_human")
  humanTurns       Int       @default(0) @map("human_turns")
