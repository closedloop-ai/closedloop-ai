// GitHub pull request conversation detail. These rows are nested under branch
// artifacts and preserve current or historical PR-specific review state.
model PullRequestDetail {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artifactId             String?         @unique @map("artifact_id") @db.Uuid
  branchArtifactId       String          @map("branch_artifact_id") @db.Uuid
  // FEA-2732 / PRD-510 D2: write-once denormalization of the parent branch
  // Artifact's organizationId (the org SSOT). Set once at creation from the
  // branch's org and never updated independently. Present because a PR detail row
  // has no Artifact of its own to scope by, and the repo-less desktop identity
  // index must span the org (two orgs can sync the same public repo's PR number).
  organizationId         String          @map("organization_id") @db.Uuid
  // Installation-repo surrogate id — nullable enrichment only (PRD-510 D2). App
  // repos carry it (webhook/adoption lookups); desktop-produced PRs in non-App
  // repos have none until a later App installation adopts the row. PR identity
  // keys on repositoryFullName (repo-less) or repositoryId (App); never on both.
  repositoryId           String?         @map("repository_id") @db.Uuid
  // Normalized `owner/name` (normalizeRepoFullName) — the producer-independent PR
  // identity component for repo-less desktop rows (PRD-510 D2), uniform across
  // desktop sync and the GitHub webhook. Enrichment for App rows.
  repositoryFullName     String?         @map("repository_full_name")
  // Nullable for desktop-only rows until `gh` enrichment / App adoption supplies
  // the canonical GitHub node id. The unique constraint still holds across all
  // non-null values (Postgres treats NULLs as distinct).
  githubId               String?         @unique @map("github_id")
  number                 Int
  title                  String?
  htmlUrl                String?         @map("html_url")
  body                   String?         @db.Text
  prState                GitHubPRState   @default(OPEN) @map("pr_state")
  isDraft                Boolean         @default(false) @map("is_draft")
  additions              Int?
  deletions              Int?
  changedFiles           Int?            @map("changed_files")
  reviewDecision         ReviewDecision? @map("review_decision")
  isCurrent              Boolean         @default(false) @map("is_current")
  // FEA-3552: the GitHub PR `created_at` — when the PR was actually raised. The
  // branch/PR timeline's "PR opened" lifecycle dot anchors here (distinct from the
  // "PR merged" dot at `mergedAt`). Additive & nullable: it fills forward from the
  // webhook/fetch/desktop-sync producers as PRs are (re)projected; historical rows
  // written before this column stay null (no opened dot) rather than being
  // fabricated from another timestamp. Replaces the FEA-3457 `openedAt: null`
  // cloud deferral so cloud reaches desktop's opened+merged parity.
  githubCreatedAt        DateTime?       @map("github_created_at")
  // PLN-1535 M1: the GitHub PR `updated_at` — the reconciler's recency boundary.
  // It fetches PRs UPDATED_AT DESC (bounded pages) and refreshes those newer than
  // the repo's stored watermark, then advances the watermark; reopened PRs bump
  // updatedAt so terminal gating needs no special case. Additive & nullable:
  // fills forward from the webhook/fetch producers; historical rows stay null.
  githubUpdatedAt        DateTime?       @map("github_updated_at")
  closedAt               DateTime?       @map("closed_at")
  mergedAt               DateTime?       @map("merged_at")
  mergeCommitSha         String?         @map("merge_commit_sha")
  // PLN-1535 M1: the PR head commit oid (GraphQL `headRefOid`). Additive &
  // nullable; completes the projection contract the reconciler writes. Distinct
  // from BranchDetail.headSha (the branch ref head) — this is the PR's head at
  // last projection.
  headRefOid             String?         @map("head_ref_oid")
  // ISS-6541: provider-reported PR head ref name. Nullable and
  // omission-preserving so legacy or provenance-poorer projections fail closed
  // instead of inferring publication from the owning Branch row.
  headRefName            String?         @map("head_ref_name")
  // ISS-8155: this PR's OWN base ref, as the provider reported it when the PR was
  // projected. Distinct from BranchDetail.baseBranch, which tracks the branch's
  // CURRENT base: a branch reused for a second PR to a different target moved
  // that value, so serving it made every historical PR claim the newer base.
  // NULL is the single spelling of "no producer measured this" — a row projected
  // before the column, a desktop-sync row that never had a base ref, or a
  // producer whose own base was absent. It is never backfilled from the Branch;
  // the read serves an explicit unknown and the GitHub producers fill it forward.
  baseRefName            String?         @map("base_ref_name")
  // ISS-5826: provider-authoritative snapshot of the PR head repository. This
  // stays independent from repositoryId/repositoryFullName above, which identify
  // the base/event repository. Every field is nullable for legacy and
  // version-skewed producers; missing evidence must never imply the base repo.
  headRepositoryGithubId                       String?   @map("head_repository_github_id")
  headRepositoryFullName                       String?   @map("head_repository_full_name")
  headRepositoryDefaultBranchName              String?   @map("head_repository_default_branch_name")
  headRepositoryDefaultBranchAvailability      String?   @map("head_repository_default_branch_availability") @db.VarChar(32)
  headRepositoryDefaultBranchCompleteness      String?   @map("head_repository_default_branch_completeness") @db.VarChar(32)
  headRepositoryDefaultBranchReason            String?   @map("head_repository_default_branch_reason") @db.VarChar(64)
  headRepositoryDefaultBranchSource            String?   @map("head_repository_default_branch_source") @db.VarChar(64)
  headRepositoryDefaultBranchMechanism         String?   @map("head_repository_default_branch_mechanism") @db.VarChar(32)
  headRepositoryDefaultBranchTrigger           String?   @map("head_repository_default_branch_trigger") @db.VarChar(32)
  headRepositoryDefaultBranchCredentialType    String?   @map("head_repository_default_branch_credential_type") @db.VarChar(32)
  headRepositoryDefaultBranchCredentialOwnerId String?   @map("head_repository_default_branch_credential_owner_id") @db.Uuid
  headRepositoryDefaultBranchObservationKey    String?   @map("head_repository_default_branch_observation_key")
  headRepositoryDefaultBranchObservedAt        DateTime? @map("head_repository_default_branch_observed_at")
  headRepositoryDefaultBranchEventAt           DateTime? @map("head_repository_default_branch_event_at")
  // PLN-1535 M3: the PR author's GitHub login (webhook `pull_request.user.login`
  // / read-model `author.login`). Additive & nullable so the Postgres-served PR
  // list can render the real author instead of the live path's "unknown"
  // fallback. Omission-preserving on update (a provenance-poorer projection that
  // lacks it never nulls a stored value); historical rows stay null until a
  // producer refreshes them. ISS-8155: the read serves an unfilled column as the
  // ABSENT form ("") for the surface to render as unknown — NOT the literal
  // "unknown" it used to coalesce to, which is a login a real GitHub account can
  // hold and so could not be told apart from a measured one.
  authorLogin            String?         @map("author_login")
  // Provider ID and actor kind, not the mutable login, qualify PR authors for
  // Collaborators. Nullable for legacy and provenance-poorer producers.
  authorProviderUserId   String?         @map("author_provider_user_id")
  authorActorType        String?         @map("author_actor_type") @db.VarChar(32)
  lastVerifiedAt         DateTime?       @map("last_verified_at")
  lastRefreshAttemptAt   DateTime?       @map("last_refresh_attempt_at")
  fetchCredentialType    String?         @map("fetch_credential_type") @db.VarChar(32)
  fetchCredentialOwnerId String?         @map("fetch_credential_owner_id") @db.Uuid
  fetchMechanism         String?         @map("fetch_mechanism") @db.VarChar(32)
  fetchTrigger           String?         @map("fetch_trigger") @db.VarChar(32)
  fetchObservedAt        DateTime?       @map("fetch_observed_at")
  fetchResultReason      String?         @map("fetch_result_reason") @db.VarChar(64)
  // ISS-8462: durable "the desktop sync lane produced this row", separate from
  // `fetchMechanism`, which records only how the row was LAST written and which
  // a successful reconcile overwrites to `graphql`. The reconciler's tier-2
  // stub arm needs origin, not last-writer: keyed on `fetchMechanism` a desktop
  // row refreshed once stopped matching its own arm and never refreshed again.
  // Write-once-true on the desktop path and never cleared — after a reconcile
  // the desktop no longer owns the row (webhook-wins reads `fetchMechanism`),
  // so nothing rewrites it. Never set by a provider producer.
  desktopOriginated      Boolean         @default(false) @map("desktop_originated")
  // FEA-3874 (parent FEA-3801, PLN-1457 S2): provider-neutrality discriminator.
  // Additive dual-read column — every existing GitHub-produced row is backfilled
  // to 'github'. The GitHub-specific columns above (githubId, prState, etc.) are
  // unchanged and remain the live read/write path in this slice; `provider` only
  // records which VCS host produced the row so later slices can branch on it.
  // `providerDetail` carries the provider-specific fields that do not have a
  // dedicated column (typed per-provider via the ChangeRequestProviderDetail
  // contract in @repo/api). Freeform text/JSON so the vocabulary grows without a
  // migration per provider; validated in the service layer, not by Prisma.
  provider               String          @default("github") @db.VarChar(32)
  providerDetail         Json?           @map("provider_detail")
  // ISS-11212 (PLN-2122 decision 3): when the last complete comment reconcile
  // finished (NULL = never reconciled), and the lease a running reconcile holds.
  commentsReconciledAt         DateTime? @map("comments_reconciled_at")
  commentsReconcileClaimedAt   DateTime? @map("comments_reconcile_claimed_at")
  // ISS-11212: when the last comment reconcile released its lease, complete or
  // not (NULL = never attempted). The cron orders by it, so a PR whose
  // reconcile keeps failing waits its turn behind the others.
  commentsReconcileAttemptedAt DateTime? @map("comments_reconcile_attempted_at")

  artifact                       Artifact?                       @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  branchArtifact                 Artifact                        @relation("BranchPullRequests", fields: [branchArtifactId], references: [id], onDelete: Cascade)
  // ISS-10170: the denormalized `organizationId` above is the tenant the
  // org-wide PR aggregates now seek on directly, so a row whose column
  // disagrees with its branch artifact's organization is a CROSS-TENANT READ,
  // not merely a wrong row. This composite FK is what refuses to store one.
  // Deliberately ADDITIVE beside the single-column `branchArtifact` FK rather
  // than a replacement: dropping that constraint would be a destructive change
  // to a live referential action for no gain, and the two agree by construction
  // (both reference the same artifact row, one of them also pinning the org).
  // Same shape as `branch_activity_atoms_branch_fkey`, which ties the identical
  // column pair through `BranchDetail`; this one targets `artifacts` because
  // that is where `organization_id` is the SSOT — `BranchDetail`'s own copy is
  // itself an unenforced denormalization, so routing through it would chain one
  // unconstrained claim onto another.
  branchArtifactTenant           Artifact                        @relation("BranchPullRequestTenant", fields: [organizationId, branchArtifactId], references: [organizationId, id], onDelete: Cascade, map: "pull_request_detail_branch_artifact_tenant_fkey")
  repository                     GitHubInstallationRepository?   @relation(fields: [repositoryId], references: [id])
  organization                   Organization                    @relation(fields: [organizationId], references: [id])
  reviews                        GitHubPRReview[]
  githubCommentThreadProjections GitHubCommentThreadProjection[]
  activityAtoms                   BranchActivityAtom[]
  currentForBranches             BranchDetail[]                  @relation("CurrentBranchPullRequest")
  deliveryPoints                 DeliveryPoint[]
  verificationStampBackfills     PullRequestVerificationStampBackfill[]
  commentAcquisitions            PullRequestCommentAcquisition[]

  // App-repo identity (webhook/backfill producers). Repo-less desktop rows have a
  // null repositoryId, so this index never constrains them (NULLs are distinct).
  @@unique([repositoryId, number])
  @@unique([id, branchArtifactId], map: "pull_request_detail_id_branch_artifact_id_key")
  // Immutable organization-scoped FK target for historical activity evidence.
  // Branch association is validated when an atom is written but is deliberately
  // absent here so a later PR relink cannot move already-recorded evidence.
  @@unique([organizationId, id], map: "pull_request_detail_org_id_key")
  @@index([branchArtifactId, isCurrent])
  @@index([organizationId])
  // FEA-3638 (insights perf, Tier-1): the dashboard delivery endpoint's dominant
  // query (fetchMergedPrs) plus its exact counts (countMergedPrsInRange /
  // countMergedPrs / the PR _min(mergedAt) in earliestRecord) all filter
  // prState = MERGED + a mergedAt window; today served only by @@index([organizationId])
  // + a scan/sort of the org's whole merged history for the date window (called out
  // as a tracked-but-missing index in service.ts). This additive composite serves
  // that filter/sort shape. CAVEAT: these queries scope the org via the JOINED
  // branch Artifact (`branchArtifact: artifactScope(ctx)` → artifacts.organization_id),
  // NOT this row's denormalized organization_id, so the planner may not lead with
  // this index's organizationId column for those queries — the effective PR-side
  // working set there is (pr_state, merged_at). The leading organizationId still
  // benefits any query that DOES filter the denormalized column directly (mirrors
  // the existing @@index([organizationId])), and is additive/no-result-change
  // either way. Final column choice is an EXPLAIN follow-up on a seeded DB.
  @@index([organizationId, prState, mergedAt])
  // NOTE: pull_request_detail_org_lower_head_repo_full_name_idx is a PARTIAL
  // EXPRESSION index on (organization_id, lower(head_repository_full_name))
  // WHERE head_repository_full_name IS NOT NULL (ISS-6452, migration
  // 20260815120000). It serves the session-ingest authority read in
  // apps/api/app/agent-sessions/service/artifact-links/shared.ts, whose
  // `LOWER(head_repository_full_name) IN (…)` predicate no plain btree can
  // match. Prisma's DSL cannot express an EXPRESSION index, so it lives only in
  // that migration and is asserted by
  // packages/database/__tests__/integration/repository-authority-lower-name-indexes.integration.test.ts.
  //
  // FEA-2732: the producer-independent identity for desktop-produced non-App PRs.
  // A later App installation fills repository_id (adoption), moving the row out of
  // this index and under @@unique([repositoryId, number]).
  @@unique([organizationId, repositoryFullName, number], map: "pull_request_detail_org_repo_full_name_number_key", where: raw("(repository_id IS NULL)"))
  // Session identity reads also resolve rows adopted by an installation.
  @@index([organizationId, repositoryFullName, number], map: "pull_request_detail_org_repo_name_number_idx")
  // ISS-11212: the comment-reconcile cron's due-PR scan (seek on prState, then
  // its ORDER BY). The migration builds it CONCURRENTLY with both timestamps
  // NULLS FIRST, which PSL cannot express and Prisma does not diff.
  @@index([prState, commentsReconcileAttemptedAt, commentsReconciledAt, id], map: "pull_request_detail_comments_reconcile_due_idx")
  @@map("pull_request_detail")
}

// Cloud SSOT for git commits observed on a branch (PRD-510 D7 / FEA-2731).
// Deliberately a STANDALONE table, NOT an Artifact subtype — commits are git
// objects; no COMMIT ArtifactType exists and none is added. The row attaches to
// the platform only via `branchArtifactId` (the branch's Artifact); there is no
// commit slug and no ArtifactLink. Fed by two producers reconciled on the
// identity key: desktop sync (non-App repos, no GitHub App required) and the
// GitHub `push` webhook (App repos). Reads are join-reached per branch.
model CommitDetail {
  id                 String    @id @default(uuid(7)) @db.Uuid
  // Write-once denormalization of the owning org (from the API key at ingest /
  // the branch Artifact's org). Present only so the identity index can span for
  // cross-tenant dedup (non-App repos carry no repositoryId, mirroring D2) — it
  // is NOT a query-scoping column (D4: reads reach it via the branch). Set once
  // at creation and never independently updated.
  organizationId     String    @map("organization_id") @db.Uuid
  // Normalized `owner/name` (normalizeRepoFullName) — the producer-independent
  // commit identity component (PRD-510 D2), uniform across desktop sync and the
  // GitHub webhook regardless of whether the App is installed.
  repositoryFullName String    @map("repository_full_name")
  sha                String
  // The branch the commit was observed on. Single FK, Cascade; no ArtifactLink.
  // Many-to-many (a commit on multiple branches) is deferred (Q10).
  branchArtifactId   String    @map("branch_artifact_id") @db.Uuid
  message            String?   @db.Text
  committedAt        DateTime? @map("committed_at")
  authoredAt         DateTime? @map("authored_at")
  authorName         String?   @map("author_name")
  authorEmail        String?   @map("author_email")
  authorLogin        String?   @map("author_login")
  linesAdded         Int?      @map("lines_added")
  linesRemoved       Int?      @map("lines_removed")
  filesChanged       Int?      @map("files_changed")
  isMerge            Boolean   @default(false) @map("is_merge")
  mergeCommitSha     String?   @map("merge_commit_sha")
  // Provenance of the last authoritative writer per the field-level merge rules
  // (Phase 4): `desktop_sync` | `push_webhook` | `github_api`. Freeform String,
  // matching BranchDetail's pushSource/headShaSource convention; the allowed
  // values are the CommitSource SSOT in @repo/api (packages/api/src/types).
  source             String
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Artifact     @relation("BranchCommits", fields: [branchArtifactId], references: [id], onDelete: Cascade)

  // PRD-510 D7 commit identity: one row per (org, normalized repo full name,
  // sha) — cross-tenant dedup and the convergence point for the desktop + webhook
  // producers. Explicit map keeps the constraint name well under Postgres's
  // 63-char identifier limit.
  @@unique([organizationId, repositoryFullName, sha], map: "commit_detail_org_repo_full_name_sha_key")
  // Branch-detail read pattern: a branch's commits, most-recent first.
  @@index([branchArtifactId, committedAt], map: "commit_detail_branch_committed_at_idx")
  @@map("commit_detail")
}

// Bounded branch file-change metadata cache. Raw file contents stay in GitHub
// and are fetched only through explicit diff/content paths.
model BranchFileChange {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchArtifactId   String   @map("branch_artifact_id") @db.Uuid
  headSha            String   @map("head_sha")
  path               String
  previousPath       String?  @map("previous_path")
  status             String
  additions          Int?
  deletions          Int?
  changes            Int?
  patch              String?  @db.Text
  patchBytes         Int      @default(0) @map("patch_bytes")
  patchOmittedReason String?  @map("patch_omitted_reason")
  isBinary           Boolean  @default(false) @map("is_binary")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  branch BranchDetail @relation(fields: [branchArtifactId], references: [artifactId], onDelete: Cascade)

  @@unique([branchArtifactId, headSha, path])
  @@index([branchArtifactId, path])
  @@index([branchArtifactId, headSha])
  // List and analytics GROUP BY branch/head need only the two LOC counters.
  // The per-file heap also carries patches, so a covering index keeps these
  // aggregates off that wider cache projection.
  @@index([branchArtifactId, headSha, additions, deletions], map: "branch_file_changes_totals_cover_idx")
  @@map("branch_file_changes")
}

// Type-specific detail for DEPLOYMENT-typed artifacts. 1:1 with `Artifact`
// via shared `artifact_id` primary key. Rows are backfilled from the
// PREVIEW_DEPLOYMENT rows in the legacy `external_links` table in
// Chunk 2B. All columns nullable because today's `DeploymentMetadata` is
// loosely shaped. Deployment state lives only on the parent `artifact.status`
// (plain TEXT so any vendor value round-trips).
model DeploymentDetail {
  artifactId          String   @id @map("artifact_id") @db.Uuid
  environment         String?
  ref                 String?
  sha                 String?
  githubStatusUrl     String?  @map("github_status_url")
  githubDeploymentUrl String?  @map("github_deployment_url")
  transient           Boolean?
  production          Boolean?
  branchArtifactId    String?  @map("branch_artifact_id") @db.Uuid
  // FEA-3874 (PLN-1457 S2): additive provider discriminator + typed
  // provider-specific detail. GitHub rows backfill to 'github'; the
  // githubStatusUrl/githubDeploymentUrl columns above are unchanged.
  provider            String   @default("github") @db.VarChar(32)
  providerDetail      Json?    @map("provider_detail")

  artifact       Artifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  branchArtifact Artifact? @relation("DeploymentOfBranch", fields: [branchArtifactId], references: [id], onDelete: SetNull)

  @@index([branchArtifactId])
  @@index([ref, sha])
  @@map("deployment_detail")
}

/// ISS-4975: append-only deployment-event history. One immutable row per
/// provider status transition, INCLUDING failures — the ingest path used to drop
/// everything except `success`, and `recordDeployment` overwrites the
/// current-state row on re-deploy, so neither change-failure rate, MTTR, nor
/// deployment frequency had a usable source. This table is additive: the
/// `DEPLOYMENT` artifact + `DeploymentDetail` row above is untouched and remains
/// the system of record for "what is deployed right now".
///
/// ISS-12780 (Perrin Upcott, 2026-10-21: "Stop writing, keep the table"):
/// nothing writes this table any more; the rows already here stay. While the
/// webhook ingested, rows were never updated or deleted, and a redelivered
/// webhook was an `ON CONFLICT DO NOTHING` no-op on the unique dedupe identity
/// below.
///
/// DEDUPE IDENTITY. `(organizationId, source, externalEventId)` — all three
/// non-nullable. `externalEventId` is the provider's status-transition id, which
/// is unique per transition; `source` keeps two event streams from colliding on a
/// raw numeric id. `externalDeploymentId` (also non-nullable) groups every
/// transition of one deployment, so DORA counts collapse per deployment rather
/// than per event. Nullable fields such as `environmentUrl` or `sha` are
/// deliberately NOT part of the identity: a failed deployment usually carries no
/// environment URL at all.
///
/// NO FOREIGN KEYS except the tenant boundary. `projectId`, `repositoryId`, and
/// `branchArtifactId` are plain id columns on purpose: an append-only history
/// must not be silently rewritten (`SET NULL`) or destroyed (`CASCADE`) when the
/// mutable current-state records it describes are deleted, tombstoned, or
/// reparented. `organizationId` keeps its FK so tenant deletion still removes
/// tenant data. The current-state DEPLOYMENT artifact for a preview deploy is
/// reachable from `environmentUrl`, which is the key `recordDeployment` upserts
/// on, so no artifact id is duplicated here.
model DeploymentEvent {
  id String @id @default(uuid(7)) @db.Uuid

  organizationId String  @map("organization_id") @db.Uuid
  /// Null for repo-level deploys that have no branch artifact to inherit a
  /// project from (production deploys of the default branch are the common
  /// case). Group by `repositoryId` for complete coverage.
  projectId      String? @map("project_id") @db.Uuid
  /// `GitHubInstallationRepository.id` when `source` is `github`.
  repositoryId   String? @map("repository_id") @db.Uuid
  /// The branch artifact the deployment ref resolved to, when one exists. Null
  /// for deploys of a ref with no tracked branch artifact — production deploys of
  /// the default branch, most often.
  branchArtifactId String? @map("branch_artifact_id") @db.Uuid

  /// Always `github`, the only source ISS-4975 ever wrote.
  source               String @db.VarChar(32)
  externalDeploymentId String @map("external_deployment_id") @db.VarChar(200)
  externalEventId      String @map("external_event_id") @db.VarChar(200)

  /// Normalized state: QUEUED, PENDING, IN_PROGRESS, SUCCESS, FAILURE, ERROR,
  /// INACTIVE, or UNKNOWN for a provider state the ingest did not recognize.
  state         String @db.VarChar(32)
  /// The raw provider state exactly as delivered, so a state we did not know how
  /// to normalize can be reclassified later without re-ingesting.
  providerState String @map("provider_state") @db.VarChar(64)

  environment         String?
  ref                 String?
  sha                 String?
  environmentUrl      String?  @map("environment_url")
  githubStatusUrl     String?  @map("github_status_url")
  githubDeploymentUrl String?  @map("github_deployment_url")
  production          Boolean?
  transient           Boolean?

  /// When the provider says the transition happened — the ordering key for every
  /// DORA window, MTTR interval, and lead-time endpoint. Distinct from
  /// `createdAt`, which is when we ingested it.
  occurredAt          DateTime  @map("occurred_at")
  /// When the deployment itself was created, when the payload reports it.
  deploymentCreatedAt DateTime? @map("deployment_created_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The only index: the ON CONFLICT DO NOTHING target of the ingest write
  /// ISS-12780 removed. Read indexes are deliberately absent until the DORA
  /// queries (ISS-4465) define the predicates they actually filter and order
  /// on — this PR ships no reader.
  @@unique([organizationId, source, externalEventId], map: "deployment_events_org_source_event_key")
  @@map("deployment_events")
}

// Replacement for polymorphic `EntityLink` with real FKs. Rows for
// DOCUMENT↔DOCUMENT links are backfilled in 2A; PR/Deployment links are
// added in 2B. Legacy `entity_links` table continues to coexist until 2F.
model ArtifactLink {
  id                            String    @id @default(uuid(7)) @db.Uuid
  organizationId                String    @map("organization_id") @db.Uuid
  sourceId                      String    @map("source_id") @db.Uuid
  targetId                      String    @map("target_id") @db.Uuid
  linkType                      LinkType  @map("link_type")
  /// Relationship-owned sibling rank. Root artifacts continue to use
  /// Artifact.sortOrder; a child with several PRODUCES parents may have a
  /// different rank in each parent's neighborhood.
  sortOrder                     Int?      @map("sort_order")
  // Additive branch participation projection for SESSION→BRANCH links. Nullable
  // so legacy links continue to resolve through metadata fallback while new
  // readers can filter/project wrote vs reviewed without parsing JSON at render
  // time. Values are the BranchParticipationKind contract in @repo/api.
  branchParticipation           String?   @map("branch_participation") @db.VarChar(32)
  branchParticipationMethod     String?   @map("branch_participation_method")
  branchParticipationObservedAt DateTime? @map("branch_participation_observed_at")
  // ISS-7669. When a later sync last RESTATED this edge, as opposed to
  // `createdAt`, which is pinned at the sync that first created the row and can
  // never move. Related Sessions orders by newest contribution, so reading
  // `createdAt` reported a session's FIRST reference to an artifact as its
  // latest. Nullable because rows written before this column existed were never
  // stamped; readers fall back to `createdAt` for those, the same shape as
  // `agent_component_session_usage.lastInvokedAt`.
  lastContributedAt             DateTime? @map("last_contributed_at")
  metadata                      Json?
  createdAt                     DateTime  @default(now()) @map("created_at")

  source Artifact @relation("ArtifactLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Artifact @relation("ArtifactLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, linkType])
  // ISS-8496: `artifact_links_source_id_fkey` is already served by the
  // source-leading unique above; `artifact_links_target_id_fkey` had nothing
  // leading with target_id, and the two triggers on this one table are the
  // controlled measurement in that ticket — same rows, same call count, 211x
  // apart. This closes the gap.
  @@index([targetId])
  // The Sessions Project facet reads source/target under org + link type
  // (`sessionProjectCountsSql`); the index covers them so that read can avoid
  // the metadata heap.
  @@index([organizationId, linkType, sourceId, targetId, id], map: "artifact_links_project_facet_cover_idx")
  @@index([organizationId, sourceId, linkType])
  @@index([organizationId, sourceId, linkType, sortOrder, targetId], map: "artifact_links_parent_rank_idx")
  @@index([organizationId, targetId, linkType])
  @@index([organizationId, sourceId, linkType, branchParticipation], map: "artifact_links_org_source_link_participation_idx")
  @@index([organizationId, targetId, linkType, branchParticipation], map: "artifact_links_org_target_link_participation_idx")
  @@map("artifact_links")
}

// Append-only activity log for artifacts (FEA-3859 / FEA-3535 Slice 1). One row
// per captured mutation on an artifact — status changes, field edits,
// assignment/approver changes, and creation — recorded so the activity feed
// has a persisted trail. `Artifact.status` and the other mutable columns keep
// no history on their own; this table is that history. Written from
// `apps/api/lib/artifact-activity-capture.ts` on the document write paths and
// read by `GET /documents/[id]/activity` (FEA-3864).
//
// `actorType` / `action` are freeform strings validated by const-object enums
// in the service layer (`ArtifactActivityActorType` / `ArtifactActivityAction`
// in @repo/api), mirroring the freeform-status precedent on `Artifact.status`
// (:1176) — Prisma enums are intentionally avoided so the vocabulary can grow
// additively without a schema migration per value.
//
// `before` / `after` carry the field-scoped snapshot for the change (e.g. the
// old and new status, or the old and new assignee id). Both are nullable: a
// `creation` event has no `before`, and a cleared field has a null `after`.
model ArtifactActivityEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  artifactId     String   @map("artifact_id") @db.Uuid
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id")
  action         String
  before         Json?
  after          Json?
  // ISS-9465: the id shared by every receipt one bulk mutation produced, here
  // and in `audit_entries.detail`. Null for a single-artifact write, which has
  // no transaction to group. Ruling 5 left it unindexed until it had a reader,
  // because this table's index maintenance was measured as the largest single
  // cost in a project delete (ISS-8496). ISS-10458's undo reference check is
  // that reader, so the index below now exists.
  transactionId  String?  @map("transaction_id") @db.Uuid
  // ISS-10458: the transaction this row REVERSES, set only on the receipts of
  // an undo. Directed rather than reusing `transactionId`: sharing one id would
  // say the two commits are one action without saying which of them undid the
  // other. Unindexed — nothing queries by it, and ruling 5's cost argument
  // still holds for a column with no reader.
  undoOfTransactionId String? @map("undo_of_transaction_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  // Serves the org-scoped, per-artifact, time-ordered list read
  // (`listActivityEvents`): filter on (organization_id, artifact_id), order by
  // created_at. The trailing created_at column also carries the keyset sort.
  @@index([organizationId, artifactId, createdAt])
  // ISS-10994: one action per V1 feed query keeps the event cursor bounded
  // when monitored-session receipts outnumber human-visible edits.
  @@index([organizationId, artifactId, action, createdAt(sort: Desc), id(sort: Desc), actorType], map: "artifact_activity_v1_action_cursor_actor_idx")
  // ISS-8496: the cascade check for `artifact_activity_events_artifact_id_fkey`
  // is `artifact_id = $1` with no organization_id, so the org-leading index
  // above cannot serve it. Measured the largest single cost in a project delete.
  @@index([artifactId])
  // ISS-10458: resolves a claimed `undoOfTransactionId` against the forward
  // mutation's own receipts before the undo is allowed to write. Org-leading so
  // the lookup cannot reach another tenant's transaction even when the caller
  // supplies a real id lifted from one.
  @@index([organizationId, transactionId])
  // #8737 follow-up (migration 20261013120100): the retained rows SQL cannot
  // certify as parseable, for the session-detail untracked-repositories read.
  // The predicate is generated from UNCERTIFIED_RETAINED_SNAPSHOT_SQL
  // (apps/api/app/agent-sessions/service/session-untracked-repositories-rows.ts);
  // this declaration is Postgres's normalized form of it, copied from db pull.
  @@index([organizationId, artifactId], map: "artifact_activity_events_monitored_retained_uncertified_idx", where: raw("((action = 'monitored_activity_retained'::text) AND (((jsonb_typeof((after -> 'repositoryFullName'::text)) = 'string'::text) AND ((after ->> 'repositoryFullName'::text) <> ''::text) AND\nCASE (after ->> 'kind'::text)\n    WHEN 'branch'::text THEN ((jsonb_typeof((after -> 'branchName'::text)) = 'string'::text) AND (length((after ->> 'branchName'::text)) >= 1))\n    WHEN 'pull_request'::text THEN\n    CASE\n        WHEN (jsonb_typeof((after -> 'prNumber'::text)) = 'number'::text) THEN ((((after ->> 'prNumber'::text))::numeric = trunc(((after ->> 'prNumber'::text))::numeric)) AND (((after ->> 'prNumber'::text))::numeric > (0)::numeric) AND (((after ->> 'prNumber'::text))::numeric <= (2147483647)::numeric))\n        ELSE false\n    END\n    ELSE false\nEND AND (jsonb_typeof((after -> 'kind'::text)) = 'string'::text) AND (((after -> 'url'::text) IS NULL) OR (jsonb_typeof((after -> 'url'::text)) = 'string'::text)) AND (jsonb_typeof((after -> 'eventKind'::text)) = 'string'::text) AND ((after ->> 'eventKind'::text) = ANY (ARRAY['user_reference'::text, 'agent_read'::text, 'agent_action'::text])) AND (jsonb_typeof((after -> 'occurredAt'::text)) = 'string'::text) AND ((after ->> 'occurredAt'::text) ~ '^[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?Z$'::text) AND (jsonb_typeof((after -> 'completeness'::text)) = 'string'::text) AND ((after ->> 'completeness'::text) = ANY (ARRAY['complete'::text, 'partial'::text])) AND (jsonb_typeof((after -> 'disposition'::text)) = 'string'::text) AND ((after ->> 'disposition'::text) = ANY (ARRAY['intentionally_absent'::text, 'repository_unfetchable'::text, 'repository_out_of_scope'::text, 'repository_identity_unknown'::text, 'authority_conflict'::text, 'provider_identity_ambiguous'::text, 'target_not_materialized'::text, 'hold_expired'::text])) AND (((after -> 'holdExpiryCause'::text) IS NULL) OR ((jsonb_typeof((after -> 'holdExpiryCause'::text)) = 'string'::text) AND ((after ->> 'holdExpiryCause'::text) = ANY (ARRAY['own_age'::text, 'escalation'::text]))))) IS NOT TRUE))"))
  // NOTE: artifact_activity_events_monitored_retained_target_idx is a PARTIAL
  // EXPRESSION index on (organization_id, artifact_id, after->>'kind',
  // after->>'repositoryFullName', COALESCE(after->>'branchName',
  // after->>'prNumber')) WHERE action = 'monitored_activity_retained' (#8737
  // follow-up, migration 20261013120000), for the per-delivery retained-row read
  // in apps/api/app/agent-sessions/service/monitored-session-activity-retained-rows.ts.
  // PSL cannot declare it; it is pinned by
  // __tests__/integration/psl-inexpressible-partial-indexes.integration.test.ts.
  @@map("artifact_activity_events")
}

/// ISS-12552 (PRD-800): one row per artifact write made with an API key,
/// written in the mutation's own transaction. Browser-session writes get none.
/// The wire operation id is `clop_` followed by `id`. Target ids carry no
/// foreign key, so deleting an artifact never pays a cascade check here
/// (ISS-8496) and a receipt outlives the record it describes.
model ArtifactOperationReceipt {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  principalUserId     String    @map("principal_user_id") @db.Uuid
  apiKeyId            String?   @map("api_key_id") @db.Uuid
  source              String
  operationKind       String    @map("operation_kind")
  targetArtifactId    String?   @map("target_artifact_id") @db.Uuid
  outcome             String
  createdArtifactId   String?   @map("created_artifact_id") @db.Uuid
  versionNumber       Int?      @map("version_number")
  commentId           String?   @map("comment_id") @db.Uuid
  linkId              String?   @map("link_id") @db.Uuid
  changedFields       String[]  @default([]) @map("changed_fields")
  contentDigestBefore String?   @map("content_digest_before")
  contentDigestAfter  String?   @map("content_digest_after")
  clientCallId        String?   @map("client_call_id")
  requestFingerprint  String?   @map("request_fingerprint")
  requestedAt         DateTime  @map("requested_at")
  committedAt         DateTime? @map("committed_at")
  /// ISS-12552: the API route template that took the write, such as
  /// `/documents/[id]`. Null on receipts written before routes were recorded.
  route               String?
  createdAt           DateTime  @default(now()) @map("created_at")

  // A replayed denied MCP call writes one rejected receipt, not one per replay.
  @@unique([organizationId, principalUserId, clientCallId], map: "artifact_operation_receipts_rejected_call_key", where: raw("((outcome = 'rejected'::text) AND (client_call_id IS NOT NULL))"))
  // The primary join from a transcript claim to its receipt: the harness's own
  // tool-call id, scoped to the session owner's organization and user.
  @@index([organizationId, principalUserId, clientCallId], map: "artifact_operation_receipts_call_id_idx")
  // The fallback join for harnesses that send no call id: a unique request
  // fingerprint inside the call's time window.
  @@index([organizationId, principalUserId, requestFingerprint, requestedAt], map: "artifact_operation_receipts_fingerprint_idx")
  @@map("artifact_operation_receipts")
}

/// ISS-12552: one historical attribution backfill run. The
/// script resumes an unfinished run with the same policy and extractor
/// versions and organization scope from its cursor, the last session it
/// finished. A null organization scope walks every organization.
model AttributionBackfillRun {
  id               String    @id @default(uuid(7)) @db.Uuid
  policyVersion    Int       @map("policy_version")
  extractorVersion Int       @map("extractor_version")
  organizationId   String?   @map("organization_id") @db.Uuid
  cursor           String?   @db.Uuid
  status           String
  counts           Json      @default("{}")
  startedAt        DateTime  @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([policyVersion, extractorVersion, organizationId, status], map: "attribution_backfill_runs_versions_status_idx")
  @@map("attribution_backfill_runs")
}

/// ISS-12552: one row per operation claim a session's
/// Desktop synced, reconciled against receipts and classified. Replaced as a
/// set when the session's evidence snapshot digest changes.
model AgentSessionOperationEvidence {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  agentSessionId     String    @map("agent_session_id") @db.Uuid
  claimKey           String    @map("claim_key")
  receiptId          String?   @map("receipt_id") @db.Uuid
  /// The receipt this claim tied for with another session's claim. Neither
  /// holds it, and a resync of either side keeps the tie.
  contestedReceiptId String?   @map("contested_receipt_id") @db.Uuid
  targetArtifactId   String?   @map("target_artifact_id") @db.Uuid
  observedTarget     String?   @map("observed_target")
  relationshipKind   String    @map("relationship_kind")
  outcome            String
  operationKind      String    @map("operation_kind")
  source             String
  unresolvedReason   String?   @map("unresolved_reason")
  agentId            String?   @map("agent_id")
  invokedAt          DateTime? @map("invoked_at")
  effectiveAt        DateTime? @map("effective_at")
  changedFields      String[]  @default([]) @map("changed_fields")
  versionNumber      Int?      @map("version_number")
  providerCallId     String?   @map("provider_call_id")
  requestFingerprint String?   @map("request_fingerprint")
  anchors            Json      @default("{}")
  extractorVersion   Int       @map("extractor_version")
  policyVersion      Int       @map("policy_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@unique([agentSessionId, claimKey], map: "agent_session_operation_evidence_claim_key")
  // A receipt is bound to at most one claim.
  @@unique([receiptId], map: "agent_session_operation_evidence_receipt_key", where: raw("(receipt_id IS NOT NULL)"))
  // Sync reconciliation finds a tied receipt's other claim by this id.
  @@index([contestedReceiptId], map: "agent_session_operation_evidence_contested_receipt_idx", where: raw("(contested_receipt_id IS NOT NULL)"))
  // Binding at receipt write: the claim waiting on this call id or fingerprint.
  @@index([organizationId, providerCallId], map: "agent_session_operation_evidence_call_id_idx")
  @@index([organizationId, requestFingerprint], map: "agent_session_operation_evidence_fingerprint_idx")
  // The sessions that touched an artifact, for the Related Sessions reads.
  @@index([organizationId, targetArtifactId], map: "agent_session_operation_evidence_target_idx")
  @@map("agent_session_operation_evidence")
}

/// ISS-12552: the last evidence snapshot a session synced, so a resync with
/// the same digest is a no-op and coverage is kept for reporting.
model AgentSessionOperationEvidenceSnapshot {
  agentSessionId     String   @id @map("agent_session_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  digest             String
  extractorVersion   Int      @map("extractor_version")
  coverage           Json
  unparsedClaims     Int      @default(0) @map("unparsed_claims")
  /// ISS-12552: the session's implementationJoin claims, the
  /// Desktop's write-to-commit join summarized per branch (no file paths).
  /// Null when the Desktop predates the join.
  repositoryActivity Json?    @map("repository_activity")
  /// The digest the session's evidence links were last synced for, written
  /// only when the attribution flag answered. While it differs from `digest`
  /// the next sync rebuilds the evidence and syncs the links again.
  linksSyncedDigest  String?  @map("links_synced_digest")
  updatedAt          DateTime @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)

  @@index([organizationId], map: "agent_session_operation_evidence_snapshot_org_idx")
  @@map("agent_session_operation_evidence_snapshots")
}

model ArtifactEvaluation {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  artifactId     String               @map("artifact_id") @db.Uuid
  loopId         String?              @map("loop_id") @db.Uuid @ignore
  reportType     EvaluationReportType @map("report_type")
  reportId       String               @map("report_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  artifact         Artifact          @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  loop             Loop?             @relation(fields: [loopId], references: [id], onDelete: SetNull) @ignore
  judgeScores      JudgeScore[]
  judgeHumanScores JudgeHumanScore[]

  @@unique([artifactId, reportId])
  @@index([artifactId, createdAt])
  @@index([organizationId, createdAt])
  @@map("artifact_evaluations")
}

model JudgeScore {
  id            String     @id @default(uuid(7)) @db.Uuid
  evaluationId  String     @map("evaluation_id") @db.Uuid
  promptId      String?    @map("prompt_id") @db.Uuid
  caseId        String     @map("case_id")
  metricName    String     @map("metric_name")
  threshold     Float
  score         Float
  justification String     @map("justification") @db.Text
  finalStatus   EvalStatus @map("final_status")
  createdAt     DateTime   @default(now()) @map("created_at")

  // Relations
  evaluation       ArtifactEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  prompt           Prompt?            @relation(fields: [promptId], references: [id], onDelete: SetNull)
  judgeHumanScores JudgeHumanScore[]

  @@unique([evaluationId, caseId, metricName])
  @@index([promptId])
  @@map("judge_scores")
}

model JudgeHumanScore {
  id             String   @id @default(uuid(7)) @db.Uuid
  // Denormalized from judgeScore.evaluationId for query performance.
  evaluationId   String   @map("evaluation_id") @db.Uuid
  judgeScoreId   String   @map("judge_score_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  score          Float
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  evaluation   ArtifactEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  judgeScore   JudgeScore         @relation(fields: [judgeScoreId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([judgeScoreId, userId, organizationId])
  @@index([evaluationId])
  @@index([organizationId, userId])
  @@map("judge_human_scores")
}

// Consolidated ratings for any artifact. Absorbs the prior DocumentRating
// and PullRequestRating tables — both now live at @@map("artifact_ratings").
// `artifactVersion` is nullable because PR/deployment ratings aren't
// version-scoped; document ratings keep it populated.
model ArtifactRating {
  id              String   @id @default(uuid(7)) @map("id") @db.Uuid
  artifactId      String   @map("artifact_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  // Score validation (1-5) enforced at API layer via Zod schema.
  score           Int
  comment         String?  @db.VarChar(500)
  artifactVersion Int?     @map("artifact_version")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  artifact     Artifact     @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([artifactId, userId, organizationId])
  @@index([artifactId, organizationId])
  @@map("artifact_ratings")
}

model FileAttachment {
  id          String   @id @default(uuid(7)) @db.Uuid
  artifactId  String?  @map("artifact_id") @db.Uuid
  bucket      String
  key         String
  filename    String
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  purpose     String   @default("context")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by_id") @db.Uuid

  // Storage-reconcile bookkeeping, owned exclusively by
  // `attachmentRowReconcileService` (the DB-row-side orphan sweep). Never read
  // or written by the upload/download/list paths and never mapped into an API
  // response.
  //
  // `reconciledAt` is when the sweep last DETERMINED this row's S3 object state,
  // and it doubles as the sweep's work queue: candidates are taken
  // least-recently-reconciled first, so successive nightly runs walk the whole
  // table instead of rescanning the same prefix forever. It defaults to `now()`
  // rather than a past sentinel so the column stays plain NOT NULL with a
  // Prisma-expressible default; the only cost is that rows already present at
  // migration time share one timestamp and are swept in an arbitrary but stable
  // order over the first few runs.
  //
  // `reconcileAbsent` records whether that determination was "object absent". A
  // row is deletable only when a PREVIOUS run recorded absence here AND the
  // current run observes absence again — two independent observations, so a
  // presigned PUT that was still transferring when the first HeadObject ran is
  // seen to have landed by the second.
  reconciledAt    DateTime @default(now()) @map("reconciled_at")
  reconcileAbsent Boolean  @default(false) @map("reconcile_absent")

  // Relations
  artifact Artifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([artifactId, purpose])
  // Serves the attachment reconcile sweep's `(bucket, key IN (...))` orphan
  // lookup, run once per list page over the whole table. Without it that lookup
  // is a seq-scan that grows unbounded with the table.
  @@index([bucket, key])
  // Serves both phases of the DB-row-side sweep, which partition the table on
  // `reconcileAbsent`: the confirm phase reads
  // `(bucket, reconcileAbsent = true, reconciledAt < runStart)` and the
  // discovery phase reads `(bucket, reconcileAbsent = false, reconciledAt <
  // runStart)`, both ordered by `reconciledAt` — so this one index answers each
  // as an ordered range scan with no sort. `createdAt` stays a heap filter
  // rather than a key column: it excludes only rows inside the 900s upload
  // window, so it removes almost nothing and would not narrow the scan.
  @@index([bucket, reconcileAbsent, reconciledAt])
  @@map("file_attachments")
}

