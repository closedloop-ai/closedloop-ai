// ISS-5826: durable replay receipts for repository-default webhook observations.
// The source-scoped unique key is inserted in the same transaction as the
// authority mutation, so replaying an older delivery after a newer one remains
// a no-op. targetKind/targetId intentionally form a polymorphic app-owned target;
// there is no cross-target foreign key or speculative secondary index.
model RepositoryDefaultObservationReceipt {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  targetKind     String   @map("target_kind") @db.VarChar(64)
  targetId       String   @map("target_id")
  source         String   @db.VarChar(64)
  observationKey String   @map("observation_key")
  observedAt     DateTime @map("observed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "repo_default_observation_receipt_org_fkey")

  @@unique([organizationId, targetKind, targetId, source, observationKey], map: "repo_default_observation_receipt_dedupe_key")
  // ISS-12780: the daily retention sweep deletes by `createdAt`.
  @@index([createdAt])
  @@map("repository_default_observation_receipts")
}

