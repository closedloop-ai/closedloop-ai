  runtimeMs        BigInt?   @map("runtime_ms")
  // When the desktop last recomputed this rollup (distinct from the cloud's own
  // updatedAt bookkeeping below).
  rollupUpdatedAt  DateTime? @map("rollup_updated_at")
  lastSyncedAt     DateTime  @default(now()) @map("last_synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [artifactId], references: [artifactId], onDelete: Cascade)

  @@map("agent_session_usage_rollups")
}

model DesktopCommand {
  id                 String    @id @default(uuid(7)) @db.Uuid
  computeTargetId    String    @map("compute_target_id") @db.Uuid
  idempotencyKey     String?   @map("idempotency_key")
  requestFingerprint String    @map("request_fingerprint")
  operationId        String    @map("operation_id")
  requestPayload     Json      @map("request_payload")
  status             String
  error              String?
  lastSequenceAcked  Int       @default(0) @map("last_sequence_acked")
  queuedTimeoutMs    Int?      @map("queued_timeout_ms")
  runningTimeoutMs   Int?      @map("running_timeout_ms")
  createdAt          DateTime  @default(now()) @map("created_at")
  // When the command ENTERED the queue, which is not when it was created.
  // `requeueUndeliveredCommands` returns an already-acknowledged accepted or
  // running row to `queued` on reconnect and leaves `created_at` alone, so
  // created_at answers "how long since dispatch" and only queued_at answers
  // "how long has this been waiting for an ack" — the question ISS-7223's sweep
  // asks. Nullable rather than backfilled across the whole table: this column is
  // only ever read for `status = 'queued'` rows, and desktop_commands has no
  // retention sweep, so a full-table backfill would rewrite unbounded history to
  // populate a value nothing reads. Live queued rows ARE backfilled.
  queuedAt           DateTime? @default(now()) @map("queued_at")
  // When the target last ANSWERED this command — accepted or rejected, both are
  // an answer. `queued_at` says how long the current delivery has waited; only
  // this says whether any delivery was ever answered at all, which is a
  // different question and the one a retry policy has to ask. A command the
  // target acked, that `requeueUndeliveredCommands` then returned to `queued`,
  // is indistinguishable from one that never arrived unless this is recorded:
  // both are `status = 'queued'` with a fresh `queued_at`. Comparing the two
  // answers it — `acked_at < queued_at` means the answer belongs to an EARLIER
  // delivery, so the work may already have run on the target.
  //
  // No default, unlike `queued_at`: an ack is an event that may never happen,
  // and NULL means NOT KNOWN TO HAVE BEEN ANSWERED — never "known not
  // answered". The migration backfills the live `accepted`/`running` rows,
  // whose state is itself proof the target answered, from their `queued_at`;
  // queued and terminal rows stay NULL, because a queued row's state proves
  // nothing and no retry ever reads a terminal one.
  ackedAt            DateTime? @map("acked_at")
  startedAt          DateTime? @map("started_at")
  finishedAt         DateTime? @map("finished_at")

  computeTarget                      ComputeTarget                       @relation(fields: [computeTargetId], references: [id], onDelete: Cascade)
  events                             DesktopCommandEvent[]
  loopExecutionCredentialConsumption LoopExecutionCredentialConsumption?

  // Command idempotency: at most one row per (target, key) when a key was given.
  @@unique([computeTargetId, idempotencyKey], where: raw("(idempotency_key IS NOT NULL)"))
  @@index([computeTargetId, status, createdAt])
  @@index([operationId])
  // The fleet-wide `status = 'queued'` aggregate. The index above leads on
  // compute_target_id, so that predicate has no usable prefix and would scan
  // every command row ever written — and desktop_commands has no retention
  // sweep, so terminal rows accumulate forever. Partial, so it stays the size
  // of the live backlog rather than of the history.
  //
  // ISS-8453 added it for the five-minute queue-depth sampler's fleet-wide
  // GROUP BY. ISS-8674 moved that read onto `ComputeTarget.queuedCommandCount`,
  // but this index did NOT leave the per-tick path: the same cron's drift
  // detector (`reconcileQueuedCounters`) counts the real queued rows of a
  // bounded sample every tick, and this is what makes that per-target count a
  // seek. It also backs the counter's one-time backfill in migration
  // 20260901120050_iss8674_queued_command_backfill and the one-statement
  // repair documented in migration 20260901120000_iss8674_queued_command_count.
  @@index([computeTargetId], map: "desktop_commands_queued_by_target_idx", where: raw("(status = 'queued'::text)"))
  // ISS-7223's ack-timeout sweep reads a fleet-wide age band over the queued
  // set: `queued_at` between two bounds, ordered by `(queued_at, id)`, LIMIT n.
  // Neither index above can serve it — both lead on compute_target_id, which
  // this read never supplies. Measured at 200k queued rows, the planner did not
  // even fall back to the partial one on its predicate: Parallel Seq Scan of the
  // whole table plus a Sort, 3285 buffers / 24.9ms, before the LIMIT can discard
  // anything, every tick. Leading on queued_at turns that into a range seek that
  // stops after the band, and carrying `id` matches the tiebreak so the ordering
  // needs no sort step — 15 buffers / 0.14ms on the same query.
  @@index([queuedAt, id], map: "desktop_commands_queued_at_idx", where: raw("(status = 'queued'::text)"))
  @@map("desktop_commands")
}

model LoopExecutionCredentialConsumption {
