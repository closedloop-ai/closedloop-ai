model Artifact {
  id             String           @id @default(uuid(7)) @db.Uuid
  // The org SSOT for every artifact type. A detail table copies it only where a
  // constraint cannot span the join (branch_detail, PRD-510 FR13). session_detail
  // does not copy it, by decision: its header records why the Sessions list
  // accepts the parent ⨝ detail join sort (PLN-854, upheld in ISS-9478).
  organizationId String           @map("organization_id") @db.Uuid
  // Nullable for EVERY artifact type — there is no storage-level project
  // requirement (FEA-1749). Whether a given type is *creatable* without a
  // project is decided by the entry points (route validators, the UI, the MCP
  // schemas), not by storage. Any artifact can be filed into a project or
  // cleared from one through `PUT /documents/[id]` and the batch movers
  // (ISS-12858); PRD, IMPLEMENTATION_PLAN and FEATURE creates still require one.
  //
  // A CHECK ("type" = 'SESSION' OR "project_id" IS NOT NULL) used to enforce the
  // old invariant here. It was dropped in
  // 20260715210000_allow_unparented_artifacts_and_retire_templates_sentinel.
  // Note that Prisma does not model CHECK constraints, so a constraint on this
  // table would NOT be visible in this file — check the raw migrations before
  // assuming the column is unconstrained.
  projectId      String?          @map("project_id") @db.Uuid
  type           ArtifactType
  subtype        ArtifactSubtype?
  /// ISS-4532: denormalized mirror of document_detail.template_for_type so the
  /// "one template per (org, type)" invariant is a single-table partial unique
  /// index (restores the index dropped in 20260212212450). Set only for
  /// TEMPLATE artifacts, by the single writer ensureDefaultTemplates.
  templateForType ArtifactSubtype? @map("template_for_type")
  name           String
  slug           String?
  assigneeId     String?          @map("assignee_id") @db.Uuid
  // Freeform per-subtype lifecycle status. Intentionally NOT bound to a DB enum:
  // a single column carries multiple disjoint vocabularies — DocumentStatus
  // (PRD/IMPLEMENTATION_PLAN/TEMPLATE), FeatureStatus (FEATURE), plus the
  // Branch/Deployment/Session vocabularies. The authoritative contracts are the
  // TypeScript SSOTs in @repo/loops-api/document; the DocumentStatus /
  // FeatureStatus enums below are advisory documentation only. See PRD-495.
  status         String
  // ISS-9833: the same nullable no-default contract `Project.priority` now
  // carries. Null is "no priority", a state a user can see and filter, not a
  // stand-in for MEDIUM (ISS-9665).
  priority       Priority?
  dueDate        DateTime?        @map("due_date")
  externalUrl    String?          @map("external_url")
  sortOrder      Int?             @map("sort_order")
  // PRD-726: database-maintained canonical read projection, never a second write API.
  canonicalParentId String?       @map("canonical_parent_id") @db.Uuid @ignore
  hierarchyRank Int?              @map("hierarchy_rank") @ignore
  canonicalChildCount BigInt       @default(0) @map("canonical_child_count") @ignore
  createdAt      DateTime         @default(now()) @map("created_at")
  createdById    String?          @map("created_by_id") @db.Uuid
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  organization              Organization                       @relation(fields: [organizationId], references: [id])
  project                   Project?                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee                  User?                              @relation("ArtifactAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy                 User?                              @relation("ArtifactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  document                  DocumentDetail?
  branch                    BranchDetail?
  pullRequest               PullRequestDetail?
  deployment                DeploymentDetail?
  session                   SessionDetail?
  loopSession               Loop?                              @relation("LoopSessionArtifact")
  branchDeployments         DeploymentDetail[]                 @relation("DeploymentOfBranch")
  pullRequestDetails        PullRequestDetail[]                @relation("BranchPullRequests")
  tenantScopedPullRequestDetails PullRequestDetail[]           @relation("BranchPullRequestTenant")
  branchCommits             CommitDetail[]                     @relation("BranchCommits")
  sourceLinks               ArtifactLink[]                     @relation("ArtifactLinkSource")
  targetLinks               ArtifactLink[]                     @relation("ArtifactLinkTarget")
  customFieldReferences     CustomFieldValueReference[]        @relation("CustomFieldReferenceTarget")
  ratings                   ArtifactRating[]
  evaluations               ArtifactEvaluation[]
  activityEvents            ArtifactActivityEvent[]
  monitoredSessionActivityQuarantines MonitoredSessionActivityQuarantine[]
  commentThreads            CommentThread[]
  fileAttachments           FileAttachment[]
  loops                     Loop[]
  generationStatusDismissal DocumentGenerationStatusDismissal?
  tagArtifacts              TagArtifact[]
  favoritedBy               FavoriteArtifact[]
  linearSubtasks            LinearSubtask[]
  prMaterializationRetries  PrMaterializationRetry[]
  branchMaterializationRetries BranchMaterializationRetry[]
  commentReanchorRequest    CommentReanchorRequest?
  deliveryPointsOnBranch    DeliveryPoint[]                    @relation("DeliveryPointBranch")
  deliveryPointAssociations DeliveryPointArtifact[]

  @@unique([organizationId, slug])
  @@index([organizationId, projectId, type])
  @@index([organizationId, projectId, sortOrder])
  @@index([organizationId, projectId, canonicalParentId, hierarchyRank, createdAt(sort: Desc), id], map: "artifacts_hierarchy_page_idx")
  @@index([organizationId, projectId, type, sortOrder, createdAt(sort: Desc), id], map: "artifacts_hierarchy_type_page_idx")
  @@index([organizationId, projectId, type, subtype, sortOrder, createdAt(sort: Desc), id], map: "artifacts_hierarchy_document_category_page_idx")
  @@index([organizationId, type, status])
  @@index([organizationId, assigneeId])
  // My Tasks assigned-artifact paging (FEA-4373): the bounded list filters on
  // (organizationId, assigneeId) and orders by (createdAt desc, id desc). The
  // filter-only index above can't serve the sort, so offset paging over a large
  // assigned set would scan+sort the whole set; this composite covers the full
  // predicate + order so paging stays index-ordered.
  @@index([organizationId, assigneeId, createdAt(sort: Desc), id(sort: Desc)], map: "artifacts_org_assignee_created_id_idx")
  // ISS-12251: the My Tasks anchor scan (`assignedNonBranchAnchorsSql`), which
  // never anchors on a SESSION. Every synced session carries its Owner as
  // `assigneeId`, so on the index above the scan heap-fetches and discards each
  // of a user's sessions; this partial copy leaves them out. The My Tasks list
  // reads `artifacts_org_assignee_type_created_id_idx` below. The `raw` text is the NORMALIZED
  // predicate `prisma db pull` reports; the migration carries the EXPLAIN.
  @@index([organizationId, assigneeId, createdAt(sort: Desc), id(sort: Desc)], map: "artifacts_org_assignee_created_id_non_session_idx", where: raw("(type <> 'SESSION'::\"ArtifactType\")"))
  // ISS-12657: the STATUS facet on the My Tasks anchor scan. `status` precedes
  // the ordering keys so a selective value is an equality seek plus an ordered
  // range; measured 53,053 -> 509 buffers on a 250k-row assignee.
  @@index([organizationId, assigneeId, status, createdAt(sort: Desc), id(sort: Desc)], map: "artifacts_org_assignee_status_created_id_idx", where: raw("(type <> 'SESSION'::\"ArtifactType\")"))
  // ISS-12657: the PRIORITY facet. Only reachable because the predicate stopped
  // casting the column — `(priority::text)` cannot be indexed at all, the cast
  // being STABLE rather than IMMUTABLE. Measured: parallel seq scan -> 456
  // buffers. A multi-value selection still falls back to the ordered scan.
  @@index([organizationId, assigneeId, priority, createdAt(sort: Desc), id(sort: Desc)], map: "artifacts_org_assignee_priority_created_id_idx", where: raw("(type <> 'SESSION'::\"ArtifactType\")"))
  // ISS-12251: the My Tasks list (`GET /documents?assigneeId=`, type =
  // DOCUMENT, ordered by created_at desc, id desc). Once every session carries
  // its Owner as `assigneeId`, the scan on `artifacts_org_assignee_created_id_idx`
  // heap-fetches and discards each of the user's sessions; the partial index
  // above cannot help when `type` arrives as a bind parameter. `type` in the key
  // keeps the scan on the requested type. The migration carries the EXPLAIN.
  @@index([organizationId, assigneeId, type, createdAt(sort: Desc), id(sort: Desc)], map: "artifacts_org_assignee_type_created_id_idx")
  // My Tasks recency window (FEA-1626): the bounded list can additionally filter
  // on `updatedAt >= cutoff`. The composite above gets Postgres to the right rows
  // by org+assignee, but `updated_at` is not in it, so every one of those rows is
  // then rechecked — the same full scan of the assigned set the window exists to
  // avoid, just with the filter applied after the scan instead of before
  // (tamsinb review). Leading with the window column lets the range scan stop
  // early on a power user's multi-year history.
  @@index([organizationId, assigneeId, updatedAt(sort: Desc)], map: "artifacts_org_assignee_updated_idx")
  @@index([organizationId, createdById])
  // REFERENCE custom-field typeahead (ISS-7804): `searchTargets` pages the
  // candidates a reference field may point at, ordered by (updatedAt desc, id
  // asc) with a bounded `take`. Neither `updatedAt` index above can serve it —
  // both require an `assigneeId` equality this query never supplies — so every
  // shape top-N sorted the whole tenant partition. This bare pair covers the
  // ARTIFACT-sourced arm (no type predicate) and the multi-source `OR` arm,
  // which no type-leading index can serve as an ordered scan.
  @@index([organizationId, updatedAt(sort: Desc), id(sort: Asc)], map: "artifacts_org_updated_id_idx")
  // ISS-7804: the single-source arm (`type = $2 [AND subtype IN (...)]`). Leading
  // with `type` makes the scan proportional to the SELECTED population rather
  // than to the tenant. `subtype` is deliberately absent: it only ever appears as
  // `IN (...)`, and a ScalarArrayOp on a non-final key column cannot return rows
  // pre-sorted by the columns after it, which would hand the sort back.
  @@index([organizationId, type, updatedAt(sort: Desc), id(sort: Asc)], map: "artifacts_org_type_updated_id_idx")
  // ISS-9627: a tenant's artifact ids IN ID ORDER. Every index above puts
  // another column between `organizationId` and `id`, so an org-scoped read that
  // must ALSO emit in `artifact_id` order — the ISS-6892 Sessions keyset walk is
  // the one that matters — had only `artifacts_pkey`, which scans every tenant's
  // rows and demotes the org predicate to a Filter. The migration carries the
  // before/after EXPLAIN.
  @@index([organizationId, id], map: "artifacts_org_id_idx")
  // ISS-10170: the FK TARGET that lets a tenant-denormalizing child row be tied
  // back to its artifact's organization by the database. `id` is already the
  // primary key, so this key is unique by construction and the build can never
  // fail on existing rows; it exists because Postgres requires a unique
  // constraint or index over exactly the referenced columns. Distinct from the
  // ISS-9627 index above, which is NOT unique and so cannot be referenced.
  @@unique([organizationId, id], map: "artifacts_org_id_key")
  // ISS-9776: the Documents ordered read — `organization_id`, `type`, `subtype`,
  // ordered by (created_at DESC, id DESC). No index above carries `subtype`, and
  // none can emit that population in created_at order, so the read was a Bitmap
  // Heap Scan plus a Sort of the whole matching set before any LIMIT applied.
  // PARTIAL on `project_id IS NULL`, and that predicate is load-bearing rather
  // than a size trim: unrestricted, this index leads with the same
  // (organization_id, type, subtype) equality set as ISS-7804's subtype-narrowed
  // reference search, so the planner preferred it there and then had to sort,
  // because this index orders by `created_at` and that query orders by
  // `updated_at`. The Documents read carries `project_id IS NULL` and no
  // reference-search arm does, so the predicate stops the two competing. Since
  // ISS-12858 the org Documents index no longer sends `unassignedProject`, so
  // this index serves only API callers that do; PRD-798 owns the list's access
  // path. The `raw` text is the NORMALIZED predicate `prisma db pull` reports; the
  // migration carries the before/after EXPLAIN.
  @@index([organizationId, type, subtype, createdAt(sort: Desc), id(sort: Desc)], map: "artifacts_org_type_subtype_created_id_idx", where: raw("(project_id IS NULL)"))
  // ISS-4532: one TEMPLATE artifact per (org, subtype); non-template rows leave
  // template_for_type null and are outside the constraint.
  @@unique([organizationId, templateForType], map: "artifacts_org_template_for_type_key", where: raw("(template_for_type IS NOT NULL)"))
  // ISS-8496: the referential action for `artifacts_project_id_fkey`
  // (onDelete: Cascade). Postgres runs it as `project_id = $1` ALONE — it has no
  // organization_id to supply — so neither org-leading composite above can seek
  // it. This index existed once and was lost by accident: it was created as
  // `artifacts_project_id_idx` in 20260203204426, renamed to
  // `documents_project_id_idx` in 20260421120000 when the legacy table vacated
  // the name, and dropped with that table. The parent `artifacts` reclaimed the
  // name in 20260422180000 without it.
  @@index([projectId])
  @@map("artifacts")
}

// Type-specific detail for DOCUMENT-typed artifacts. 1:1 with `Artifact` via
// shared `artifact_id` primary key. Other detail tables (pull_request_detail,
// deployment_detail) arrive in Chunk 2b.
model DocumentDetail {
  artifactId         String           @id @map("artifact_id") @db.Uuid
  fileName           String?          @map("file_name")
  approverId         String?          @map("approver_id") @db.Uuid
  templateForType    ArtifactSubtype? @map("template_for_type")
  latestVersion      Int              @default(1) @map("latest_version")
  repositorySnapshot Json             @map("repository_snapshot")

  artifact Artifact          @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  approver User?             @relation("DocumentDetailApprover", fields: [approverId], references: [id], onDelete: SetNull)
  versions DocumentVersion[]

  @@map("document_detail")
}

// Branch-owned detail for BRANCH-typed artifacts.
model BranchDetail {
  artifactId                    String       @id @map("artifact_id") @db.Uuid
  // Write-once denormalization of the parent Artifact.organizationId (the org
  // SSOT — PRD-510 FR13). Present only because the D2 unique index cannot span
  // the Artifact join; set once at creation from the parent Artifact and never
  // updated independently (guarded by the FR13 invariant test).
  organizationId                String       @map("organization_id") @db.Uuid
  // Installation-repo surrogate id — nullable enrichment only (PRD-510 D2). App
  // repos carry it (webhook/status/file-cache lookups); desktop-produced
  // branches in non-App repos have none. Branch identity keys on
  // repositoryFullName (D2), not this id.
  repositoryId                  String?      @map("repository_id") @db.Uuid
  // Normalized `owner/name` (normalizeRepoFullName) — the producer-independent
  // branch identity component (PRD-510 D2), uniform across desktop sync and the
  // GitHub webhook regardless of whether the App is installed.
  repositoryFullName            String       @map("repository_full_name")
  branchName                    String       @map("branch_name")
  baseBranch                    String?      @map("base_branch")
  baseBranchSource              String?      @map("base_branch_source")
  headSha                       String?      @map("head_sha")
  headShaSource                 String?      @map("head_sha_source")
  headShaObservedAt             DateTime?    @map("head_sha_observed_at")
  // Genuine-activity timestamp for the branch: monotonic GREATEST() of canonical
  // provider events with trustworthy occurrence time — PR open/merge/close,
  // review/comment activity, completed CI checks, and deployment statuses.
  // Push receipt/head observation alone is not an occurrence timestamp. File or
  // checks-cache refreshes and sync bookkeeping never bump it; attributable
  // monitored-Session source events do.
  // Default sort for the Branches list. Nullable for pre-backfill rows; readers
  // fall back to the Artifact createdAt.
  lastActivityAt                DateTime?    @map("last_activity_at")
  lastPushBeforeSha             String?      @map("last_push_before_sha")
  // Explicit set-once push state (PRD-510 FR2, mirroring FEA-2531 Phase C).
  // `firstPushedAt` is the earliest verified push (earliest wins); `pushSource`
  // is `session` | `webhook`. Deliberately NEVER derived from the volatile
  // headShaSource (the stale_push trap) or from row existence (D3: existence
  // means "observed", not "pushed"). Drives the FR12 display predicate.
  firstPushedAt                 DateTime?    @map("first_pushed_at")
  pushSource                    String?      @map("push_source")
  // ISS-10992: durable round-robin backfill claim and last evidence coverage.
  // Historical provider scans may recover people without proving completeness.
  pushCoverageLastAttemptAt     DateTime?    @map("push_coverage_last_attempt_at")
  pushCoverageAvailability      String?      @map("push_coverage_availability") @db.VarChar(32)
  currentPullRequestDetailId    String?      @map("current_pull_request_detail_id") @db.Uuid
  deletedAt                     DateTime?    @map("deleted_at")
  checksStatus                  ChecksStatus @default(UNKNOWN) @map("checks_status")
  checksDetailHeadSha           String?      @map("checks_detail_head_sha")
  checksDetailTotalCount        Int          @default(0) @map("checks_detail_total_count")
  checksDetailTruncated         Boolean      @default(false) @map("checks_detail_truncated")
  checksDetailProviderState     String?      @map("checks_detail_provider_state")
  checksDetailUnavailableReason String?      @map("checks_detail_unavailable_reason")
  checksDetailUpdatedAt         DateTime?    @map("checks_detail_updated_at")
  checkRunRetryState            String?      @map("check_run_retry_state") @db.VarChar(32)
  checkRunRetryHeadSha          String?      @map("check_run_retry_head_sha")
  checkRunRetryResourceId       String?      @map("check_run_retry_resource_id") @db.VarChar(255)
  checkRunRetryIdempotencyKey   String?      @map("check_run_retry_idempotency_key") @db.VarChar(255)
  checkRunRetryAttempts         Int          @default(0) @map("check_run_retry_attempts")
  checkRunRetryNextAt           DateTime?    @map("check_run_retry_next_at")
  checkRunRetryLastAttemptAt    DateTime?    @map("check_run_retry_last_attempt_at")
  checkRunRetryReason           String?      @map("check_run_retry_reason") @db.VarChar(64)
  fileCacheStatus               String       @default("absent") @map("file_cache_status")
  fileCacheHeadSha              String?      @map("file_cache_head_sha")
  fileCacheFileCount            Int          @default(0) @map("file_cache_file_count")
  /// ISS-6127: whether the provider may have withheld files from the cached
  /// comparison. A SECOND axis from `fileCacheStatus`, not a sixth member of it:
  /// a capped read is genuinely `fresh` (fetched, at the current head SHA), and
  /// what is wrong with it is that it is incomplete. Folding the two would make
  /// a capped-and-since-stale cache unrepresentable. Never infer this from
  /// `fileCacheFileCount` — `>= cap` stops being knowable the moment the cap
  /// moves, which is how the defect survived.
  fileCacheCapped               Boolean      @default(false) @map("file_cache_capped")
  fileCachePatchBytes           Int          @default(0) @map("file_cache_patch_bytes")
  fileCacheUpdatedAt            DateTime?    @map("file_cache_updated_at")
  syncStatus                    String       @default("idle") @map("sync_status")
  lastSyncStartedAt             DateTime?    @map("last_sync_started_at")
  lastSyncCompletedAt           DateTime?    @map("last_sync_completed_at")
  lastSyncErrorCode             String?      @map("last_sync_error_code")
  lastSyncErrorMessage          String?      @map("last_sync_error_message") @db.Text
  fetchCredentialType           String?      @map("fetch_credential_type") @db.VarChar(32)
  fetchCredentialOwnerId        String?      @map("fetch_credential_owner_id") @db.Uuid
  fetchMechanism                String?      @map("fetch_mechanism") @db.VarChar(32)
  fetchTrigger                  String?      @map("fetch_trigger") @db.VarChar(32)
  fetchObservedAt               DateTime?    @map("fetch_observed_at")
  fetchResultReason             String?      @map("fetch_result_reason") @db.VarChar(64)
  createdAt                     DateTime     @default(now()) @map("created_at")
  updatedAt                     DateTime     @updatedAt @map("updated_at")

  artifact                 Artifact                        @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  organization             Organization                    @relation(fields: [organizationId], references: [id])
  repository               GitHubInstallationRepository?   @relation(fields: [repositoryId], references: [id])
  currentPullRequestDetail PullRequestDetail?              @relation("CurrentBranchPullRequest", fields: [currentPullRequestDetailId], references: [id], onDelete: SetNull)
  fileChanges              BranchFileChange[]
  statusChecks             BranchStatusCheck[]
  githubCommentProjections GitHubCommentThreadProjection[]
  activityAtoms            BranchActivityAtom[]
  pushContributions        BranchPushContribution[]
  analyticsSessionRollups  BranchAnalyticsSessionRollup[]

  // PRD-510 D2 branch identity: one row per (org, normalized repo full name,
  // branch name) — uniform across producers, independent of App installation.
  // Explicit map: the default name exceeds Postgres's 63-char identifier limit.
  @@unique([organizationId, repositoryFullName, branchName], map: "branch_detail_org_repo_full_name_branch_key")
  // Composite ownership target for organization-scoped activity evidence.
  @@unique([organizationId, artifactId], map: "branch_detail_org_artifact_key")
  // FR12 display predicate: org-scoped scans filtering on push evidence.
  @@index([organizationId, firstPushedAt], map: "branch_detail_org_first_pushed_at_idx")
  @@index([pushCoverageLastAttemptAt, artifactId], map: "branch_detail_push_coverage_round_robin_idx")
  @@index([repositoryId, headSha])
  @@index([headShaSource, lastActivityAt(sort: Desc), artifactId], map: "branch_detail_remote_head_evidence_idx", where: raw("((head_sha IS NOT NULL) AND (deleted_at IS NULL))"))
  @@index([currentPullRequestDetailId])
  @@index([syncStatus])
  @@index([lastActivityAt])
  // Check-run retry idempotency: the key only exists once a retry is in flight,
  // so the constraint is scoped to rows carrying the full retry identity.
  @@unique([artifactId, repositoryId, checkRunRetryHeadSha, checkRunRetryResourceId, checkRunRetryIdempotencyKey], map: "branch_detail_check_run_retry_resource_key_idx", where: raw("((check_run_retry_state IS NOT NULL) AND (check_run_retry_head_sha IS NOT NULL) AND (check_run_retry_resource_id IS NOT NULL) AND (check_run_retry_idempotency_key IS NOT NULL))"))
  @@index([checkRunRetryState, checkRunRetryNextAt], map: "branch_detail_check_run_retry_due_idx")
  @@index([repositoryId, checkRunRetryHeadSha], map: "branch_detail_check_run_retry_repo_head_idx")
  @@map("branch_detail")
}

// ISS-6058: immutable provenance-bearing activity observations. Producers keep
// exact source identity and occurrence/completion time here while continuing to
// advance BranchDetail.lastActivityAt for deployment-skew compatibility.
model BranchActivityAtom {
  id                   String   @id @default(uuid(7)) @db.Uuid
  version              Int
  organizationId       String   @map("organization_id") @db.Uuid
  branchArtifactId     String   @map("branch_artifact_id") @db.Uuid
  source               String   @db.VarChar(128)
  sourceEventId        String   @map("source_event_id") @db.VarChar(512)
  // New writers claim the legacy v1 identity beside a target-qualified v2
  // row so an old binary replay cannot create a second semantic atom. Alias
  // rows are excluded from canonical reads and aggregate/metric population.
  compatibilityAliasForSourceEventId String? @map("compatibility_alias_for_source_event_id") @db.VarChar(512)
  occurredAt           DateTime @map("occurred_at")
  activityKind         String?  @map("activity_kind") @db.VarChar(32)
  attributionKind      String   @map("attribution_kind") @db.VarChar(32)
  pullRequestDetailId  String?  @map("pull_request_detail_id") @db.Uuid
  completeness         String   @db.VarChar(32)
  createdAt            DateTime @default(now()) @map("created_at")
  // ISS-10009: per-push evidence, written only by the `push_loc` source lane.
  // The shas bound the range the delta describes; the counts stay NULL whenever
  // the provider compare was capped, truncated, or failed, because a short sum
  // reads as a confident measurement. No consumer reads them until part 2.
  beforeSha            String?  @map("before_sha") @db.VarChar(64)
  afterSha             String?  @map("after_sha") @db.VarChar(64)
  linesAdded           Int?     @map("lines_added")
  linesRemoved         Int?     @map("lines_removed")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "branch_activity_atoms_organization_fkey")
  branch            BranchDetail       @relation(fields: [organizationId, branchArtifactId], references: [organizationId, artifactId], onDelete: Cascade, map: "branch_activity_atoms_branch_fkey")
  pullRequestDetail PullRequestDetail? @relation(fields: [organizationId, pullRequestDetailId], references: [organizationId, id], onDelete: Cascade, map: "branch_activity_atoms_pull_request_fkey")

  @@unique([organizationId, branchArtifactId, source, sourceEventId], map: "branch_activity_atoms_dedupe_key")
  @@index([organizationId, branchArtifactId, occurredAt(sort: Desc), source, sourceEventId], map: "branch_activity_atoms_latest_idx")
  // ISS-10009 part 2: the push-LOC cohort read seeks `(organizationId,
  // branchArtifactId, source)` before the server write clock. This supports a
  // selective seek, NOT the multi-branch query's global createdAt/sourceEventId
  // ordering: that still sorts, and broad cohorts may choose a sequential scan.
  @@index([organizationId, branchArtifactId, source, createdAt(sort: Desc)], map: "branch_activity_atoms_source_created_idx")
  @@map("branch_activity_atoms")
}

// ISS-10992: actor-attributed successful Branch push evidence, independent of
// push_loc metrics, which can omit a push when commit time is unavailable.
model BranchPushContribution {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  branchArtifactId   String   @map("branch_artifact_id") @db.Uuid
  repositoryFullName String   @map("repository_full_name")
  refName            String   @map("ref_name")
  beforeSha          String   @map("before_sha") @db.VarChar(64)
  afterSha           String   @map("after_sha") @db.VarChar(64)
  source             String   @db.VarChar(32)
  sourceEventId      String   @map("source_event_id") @db.VarChar(255)
  providerUserId     String   @map("provider_user_id")
  actorType          String   @map("actor_type") @db.VarChar(32)
  observedAt         DateTime @default(now()) @map("observed_at")
  createdAt          DateTime @default(now()) @map("created_at")

  branch BranchDetail @relation(fields: [organizationId, branchArtifactId], references: [organizationId, artifactId], onDelete: Cascade, map: "branch_push_contributions_branch_fkey")

  @@unique([organizationId, branchArtifactId, source, sourceEventId], map: "branch_push_contributions_dedupe_key")
  @@index([organizationId, branchArtifactId, repositoryFullName, refName, observedAt, id], map: "branch_push_contributions_current_ref_history_idx")
  @@map("branch_push_contributions")
}

/// Internal Branch analytics token/cost projection. Public Branch responses do
/// not expose this row or its freshness metadata; readers either use a complete
/// fresh projection or fall back to the canonical live token-event aggregate.
model BranchAnalyticsSessionRollup {
  id                        String   @id @default(uuid(7)) @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  branchArtifactId          String   @map("branch_artifact_id") @db.Uuid
  sessionArtifactId         String   @map("session_artifact_id") @db.Uuid
  branchParticipation       String   @map("branch_participation") @db.VarChar(32)
  branchParticipationMethod String?  @map("branch_participation_method")
  source                    String   @db.VarChar(64)
  bucketStart               DateTime @map("bucket_start")
  bucketEnd                 DateTime @map("bucket_end")
  inputTokens               BigInt   @default(0) @map("input_tokens")
  outputTokens              BigInt   @default(0) @map("output_tokens")
  cacheReadTokens           BigInt   @default(0) @map("cache_read_tokens")
  cacheWriteTokens          BigInt   @default(0) @map("cache_write_tokens")
  estimatedCost             Decimal? @map("estimated_cost") @db.Decimal(14, 6)
  minInputTokens            BigInt?  @map("min_input_tokens")
  minOutputTokens           BigInt?  @map("min_output_tokens")
  minCacheReadTokens        BigInt?  @map("min_cache_read_tokens")
  minCacheWriteTokens       BigInt?  @map("min_cache_write_tokens")
  minEstimatedCost          Decimal? @map("min_estimated_cost") @db.Decimal(14, 6)
  estimatedCostEventCount   Int      @default(0) @map("estimated_cost_event_count")
  eventCount                Int      @default(0) @map("event_count")
  sourceMinEventCreatedAt   DateTime @map("source_min_event_created_at")
  sourceMaxEventCreatedAt   DateTime @map("source_max_event_created_at")
  asOf                      DateTime @map("as_of")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       BranchDetail  @relation(fields: [organizationId, branchArtifactId], references: [organizationId, artifactId], onDelete: Cascade, map: "branch_analytics_session_rollups_branch_fkey")
  session      SessionDetail @relation(fields: [sessionArtifactId], references: [artifactId], onDelete: Cascade)

  @@unique([organizationId, branchArtifactId, sessionArtifactId, branchParticipation, source, bucketStart], map: "branch_analytics_session_rollups_identity_key")
  @@index([organizationId, sessionArtifactId, source, bucketStart], map: "branch_analytics_session_rollups_session_bucket_idx")
  @@index([organizationId, branchArtifactId, bucketStart], map: "branch_analytics_session_rollups_branch_bucket_idx")
  @@index([sessionArtifactId], map: "branch_analytics_session_rollups_session_artifact_id_idx")
  @@index([organizationId, sourceMaxEventCreatedAt], map: "branch_analytics_session_rollups_source_watermark_idx")
  @@index([organizationId, source, asOf], map: "branch_analytics_session_rollups_org_source_as_of_idx")
  @@map("branch_analytics_session_rollups")
}

/// Internal freshness and resumable backfill state for the Branch analytics
/// projection. This is observability/control-plane data, never user-facing copy.
model BranchAnalyticsRollupState {
  organizationId                    String    @id @map("organization_id") @db.Uuid
  state                             String    @default("pending") @db.VarChar(32)
  sourceWatermarkEventCreatedAt     DateTime? @map("source_watermark_event_created_at")
  materializedThroughEventCreatedAt DateTime? @map("materialized_through_event_created_at")
  asOf                              DateTime? @map("as_of")
  lagSeconds                        Int?      @map("lag_seconds")
  backfillCursorCreatedAt           DateTime? @map("backfill_cursor_created_at")
  backfillCursorEventId             String?   @map("backfill_cursor_event_id") @db.Uuid
  backfillCompletedAt               DateTime? @map("backfill_completed_at")
  lastBackfillStartedAt             DateTime? @map("last_backfill_started_at")
  lastBackfillCompletedAt           DateTime? @map("last_backfill_completed_at")
  lastErrorAt                       DateTime? @map("last_error_at")
  lastErrorCode                     String?   @map("last_error_code") @db.VarChar(64)
  reconciledThroughAt               DateTime? @map("reconciled_through_at") @db.Timestamptz
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([state, materializedThroughEventCreatedAt], map: "branch_analytics_rollup_states_due_idx")
  @@map("branch_analytics_rollup_states")
}

// Durable first-receive anchors for monitored activity rejected as future
