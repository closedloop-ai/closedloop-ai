// =============================================================================
// AGENT COMPONENT INVENTORY + USAGE (FEA-2923 / T-6.1, T-6.2)
// Two independent representations — never conflate. See reconciled-decisions.md.
// =============================================================================

/// F1 (FEA-3290 / PRD-527) — the typed provenance of a DefinitionVersion: the
/// kind of place an exact definition was observed. `repository` (owner/repo ·
/// path · commit), `local` (device · path), or `pack` (membership carrying that
/// exact version). Never collapsed into a singular parent; never merged on a
/// shared name. Determines which evidence columns on SourceOccurrence are
/// populated (repo* / local* / packId).
enum SourceOccurrenceType {
  repository
  local
  pack
  // FEA-3982 (Slice 1 / concern D): provenance kinds beyond the FEA-3290 trio.
  // `static_file` = a checked-in loose definition file that is not a repo scan
  // (e.g. a distributed standalone `.md`); `distributed` = pushed via a
  // distribution rather than installed from a pack; `builtin_claude` /
  // `builtin_codex` = shipped inside the harness binary, not authored locally.
  // Additive/skew-safe: existing rows keep their values, and a reader that does
  // not know a new value degrades it to `local` (see the type mirror). Member
  // names are already the exact SQL literals, so no `@map` is needed.
  static_file
  distributed
  builtin_claude
  builtin_codex

  @@map("source_occurrence_type")
}

/// F1 (FEA-3290) — whether a source occurrence's definition body was readable
/// at capture. `inaccessible` (permission-denied) is deliberately DISTINCT from
/// a deleted/absent occurrence (AC-5): last-known-good is preserved, and an
/// inaccessible private body is never conflated with "missing".
enum SourceAccessState {
  accessible
  inaccessible

  @@map("source_access_state")
}

/// F1 (FEA-3290) — the honest resolution state of an inventory component
/// (AC-7 / AC-020). `unresolved` gates name-only / label-minted rows out of
/// "configured component"; `inaccessible` (permission-denied) is DISTINCT from
/// `missing` (deleted/absent). Legacy rows default to `unresolved`. NOTE: the
/// derivation logic that TRANSITIONS a row between these states is Slice 4 —
/// this slice only introduces the column + the `unresolved` default.
enum ComponentResolvedState {
  resolved
  unresolved
  inaccessible
  missing

  @@map("component_resolved_state")
}

/// Inventory / Existence registry — one deduped row per distinct component
/// per compute target. Org-visible via org ↔ computeTarget join; org-scoped
/// reads filter through computeTarget.organizationId. Populated by event-driven
/// discovery (upsert-on-observe), synced desktop→api.
model AgentComponent {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  computeTargetId     String                 @map("compute_target_id") @db.Uuid
  componentKind       String                 @map("component_kind")
  externalComponentId String                 @map("external_component_id")
  harness             String?
  name                String?
  componentKey        String?                @map("component_key")
  version             String?
  description         String?
  sourceUrl           String?                @map("source_url")
  installPath         String?                @map("install_path")
  packId              String?                @map("pack_id")
  scope               String?
  projectPath         String?                @map("project_path")
  metadata            Json?
  // F1 (FEA-3290 / AC-7 / AC-020): honest resolution state. Legacy + label-minted
  // rows default to `unresolved`; the derivation that promotes to `resolved` /
  // flags `inaccessible` vs `missing` lands in Slice 4. This slice adds the
  // column + default only (no writer/derivation).
  resolvedState       ComponentResolvedState @default(unresolved) @map("resolved_state")
  // Definition file text + its sha256 (FEA-2923 content pipeline). Synced from
  // desktop, deduped by hash; backs the detail Prompt panel and (later) the
  // content-hash version history. Nullable: event-driven components with no
  // discoverable definition file carry null.
  content             String?                @db.Text
  contentHash         String?                @map("content_hash")
  // ISS-5029: true when the desktop packer dropped retained revisions of this
  // identity at its per-family entry cap or per-component variant byte budget,
  // so `agent_component_versions` holds a KNOWN-partial history for it. Written
  // on every sync from the marker the packer sets where the cap binds; a desktop
  // that predates the marker omits it and the writer stores false ("no evidence
  // of truncation" — today's behaviour). NOT NULL with a false default so no
  // existing row becomes nullable or has to be backfilled.
  variantsTruncated   Boolean                @default(false) @map("variants_truncated")
  // ISS-5029 (whitlockk, #4391): WHICH cap bound — `family_cap` (the packer's
  // per-family candidate/entry cap, which only binds when the family holds more
  // revisions than one sync can carry) or `byte_budget` (which can bind at two
  // revisions and bounds nothing). The detail read can only PROVE the cloud is
  // missing a revision from the former, so the two must not be stored as one
  // undifferentiated boolean. Nullable: null means "truncated, reason unknown"
  // or "not truncated", and both read as no proof. Stored verbatim so a reason a
  // newer desktop introduces survives until this side learns it.
  variantsTruncatedReason String?            @map("variants_truncated_reason")
  firstSeenAt         DateTime?              @map("first_seen_at")
  lastSeenAt          DateTime?              @map("last_seen_at")
  uninstalledAt       DateTime?              @map("uninstalled_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  organization  Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  computeTarget ComputeTarget                @relation(fields: [computeTargetId], references: [id], onDelete: Cascade)
  sessionUsages AgentComponentSessionUsage[]
  invocations   AgentComponentInvocation[]

  // Primary dedup key: one row per (device, kind, external component id).
  @@unique([computeTargetId, componentKind, externalComponentId])
  @@index([organizationId, componentKind])
  @@index([organizationId])
  // FEA-4335: content-hash detail routing resolves the inventory identity by
  // (org, kind, content_hash) (`resolveInventoryContentIdentity` + the detail
  // inventory read), so index that path instead of scanning the whole same-kind
  // slice for the hash. Explicit name (Prisma's default exceeds Postgres's 63-char
  // identifier limit).
  @@index([organizationId, componentKind, contentHash], map: "agent_components_org_kind_content_hash_idx")
  // ISS-6104: the plugin child-inventory join (`loadChildInventoryJoin`,
  // apps/api/app/agent-components/plugin-child-usage.ts) filters
  // `organization_id = ? AND pack_id IN (…)`, which nothing here covered — it
  // walked the whole org partition to return zero. `getPackAnalytics`
  // (apps/api/app/agent-components/pack-analytics-service.ts) reads the scalar
  // form of the same predicate and is served by it too. Partial because every
  // child row's `pack_id` is NULL today (see ISS-6094), which keeps the index
  // near-empty and off the component-sync write path until linkage lands; the
  // migration (20260812120000, built CONCURRENTLY) carries the measured
  // before/after plans.
  @@index([organizationId, packId], map: "agent_components_org_pack_id_idx", where: raw("(pack_id IS NOT NULL)"))
  @@map("agent_components")
}

/// FEA-2923 content-hash version history (org-scoped mirror of the desktop
/// `agent_component_versions`). One row per distinct definition revision, keyed
/// by (org, component, source, content_hash) — NOT the invoking owner. Synced
/// from desktop deduped by hash; backs the detail Prompt panel's version
/// selector. The current revision is the one whose contentHash matches the live
/// AgentComponent row.
model AgentComponentVersion {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  componentKind       String    @map("component_kind")
  componentKey        String    @map("component_key")
  source              String    @default("")
  contentHash         String    @map("content_hash")
  content             String    @db.Text
  format              String?
  // F1 link (FEA-3290): the exact DefinitionVersion this coarse content-hash
  // revision maps to. Nullable (backfilled in Slice 5; no writer here). SetNull
  // so a purged version never orphans the coarse row.
  definitionVersionId String?   @map("definition_version_id") @db.Uuid
  // ISS-4965 (Perrin, 2026-10-05): the usage-space digest of the definition
  // AS WRITTEN, set only when the stored `content` was secret-redacted. Usage
  // rows carry the raw-content digest, so reads prefer this column over
  // re-deriving it from the redacted body. NULL: `content` is the raw body.
  usageScopeHash      String?   @map("usage_scope_hash")
  firstSeenAt         DateTime? @map("first_seen_at")
  lastSeenAt          DateTime? @map("last_seen_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definitionVersion DefinitionVersion? @relation(fields: [definitionVersionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, componentKind, componentKey, source, contentHash])
  @@index([organizationId, componentKind, componentKey])
  @@index([definitionVersionId])
  // FEA-4335: content-hash detail/trend routing resolves the name-level identity
  // by (org, kind, content_hash) (`resolveContentHashIdentity`'s coarse fallback),
  // which the leading (org, kind, componentKey) index cannot serve without the
  // key. Index the coarse-hash lookup path directly. Explicit name (Prisma's
  // default exceeds Postgres's 63-char identifier limit).
  @@index([organizationId, componentKind, contentHash], map: "agent_component_versions_org_kind_content_hash_idx")
  @@map("agent_component_versions")
}

/// Usage / Invocation stats — per session × component key. No organizationId:
/// org isolation is enforced through SessionDetail → Artifact.organizationId
/// (D4 decision, same precedent as AgentSessionTokenEvent). Independent from
/// AgentComponent existence: either can exist without the other.
model AgentComponentSessionUsage {
  id                     String    @id @default(uuid(7)) @db.Uuid
  agentSessionId         String    @map("agent_session_id") @db.Uuid
  componentKind          String    @map("component_kind")
  componentKey           String    @map("component_key")
  // ISS-6756: the case/whitespace-folded form of `component_key`, persisted so
  // the org-scoped identity reads can match with an INDEXABLE `=` instead of the
  // `ILIKE` Prisma emits for `mode: "insensitive"`. No btree — not even a
  // `LOWER(component_key)` expression index — can serve an `ILIKE` predicate, so
  // the value has to be a real column. DERIVED BY THE DATABASE, never by the
  // application: migration 20260820120000 installs a BEFORE INSERT/UPDATE trigger
  // that overwrites whatever a writer supplies with `lower(btrim(component_key))`.
  // That keeps the fold correct for rows a pre-deploy writer inserts mid rolling
  // deploy, and keeps the backfilled and the newly-written rows on ONE definition.
  // The `@default("")` exists only so Prisma's `create()` typing does not demand a
  // value the trigger is going to discard; a persisted `''` is unreachable because
  // the trigger runs before the row lands.
  componentKeyNormalized String    @default("") @map("component_key_normalized")
  // FEA-2990: the git branch this usage bucket ran on, from per-event
  // `events.git_branch` on the desktop. Empty string '' is the "no per-event
  // branch" sentinel (Codex, legacy pre-column events, non-tool kinds); those
  // rows fall back to session-level SessionBranch attribution. Part of the
  // natural key so a session that switched branches mid-run persists one row
  // per (component, branch). Defaulted to '' so older desktop builds that omit
  // the field upsert into the single session-level bucket exactly as before.
  gitBranch              String    @default("") @map("git_branch")
  // Nullable: usage can be recorded before the inventory row exists (e.g. built-in
  // tools), or inventory sync may not have run yet.
  agentComponentId       String?   @map("agent_component_id") @db.Uuid
  harness                String?
  invocationCount        Int       @default(0) @map("invocation_count")
  errorCount             Int       @default(0) @map("error_count")
  // FEA-2923: the component's content hash when this usage was recorded
  // (hash-at-invocation), synced from desktop. Null when unknown.
  componentVersionHash   String?   @map("component_version_hash")
  // ISS-7259: this row is the session's FIRST ATTRIBUTED SKILL, as the harness
  // stamped it — NOT a claim that the skill launched the session. Claude stamps
  // `attributionSkill` per assistant turn and never marks a launch, so a column
  // named for a launch would invite a rollup the value cannot support. A FLAG on
  // the existing usage row rather than a row of its own, so one skill is never
  // counted as both an invocation and an attribution.
  //
  // Only TRUE or NULL is ever written: the wire omits the field for a row that
  // is not the attributed skill, so an absent value covers both "an older
  // desktop never sent it" and "a current desktop sent it and this row is not
  // the one". Those are indistinguishable here and NULL says so honestly;
  // consumers filter on `= true`, where NULL and FALSE behave alike.
  isFirstAttributedSkill Boolean?  @map("is_first_attributed_skill")
  // F1 link (FEA-3290): the exact DefinitionVersion the session ran against
  // (hash-at-invocation resolved to a fingerprint). Nullable (backfilled in
  // Slice 5; no writer here). SetNull so a purged version never orphans usage.
  definitionVersionId    String?   @map("definition_version_id") @db.Uuid
  // FEA-3981 (PLN-1488) NOTE: per-model/token/cost telemetry lives on the
  // per-INVOCATION grain (AgentComponentInvocation), NOT here. This table is
  // keyed on (session, kind, key, git_branch), so a subagent that ran under
  // BOTH opus and sonnet in one session/branch collapses into ONE row — a
  // scalar `model` here cannot represent "mixed". The component-level rollup
  // (tokens/cost sum, model SET) is DERIVED by aggregating the invocation rows
  // (Slice D read), so mixed-model stays representable. See the invocation
  // model below for the additive telemetry columns.
  firstInvokedAt         DateTime? @map("first_invoked_at")
  lastInvokedAt          DateTime? @map("last_invoked_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  session           SessionDetail      @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade)
  agentComponent    AgentComponent?    @relation(fields: [agentComponentId], references: [id], onDelete: SetNull)
  definitionVersion DefinitionVersion? @relation(fields: [definitionVersionId], references: [id], onDelete: SetNull)

  @@unique([agentSessionId, componentKind, componentKey, gitBranch], map: "idx_acsu_session_kind_key_branch")
  @@index([agentComponentId])
  @@index([definitionVersionId])
  @@index([agentSessionId, componentKind])
  // FEA-3160: the Agents-workspace time window filters usage on
  // `last_invoked_at >= startDate`. The nested `sessionUsages` read scopes by
  // last_invoked_at alone, so a plain index serves that range predicate…
  @@index([lastInvokedAt])
  // …while the org-scoped child-usage rollup and orphan-usage reads filter
  // `component_kind IN (...)` together with the same range, so a composite
  // (component_kind, last_invoked_at) serves those without a full scan.
  @@index([componentKind, lastInvokedAt])
  // ISS-6756: the org-scoped identity reads (`fetchTokenTrendUsageRows`,
  // `detailOrphanUsageWhere`) bind neither `agent_component_id` nor
  // `agent_session_id`, so before this index they narrowed only to the same-kind
  // partition ACROSS ALL TENANTS — org arrives through the `session.artifact`
  // join, not a column here — and discarded the rest with a post-scan filter.
  // Built CONCURRENTLY by migration 20260820120200, not by this declaration.
  @@index([componentKind, componentKeyNormalized], map: "agent_component_session_usage_kind_key_norm_idx")
  // ISS-10815: the detail route's usage-fingerprint resolution
  // (`resolveUsageContentIdentity`) groups BY `component_key_normalized`, so
  // that column is the value it solves for and the index above cannot serve it —
  // it binds `component_version_hash` instead, which carried no index at all and
  // so left the read on the cross-tenant `component_kind` prefix.
  // Built CONCURRENTLY by migration 20260921190000, not by this declaration.
  @@index([componentKind, componentVersionHash], map: "agent_component_session_usage_kind_version_hash_idx")
  @@map("agent_component_session_usage")
}

// =============================================================================
// F1 DEFINITION SOURCE + VERSION REGISTRY (FEA-3290 / PRD-527)
// The registry of *what each component is* (provenance-FREE exact version
// identity) and *everywhere its exact definition has been seen* (typed source
// occurrences). PD4: identity, provenance, membership, install, usage are
// SEPARATE contracts. PD5: fingerprint = normalized content + kind; EXCLUDES
// provenance. This slice (Slice 2 of 6) delivers the SCHEMA + migration ONLY —
// writers (Slice 3), resolution derivation (Slice 4), backfill (Slice 5), and
// read surface (Slice 6) are separate PRs and are NOT in this migration.
//
// OQ1 divergence (Marisol-approved): a NEW `DefinitionVersion` table keyed on
// Slice-1's provenance-free `definitionHash` + `normalizerContractVersion`,
// rather than extending the legacy `AgentComponentVersion` (whose natural key
// conflates version-identity with where-observed via `source`, and which has no
// contract-version column). `AgentComponentVersion` is kept intact and gains a
// nullable link column instead. See the PR body for the full rationale.
// =============================================================================

/// F1 exact-definition version registry (FEA-3290 / PRD-527). One row per
/// distinct provenance-FREE fingerprint (`definitionHash`, Slice-1 contract) per
/// org — the authoritative "which exact version" identity (fact-2), as opposed
/// to the coarse `componentUuid` (fact-1) and the legacy raw-sha256
/// `AgentComponentVersion` (FEA-2923). `definitionHash` is produced ONLY by
/// `computeDefinitionHash` in `@repo/api/src/definition-fingerprint` (Slice 1);
/// never recomputed here. `normalizerContractVersion` is stored so a stored hash
/// is never reinterpreted under a later rule set (a bump yields a new hash
/// space, so it can never collide within the same hash → NOT in the unique key).
model DefinitionVersion {
  id                        String   @id @default(uuid(7)) @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  /// The component kind this version's bytes were fingerprinted under. Kind is
  /// already folded into `definitionHash`, so this is denormalized for
  /// filtering/reads, NOT part of the uniqueness key.
  componentKind             String   @map("component_kind")
  /// Slice-1 provenance-free SHA-256 fingerprint (64 lowercase hex). Version id.
  definitionHash            String   @map("definition_hash")
  /// NORMALIZER_CONTRACT_VERSION under which `definitionHash` was produced.
  normalizerContractVersion Int      @map("normalizer_contract_version")
  /// Exact definition text this version fingerprints (the Prompt-panel content).
  content                   String   @db.Text
  /// Source format (md, json, yml, …) at first observation; null when unknown.
  format                    String?
  firstSeenAt               DateTime @default(now()) @map("first_seen_at")
  lastSeenAt                DateTime @default(now()) @map("last_seen_at")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceOccurrences    SourceOccurrence[]
  componentVersions    AgentComponentVersion[]
  sessionUsages        AgentComponentSessionUsage[]
  invocations          AgentComponentInvocation[]
  catalogItemVersions  CatalogItemVersion[]
  editors              DefinitionVersionEditor[]

  /// One row per exact fingerprint per org. `definitionHash` alone is exact
  /// within an org (kind folded in); no componentUuid in the key by design.
  @@unique([organizationId, definitionHash])
  @@index([organizationId, componentKind])
  @@map("definition_versions")
}

/// FEA-3982 (Marisol-approved edit-lineage capture) — WHO created or edited a given
/// exact `DefinitionVersion` fingerprint. `DefinitionVersion` intentionally has
/// no author column (identity is provenance-free bytes); this join table records
/// the multi-editor lineage that backs the future "Collaborators (authors)"
/// column (discoverer + everyone who authored/edited that exact hash). One row
/// per (version, user); the earliest `firstEditedAt` across an org's version rows
/// is the discoverer, later distinct users are additional editors.
///
/// A "version edit" is observing/synced/authoring the exact bytes: because the
/// fingerprint is provenance-free, two users who independently produce the SAME
/// bytes are BOTH authors of that one version (collaboration on identical
/// content), while a byte-different edit produces a NEW `DefinitionVersion` with
/// its own lineage. Org-scoped through the parent version; `role` distinguishes
/// the first observer (`discoverer`) from later `editor`s for display without a
/// second scan.
model DefinitionVersionEditor {
  id                  String                        @id @default(uuid(7)) @db.Uuid
  definitionVersionId String                        @map("definition_version_id") @db.Uuid
  userId              String                        @map("user_id") @db.Uuid
  /// Reserved: always `editor` today. No writer sets `discoverer` — the
  /// discoverer (first observer of this hash in the org) is DERIVED at read time
  /// as `min(firstEditedAt)`, so `role` is not populated with `discoverer` yet.
  /// Kept as a column so a future writer can distinguish the two without a
  /// schema change; the `discoverer` enum value exists for that forward use.
  role                DefinitionVersionEditorRole   @default(editor)
  firstEditedAt       DateTime                      @default(now()) @map("first_edited_at")
  lastEditedAt        DateTime                      @default(now()) @map("last_edited_at")
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")

  definitionVersion DefinitionVersion @relation(fields: [definitionVersionId], references: [id], onDelete: Cascade)
  user              User              @relation("DefinitionVersionEditor", fields: [userId], references: [id], onDelete: Cascade)

  /// One lineage row per (version, user); a re-observation bumps `lastEditedAt`.
  @@unique([definitionVersionId, userId])
  @@index([userId])
  @@map("definition_version_editors")
}

/// FEA-3982 — a version editor's role. `discoverer` = the first user observed to
/// carry this exact hash in the org (the original author from the read surface's
/// point of view); `editor` = any later distinct user who authored/observed the
/// same bytes. Additive/skew-safe.
enum DefinitionVersionEditorRole {
  discoverer
  editor

  @@map("definition_version_editor_role")
}

/// F1 provenance join (FEA-3290): "this exact DefinitionVersion was observed at
/// this source/device/path at this time." Many occurrences per version. Never
/// affects version identity — provenance is deliberately EXCLUDED from
/// `definitionHash` (PD5). Typed by `occurrenceType`: `repository` populates the
/// repo* columns, `local` the local* columns, `pack` the packId — the other
/// evidence columns stay null for that type. Org-scoped; compute target nullable
/// (SetNull) because a version can be observed from non-device sources (repo
/// scan, pack) or after a target is deleted.
model SourceOccurrence {
  id                  String               @id @default(uuid(7)) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  definitionVersionId String               @map("definition_version_id") @db.Uuid
  occurrenceType      SourceOccurrenceType @map("occurrence_type")
  /// Whether the body was readable at capture (AC-5). `inaccessible`
  /// (permission-denied) is distinct from a deleted/absent occurrence.
  accessState         SourceAccessState    @default(accessible) @map("access_state")

  // --- repository evidence (occurrenceType = repository) ---
  /// `owner/repo` full name.
  repoFullName String? @map("repo_full_name")
  /// Path to the definition within the repo.
  repoPath     String? @map("repo_path")
  /// Commit sha the definition was observed at.
  repoCommit   String? @map("repo_commit")

  // --- local evidence (occurrenceType = local) ---
  /// The compute target the occurrence was observed on, when known.
  computeTargetId String? @map("compute_target_id") @db.Uuid
  /// Filesystem path the definition was read from on that target.
  localPath       String? @map("local_path")

  // --- pack evidence (occurrenceType = pack) ---
  /// The pack whose membership carries this exact version (F4 boundary; a plain
  /// nullable id here, no FK — pack identity/lifecycle is owned by F4).
  packId String? @map("pack_id")

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definitionVersion DefinitionVersion          @relation(fields: [definitionVersionId], references: [id], onDelete: Cascade)
  computeTarget     ComputeTarget?             @relation(fields: [computeTargetId], references: [id], onDelete: SetNull)
  invocations       AgentComponentInvocation[]

  /// One row per distinct provenance an exact version was seen at, so an
  /// idempotent rescan upserts rather than duplicates (AC-6). The evidence
  /// natural-key participants (repoFullName/repoPath/repoCommit,
  /// computeTargetId/localPath, packId) are coalesced to '' by the writer
  /// (Slice 3) before hitting this key. CAVEAT (documented in the migration):
  /// Postgres treats NULL as DISTINCT in a unique index, so two rows with NULL
  /// key parts would NOT collide — the writer therefore never passes NULL into
  /// the key participants (coalesces to '' / drives NULL-target dedupe through
  /// the application upsert). Provenance is descriptive, not identity-bearing,
  /// so a residual duplicate never corrupts version identity.
  @@unique([definitionVersionId, occurrenceType, repoFullName, repoPath, repoCommit, computeTargetId, localPath, packId], map: "idx_source_occurrence_natural_key")
  // FEA-3909: the null-target family (a `pack` occurrence; a future repo scan)
  // needs its own NULL-safe unique key so the writer can do an atomic
  // INSERT … ON CONFLICT instead of a racy find-then-create — the full key above
  // cannot arbitrate because Postgres treats a NULL compute_target_id as
  // DISTINCT. A sibling EXPRESSION index (idx_source_occurrence_null_target_natural_key,
  // COALESCE-folded) covers the same family and stays in migration SQL only,
  // since PSL cannot express an expression index.
  @@unique([definitionVersionId, occurrenceType, repoFullName, repoPath, repoCommit, localPath, packId], map: "idx_source_occurrence_null_target_key", where: raw("(compute_target_id IS NULL)"))
  @@index([organizationId, definitionVersionId])
  @@index([computeTargetId])
  @@map("source_occurrences")
}

// =============================================================================
// CATALOG + DISTRIBUTION PLATFORM (FEA-2923 / T-14.1–T-14.4, T-21.1)
// Admin-authored / curated distributable definitions and distribution tracking.
// =============================================================================

/// A distributable definition of any component kind (plugin, skill, command,
/// agent, hook, mcp). Source: org_custom (admin-uploaded, org-private),
/// curated (ClosedLoop best-practice, global, read-only), or marketplace
/// (future; leave hooks). organizationId is null for global/curated items.
///
/// Legacy Agent supersede (T-21.1): legacyAgentId traces migration provenance.
/// sourceRepo + role are preserved for Agent bootstrap idempotency (the
/// @@unique([organizationId, sourceRepo, role]) below mirrors Agent's constraint
/// for targetKind='agent' rows, scoped by a WHERE target_kind = 'agent' predicate
/// so non-agent items are outside it).
/// See migration: add_agent_component_and_catalog_distribution.
model CatalogItem {
  id                     String   @id @default(uuid(7)) @db.Uuid
  // Nullable for global/curated scope items (organizationId IS NULL).
  organizationId         String?  @map("organization_id") @db.Uuid
  targetKind             String   @map("target_kind") // plugin|skill|command|agent|hook|mcp
  source                 String // org_custom|curated|marketplace
  scope                  String // org|global
  name                   String
  description            String?
  version                String   @default("1.0.0")
  sortOrder              Int      @default(0) @map("sort_order")
  // S3 asset keys (written after upload confirmation in T-15.3)
  zipAssetBucket         String?  @map("zip_asset_bucket")
  zipAssetKey            String?  @map("zip_asset_key")
  logoAssetBucket        String?  @map("logo_asset_bucket")
  logoAssetKey           String?  @map("logo_asset_key")
  filesAssetKey          String?  @map("files_asset_key")
  enabled                Boolean  @default(true)
  archived               Boolean  @default(false)
  // Coaching Packs sub-slice (T-22.1): coaching items carry signals[] payload
  // and are excluded from the generic plugin ranking/leaderboard.
  coaching               Boolean  @default(false)
  coachingConfig         Json?    @map("coaching_config")
  // Legacy Agent supersede (T-21.1) — migration traceability
  legacyAgentId          String?  @map("legacy_agent_id") @db.Uuid
  // FEA-3050 promote idempotency: the discovered AgentComponent this item was
  // promoted from (best-of-breed promote, FEA-2923 §J). Bare traceability
  // column (mirrors legacyAgentId/sourceLoopId — no relation). The partial unique
  // on it (below) guards against double-promote creating duplicate org-wide
  // AutoInstall distributions; the older catalog_items partial uniques only cover
  // target_kind='agent' rows.
  sourceAgentComponentId String?  @map("source_agent_component_id") @db.Uuid
  // Preserved for Agent bootstrap idempotency (T-21.1); mirrors Agent.sourceRepo/role
  sourceRepo             String?  @map("source_repo")
  role                   String?
  // Stable, org-scoped-unique context-pack slug for targetKind='agent' items,
  // disambiguated with -2/-3 suffixes at ingest (mirrors the superseded
  // Agent.slug). Persisted so same-role agents from different sourceRepos keep
  // distinct harness file names (`.claude/agents/{slug}.md`) instead of
  // colliding on a role-derived slug recomputed on read (FEA-2923).
  agentSlug              String?  @map("agent_slug")
  sourceLoopId           String?  @map("source_loop_id") @ignore
  // Pack authoring (component container): a Pack is a top-level CatalogItem
  // (parentPackId IS NULL) that holds N child component CatalogItems
  // (skill/command/agent/hook/plugin/mcp). Cascade so archiving/deleting a Pack
  // removes its authored components. Null for standalone items + legacy rows.
  parentPackId           String?  @map("parent_pack_id") @db.Uuid
  // Content-addressed component identity: uuidv5(source + owner + normalized
  // content). Stable across author/import origin; the dedup + cloud-analytics
  // join key. Null for asset-only items and the Pack container itself.
  componentUuid          String?  @map("component_uuid") @db.Uuid
  createdById            String?  @map("created_by_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization  Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User?                @relation("CatalogItemCreatedBy", fields: [createdById], references: [id])
  parentPack    CatalogItem?         @relation("PackComponents", fields: [parentPackId], references: [id], onDelete: Cascade)
  components    CatalogItem[]        @relation("PackComponents")
  versions      CatalogItemVersion[]
  distributions Distribution[]

  @@index([organizationId, archived])
  @@index([source, scope])
  @@index([organizationId, targetKind])
  @@index([parentPackId])
  @@index([organizationId, componentUuid])
  // Agent-item identity, scoped to target_kind='agent' so non-agent items (which
  // leave agent_slug/source_repo null or share them) are outside the constraint.
  @@unique([organizationId, agentSlug], map: "catalog_items_organization_id_agent_slug_agent_key", where: raw("((target_kind = 'agent'::text) AND (agent_slug IS NOT NULL))"))
  @@unique([organizationId, sourceRepo, role], map: "catalog_items_organization_id_source_repo_role_agent_key", where: raw("(target_kind = 'agent'::text)"))
  // FEA-3050 promote idempotency.
  @@unique([organizationId, sourceAgentComponentId], where: raw("(source_agent_component_id IS NOT NULL)"))
  @@map("catalog_items")
}

/// Versioned history of a CatalogItem's content (prompt/config/content).
/// Mirrors AgentVersion. 1:N with CatalogItem.
model CatalogItemVersion {
  id            String   @id @default(uuid(7)) @db.Uuid
  catalogItemId String   @map("catalog_item_id") @db.Uuid
  version       Int
  name          String
  // Content/prompt: nullable to allow asset-only items (zip bundle, no inline text)
  content       String?  @db.Text
  changeNote    String?  @map("change_note")
  changedById   String?  @map("changed_by_id") @db.Uuid
  // F1 link (FEA-3909 / PRD-527 F4): the exact provenance-free DefinitionVersion
  // this version's stored `content` fingerprints to (via `computeDefinitionHash`
  // → `registerDefinitionVersion`, the SSOT). This is the row that actually
  // carries a pack member's definition body, so the catalog→registry link lives
  // here rather than on the child CatalogItem. Nullable: asset-only versions and
  // legacy rows with no stored body stay NULL (conservative — no invented
  // version, PD5). SetNull so a purged version never orphans the catalog row.
  // The provenance-tainted `CatalogItem.componentUuid` is preserved alongside as
  // a compatibility identity; readers prefer this link when present.
  definitionVersionId String? @map("definition_version_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("CatalogItemVersionChangedBy", fields: [changedById], references: [id])
  definitionVersion DefinitionVersion? @relation(fields: [definitionVersionId], references: [id], onDelete: SetNull)

  @@unique([catalogItemId, version])
  @@index([catalogItemId])
  @@index([definitionVersionId])
  @@map("catalog_item_versions")
}

/// A distribution assignment: a CatalogItem pushed to a targeting set with
/// a mode (auto_install = no user action; opt_in = user accepts). Org-scoped.
model Distribution {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  catalogItemId  String   @map("catalog_item_id") @db.Uuid
  mode           String // auto_install|opt_in
  targetingType  String   @map("targeting_type") // all|specific
  desiredEnabled Boolean  @default(true) @map("desired_enabled")
  createdById    String?  @map("created_by_id") @db.Uuid
  /// ISS-5123: when non-null, the distribution has been WITHDRAWN — the org no
  /// longer offers this pack, so it is excluded from every "live distribution"
  /// read (`listForOrg`, `getAssignedForTarget`). Deliberately a soft-delete
  /// rather than a row delete: `DistributionTargetStatus` cascades on delete, so
  /// a hard delete would destroy the record of what was installed on whose
  /// machine — precisely the history an admin needs AFTER withdrawing, since
  /// already-installed copies are left in place and keep working.
  withdrawnAt    DateTime? @map("withdrawn_at")
  withdrawnById  String?   @map("withdrawn_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogItem      CatalogItem                  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  createdBy        User?                        @relation("DistributionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  withdrawnBy      User?                        @relation("DistributionWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: SetNull)
  targetStatuses   DistributionTargetStatus[]
  targetingEntries DistributionTargetingEntry[]

  @@index([catalogItemId])
  @@index([organizationId])
  @@map("distributions")
}

/// Per-(distribution, computeTarget[/user]) install/enable status and version
/// tracking. Drives compliance dashboards.
model DistributionTargetStatus {
  id                String    @id @default(uuid(7)) @db.Uuid
  distributionId    String    @map("distribution_id") @db.Uuid
  // Nullable for user-only (non-target) opt-in scoping.
  computeTargetId   String?   @map("compute_target_id") @db.Uuid
  // Nullable; populated for user-scoped opt-in tracking.
  userId            String?   @map("user_id") @db.Uuid
  status            String // pending|installed|enabled|failed|opted_in|declined
  installedVersion  String?   @map("installed_version")
  // Links to an audit trail row (e.g. pack_install_runs) when available.
  installRunId      String?   @map("install_run_id")
  // Coaching Packs sub-slice (T-22.1): true when the user has explicitly chosen
  // a different (or no) pack locally, overriding the org-distributed default.
  // Prevents auto-install from clobbering a recorded user choice.
  overriddenLocally Boolean   @default(false) @map("overridden_locally")
  failureReason     String?   @map("failure_reason")
  installedAt       DateTime? @map("installed_at")
  enabledAt         DateTime? @map("enabled_at")
  reportedAt        DateTime? @map("reported_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  distribution  Distribution   @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  computeTarget ComputeTarget? @relation(fields: [computeTargetId], references: [id], onDelete: Cascade)
  user          User?          @relation("DistributionTargetStatusUser", fields: [userId], references: [id], onDelete: SetNull)

  // One status per (distribution, compute target) when a target is named; a plain
  // @@unique would reject the user-scoped rows that leave compute_target_id NULL.
  @@unique([distributionId, computeTargetId], map: "distribution_target_status_distribution_id_compute_target_id_ke", where: raw("(compute_target_id IS NOT NULL)"))
  @@index([distributionId])
  @@index([computeTargetId])
  @@index([distributionId, status])
  @@map("distribution_target_status")
}

/// Specific-targeting rows: which compute targets or users a Distribution
/// explicitly targets when targetingType = 'specific'.
model DistributionTargetingEntry {
  id              String   @id @default(uuid(7)) @db.Uuid
  distributionId  String   @map("distribution_id") @db.Uuid
  computeTargetId String?  @map("compute_target_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  distribution  Distribution   @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  computeTarget ComputeTarget? @relation(fields: [computeTargetId], references: [id], onDelete: Cascade)

  @@index([distributionId])
  @@index([computeTargetId])
  @@map("distribution_targeting_entries")
}

/// Staged cloud copy of one complete Desktop invocation projection.
/// A generation is visible to readers only after every part has arrived, its
/// complete-set hash has been validated, and `activeAt` has been set while
/// holding the owning SessionDetail lock. ISS-12781: an active generation
/// absorbs each fresher one for its session, taking its identity and part
/// ledger while keeping the rows it did not change. Organization scope is inherited from
/// SessionDetail -> Artifact.organizationId; it is deliberately not duplicated.
model AgentComponentInvocationGeneration {
  id                   String    @id @default(uuid(7)) @db.Uuid
  // Exactly one completed generation may be active for a session.
  agentSessionId       String    @unique(map: "idx_acig_one_active_per_session", where: raw("(active_at IS NOT NULL)")) @map("agent_session_id") @db.Uuid
  externalGenerationId String    @map("external_generation_id")
  sourceUpdatedAt      DateTime  @map("source_updated_at")
  dataRevision         Int       @map("data_revision")
  sourceSequence       Int       @map("source_sequence")
  expectedPartCount    Int       @map("expected_part_count")
  activeAt             DateTime? @map("active_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  session     SessionDetail                  @relation(fields: [agentSessionId], references: [artifactId], onDelete: Cascade, map: "fk_acig_session")
  parts       AgentComponentInvocationPart[]
  invocations AgentComponentInvocation[]

  @@unique([agentSessionId, externalGenerationId, sourceUpdatedAt, dataRevision, sourceSequence], map: "idx_acig_session_external_generation_freshness")
  @@index([agentSessionId, activeAt], map: "idx_acig_session_active")
  @@index([agentSessionId, sourceUpdatedAt, dataRevision, sourceSequence], map: "idx_acig_session_source_freshness")
  @@map("agent_component_invocation_generations")
}

/// Durable receipt for a byte-bounded generation part. The ingest service
/// compares the hash, item count, and payload bytes on retry before it accepts
/// any staged items, so a conflicting retry cannot rewrite history.
model AgentComponentInvocationPart {
  id           String   @id @default(uuid(7)) @db.Uuid
  generationId String   @map("generation_id") @db.Uuid
  partIndex    Int      @map("part_index")
  partHash     String   @map("part_hash")
  itemCount    Int      @map("item_count")
  payloadBytes Int      @map("payload_bytes")
  receivedAt   DateTime @default(now()) @map("received_at")
  // ISS-12781: the part's redacted wire items, held here until the generation
  // completes instead of as invocation rows, so activation writes only the
  // rows that differ from the active set. NULL once the generation is applied,
  // and on parts staged as rows before this column existed.
  stagedItems  Json?    @map("staged_items")
  // ISS-12781: the projected ids of `stagedItems`, so the cross-part id check
  // reads these instead of detoasting every earlier part's payload. NULL
  // exactly when `stagedItems` is.
  stagedInvocationIds Json? @map("staged_invocation_ids")

  generation  AgentComponentInvocationGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade, map: "fk_acip_generation")
  invocations AgentComponentInvocation[]

  @@unique([generationId, partIndex], map: "idx_acip_generation_part")
  @@map("agent_component_invocation_parts")
}

/// One component invocation of a complete generation. ISS-12781: a fresher
/// generation's activation keeps an identical row and replaces a changed one.
/// Resolution links are nullable because evidence may be missing, unmatched,
/// or ambiguous. Non-versionable tool/MCP/orchestration rows intentionally keep
/// all three links and definitionHash null.
model AgentComponentInvocation {
  id                         String    @id @default(uuid(7)) @db.Uuid
  generationId               String    @map("generation_id") @db.Uuid
  partId                     String    @map("part_id") @db.Uuid
  externalInvocationId       String    @map("external_invocation_id")
  sourceSessionId            String    @map("source_session_id")
  childSessionId             String?   @map("child_session_id")
  parentExternalInvocationId String?   @map("parent_external_invocation_id")
  externalAgentId            String?   @map("external_agent_id")
  componentKind              String    @map("component_kind")
  componentKey               String    @map("component_key")
  /// ISS-6757: the case-folded projection of `componentKey` the component
  /// detail's invocation read filters on. DERIVED, never authored: a
  /// `BEFORE INSERT OR UPDATE OF component_key, component_key_normalized`
  /// trigger (migration 20260820140000) sets it to `lower(component_key)` on
  /// every write, so no producer supplies it. Prisma cannot mark a field
  /// read-only, so this one IS writable from the client (whitlockk) — the derived
  /// column is in the trigger's `UPDATE OF` list precisely so that such a write
  /// is silently re-folded instead of persisting a value the equality read
  /// cannot match. Nullable only so the column could be added without rewriting
  /// the table; the trigger plus the backfill (migration 20260820140100) leave
  /// no NULL behind.
  componentKeyNormalized     String?   @map("component_key_normalized")
  rawName                    String?   @map("raw_name")
  normalizedName             String?   @map("normalized_name")
  relationship               String
  invokedAt                  DateTime? @map("invoked_at")
  sequence                   Int
  anchor                     Json
  providerInvocationId       String?   @map("provider_invocation_id")
  attributionStatus          String    @map("attribution_status")
  evidenceClass              String    @map("evidence_class")
  definitionHash             String?   @map("definition_hash")
  normalizerContractVersion  Int?      @map("normalizer_contract_version")
  definitionContent          String?   @map("definition_content") @db.Text
  definitionFormat           String?   @map("definition_format")
  sourcePath                 String?   @map("source_path")
  sourceModifiedAt           DateTime? @map("source_modified_at")
  capturedAt                 DateTime? @map("captured_at")
  repositoryFullName         String?   @map("repository_full_name")
  repositoryCommit           String?   @map("repository_commit")
  packId                     String?   @map("pack_id")
  branchName                 String?   @map("branch_name")
  agentComponentId           String?   @map("agent_component_id") @db.Uuid
  definitionVersionId        String?   @map("definition_version_id") @db.Uuid
  sourceOccurrenceId         String?   @map("source_occurrence_id") @db.Uuid
  // FEA-3981 (PLN-1488) per-component telemetry — additive, all nullable with
  // NO default so legacy rows stay NULL = "not computed". Capture (desktop),
  // sync, read, and UI land in later slices; Slice A only adds the columns.
  // These live at the per-INVOCATION grain (one row per invocation) so a
  // subagent that runs under multiple models yields one row per model turn —
  // "mixed-model" is naturally represented as distinct rows. The component-level
  // rollup (AgentComponentSessionUsage) DERIVES its totals and its model SET by
  // aggregating these rows, rather than storing a lossy scalar.
  //
  // (a) REAL per-SUBAGENT token/model/cost: a subagent invocation carries the
  //     model it ran and that turn's usage; other kinds leave them NULL.
  //     Triggered downstream cost stays session-level (not fabricated here).
  model                      String?
  inputTokens                BigInt?   @map("input_tokens")
  outputTokens               BigInt?   @map("output_tokens")
  cacheReadTokens            BigInt?   @map("cache_read_tokens")
  cacheWriteTokens           BigInt?   @map("cache_write_tokens")
  estimatedCost              Decimal?  @map("estimated_cost") @db.Decimal(14, 6)
  // (b) Per-component result-FOOTPRINT tokens — the deterministic "tokens this
  //     component injected into context" metric, computed for ALL kinds:
  //     tool/MCP = tool_result output, skill = SKILL.md body + pulled content,
  //     command = expanded template, hook = stdout.
  /// ISS-10713: measured elapsed milliseconds; NULL when no matched result exists.
  durationMs BigInt? @map("duration_ms")
  footprintTokens            BigInt?   @map("footprint_tokens")
  // ISS-7795: HOW the telemetry above was arrived at ('measured' = bracketed
  // around this invocation, 'estimated' = derived, e.g. a session-average
  // share). Nullable with no default: NULL means no telemetry, NOT "unknown
  // method for a number we hold" — the ingest boundary rejects a value without
  // this label and this label without a value, so the pair is never half-set.
  usageMeasurement           String?   @map("usage_measurement")
  // ISS-10730: the lines THIS invocation changed, from the tool call's own
  // `diffDelta` — a THIRD population, additive with neither telemetry block
  // above. Only tool/mcp/orchestration rows carry them; NULL means "not
  // computed", never a measured zero.
  linesAdded                 Int?      @map("lines_added")
  linesRemoved               Int?      @map("lines_removed")
  // ISS-10718 / FEA-4093: whether this invocation succeeded, for the kinds whose
  // success is a first-class transcript fact. NULL is a THIRD value meaning "not
  // a fact this kind records" and must never be coerced to `false` on read or on
  // write — a tool call that errored and a hook nobody can adjudicate are
  // different facts. Mirrors the desktop column this syncs from.
  succeeded                  Boolean?  @map("succeeded")
  // ISS-7796 / ISS-10725: the findings funnel — the OUTPUT side of the same row
  // the cost denominator above sits on, so numerator and denominator divide.
  // Additive, both nullable with NO default, so legacy rows stay NULL = "not
  // measured". NULL is never a measured zero: a reviewer that genuinely emitted
  // nothing stores 0, a component we did not measure stores NULL, and those are
  // different facts a reader must keep apart.
  //
  // EXACTLY TWO COLUMNS. `findings_confirmed` (emitted - invalidated) and the
  // invalidation rate are DERIVED at read and must never be added here — a
  // third stored number is a third number that can disagree with the two it
  // came from. There is no per-finding cost column either (PRD-753 R3/R8).
  //
  // Both-or-neither, like `usage_measurement` above: the ingest boundary
  // rejects one without the other, so no row holds an invalidated count with
  // nothing to divide it by.
  findingsEmitted            BigInt?   @map("findings_emitted")
  findingsInvalidated        BigInt?   @map("findings_invalidated")
  /// ISS-11325: WHY the two cells above read what they read. The counts are a
  /// measurement; this is the statement about them -- withheld for one of the
  /// ingest's three named reasons (count-capped, byte-gated, unreadable),
  /// carried forward from an EARLIER run, or measured by this one. NULL means no
  /// disposition was recorded, which the read resolves to `unrecorded`. TEXT,
  /// not an enum: the vocabulary lives in
  /// `@repo/api/src/types/agent-component-findings-disposition` and the read
  /// tolerates a member this build cannot place.
  findingsDisposition        String?   @map("findings_disposition")
  /// ISS-10720: WHICH SOURCE attributed this invocation to its component -- a
  /// second axis beside `evidence_class`, which answers where the DEFINITION
  /// came from. NULL means the transcript attributed it.
  attributionSource          String?   @map("attribution_source")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  generation        AgentComponentInvocationGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade, map: "fk_aci_generation")
  part              AgentComponentInvocationPart       @relation(fields: [partId], references: [id], onDelete: Cascade, map: "fk_aci_part")
  agentComponent    AgentComponent?                    @relation(fields: [agentComponentId], references: [id], onDelete: SetNull, map: "fk_aci_component")
  definitionVersion DefinitionVersion?                 @relation(fields: [definitionVersionId], references: [id], onDelete: SetNull, map: "fk_aci_definition_version")
  sourceOccurrence  SourceOccurrence?                  @relation(fields: [sourceOccurrenceId], references: [id], onDelete: SetNull, map: "fk_aci_source_occurrence")

  @@unique([generationId, externalInvocationId], map: "idx_aci_generation_external_invocation")
  @@index([generationId, sequence], map: "idx_aci_generation_sequence")
  @@index([agentComponentId, invokedAt], map: "idx_aci_component_invoked_at")
  @@index([definitionVersionId, invokedAt], map: "idx_aci_definition_version_invoked_at")
  // ISS-6757: the component detail's invocation read walks the UNATTRIBUTED rows
  // by folded key, so the index is partial on agent_component_id IS NULL.
  @@index([componentKind, componentKeyNormalized], map: "idx_aci_kind_key_normalized_unattributed", where: raw("(agent_component_id IS NULL)"))
  // ISS-8496: `fk_aci_part` is the deepest referential action on the
  // delete-project cascade (projects -> artifacts -> session_detail -> ... ->
  // agent_component_invocation_parts, all onDelete: Cascade). Every index above
  // leads with generation_id, agent_component_id, definition_version_id or
  // component_kind, so the `part_id = $1` lookup had nothing to seek.
  @@index([partId], map: "agent_component_invocations_part_id_idx")
  @@map("agent_component_invocations")
}

// =============================================================================
// AUDIT LEDGER (FEA-3856 / FEA-3799 Phase 1)
// =============================================================================

/// Tamper-evident, append-only audit ledger. Each organization owns an
/// independent hash chain: rows are keyed by `(organizationId, seq)` with a
/// gap-free monotonic `seq`, and each row's `hash` is derived from its own
/// fields plus the previous row's `hash` (`prevHash`), so mutating any historic
/// row breaks every downstream link (see `auditLedgerService.verifyChain`).
///
/// Append-only is enforced at the DB layer by a `BEFORE UPDATE OR DELETE`
/// trigger that RAISEs (see the migration) — Prisma cannot express a trigger, so
/// the guard lives in hand-edited migration SQL. `actorType`/`actorId` are free
/// columns (no FK) so a `system` or future signed `agent` actor does not depend
/// on the Phase-2 per-agent key table. Rows arrive through `audit_outbox`
/// (below), drained by the `drain-audit-outbox` cron (FEA-3862).
model AuditEntry {
  organizationId String   @map("organization_id") @db.Uuid
  seq            BigInt
  hash           String   @db.Char(64)
  prevHash       String   @map("prev_hash") @db.Char(64)
  action         String
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id") @db.Uuid
  objectType     String   @map("object_type")
  objectId       String   @map("object_id")
  detail         Json
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, seq])
  // No @@index([organizationId, seq]) — the composite PK above already provides
  // that index; a separate one would be redundant (extra write + storage cost).
  @@index([organizationId, objectType, objectId])
  @@map("audit_entries")
}

/// Durable outbox for pending audit-ledger emissions (FEA-3862 Slice 1c).
///
/// Emit points write a row here — best-effort, never blocking or failing the
/// originating request — instead of appending to `audit_entries` inline. The
/// `drain-audit-outbox` cron claims pending rows per organization and calls
/// `auditLedgerService.append`, which takes the per-org single-writer advisory
/// lock so `seq` stays gap-free. Decoupling emission from append is what keeps
/// a ledger hiccup off the user's hot path: a failed outbox insert is swallowed
/// and logged; a failed append leaves the row pending — with a bumped
/// `attempts`/`lastError` — for the next drain, until it reaches the drain's
/// dead-letter cap.
///
/// Rows are deleted once appended (the ledger is the durable record); a row is
/// retried only up to the drain's max-attempts cap, after which it is parked as
/// a dead-letter — excluded from every future drain batch, its `attempts` and
/// `lastError` kept for an operator dead-letter view. So this table holds the
/// small pending/failed backlog plus any parked poison rows; the drain query
/// filters on `attempts` and orders by `createdAt`, and `@@index([attempts,
/// createdAt])` serves it so the growing parked set never bloats a drain pass.
model AuditOutbox {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  action         String
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id") @db.Uuid
  objectType     String   @map("object_type")
  objectId       String   @map("object_id")
  detail         Json
  /// Number of failed drain attempts; a poison row that keeps throwing climbs to
  /// the drain's max-attempts cap and is then parked (excluded from the drain
  /// batch) rather than blocking newer rows.
  attempts       Int      @default(0)
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  /// Serves the drain's pending scan: WHERE attempts < cap ORDER BY created_at.
  /// Leading `attempts` range-excludes parked rows (attempts >= cap) so the
  /// dead-letter set never enters the scan/sort.
  @@index([attempts, createdAt])
  @@map("audit_outbox")
}

/// ISS-8126: one viewer's last EVALUATED decision for one feature-flag gate,
/// shared across serverless instances.
///
/// ISS-7860 memoized the LOC/$ cost-basis gate so a viewer's reads agree inside
/// one instance. `apps/api` is serverless, so two reads served by two COLD
/// instances during a PostHog outage still resolved differently and the reader
/// watched the ratio change between two nearby page loads. An in-process memo
/// cannot close that — a cold instance has no last-known decision to hold — and
/// this is where it holds one.
///
/// Read on exactly ONE path: the fallback for an evaluation that could not be
/// made. Never consulted when PostHog answers, so flipping a rollout still takes
/// effect within the memo's TTL rather than being pinned here.
///
/// Deliberately NOT org-scoped. The subject is a request principal, not an
/// organization's data, and the gate resolves a viewer from distinct ids alone;
/// adding a column no writer can populate would only invite an org predicate
/// that cannot be honored.
model FeatureFlagDecision {
  /// The exact PostHog flag key, so one table serves every gate that opts in.
  flagKey String @map("flag_key")

  /// The gate's OWN memo cache key (the JSON-encoded distinct-id list), not a
  /// user id. Keying this any other way would let two instances compute
  /// different keys for one viewer, leave every instance cold, and make the
  /// whole table inert.
  viewerKey String @map("viewer_key")

  value Boolean

  /// When PostHog EVALUATED this, which is not when the row was written. The
  /// staleness window is measured from the evaluation, and the conditional
  /// upsert that stops an older evaluation overwriting a newer verdict compares
  /// this column — a write timestamp would make a slow-but-older instance look
  /// fresher simply because it finished last.
  decidedAt DateTime @map("decided_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  /// The composite primary key IS the lookup index, so the read is one index
  /// probe and no secondary index is needed.
  @@id([flagKey, viewerKey])
  @@map("feature_flag_decisions")
}

/// ISS-12048: the production feature-flag snapshot a `$vibe` preview schema
/// pins, so a preview environment evaluates every flag as production did for
/// the person who opened it instead of evaluating live.
///
/// At most one row, `id = "current"`: a schema pins one snapshot, and a refresh
/// replaces it. Written only by `POST /preview-schemas/feature-flag-snapshot`
/// into a `preview_*` schema, and read only by an `apps/api` runtime whose own
/// schema is a preview schema, so production and normal stage never consult it
/// even if a row were somehow present.
///
/// Not org-scoped: it describes the environment, not an organization's data.
model FeatureFlagSnapshot {
  id         String   @id
  /// The PostHog distinct id the snapshot was evaluated for.
  distinctId String   @map("distinct_id")
  /// The ClosedLoop org the snapshot was evaluated in, when one was given.
  orgId      String?  @map("org_id")
  /// When PostHog evaluated the snapshot, not when this row was written.
  takenAt    DateTime @map("taken_at")
  /// `Record<string, boolean | string>`, validated against
  /// `featureFlagSnapshotSchema` on write and again on read.
  flags      Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("feature_flag_snapshots")
}

// =============================================================================
// DELIVERY POINTS (ISS-8399) — the provider-keyed numerator association store
// =============================================================================

/// Which external provider a delivery-point row came from. Deliberately a
/// SUBSET of the `NumeratorProvider` contract in `@repo/api`: LOC is a provider
/// there, but it is derived from our own git data and has no external rows to
/// associate, so it has no member here. The `DELIVERY_PROVIDER_ADAPTERS` map in
/// `apps/api/lib/delivery-points/provider-adapters.ts` is what forces a new
/// numerator provider to declare whether it needs a member here.
enum DeliveryPointProvider {
  PENSERO
}

/// What kind of interaction a delivery row awarded points for. `OTHER` is a
/// real member, not a parse failure: the provider owns this vocabulary, and
/// dropping a row we cannot classify would silently under-report delivery. The
/// verbatim wire value is kept in `raw_item_type` alongside it.
enum DeliveryItemType {
  PULL_REQUEST
  PULL_REQUEST_REVIEW
  MESSAGING
  TICKET
  OTHER
}

/// The person's role in the interaction. One pull request yields a CREATOR row
/// plus N REVIEWER rows to different people.
///
/// WHICH ROLE FEEDS THE NUMERATOR was settled by operator ruling on 2026-09-09
/// (ISS-9811/ISS-9813): ALL FOUR contribute and their SUM is the numerator, with
/// no role predicate. The provider apportions upstream — one pull request's
/// value is DIVIDED across its role rows rather than replicated to each — so
/// `points` is a per-row SHARE and summing every role reconstructs the
/// interaction's value exactly once; summing only CREATOR would UNDER-count by
/// discarding the reviewers' shares. This column is retained so future features
/// can slice by role, not as a filter on the numerator.
enum DeliveryContributorRole {
  CREATOR
  REVIEWER
  ASSIGNEE
  OTHER
}

/// How a delivery row resolved against OUR records. A closed set, and
/// AMBIGUOUS is a first-class member precisely so ambiguity never resolves to
/// "pick the first" — that is how one pull request ends up carrying another's
/// points.
enum DeliveryMatchOutcome {
  /// Resolved to exactly one of our pull requests.
  MATCHED
  /// A well-formed reference to a pull request we do not have.
  NO_COUNTERPART
  /// More than one candidate, or a self-contradicting provider interaction.
  AMBIGUOUS
  /// The row names no pull-request interaction at all (a Slack message, a
  /// provider-side ticket), so it can never acquire a number. Distinct from
  /// NO_COUNTERPART: we never got as far as a lookup. TERMINAL.
  UNMATCHABLE
  /// The row names a pull-request interaction, but no row seen so far — in this
  /// run or in any stored earlier run — supplied its number. PROVISIONAL, not
  /// terminal: the counterpart row may simply be in a window nobody has fetched
  /// yet, and a later run that sees it will resolve this row. Kept apart from
  /// UNMATCHABLE so "we have not looked yet" cannot be read as "there is
  /// nothing to find".
  PENDING_REFERENCE
}

/// Where a delivery point's artifact association came from.
///
/// Our own branch/PR artifact links are the ONLY source today, and the enum
/// exists rather than being dropped because a future provider may supply its
/// own artifact references (the JIRA seam) and that must be distinguishable
/// from a link we derived ourselves. A provider TITLE is deliberately not a
/// source: it does not establish the repository/PR identity these rows key on,
/// so a row we could not identify carries its outcome and no associations.
enum DeliveryArtifactLinkSource {
  OUR_LINKS
}

/// One extracted delivery row from an external numerator provider.
///
/// IDEMPOTENCY: `(organization_id, provider, provider_item_id)` is unique and is
/// the upsert key. Delivery windows OVERLAP — a window returns rows for pull
/// requests created well before it — so points accrete across re-extractions.
/// Every write is an UPSERT of the provider's own measured value; nothing ever
/// sums on re-read, because summing would silently inflate the numerator on
/// every backfill pass.
///
/// THREE ZEROS, kept distinct on purpose. `points = 0` with
/// `match_outcome = MATCHED` is a MEASURED zero. A pull request with no row here
/// at all has not been backfilled, or was not matched — and neither of those is
/// a zero. Readers must not collapse them.
model DeliveryPoint {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  provider       DeliveryPointProvider

  /// The provider's own row id. The idempotency key — never a title, never a
  /// (person, date) tuple, both of which repeat.
  providerItemId String  @map("provider_item_id")
  /// The provider's interaction id (e.g. Pensero `/interactions/pull_request/<id>`).
  /// This is the join key WITHIN the provider's feed: the creator row carries no
  /// pull-request number of its own and gets one only from a sibling row sharing
  /// this id, possibly from a different window. Nullable for rows with no
  /// interaction (a Slack message has none).
  providerInteractionId String? @map("provider_interaction_id")

  itemType    DeliveryItemType        @map("item_type")
  /// Verbatim wire `item_type`, retained even when classified OTHER.
  rawItemType String                  @map("raw_item_type")
  role        DeliveryContributorRole
  /// Verbatim wire `role`, retained even when classified OTHER.
  rawRole     String                  @map("raw_role")

  /// The provider's measured value. Decimal, not float: these are summed into a
  /// numerator and the provider emits tenths (0.1, 2.2, 0.9).
  points      Decimal  @db.Decimal(12, 4)
  /// The calendar day the provider attributed the delivery to. NOT the pull
  /// request's own date — a window returns rows for much older pull requests.
  deliveredOn DateTime @map("delivered_on") @db.Date
  /// The provider's title for the row. Diagnostic only. Titles are not unique,
  /// are lossy, and are never a matching key.
  title       String

  /// The provider's person id, and the lowercased email used to bridge that
  /// person to one of our users. The provider sends no GitHub login, so email is
  /// the only bridge — and its `username` field differs in CASE from `email` for
  /// real users, which is why the normalized form is what is stored.
  providerPersonId String  @map("provider_person_id")
  personEmail      String  @map("person_email")
  /// The bridged user, or null when no user in this org has that email.
  userId           String? @map("user_id") @db.Uuid

  /// Normalized `owner/name` of the pull request this row resolved to, if any.
  /// Parsed, never assumed: the feed spans repositories.
  repositoryFullName  String? @map("repository_full_name")
  pullRequestNumber   Int?    @map("pull_request_number")
  /// The matched `pull_request_detail` row. Null unless `match_outcome` is
  /// MATCHED — a null here is never a zero, it is an unresolved row.
  pullRequestDetailId String? @map("pull_request_detail_id") @db.Uuid
  /// The matched pull request's BRANCH artifact, which is the pull request's
  /// only real identity in the artifact graph. Deliberately not
  /// `pull_request_detail.artifact_id`: that column is vestigial (it predates
  /// `20260515002500_add_branch_artifact_foundation`, every current writer
  /// omits it, and no `PULL_REQUEST` member of `ArtifactType` exists for it to
  /// point at), so keying on it would leave almost every matched row with a
  /// null artifact and make a successful match read as a coverage hole.
  branchArtifactId    String? @map("branch_artifact_id") @db.Uuid

  matchOutcome DeliveryMatchOutcome @map("match_outcome")

  extractedAt DateTime @default(now()) @map("extracted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  pullRequestDetail PullRequestDetail?      @relation(fields: [pullRequestDetailId], references: [id], onDelete: SetNull)
  branchArtifact    Artifact?               @relation("DeliveryPointBranch", fields: [branchArtifactId], references: [id], onDelete: SetNull)
  artifactAssociations DeliveryPointArtifact[]

  @@unique([organizationId, provider, providerItemId], map: "delivery_points_org_provider_item_key")
  /// The backfill's own re-read path: "what did we already store for this
  /// provider in this window", ordered by day.
  @@index([organizationId, provider, deliveredOn], map: "delivery_points_org_provider_delivered_idx")
  /// The numerator read path: a provider's points for a set of pull requests.
  @@index([organizationId, provider, branchArtifactId], map: "delivery_points_org_provider_branch_idx")
  // ISS-8496: `delivery_points_branch_artifact_id_fkey` is onDelete: SetNull,
  // which still has to FIND the referencing rows by `branch_artifact_id = $1`
  // before it can null them. The composite above leads with organization_id.
  @@index([branchArtifactId], map: "delivery_points_branch_artifact_id_idx")
  // ISS-8496: the same reason one hop further out. Deleting a project cascades
  // to its branch Artifacts and from there to `pull_request_detail`
  // (onDelete: Cascade), so `delivery_points_pull_request_detail_id_fkey` — also
  // SetNull — runs `pull_request_detail_id = $1` once per PR row deleted. Every
  // other index on this table leads with organization_id.
  @@index([pullRequestDetailId], map: "delivery_points_pull_request_detail_id_idx")
  /// Resolving a creator row once a later segment supplies its number.
  @@index([organizationId, provider, providerInteractionId], map: "delivery_points_org_provider_interaction_idx")
  @@map("delivery_points")
}

/// Many-to-many association between a delivery point and EVERY artifact it
/// resolves to — the pull request, the issue/plan it references, and anything
/// else our own links reach. Deliberately not a single `artifact_id` column on
/// `delivery_points`: one pull request routinely addresses several tickets, and
/// one ticket is routinely addressed by several pull requests.
///
/// HOW THE POINTS FAN IN ACROSS THAT RELATION IS AN OPEN PRODUCT QUESTION
/// (ISS-8399). This table records the association only; it does NOT divide,
/// duplicate, or attribute points, and no reader may assume it has.
model DeliveryPointArtifact {
  deliveryPointId String                     @map("delivery_point_id") @db.Uuid
  artifactId      String                     @map("artifact_id") @db.Uuid
  organizationId  String                     @map("organization_id") @db.Uuid
  source          DeliveryArtifactLinkSource
  createdAt       DateTime                   @default(now()) @map("created_at")

  deliveryPoint DeliveryPoint @relation(fields: [deliveryPointId], references: [id], onDelete: Cascade)
  artifact      Artifact      @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([deliveryPointId, artifactId])
  /// "Which delivery points reference this artifact" — the read direction the
  /// numerator uses for an issue/plan rather than a pull request.
  @@index([organizationId, artifactId], map: "delivery_point_artifacts_org_artifact_idx")
  // ISS-8496: cascade check for `delivery_point_artifacts_artifact_id_fkey`.
  // The composite primary key leads with delivery_point_id and the index above
  // leads with organization_id, so neither can seek on artifact_id alone.
  @@index([artifactId])
  @@map("delivery_point_artifacts")
}

/// ISS-8463: the pre-image of every `pull_request_detail` row whose false
/// verification stamp the one-shot backfill cleared.
///
/// Exists because clearing `last_verified_at` destroys the ONLY record that
/// those rows were ever stamped, and the ticket requires the backfill to be
/// reversible. `apps/api/scripts/backfill-unresolvable-pr-stubs.ts` writes a row
/// here inside the same transaction that clears the stamp, and reverses from it.
///
/// `prior_pr_state` is captured although the backfill does not modify the
/// column: it is the other half of what made these rows read as measured, and
/// once the stamp is gone the population's state distribution is otherwise
/// unrecoverable.
model PullRequestVerificationStampBackfill {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// One operator invocation. Reverting targets a run, never a loose row set.
  runId               String        @map("run_id") @db.Uuid
  pullRequestDetailId String        @map("pull_request_detail_id") @db.Uuid
  organizationId      String        @map("organization_id") @db.Uuid
  priorLastVerifiedAt DateTime      @map("prior_last_verified_at")
  priorPrState        GitHubPRState @map("prior_pr_state")
  capturedAt          DateTime      @default(now()) @map("captured_at")
  /// Set when the pre-image has been written back. A revert reads only rows
  /// where this is null, so a second revert of the same run is a no-op rather
  /// than a re-stamp of a row the reconciler has since legitimately verified.
  revertedAt          DateTime?     @map("reverted_at")

  pullRequestDetail PullRequestDetail @relation(fields: [pullRequestDetailId], references: [id], onDelete: Cascade)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The revert path: one run's un-reverted captures.
  @@index([runId, revertedAt], map: "pr_verification_stamp_backfill_run_idx")
  @@index([pullRequestDetailId], map: "pr_verification_stamp_backfill_detail_idx")
  @@map("pull_request_verification_stamp_backfill")
}

/// ISS-11767 (PLN-2174): proof of the latest comment reconcile read of each
/// lane of a pull request, one row per (PR, lane), overwritten by every
/// recorded attempt. Written only by the reconcile's lease release; the latest
/// attempt wins, with no clock expiry (operator decision 2).
model PullRequestCommentAcquisition {
  pullRequestDetailId  String                       @map("pull_request_detail_id") @db.Uuid
  lane                 PullRequestCommentLane
  organizationId       String                       @map("organization_id") @db.Uuid
  /// Incremented on every recorded attempt for this lane.
  generation           Int
  status               PullRequestCommentLaneStatus
  /// Rows the provider returned (0 = proven empty); NULL when failed or seeded.
  itemCount            Int?                         @map("item_count")
  errorCode            String?                      @map("error_code") @db.VarChar(64)
  listedAt             DateTime                     @map("listed_at")
  /// The last complete observation, kept across later non-complete attempts.
  lastCompleteListedAt DateTime?                    @map("last_complete_listed_at")
  /// Consecutive non-complete attempts since the last complete one.
  incompleteStreak     Int                          @map("incomplete_streak")
  /// Comments this attempt's cleanup deleted; NULL when no cleanup ran.
  retractedCount       Int?                         @map("retracted_count")
  recordedAt           DateTime                     @map("recorded_at")

  // Through the PR's (organization_id, id) key, so a row cannot carry an
  // organization other than its pull request's.
  pullRequestDetail PullRequestDetail @relation(fields: [organizationId, pullRequestDetailId], references: [organizationId, id], onDelete: Cascade, map: "pull_request_comment_acquisitions_pull_request_detail_fkey")

  @@id([pullRequestDetailId, lane])
  @@map("pull_request_comment_acquisitions")
}

/// One guided-onboarding run, per user per organization (PRD-689, ISS-8375).
model OnboardingAttempt {
  id                  String    @id @default(uuid(7)) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid

  /// The workspace-experience variant this run STARTED in. Resume reads this,
  /// never the live flag, so a mid-flight assignment change cannot swap the
  /// component tree under a user who is halfway through.
  experienceVariant   String    @map("experience_variant")
  /// The host the run started on, reported as the snapshot's `startedOnHost`.
  /// Never restored against: see `ATTEMPT_SELECT` in
  /// `apps/api/app/onboarding/guided/attempt-store.ts`.
  host                String

  /// PersistedOnboardingState v1. Opaque here; parsed by the shared strict schema.
  state               Json
  /// Compare-and-swap token. Every accepted transition increments it.
  revision            Int       @default(0)
  /// Last accepted command id, for duplicate-delivery replay.
  lastCommandId       String?   @map("last_command_id") @db.Uuid

  accountSkippedAt    DateTime? @map("account_skipped_at")
  desktopDownloadedAt DateTime? @map("desktop_downloaded_at")
  tourCompletedAt     DateTime? @map("tour_completed_at")
  /// ISS-11670: when THIS user's own invitation send landed, stamped by the
  /// invitation route on the same `invited > 0` the org marker uses, and seeded
  /// from `completed_at` by this column's own migration for runs that had
  /// already finished. The org's `settings->onboarding->invitesSentAt` answers a
  /// different question — has anyone in this org ever invited — and cannot stand
  /// in for it: the operator ruled on 2026-09-30 that every new user is prompted
  /// regardless of what the rest of the org has done, and separately that an
  /// already-onboarded reader is not re-prompted.
  invitesSentAt       DateTime? @map("invites_sent_at")
  completedAt         DateTime? @map("completed_at")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One run per user per org. Load-bearing beyond de-duplication: the
  /// compare-and-swap `updateMany` selects on this pair plus `revision`, so it
  /// is the identity a transition arbitrates on.
  @@unique([userId, organizationId])
  /// Cascade support for `onboarding_attempts_organization_id_fkey`; the unique
  /// above leads with user_id and cannot seek on organization_id alone.
  @@index([organizationId])
  @@map("onboarding_attempts")
}

/// Server-backed per-user grid preferences for authenticated grid surfaces
/// (PRD-716, ISS-9448). The value is an opaque JSON object owned by grid
/// adopters; this table owns identity, revision, tenant scoping, and reset.
model GridPreference {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  gridKey        String   @map("grid_key")
  preferenceKind String   @map("preference_kind")
  scopeKey       String   @map("scope_key")
  value          Json
  revision       Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, gridKey, preferenceKind, scopeKey], map: "grid_preferences_identity_key")
  @@index([userId], map: "grid_preferences_user_id_idx")
  @@map("grid_preferences")
}


/// ISS-10717: the per-session rollup of the desktop `claude_code_*` OTel corpus.
///
/// GRAIN. Per-session, with the component dimension broken out into
/// `ClaudeCodeComponentTelemetry` below. The local grain is per-event and large
/// (32,930 cost events on one machine when ISS-7352 measured it); the product
/// questions are per-session and per-component, and the raw events stay on the
/// machine that recorded them. The reasoning is recorded in full on
/// `packages/api/src/types/desktop-claude-code-telemetry-sync.ts`.
///
/// EVERY COUNT IS NULLABLE WITH NO DEFAULT, and that is load-bearing rather than
/// lax. NULL means the recording machine has never recorded that signal family;
/// `0` means it measured the family and this session produced none. Defaulting
/// any of these to `0` would state a measured absence the machine never
/// observed. `llmRequestCount` is the case that makes it concrete:
/// `claude_code_llm_request` is fed only under
/// `CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1`, which nothing sets, so a `0` there
/// would assert this session issued no LLM requests when in truth none were ever
/// captured.
model ClaudeCodeSessionTelemetry {
  artifactId      String   @id @map("artifact_id") @db.Uuid
  /// The producing harness, recorded so a reader can answer absent-BY-HARNESS
  /// for a Codex or Copilot session instead of reporting a capture failure.
  harness         String
  /// The protocol version the delivering desktop spoke. Kept so a row can be
  /// interpreted against the contract that wrote it after a newer one ships.
  protocolVersion Int      @map("protocol_version")

  costEventCount            Int? @map("cost_event_count")
  apiRequestCount           Int? @map("api_request_count")
  errorEventCount           Int? @map("error_event_count")
  permissionEventCount      Int? @map("permission_event_count")
  permissionModeChangeCount Int? @map("permission_mode_change_count")
  mcpServerConnectionCount  Int? @map("mcp_server_connection_count")
  toolResultCount           Int? @map("tool_result_count")
  llmRequestCount           Int? @map("llm_request_count")
  /// ISS-11322. For these three families a ROW COUNT IS the signal, so they take
  /// the same nullable-no-default shape as the eight above. The three families
  /// ISS-11322 also adds whose signal is a VALUE are carried as
  /// `ClaudeCodeActiveTimeTelemetry`, `ClaudeCodeLinesOfCodeTelemetry` and the
  /// `identity*` columns below, and have no count column on purpose.
  authEventCount            Int? @map("auth_event_count")
  pluginEventCount          Int? @map("plugin_event_count")
  sessionStartCount         Int? @map("session_start_count")

  /// Summed `claude_code_cost_event.cost_usd` — the HARNESS's counter ledger.
  /// NOT a second opinion of `session_detail.estimated_cost` (our pricing engine)
  /// nor of `session_detail.authoritative_cost_usd` (Claude's result envelope):
  /// three producers, three ledgers, and the read contract names each one.
  costEventUsd            Decimal? @map("cost_event_usd") @db.Decimal(14, 6)
  /// Summed `claude_code_api_request.cost_usd_micros` — the PRODUCER's own
  /// exact-integer cost, in millionths of a dollar. Stored in its native integer
  /// unit rather than divided into the Decimal above, because the integer is the
  /// precision this ledger offers and the division would throw it away.
  apiRequestCostUsdMicros BigInt?  @map("api_request_cost_usd_micros")

  observedFrom DateTime? @map("observed_from")
  observedTo   DateTime? @map("observed_to")

  /// Whether the component breakdown below is the TOP SLICE by cost rather than
  /// the whole set, because the session has more components than one request may
  /// carry. A reader must say "partial" rather than read the rows as complete,
  /// and the ingest must not delete the tail it never received.
  componentsTruncated Boolean @default(false) @map("components_truncated")
  /// ISS-11322: the same disclosure for the two value-bearing breakdowns. A
  /// capped slice must read as partial, and the ingest must not delete the tail
  /// it never received.
  activeTimeTruncated  Boolean @default(false) @map("active_time_truncated")
  linesOfCodeTruncated Boolean @default(false) @map("lines_of_code_truncated")

  /// ISS-11322: whether the delivery CARRIED each value-bearing breakdown at all,
  /// which is the array form of the nullable-count rule above and is not derivable
  /// from the rows. FALSE means the recording machine has never recorded that
  /// family; TRUE with zero rows means it records the family and this session
  /// produced none. Without these two columns the read has no way to tell them
  /// apart — a rollup exists for any session with ANY of the fourteen families, so
  /// "no rows" would report a measured zero on every machine that has never
  /// captured active time or lines of code. Same role `identityRecorded` plays
  /// below for the identity object.
  activeTimeRecorded   Boolean @default(false) @map("active_time_recorded")
  linesOfCodeRecorded  Boolean @default(false) @map("lines_of_code_recorded")

  /// ISS-11322: the dimensions `claude_code_session_identity` carries. NOT a
  /// count — that table is keyed on `session_id`, so its count is 0 or 1 and says
  /// only whether the harness stamped an identity. The two user-account columns
  /// of that table are deliberately NOT synced: they identify a person rather
  /// than describe the run, and carrying them across the desktop boundary is a
  /// privacy decision for a human. NULL here is "the harness did not stamp it".
  identityRecorded       Boolean @default(false) @map("identity_recorded")
  identityOrganizationId String? @map("identity_organization_id")
  identitySource         String? @map("identity_source")
  identityTerminalType   String? @map("identity_terminal_type")
  identityAppVersion     String? @map("identity_app_version")
  identityAppEntrypoint  String? @map("identity_app_entrypoint")

  lastSyncedAt DateTime @default(now()) @map("last_synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [artifactId], references: [artifactId], onDelete: Cascade)

  @@map("claude_code_session_telemetry")
}

/// ISS-11322: one activity type's summed seconds for a session.
///
/// SECONDS, not a row count, and BROKEN OUT BY `activityType` rather than
/// blended. `claude_code_active_time` separates user seconds from CLI seconds:
/// they are two different measurements of the same session, one total would
/// describe neither, and a count of activity rows would be a third number
/// wearing the words "active time". This is why ISS-10717 cut the family rather
/// than folding it in as a count.
model ClaudeCodeActiveTimeTelemetry {
  id         String @id @default(uuid(7)) @db.Uuid
  artifactId String @map("artifact_id") @db.Uuid
  /// The harness's own activity type. Text rather than an enum so a newer
  /// harness's type does not fail the row.
  activityType String @map("activity_type")
  /// Summed `claude_code_active_time.seconds`. NOT NULL: a row exists only
  /// because a representable total was measured, and an unrepresentable one is
  /// omitted by the producer rather than sent as some number.
  seconds      Decimal @db.Decimal(14, 3)

  lastSyncedAt DateTime @default(now()) @map("last_synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [artifactId], references: [artifactId], onDelete: Cascade)

  @@unique([artifactId, activityType], map: "claude_code_active_time_telemetry_artifact_type")
  @@index([artifactId])
  @@map("claude_code_active_time_telemetry")
}

/// ISS-11322: one `(model, changeType)` pair's summed line count for a session.
///
/// BROKEN OUT for the same reason as the component grain: `claude_code_lines_of_code`
/// is keyed by `model` and `change_type`, and lines ADDED by one model are not an
/// addend of lines REMOVED by another. One scalar would be the sum of two
/// opposite-signed magnitudes published as a single positive number.
model ClaudeCodeLinesOfCodeTelemetry {
  id         String @id @default(uuid(7)) @db.Uuid
  artifactId String @map("artifact_id") @db.Uuid
  model      String
  changeType String @map("change_type")
  /// Summed `claude_code_line_count`. A BigInt because the source column is one
  /// and a long-lived machine can exceed the safe-integer range.
  lineCount  BigInt @map("line_count")

  lastSyncedAt DateTime @default(now()) @map("last_synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [artifactId], references: [artifactId], onDelete: Cascade)

  @@unique([artifactId, model, changeType], map: "claude_code_lines_of_code_telemetry_artifact_key")
  @@index([artifactId])
  @@map("claude_code_lines_of_code_telemetry")
}

/// ISS-10717: one component's share of a session, as the HARNESS attributed it.
///
/// This is the headline of the ticket. Claude Code stamps `agent_name`,
/// `skill_name`, `plugin_name`, `mcp_server_name`, `mcp_tool_name`,
/// `query_source`, `speed` and `effort` on every cost counter, and ISS-7352
/// measured our own transcript-derived attribution at 4 matched against 32,930
/// unresolved. The producer's answer is what this table carries.
model ClaudeCodeComponentTelemetry {
  id         String @id @default(uuid(7)) @db.Uuid
  artifactId String @map("artifact_id") @db.Uuid
  /// The harness's canonical join of the whole attribution tuple. `""` is the
  /// one UNATTRIBUTED value and is a real member of the key, not a missing one.
  attributionKey String @map("attribution_key")
  /// Which producer supplied the attribution, kept per row so a disagreement
  /// with transcript-derived attribution is diagnosable instead of invisible.
  attributionSource String @map("attribution_source")

  agentName     String? @map("agent_name")
  skillName     String? @map("skill_name")
  pluginName    String? @map("plugin_name")
  mcpServerName String? @map("mcp_server_name")
  mcpToolName   String? @map("mcp_tool_name")
  querySource   String? @map("query_source")
  speed         String?
  effort        String?

  costEventCount Int      @default(0) @map("cost_event_count")
  /// Summed `claude_code_cost_event.cost_usd` for this component. Nullable for
  /// the same reason as the rollup's costs: a component with no cost recorded is
  /// not a component that cost nothing.
  costUsd        Decimal? @map("cost_usd") @db.Decimal(14, 6)

  lastSyncedAt DateTime @default(now()) @map("last_synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session SessionDetail @relation(fields: [artifactId], references: [artifactId], onDelete: Cascade)

  @@unique([artifactId, attributionKey], map: "claude_code_component_telemetry_artifact_key")
  @@index([artifactId])
  @@map("claude_code_component_telemetry")
}

/// ISS-10717: the completeness signal — how many Claude Code OTel signals a
/// recording machine LOST, by reason.
///
/// Without it a consumer cannot tell a session that genuinely produced no
/// permission events from one whose export the receiver evicted under
/// backpressure, and every count synced above would read as authoritative when
/// it is a lower bound.
///
/// Keyed by COMPUTE TARGET rather than by session because two of the three drop
/// sites lose the signal before anything knows its session: an ACKed export
/// evicted at the receiver was never decoded past its envelope, and a record the
/// normalizer found unusable is by definition one whose fields could not be read.
/// Attributing these to a session would be inventing an attribution.
model ClaudeCodeSignalDropCounter {
  id              String   @id @default(uuid(7)) @db.Uuid
  computeTargetId String   @map("compute_target_id") @db.Uuid
  harness         String
  /// A `ClaudeCodeTelemetryDropReason` member. Text rather than an enum so a
  /// newer desktop's reason is stored rather than rejected.
  reason          String
  /// The machine's own monotonic counter, LAST-WRITE-WINS. Never summed across
  /// deliveries: each payload carries the machine's current total, so adding two
  /// deliveries would double-count.
  droppedCount    BigInt   @map("dropped_count")
  firstObservedAt DateTime @map("first_observed_at")
  lastObservedAt  DateTime @map("last_observed_at")

  lastSyncedAt DateTime @default(now()) @map("last_synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  computeTarget ComputeTarget @relation(fields: [computeTargetId], references: [id], onDelete: Cascade)

  @@unique([computeTargetId, harness, reason], map: "claude_code_signal_drop_counter_natural")
  @@map("claude_code_signal_drop_counter")
}


// ISS-11127: analytics-only join, no user or device identity; expired on insert.
model DesktopSignInAnalyticsAttempt {
  challengeHash String @id @map("challenge_hash")
  flowId String @map("flow_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("desktop_sign_in_analytics_attempt")
}
