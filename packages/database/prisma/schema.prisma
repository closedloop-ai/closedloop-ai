model CommentThread {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  source           ThreadSource @default(NATIVE)
  externalId       String?      @map("external_id")
  roomId           String?      @map("room_id")
  artifactId       String       @map("artifact_id") @db.Uuid
  status           ThreadStatus @default(OPEN)
  metadata         Json?
  // `{ v, ...CommentAnchor }` (packages/api/src/types/comment-anchor.ts); null
  // until a source writes anchors (ISS-11212).
  anchor           Json?
  anchorState      CommentAnchorState? @map("anchor_state")
  revision         Int          @default(0)
  createdAtVersion Int?         @map("created_at_version")
  resolvedAt       DateTime?    @map("resolved_at")
  resolvedById     String?      @map("resolved_by_id") @db.Uuid
  createdById      String?      @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization     Organization                   @relation(fields: [organizationId], references: [id])
  artifact         Artifact                       @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  comments         Comment[]
  githubProjection GitHubCommentThreadProjection?
  syncStates       CommentSyncState[]

  @@unique([organizationId, externalId])
  @@unique([id, artifactId], map: "comment_threads_id_artifact_id_key")
  // ISS-8496: cascade check for `comment_threads_artifact_id_fkey`, which is
  // `artifact_id = $1` alone. The org-leading index below cannot serve it, and
  // `comment_threads_id_artifact_id_key` leads with `id`.
  @@index([artifactId])
  @@index([organizationId, artifactId, status])
  @@index([organizationId, roomId])
  @@index([organizationId, status, updatedAt])
  // FEA-3550: covering index for the org-scoped aggregate `GET /trace-comments`
  // list, which filters native threads by (organizationId, source, status?) and
  // orders by createdAt. Leads with organizationId + source so the planner scans
  // only this org's native threads instead of the whole table as comment volume
  // grows, and carries status + createdAt for the status filter and desc sort.
  @@index([organizationId, source, status, createdAt])
  @@index([createdById])
  @@map("comment_threads")
}

// Provider-specific projection for GitHub review and issue-comment thread state.
// Generic artifact comments stay in CommentThread so future sources do not inherit GitHub columns.
model GitHubCommentThreadProjection {
  threadId               String                    @id @map("thread_id") @db.Uuid
  branchArtifactId       String                    @map("branch_artifact_id") @db.Uuid
  pullRequestDetailId    String                    @map("pull_request_detail_id") @db.Uuid
  threadKind             GitHubCommentThreadKind   @map("thread_kind")
  reviewThreadId         String?                   @map("review_thread_id")
  rootCommentId          String?                   @map("root_comment_id")
  reviewId               String?                   @map("review_id")
  path                   String?
  line                   Int?
  // ISS-11212: GitHub `original_line`, kept for the code anchor's originalEndLine.
  originalLine           Int?                      @map("original_line")
  side                   GitHubDiffSide?
  startLine              Int?                      @map("start_line")
  startSide              GitHubDiffSide?           @map("start_side")
  commitSha              String?                   @map("commit_sha")
  htmlUrl                String?                   @map("html_url") @db.Text
  resolvable             Boolean                   @default(false)
  legacyState            GitHubLegacyCommentState? @map("legacy_state")
  deletedAt              DateTime?                 @map("deleted_at")
  lastSyncedAt           DateTime?                 @map("last_synced_at")
  fetchCredentialType    String?                   @map("fetch_credential_type") @db.VarChar(32)
  fetchCredentialOwnerId String?                   @map("fetch_credential_owner_id") @db.Uuid
  fetchMechanism         String?                   @map("fetch_mechanism") @db.VarChar(32)
  fetchTrigger           String?                   @map("fetch_trigger") @db.VarChar(32)
  fetchObservedAt        DateTime?                 @map("fetch_observed_at")
  fetchResultReason      String?                   @map("fetch_result_reason") @db.VarChar(64)

  thread             CommentThread             @relation(fields: [threadId, branchArtifactId], references: [id, artifactId], onDelete: Cascade)
  branch             BranchDetail              @relation(fields: [branchArtifactId], references: [artifactId], onDelete: Cascade)
  pullRequestDetail  PullRequestDetail         @relation(fields: [pullRequestDetailId, branchArtifactId], references: [id, branchArtifactId], onDelete: Cascade)
  commentProjections GitHubCommentProjection[]

  @@unique([threadId, branchArtifactId], map: "github_comment_thread_projections_thread_branch_key")
  @@index([pullRequestDetailId, threadKind, rootCommentId], map: "github_comment_thread_projections_root_comment_idx")
  @@index([pullRequestDetailId, threadKind, reviewThreadId], map: "github_comment_thread_projections_review_thread_idx")
  @@index([pullRequestDetailId], map: "github_comment_thread_projections_pr_detail_idx")
  @@index([lastSyncedAt], map: "github_comment_thread_projections_last_synced_at_idx")
  // ISS-8496: the cascade check for
  // `github_comment_thread_projections_branch_artifact_id_fkey`, which reaches
  // this table one hop past `artifacts` (projects -> artifacts -> branch_detail
  // -> here). The `thread_branch_key` unique above mentions branch_artifact_id
  // but leads with thread_id, and a referential action supplies only its own FK
  // column, so nothing here could seek `branch_artifact_id = $1`.
  @@index([branchArtifactId], map: "github_comment_thread_projections_branch_artifact_id_idx")
  // Live-thread identity: a soft-deleted row leaves the constraint so the next
  // sync can re-project the same GitHub thread.
  @@unique([pullRequestDetailId, threadKind, reviewThreadId], map: "github_comment_thread_projections_pr_review_thread_unique", where: raw("((review_thread_id IS NOT NULL) AND (deleted_at IS NULL))"))
  @@unique([pullRequestDetailId, threadKind, rootCommentId], map: "github_comment_thread_projections_pr_root_comment_unique", where: raw("((root_comment_id IS NOT NULL) AND (deleted_at IS NULL))"))
  @@map("github_comment_thread_projections")
}

model Comment {
  id              String    @id @default(uuid(7)) @db.Uuid
  threadId        String    @map("thread_id") @db.Uuid
  authorId        String    @map("author_id") @db.Uuid
  body            Json
  bodyFormat      CommentBodyFormat @map("body_format")
  revision        Int       @default(0)
  plainText       String?   @map("plain_text") @db.Text
  externalId      String?   @map("external_id")
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  editedAt        DateTime? @map("edited_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  thread           CommentThread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent           Comment?                 @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies          Comment[]                @relation("CommentReplies")
  reactions        CommentReaction[]
  attachments      CommentAttachment[]
  githubProjection GitHubCommentProjection?
  syncStates       CommentSyncState[]

  @@unique([externalId])
  @@unique([id, threadId], map: "comments_id_thread_id_key")
  @@index([threadId, createdAt])
  @@index([parentCommentId])
  @@index([authorId])
  // ISS-12775: covers the Branches list Collaborator identity's comment reads
  // (thread, id, created_at, author of live comments) so they skip the wide heap.
  @@index([threadId, id, createdAt, authorId], map: "comments_thread_live_cover_idx", where: raw("(deleted_at IS NULL)"))
  @@map("comments")
}

// ISS-11212: one row per (thread or comment, provider, direction). Exactly one
// of threadId / commentId is set, enforced by a CHECK in the migration because
// Prisma cannot declare it. The uniques lead with the FK column, so they also
// serve the cascade from comment_threads and comments.
model CommentSyncState {
  id                String               @id @default(uuid(7)) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  threadId          String?              @map("thread_id") @db.Uuid
  commentId         String?              @map("comment_id") @db.Uuid
  provider          CommentSyncProvider
  direction         CommentSyncDirection
  state             CommentSyncStatus
  syncedRevision    Int?                 @map("synced_revision")
  providerUpdatedAt DateTime?            @map("provider_updated_at")
  attempts          Int                  @default(0)
  lastErrorCode     String?              @map("last_error_code")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id])
  thread       CommentThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  comment      Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([threadId, provider, direction])
  @@unique([commentId, provider, direction])
  @@map("comment_sync_states")
}

// Provider-specific projection for GitHub comment identity and reply metadata.
// Parent/child structure remains generic through Comment.parentCommentId.
model GitHubCommentProjection {
  commentId                String    @id @map("comment_id") @db.Uuid
  threadId                 String    @map("thread_id") @db.Uuid
  externalAuthorId         String?   @map("external_author_id") @db.Uuid
