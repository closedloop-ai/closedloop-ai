  UNINSTALLED
}

// Distinguishes manually created API keys from desktop-managed bootstrap keys.
enum ApiKeySource {
  USER_CREATED
  DESKTOP_MANAGED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum LoopStatus {
  PENDING
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
  // Deferred at dispatch because a linked blocking artifact is still
  // non-terminal. Re-evaluated by the loop reconciliation cron, which
  // transitions BLOCKED -> PENDING once every blocker resolves. Non-claimable
  // (the orchestrator only claims PENDING loops) and non-terminal.
  BLOCKED
}

enum LoopCommand {
  PLAN
  EXECUTE
  CHAT
  EXPLORE
  REQUEST_CHANGES
  DECOMPOSE
  EVALUATE_PRD
  GENERATE_PRD
  EVALUATE_PLAN
  EVALUATE_CODE
  REQUEST_PRD_CHANGES
  BOOTSTRAP
  MANUAL
  EVALUATE_FEATURE
}

// Discriminates how a SessionDetail row was produced: a synced desktop agent
// run (DESKTOP_SYNC) vs. a materialized orchestration Loop (LOOP). Lets the
// unified Sessions list tell the two apart. See FEA-1718 / PLN-921.
enum SessionOrigin {
  DESKTOP_SYNC
  LOOP
}

enum CustomFieldType {
  TEXT
  NUMBER
  ENUM
  MULTI_ENUM
  DATE
  PEOPLE
  REFERENCE
  REFERENCE_MULTI
}

// Which domain entity a custom field definition, setting, or value attaches to.
// PROJECT resolves against `projects`; every other value resolves against
// `artifacts`, discriminated by the matching `ArtifactType` — so `entityId` is
// an `Artifact.id` for all three and the entity type is what stops one
// artifact kind being addressed as another (ISS-7209).
//
// ADDING A MEMBER? It must also be added to the orphan-reap trigger in
// prisma/migrations/20260820140000_iss7209_custom_field_artifact_orphan_cleanup/migration.sql,
// as a NEW migration — that one is applied and immutable. The trigger's
// `entity_type IN ('DOCUMENT','SESSION','BRANCH')` list is raw SQL and cannot be
// tied to this enum mechanically, so nothing will fail typecheck or CI if you
// skip it: the new type's settings and values would simply outlive their
// deleted artifact and be re-read by whatever artifact next presents that
// `entity_id`. Add it there IF AND ONLY IF the new type addresses `artifacts.id`
// — PROJECT does not, and is excluded on purpose. The TypeScript consumers of
// this enum are guarded (exhaustive `Record`/`switch` with a `never` arm), so
// they will red `tsc` on their own; the trigger is the one that will not.
enum CustomFieldEntityType {
  PROJECT
  DOCUMENT
  SESSION
  BRANCH
}

// The target populations a REFERENCE / REFERENCE_MULTI field may point at
// (ISS-7208). Deliberately NOT `ArtifactType`: the product contract is the four
// "sources" the add-field dialog offers, and ISSUE is an `ArtifactSubtype` of
// DOCUMENT rather than a type of its own, so no single existing enum spans the
// set. The source → artifact predicate mapping is resolved in exactly one place
// (`apps/api/app/custom-fields/reference-targets.ts`).
enum ReferenceTargetSource {
  ARTIFACT
  SESSION
  ISSUE
  BRANCH
}

// Display format for NUMBER custom fields.
//
// DURATION (ISS-7210) renders `custom_field_values.number_value` as an elapsed
// span. Its CANONICAL STORAGE UNIT IS MILLISECONDS — the same unit every other
// elapsed span in this schema and in `@repo/api` uses (`durationMs`,
// `duration_ms`), so a cycle-time column can be populated from those sources
// without a conversion step. A duration stored in any other unit is a bug.
enum NumberFormat {
  NONE
  CURRENCY
  PERCENTAGE
  CUSTOM
  DURATION
}

enum LabelPosition {
  PREFIX
  SUFFIX
}

enum ThreadSource {
  NATIVE
  LIVEBLOCKS
  GITHUB
}

enum ThreadStatus {
  OPEN
  RESOLVED
}

enum CommentAnchorState {
  ANCHORED
  MOVED
  OUTDATED
  ORPHANED
}

enum CommentBodyFormat {
  RICH_V1
  MARKDOWN
  LIVEBLOCKS_V1
}

enum CommentSyncProvider {
  DESKTOP
  GITHUB
  LIVEBLOCKS
}

enum CommentSyncDirection {
  INBOUND
  OUTBOUND
  BOTH
}

enum CommentReanchorMode {
  MISSING
  FULL
}

enum CommentSyncStatus {
  SYNCED
  PENDING
  FAILED
  ABANDONED
}

enum ExternalCommentProvider {
  GITHUB
}

enum GitHubCommentThreadKind {
  REVIEW_THREAD
  ISSUE_COMMENT
  // ISS-11212 (PLN-2122 decision 6): a review's summary body, one thread per review.
  REVIEW_SUMMARY
}

// ISS-11767 (PLN-2174): the independent GitHub lists a pull request's comment
// reconcile reads, and the outcome of the latest read of each.
enum PullRequestCommentLane {
  ISSUE_COMMENTS
  REVIEW_COMMENTS
  REVIEWS
}

enum PullRequestCommentLaneStatus {
  COMPLETE
  CEILING
  SHIFTED
  FAILED
}

enum GitHubDiffSide {
  LEFT
  RIGHT
}

enum GitHubLegacyCommentState {
  PENDING
  ADDRESSED
  DISMISSED
}

enum PreferredComputeMode {
  LOCAL
  CLOUD
}

// Kinds of first-class artifacts tracked in the `artifacts` parent table.
// Added in Chunk 2a of PLN-321 alongside the Artifact/DocumentDetail models.
enum ArtifactType {
  DOCUMENT
  BRANCH
  DEPLOYMENT
  SESSION
}

// Narrower classification for DOCUMENT-typed artifacts (carries values that
// used to live on the legacy DocumentType enum). Null for PRs and deployments.
//
// FEA-3956 (PRD-560 Phase 3): `ISSUE` is the canonical value for the Feature →
// Issue rename, ADDED here (additive, non-destructive) so the column accepts it
// from a skewed newer client. Per PRD-560 decision 2 existing rows are NOT
// migrated — they stay stored as `FEATURE`, and the API/wire boundary maps the
// canonical `ISSUE` input back to the persisted `FEATURE` in code
// (`normalizeArtifactSubtype`). `FEATURE` remains a permanent compat alias;
// removing it is Phase 4 (FEA-3957) and needs explicit human approval.
enum ArtifactSubtype {
  PRD
  IMPLEMENTATION_PLAN
  TEMPLATE
  FEATURE
  DOC
  ISSUE
}

// =============================================================================
// CORE ENTITIES
// =============================================================================

model PreviewSchema {
  schemaName String   @id @map("schema_name")
  branch     String?
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@map("preview_schemas")
}

model PreviewSchemaObservation {
  schemaName      String   @id @map("schema_name")
  firstObservedAt DateTime @default(now()) @map("first_observed_at") @db.Timestamptz

  @@map("preview_schemas_observations")
}

model ArtifactLinkTreePage {
  snapshotId     String       @map("snapshot_id") @db.Uuid
  offset         Int
  organizationId String       @map("organization_id") @db.Uuid
  queryKey       String       @map("query_key")
  linkIds        String[]     @map("link_ids") @db.Uuid
  hasMore        Boolean      @map("has_more")
  createdAt      DateTime     @default(now()) @map("created_at")
  expiresAt      DateTime     @map("expires_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([snapshotId, offset])
  @@index([organizationId, queryKey, offset, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("artifact_link_tree_pages")
}

model Organization {
  artifactLinkTreePages ArtifactLinkTreePage[]

  id                    String    @id @default(uuid(7)) @db.Uuid
  clerkId               String    @unique @map("clerk_id")
  active                Boolean   @default(true) @map("active")
  name                  String
  slug                  String    @unique
  claudeApiKeyEncrypted String?   @map("claude_api_key_encrypted") @ignore
  claudeApiKeyLastFour  String?   @map("claude_api_key_last_four") @ignore
  claudeApiKeySetAt     DateTime? @map("claude_api_key_set_at") @ignore
  settings              Json      @default("{}")
  // Privacy gate for unified search over AI session transcript CONTENT (FEA-3930,
  // parent FEA-3800). Default false: transcript text (which can carry source,
  // secrets, and prompts) is NOT indexed into `search_document` or returned by the
  // FTS query unless an org admin opts in. Both the write-time indexer and the
  // query path check this flag, so flipping it off stops new indexing and hides
  // any `agent_session` rows left from when it was on.
  searchIncludeTranscripts Boolean @default(false) @map("search_include_transcripts")
  // ISS-11449: physical compatibility column retained until the follow-up
  // destructive migration. FEA-4169's org-wide session-sync policy is retired —
  // nothing reads or writes this any more — but the read-removal must ship and
  // deploy before the DROP (docs/runbooks/backward-compatible-api-contracts.md),
  // and `prisma migrate dev` reports drift if the field leaves the schema while
  // the column is still in the database. `@ignore` keeps it out of the generated
  // Prisma client, so it is unreachable from code, exactly as `SessionDetail.branch`
  // does for ISS-4742. Do not add a reader; the follow-up deletes this line.
  sessionSyncPolicyEnabled Boolean @default(true) @map("session_sync_policy_enabled") @ignore
  // ISS-6590: durable completion marker for the GitHubRepoSyncState bootstrap.
  // Set ONLY after a pass upserts a row for every candidate repo without a
  // single per-repo failure. The cron used to settle the org on "has >= 1 sync
  // state row", so a pass that died part-way (transient DB error, or the route
  // hitting maxDuration mid-org) retired the org permanently with most of its
  // repos still missing a row — and therefore invisible to the PR reconciler.
  githubRepoSyncBootstrappedAt DateTime? @map("github_repo_sync_bootstrapped_at")
  // ISS-6590: claimed BEFORE each bootstrap pass, success or not, so the
  // selector's `createdAt asc` ordering cannot park a permanently-failing org at
  // the head of every batch and starve the orgs behind it.
  githubRepoSyncBootstrapAttemptedAt DateTime? @map("github_repo_sync_bootstrap_attempted_at")
  // ISS-7132: the `updated_at` Clerk stamped on the payload this mirror row was
  // last written from — Clerk's clock, NOT ours, so it is the only value that
  // orders two deliveries against each other. Svix is at-least-once and
  // unordered, so a retry or a late delivery would otherwise write an OLDER
  // name/slug over a newer one; `slug` is the `[orgSlug]` routing key, so that
  // reverts every org URL. Every Clerk-sourced write gates on this being
  // strictly older than the incoming payload. Nullable: rows that predate this
  // column (and rows created by `findOrCreateByClerkId`, whose payload has no
  // organization-level timestamp) have never been stamped and accept the first
  // Clerk write, which then stamps them.
  clerkUpdatedAt        DateTime? @map("clerk_updated_at")
  // PLN-2187 T-2.6 (ISS-11216): set the first time `document-unified-comments`
  // reads on for the org; from then on its document comments are written to
  // Postgres whatever a later flag lookup answers. Retired with the flag by C19.
  documentCommentsSwitchedAt DateTime? @map("document_comments_switched_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  users                     User[]
  teams                     Team[]
  artifactRatings           ArtifactRating[]
  projects                  Project[]
  artifacts                 Artifact[]
  githubInstallation        GitHubInstallation?
  loops                     Loop[]
  prompts                   Prompt[]
  computeTargets            ComputeTarget[]
  computeTargetHealthChecks ComputeTargetHealthCheck[]
  sessionTranscripts        SessionTranscript[]
  judgeHumanScores          JudgeHumanScore[]
  customFields              CustomField[]
  commentThreads            CommentThread[]
  commentSyncStates         CommentSyncState[]
  agents                    Agent[]
  repoBootstrapConfigs      RepoBootstrapConfig[]
  userPublicKeys            UserPublicKey[]
  agentComponents           AgentComponent[]
  agentComponentVersions    AgentComponentVersion[]
  definitionVersions        DefinitionVersion[]
  sourceOccurrences         SourceOccurrence[]
  catalogItems              CatalogItem[]
  distributions             Distribution[]
  publicRepositories        PublicRepository[]
  externalCommentAuthors    ExternalCommentAuthor[]
  prVerificationStampBackfills PullRequestVerificationStampBackfill[]
  githubUserConnections     GitHubUserConnection[]
  githubAccessCapabilities  GitHubAccessCapability[]
  githubRepoSyncStates      GitHubRepoSyncState[]
  githubObservedRepositories GitHubObservedRepository[]
  tags                      Tag[]
  linearSubtasks            LinearSubtask[]
  penseroIntegration        PenseroIntegration?
  desktopSessions           DesktopSession[]
  githubDirtyScopeNudges    GitHubDirtyScopeNudge[]
  prMaterializationRetries PrMaterializationRetry[]
  branchMaterializationRetries BranchMaterializationRetry[]
  commentReanchorRequests  CommentReanchorRequest[]
  branchAnalyticsRollupState BranchAnalyticsRollupState?
  branchAnalyticsSessionRollups BranchAnalyticsSessionRollup[]
  branchDetails             BranchDetail[]
  branchActivityAtoms       BranchActivityAtom[]
  monitoredSessionActivityQuarantines MonitoredSessionActivityQuarantine[]
  pullRequestDetails        PullRequestDetail[]
  repositoryDefaultObservationReceipts RepositoryDefaultObservationReceipt[]
  commitDetails             CommitDetail[]
  auditEntries              AuditEntry[]
  auditOutboxEntries        AuditOutbox[]
  deploymentEvents          DeploymentEvent[]
  deliveryPoints            DeliveryPoint[]
  deliveryPointArtifacts    DeliveryPointArtifact[]
  onboardingAttempts        OnboardingAttempt[]
  gridPreferences           GridPreference[]
  penseroBackfillDays       PenseroBackfillDay[]
  penseroBackfillCursor     PenseroBackfillCursor?
  sessionMeshMessages       SessionMeshMessage[]
  sessionMeshPresences      SessionMeshPresence[]
  sessionMeshDeliveries     SessionMeshDelivery[]
  sessionMeshMetricEvents   SessionMeshMetricEvent[]
  sessionMeshSubscriptions  SessionMeshSubscription[]

  @@map("organizations")
}

model User {
  id                       String                @id @default(uuid(7)) @db.Uuid
  clerkId                  String                @map("clerk_id")
  organizationId           String                @map("organization_id") @db.Uuid
  active                   Boolean               @default(true) @map("active")
  email                    String
  firstName                String?               @map("first_name")
  lastName                 String?               @map("last_name")
  avatarUrl                String?               @map("avatar_url")
  phoneNumber              String?               @map("phone_number")
  role                     ApproverRole          @default(ENGINEER)
  linearId                 String?               @map("linear_id")
  slackId                  String?               @map("slack_id")
  githubUsername           String?               @map("github_username")
  claudeApiKeyEncrypted    String?               @map("claude_api_key_encrypted") @ignore
  claudeApiKeyLastFour     String?               @map("claude_api_key_last_four") @ignore
  claudeApiKeySetAt        DateTime?             @map("claude_api_key_set_at") @ignore
  preferredComputeMode     PreferredComputeMode? @map("preferred_compute_mode") @ignore
  preferredComputeTargetId String?               @map("preferred_compute_target_id") @db.Uuid @ignore
  preferredHarness         String?               @map("preferred_harness") @ignore
  onboardingChecklistDismissedAt DateTime?        @map("onboarding_checklist_dismissed_at")
  // ISS-7132: the `updated_at` Clerk stamped on the `user.*` payload this row's
  // profile columns were last written from. Same ordering guard, and same
  // reason, as `Organization.clerkUpdatedAt`.
  clerkUpdatedAt           DateTime?             @map("clerk_updated_at")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  // Relations
  organization                Organization                        @relation(fields: [organizationId], references: [id])
  preferredComputeTarget      ComputeTarget?                      @relation("UserPreferredComputeTarget", fields: [preferredComputeTargetId], references: [id]) @ignore
  teamMemberships             TeamMember[]
  artifactRatings             ArtifactRating[]
  favoriteProjects            FavoriteProject[]
  favoriteArtifacts           FavoriteArtifact[]
  assignedProjects            Project[]                           @relation("ProjectAssignee")
  createdProjects             Project[]                           @relation("ProjectCreatedBy")
  assignedArtifacts           Artifact[]                          @relation("ArtifactAssignee")
  createdArtifacts            Artifact[]                          @relation("ArtifactCreatedBy")
  approvedDocumentDetails     DocumentDetail[]                    @relation("DocumentDetailApprover")
  loops                       Loop[]
  computeTargets              ComputeTarget[]
  judgeHumanScores            JudgeHumanScore[]
  createdCustomFields         CustomField[]
  updatedCustomFieldValues    CustomFieldValue[]
  dismissedGenerationStatuses DocumentGenerationStatusDismissal[]
  createdAgents               Agent[]                             @relation("AgentCreatedBy")
  agentVersionChanges         AgentVersion[]                      @relation("AgentVersionChangedBy")
  publicKeys                  UserPublicKey[]
  externalCommentAuthors      ExternalCommentAuthor[]
  githubUserConnections       GitHubUserConnection[]
  createdTags                 Tag[]                               @relation("TagCreatedBy")
  desktopSessions             DesktopSession[]
  createdCatalogItems         CatalogItem[]                       @relation("CatalogItemCreatedBy")
  changedCatalogItemVersions  CatalogItemVersion[]                @relation("CatalogItemVersionChangedBy")
  createdDistributions        Distribution[]                      @relation("DistributionCreatedBy")
  withdrawnDistributions      Distribution[]                      @relation("DistributionWithdrawnBy")
  distributionTargetStatuses  DistributionTargetStatus[]          @relation("DistributionTargetStatusUser")
  definitionVersionEdits      DefinitionVersionEditor[]           @relation("DefinitionVersionEditor")
  deliveryPoints              DeliveryPoint[]
  onboardingAttempts          OnboardingAttempt[]
  gridPreferences             GridPreference[]
  sessionMeshMessages         SessionMeshMessage[]
  sessionMeshPresences        SessionMeshPresence[]
  sessionMeshDeliveries       SessionMeshDelivery[]
  sessionMeshMetricEvents     SessionMeshMetricEvent[]
  sessionMeshSubscriptions    SessionMeshSubscription[]

  @@unique([organizationId, email])
  @@unique([clerkId, organizationId])
  @@index([clerkId])
  @@index([linearId])
  @@index([slackId])
  @@index([githubUsername])
  @@map("users")
}

model UserPublicKey {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  publicKeyBase64 String   @map("public_key_base64")
  fingerprint     String
  createdAt       DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([organizationId])
  @@map("user_public_keys")
}

// Organization-wide mesh state. `agentId` is the canonical runtime identity,
// never a scheduler slot alias (which is not stable or routable).
model SessionMeshPresence {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  agentId           String   @map("agent_id")
  repository        String
  revision          String
  dirtyStateHash    String?  @map("dirty_state_hash")
  configurationHash String?  @map("configuration_hash")
  harness          String    @default("unknown")
  capabilities     Json      @default("[]")
  lineage          Json      @default("{}")
  context          Json      @default("{}")
  paths             Json     @default("[]")
  symbols           Json     @default("[]")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, agentId])
  @@index([organizationId, repository, expiresAt])
  @@index([expiresAt])
  @@map("session_mesh_presences")
}

model SessionMeshMessage {
  id                String   @id @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  authorUserId      String   @map("author_user_id") @db.Uuid
  authorAgentId     String?  @map("author_agent_id")
  idempotencyKey    String   @map("idempotency_key")
  recipientAgentIds Json     @default("[]") @map("recipient_agent_ids")
  replyToMessageId  String?  @map("reply_to_message_id") @db.Uuid
  kind              String
  repository        String
  revision          String
  dirtyStateHash    String?  @map("dirty_state_hash")
  configurationHash String?  @map("configuration_hash")
  lineage           Json     @default("{}")
  paths             Json     @default("[]")
  symbols           Json     @default("[]")
  summary           String
  context           Json     @default("{}")
  sensitivity       String   @default("normal")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User                  @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  deliveries   SessionMeshDelivery[]
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, repository, revision, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, replyToMessageId, createdAt])
  @@index([expiresAt])
  @@map("session_mesh_messages")
}

model SessionMeshDelivery {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  messageId        String    @map("message_id") @db.Uuid
  recipientUserId  String    @map("recipient_user_id") @db.Uuid
  recipientAgentId String    @map("recipient_agent_id")
  relevance        Json      @default("{}")
  status           String    @default("queued")
  attemptCount     Int       @default(0) @map("attempt_count")
  attemptedAt      DateTime? @map("attempted_at")
  failedAt         DateTime? @map("failed_at")
  heldAt           DateTime? @map("held_at")
  refusedAt        DateTime? @map("refused_at")
  dismissedAt      DateTime? @map("dismissed_at")
  failureReason    String?   @map("failure_reason")
  queuedAt         DateTime  @default(now()) @map("queued_at")
