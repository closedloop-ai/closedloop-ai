// Relationship types between entities (source → target, where source is the origin/cause)
enum LinkType {
  PRODUCES // source produces target (PRD → Plan, Plan → PR, PR → Preview)
  BLOCKS // source blocks target (Feature blocks Feature)
  RELATES_TO // bidirectional association (Feature ↔ Feature)
}

// Advisory only — not bound to any column (Artifact.status is a freeform
// String). Documents are PRD/IMPLEMENTATION_PLAN/TEMPLATE subtypes; their
// authoring/approval lifecycle. SSOT: @repo/loops-api/document. PRD-495.
enum DocumentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  EXECUTED
  OBSOLETE
}

// Advisory only — not bound to any column. Features (subtype = FEATURE); their
// delivery / issue-tracker lifecycle. SSOT: @repo/loops-api/document.
enum FeatureStatus {
  TRIAGE
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELED
}

enum EvaluationReportType {
  PLAN
  CODE
  PRD
  FEATURE
}

enum EvalStatus {
  FAILED
  NEEDS_IMPROVEMENT
  PASSED
}

enum PromptType {
  AGENT
  JUDGE
}

enum ApproverRole {
  PM
  DESIGNER
  TECH_LEAD
  ENGINEER
  STAKEHOLDER
}

enum GitHubPRState {
  OPEN
  MERGED
  CLOSED
}

enum ChecksStatus {
