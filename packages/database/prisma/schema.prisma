// =============================================================================
// DESKTOP SESSION AUTH (FEA-1514 / FEA-2215)
// First-party desktop sessions. Short-lived access tokens are stateless JWTs
// (see packages/auth/desktop-session-jwt.ts); only the rotating refresh-token
// family is persisted here, and only as a hash. Session + refresh-token family
// are bound to the desktop device public key so a stolen refresh token alone
// cannot mint a new access token.
// =============================================================================

model DesktopSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  gatewayId      String    @map("gateway_id")
  boundPublicKey String    @map("bound_public_key")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  expiresAt      DateTime  @map("expires_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens DesktopRefreshToken[]

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  // Supports findActiveDeviceSession (PRD-532 PR-K): newest live session for a
  // given user/org/gateway. Leading equality columns userId/organizationId/
  // gatewayId; revokedAt narrows to non-revoked rows.
  @@index([userId, organizationId, gatewayId, revokedAt])
  @@map("desktop_sessions")
}

model DesktopRefreshToken {
  id                 String    @id @default(uuid(7)) @db.Uuid
  sessionId          String    @map("session_id") @db.Uuid
  familyId           String    @map("family_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  expiresAt          DateTime  @map("expires_at")
  lastUsedAt         DateTime? @map("last_used_at")
  revokedAt          DateTime? @map("revoked_at")
  replacedByTokenId  String?   @map("replaced_by_token_id") @db.Uuid
  rotatedFromTokenId String?   @map("rotated_from_token_id") @db.Uuid

  session DesktopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("desktop_refresh_tokens")
}

model Project {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  name            String
  description     String?
  // ISS-9833 (ruled 2026-09-14): a project's priority is the same field as an
  // artifact's — nullable, no default, explicit null clears. It stays on
  // `projects` because there is no PROJECT member of ArtifactType and so no
  // artifact row to move it to. Rows already storing MEDIUM are kept as-is by
  // that ruling: a value a 2026-02-24 migration rewrote from NOT_SET cannot be
  // told apart from one a human chose.
  priority        Priority?
  status          ProjectStatus @default(NOT_STARTED)
  assigneeId      String?       @map("assignee_id") @db.Uuid
  createdById     String        @map("created_by_id") @db.Uuid
  slug            String?
  targetDate      DateTime?     @map("target_date")
  codebaseSummary String?       @map("codebase_summary")
  lastIndexedAt   DateTime?     @map("last_indexed_at")
  settings        Json          @default("{}")
  sortOrder       Int?          @map("sort_order")
  // PRD-726: write-maintained hierarchy versions keep page cursors O(1) to validate.
  hierarchyVersion String      @default("54b7ae02659c70d4cfc6c47f172e519b") @map("hierarchy_version") @ignore
  hierarchyMutationVersion String @default("e3b0c44298fc1c149afbf4c8996fb924") @map("hierarchy_mutation_version") @ignore
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  organization Organization      @relation(fields: [organizationId], references: [id])
  assignee     User?             @relation("ProjectAssignee", fields: [assigneeId], references: [id])
  createdBy    User              @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  artifacts    Artifact[]
  teams        ProjectTeam[]
  favoritedBy  FavoriteProject[]
  tagProjects  TagProject[]
  rankEvents   ProjectRankEvent[]

  @@unique([organizationId, slug])
  @@index([assigneeId])
  @@index([createdById])
  @@map("projects")
}

/// Append-only record of one atomic BULK root-artifact rank rewrite
/// (`POST /projects/:id/artifacts/rank`, ISS-8999).
///
/// Deliberately NOT `artifact_activity_events`: that log is the per-artifact
/// change feed a person's edits land in, and one bulk rewrite that re-ranks
/// every root in a project is a single machine-scale operation, not N human
/// drags. Keeping it in its own table means no consumer of the activity feed
/// can read these writes as human drag labels.
///
/// `source` is a freeform string validated by the `BulkRankMutationSource`
/// const object in `@repo/api`, mirroring the `Artifact.status` precedent so
/// the vocabulary grows without a migration per value.
///
/// `idempotency_key` is also the replay key. The unique index below is claimed
/// with ON CONFLICT DO NOTHING inside the same transaction as the rank rewrite,
/// so a retry after a timeout either re-applies (the first attempt rolled back
/// and released the claim) or replays this row's committed result.
model ProjectRankEvent {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  projectId          String   @map("project_id") @db.Uuid
  idempotencyKey     String   @map("idempotency_key")
  source             String
  /// The requesting principal, when one is known. Recording it does not make
  /// the write a human drag label: the operation's kind is this table plus
  /// `source`, never the actor.
  actorUserId        String?  @map("actor_user_id") @db.Uuid
  /// The epoch this operation committed, as returned to the caller.
  rankEpoch          String   @map("rank_epoch")
  /// The committed order, top first. Replayed verbatim on an idempotent retry.
  orderedArtifactIds String[] @map("ordered_artifact_ids") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@map("project_rank_events")
}

