{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // Browser-safety guard (see AGENTS.md): with no ambient @types/node in scope,
    // any use of `Buffer`/`process`/`node:*` in a lib module fails typecheck.
    // `TextEncoder`/`TextDecoder`/`URL` come from the base `lib` (DOM + es2022),
    // so universal Web APIs stay available.
    "types": [],
    // Redundant for `tsc` — every `@repo/*` here already resolves through the
    // workspace symlink to the same files. It is load-bearing for PLAYWRIGHT:
    // its transform picks the tsconfig NEAREST each file it compiles, so a
    // `packages/lib` module pulled into a spec is resolved against THIS file,
    // not the root one that carries the mapping. Without it a bare
    // `@repo/api/src/types/branch` falls back to Node resolution, which needs
    // the extension these sources do not write, and the whole spec aborts at
    // load with `Cannot find module …/node_modules/@repo/api/src/types/branch`
    // (ISS-6949). Keep this in step with the root tsconfig's `@repo/*` entry.
    "paths": {
      "@repo/*": ["../*"]
    }
  },
  "include": ["**/*.ts"],
  // `vitest.config.ts` imports `vitest/config`, whose types transitively pull in
  // @types/node globals and would leak `Buffer`/`process` into the whole program,
  // silently defeating the `types: []` guard above. It is config, not shipped
  // code, and vitest loads it at runtime — so keep it out of the typecheck. Test
  // files (`*.test.ts`) stay checked; they are browser-safe like the code.
  "exclude": ["node_modules", "dist", "vitest.config.ts"]
}
