{
  "name": "@repo/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist *.tsbuildinfo node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false --incremental --tsBuildInfoFile ./tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@closedloop-ai/loops-api": "workspace:*",
    "@closedloop-ai/telemetry-contract": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "1.39.0",
    "@repo/api": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "react": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
