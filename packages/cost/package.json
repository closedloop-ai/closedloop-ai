{
  "name": "@repo/cost",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "dependencies": {
    "@pydantic/genai-prices": "0.0.66"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist *.tsbuildinfo node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false --incremental --tsBuildInfoFile ./tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=src/**/*.{ts,tsx}'",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "private": true
}
