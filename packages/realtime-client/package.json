{
  "name": "@repo/realtime-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./port": "./src/port.ts",
    "./connection": "./src/connection.ts",
    "./poll": "./src/poll.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist *.tsbuildinfo node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false --incremental --tsBuildInfoFile ./tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@repo/realtime-contract": "workspace:*",
    "socket.io-client": "^4.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^25.3.5",
    "socket.io": "^4.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
