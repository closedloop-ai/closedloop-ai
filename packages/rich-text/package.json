{
  "name": "@repo/rich-text",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist *.tsbuildinfo node_modules",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=*.{ts,tsx}'",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false --incremental --tsBuildInfoFile ./tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@repo/api": "workspace:*",
    "@repo/design-system": "workspace:@closedloop-ai/design-system@*",
    "@tiptap/core": "~3.22.3",
    "@tiptap/extension-list": "~3.22.3",
    "@tiptap/extension-placeholder": "~3.22.3",
    "@tiptap/extension-table": "~3.22.3",
    "@tiptap/extension-table-cell": "~3.22.3",
    "@tiptap/extension-table-header": "~3.22.3",
    "@tiptap/extension-table-row": "~3.22.3",
    "@tiptap/markdown": "~3.22.3",
    "@tiptap/pm": "~3.22.3",
    "@tiptap/react": "~3.22.3",
    "@tiptap/starter-kit": "~3.22.3",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^0.556.0",
    "mermaid": "^11.16.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@repo/typescript-config": "workspace:*",
    "jsdom": "^30.0.1",
    "react-dom": "19.2.8",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
