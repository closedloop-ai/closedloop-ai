{
  "name": "@closedloop-ai/shared-platform",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./detection-store": {
      "types": "./dist/detection-store.d.ts",
      "import": "./dist/detection-store.js",
      "require": "./dist/detection-store.cjs",
      "default": "./dist/detection-store.js"
    },
    "./gateway-constants": {
      "types": "./dist/gateway-constants.d.ts",
      "import": "./dist/gateway-constants.js",
      "require": "./dist/gateway-constants.cjs",
