      "require": "./dist/relay-request-model.cjs",
      "default": "./dist/relay-request-model.js"
    },
    "./routing-store": {
      "types": "./dist/routing-store.d.ts",
      "import": "./dist/routing-store.js",
      "require": "./dist/routing-store.cjs",
      "default": "./dist/routing-store.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js",
      "require": "./dist/storage.cjs",
