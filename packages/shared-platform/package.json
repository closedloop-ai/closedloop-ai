    },
    "./gateway-fetch-shim": {
      "types": "./dist/gateway-fetch-shim.d.ts",
      "import": "./dist/gateway-fetch-shim.js",
      "require": "./dist/gateway-fetch-shim.cjs",
      "default": "./dist/gateway-fetch-shim.js"
    },
    "./gateway-probe": {
      "types": "./dist/gateway-probe.d.ts",
      "import": "./dist/gateway-probe.js",
      "require": "./dist/gateway-probe.cjs",
      "default": "./dist/gateway-probe.js"
    },
    "./keyless-telemetry": {
      "types": "./dist/keyless-telemetry.d.ts",
      "import": "./dist/keyless-telemetry.js",
      "require": "./dist/keyless-telemetry.cjs",
      "default": "./dist/keyless-telemetry.js"
    },
    "./parse-env-ms": {
      "types": "./dist/parse-env-ms.d.ts",
