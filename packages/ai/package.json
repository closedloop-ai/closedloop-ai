{
  "name": "@repo/ai",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist *.tsbuildinfo node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false --incremental --tsBuildInfoFile ./tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=*.{ts,tsx}' '--coverage.include=lib/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.75",
    "@ai-sdk/openai": "^3.0.62",
    "@ai-sdk/provider": "^3.0.10",
    "@ai-sdk/react": "^3.0.177",
    "@t3-oss/env-nextjs": "^0.13.11",
    "ai": "^6.0.175",
    "react": "19.2.9",
    "streamdown": "^2.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
