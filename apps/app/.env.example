# apps/app (:3000) — authenticated product UI.
#
# Prefer the single-file setup: `cp local.env.example local.env && pnpm env:local`
# links one root file into every app instead of six copies you keep in sync.
# This per-app file remains supported for anyone who wants app-only overrides.

# Server
# Sign-in needs BOTH of these: the (authenticated) layout calls auth() +
# currentUser() server-side, so a publishable key alone leaves every authed
# route redirecting to /sign-in.
# CLERK_SECRET_KEY="sk_..."
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."

# Uncomment and fill these when you have service credentials:
# CLERK_WEBHOOK_SECRET="whsec_..."
# RESEND_FROM=""
# RESEND_TOKEN=""
# SVIX_TOKEN=""
# LIVEBLOCKS_SECRET=""
VERCEL_PROJECT_PRODUCTION_URL="http://localhost:3000"

# Desktop trusted-config relay origin. Leave unset for Closedloop production,
# which defaults to https://relay.closedloop.ai. Set this for self-hosted,
# staging, or custom relay deployments. Local `just dev` provides
# RELAY_API_URL=http://localhost:3020 automatically; without that, localhost
# falls back to NEXT_PUBLIC_API_URL.
CL_RELAY_ORIGIN=""

# Client
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-..."
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Explicit environment name. Set in Vercel project settings to "production",
# "stage", or "development". When absent, getAppEnvironment() falls back to
# URL substring detection (localhost → local, "stage" in URL → stage, else prod).
# NEXT_PUBLIC_APP_ENVIRONMENT="development"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
# apps/web serves the Fumadocs /docs section; there is no separate docs app.
NEXT_PUBLIC_DOCS_URL="http://localhost:3001/docs"

# E2E testing (Playwright) — required for `pnpm test:e2e`
# DEVOPS_CLOSEDLOOP_APP_PWD: password for the shared devops+testing@closedloop.ai Clerk account
# CLERK_TESTING_TOKEN: Clerk testing token from https://dashboard.clerk.com → Testing
DEVOPS_CLOSEDLOOP_APP_PWD=""
CLERK_TESTING_TOKEN=""
# ISS-9244. Set to "true" on a DEPLOYED E2E target (stage) so the server stops
# pre-resolving feature flags into the RSC payload and the localStorage fixture
# a spec seeds can pin them. Server-only, never NEXT_PUBLIC_: a visitor must have
# no channel to set it. Takes effect ONLY where NEXT_PUBLIC_APP_ENVIRONMENT is
# explicitly "stage" or "development" — an undeclared deployment keeps the
# bootstrap, so setting this alone on a project that never declared itself does
# nothing by design.
# E2E_SUPPRESS_FEATURE_FLAG_BOOTSTRAP="true"

# Linear OAuth initiation (client_id only - secret stays in API)
LINEAR_CLIENT_ID=""

# GitHub App (slug for install URL - OAuth credentials are in API only)
NEXT_PUBLIC_GITHUB_APP_SLUG=""

# Strict CSP (report-only until ISS-7475 flips enforcement) — all optional.
# CSP_EXTRA_IMG_SRC / CSP_EXTRA_CONNECT_SRC take comma-separated https://
# origins for per-environment hosts (presigned S3 attachment/transcript
# buckets). An attachment bucket usually belongs in BOTH vars: img-src to
# display, connect-src for the upload fetch PUT. Leave unused vars commented
# out; these keys treat an empty "" as unset (emptyStringAsUndefined in
# @repo/security keys).
# CSP_ENABLED="true"
# CSP_REPORT_URI=""
# CSP_EXTRA_IMG_SRC=""
# CSP_EXTRA_CONNECT_SRC=""
