{
  "name": "storybook",
  "version": "11.2.0",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "catalog:sync": "node ./scripts/sync-component-catalog.mjs",
    "validate:catalog": "node ./scripts/validate-story-titles.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "test:storybook": "STORYBOOK_BROWSER_TESTS=1 vitest run && pnpm test:branches-plays",
    "test:branches-plays": "node ./scripts/verify-branches-list-plays.mjs",
    "test:mcp": "node ./scripts/mcp-handshake.mjs",
    "test:coverage": "vitest run --coverage --coverage.allowExternal=true --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@repo/app": "workspace:*",
    "@repo/design-system": "workspace:@closedloop-ai/design-system@*",
    "@repo/navigation": "workspace:*",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.556.0",
    "next": "catalog:",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@repo/analytics": "workspace:*",
    "@repo/api": "workspace:*",
    "@repo/loops-api": "workspace:@closedloop-ai/loops-api@*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "axe-core": "^4.12.1",
    "chromatic": "^18.9.5",
    "jsdom": "^30.1.1",
    "playwright": "^1.56.0",
    "postcss": "^8.5.10",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.2"
  }
}
