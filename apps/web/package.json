{
  "name": "web",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "test": "NODE_ENV=test vitest run",
    "test:coverage": "NODE_ENV=test vitest run --coverage --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=**/*.{ts,tsx}'",
    "analyze": "ANALYZE=true npm run build",
    "clean": "git clean -xdf .cache .turbo dist *.tsbuildinfo node_modules",
    "generate:api-reference": "tsx scripts/generate-api-reference.ts",
    "typecheck": "fumadocs-mdx && tsc --noEmit --emitDeclarationOnly false --incremental --tsBuildInfoFile ./tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@arcjet/next": "1.12.0",
    "@next/third-parties": "16.0.7",
    "@radix-ui/react-icons": "^1.3.2",
    "@repo/analytics": "workspace:*",
    "@repo/api": "workspace:*",
    "@repo/app": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/design-system": "workspace:@closedloop-ai/design-system@*",
    "@repo/email": "workspace:*",
    "@repo/internationalization": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/security": "workspace:*",
    "@repo/seo": "workspace:*",
    "@rescale/nemo": "^2.1.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "date-fns": "^4.1.0",
    "fumadocs-core": "^16.8.5",
    "fumadocs-mdx": "14.3.1",
    "fumadocs-openapi": "10.8.6",
    "fumadocs-ui": "16.8.0",
    "import-in-the-middle": "^3.0.1",
    "lucide-react": "^0.556.0",
    "next": "catalog:",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "require-in-the-middle": "8.0.1",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "^30.1.1",
    "posthog-js": "1.359.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.2"
  }
