# apps/web (:3001) — marketing site plus the Fumadocs /docs section.
#
# Prefer the single-file setup: `cp local.env.example local.env && pnpm env:local`
# links one root file into every app instead of six copies you keep in sync.
#
# apps/web/env.ts extends only core/email/observability/security keys, so this is
# the thinnest surface in the repo — it needs no database and no Clerk secret.

# Server
# Uncomment and fill these when you have service credentials:
# RESEND_FROM=""
# RESEND_TOKEN=""
VERCEL_PROJECT_PRODUCTION_URL="http://localhost:3001"

# Client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
# This app serves /docs itself; there is no separate docs app.
NEXT_PUBLIC_DOCS_URL="http://localhost:3001/docs"
