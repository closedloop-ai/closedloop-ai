{
  "name": "realtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ./tsconfig.tsbuildinfo",
    "lint": "biome check src/",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.989.0",
    "@aws-sdk/credential-providers": "^3.1004.0",
    "@aws-sdk/rds-signer": "^3.1003.0",
    "@aws-sdk/util-format-url": "^3.972.7",
    "@opentelemetry/api": "^1.9.1",
    "@repo/http-service": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/realtime-contract": "workspace:*",
    "@repo/redis": "workspace:*",
    "@smithy/hash-node": "^4.2.11",
    "@smithy/signature-v4": "^5.3.11",
    "hono": "catalog:",
    "jose": "^6.2.12",
    "pg": "^8.20.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@repo/realtime-client": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/pg": "8.20.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
