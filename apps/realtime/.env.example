# apps/realtime (:3040) — the realtime WebSocket service.
#
# Prefer the single-file setup: `cp local.env.example local.env && pnpm env:local`
# links one root file into every app and generates the token key pair below.
#
# The service logs `realtime.env_invalid` and exits 1 when
# REALTIME_TOKEN_PUBLIC_KEYS, REDIS_URL or any of the five
# REALTIME_INTERNAL_OIDC_* keys below is missing or blank. A Redis or Postgres
# it cannot reach does not stop it: it runs, unready or degraded.
REDIS_URL="redis://localhost:6379"
# ElastiCache IAM auth (the cache name and IAM user id your infrastructure
# provisions for this service).
# Unset, every Redis connection uses REDIS_URL alone. Set either and both are
# required, plus AWS_REGION and a rediss:// REDIS_URL. The task role then
# re-signs a 15-minute token every few minutes, which every (re)connect uses,
# and each connection re-AUTHs (the subscriber reconnects) within 12 hours.
# REALTIME_REDIS_IAM_CACHE_NAME=""
# REALTIME_REDIS_IAM_USER_ID=""

# The dedicated `LISTEN realtime_signal` connection, which never runs any other
# statement. `password` auth needs REALTIME_PG_PASSWORD; `iam` mints an RDS IAM
# token per connect and needs AWS_REGION. With none of these set the service
# runs and never becomes ready; set any and the rest (all but REALTIME_PG_PORT,
# default 5432) are required. An unreachable Postgres leaves it up, not ready.
REALTIME_PG_AUTH="password"
REALTIME_PG_HOST="localhost"
REALTIME_PG_PORT="5432"
REALTIME_PG_USER="postgres"
REALTIME_PG_PASSWORD="password"
REALTIME_PG_DATABASE="closedloop_ai"
# AWS_REGION="us-east-1"

# Optional. Exact browser origins; a request with no Origin is always allowed.
REALTIME_ALLOWED_ORIGINS="http://localhost:3000"
# REALTIME_PORT="3040"
# REALTIME_PING_TIMEOUT_MS="60000"
# Live connections one user, and one org, may hold across every instance.
# REALTIME_MAX_CONNECTIONS_PER_USER="30"
# REALTIME_MAX_CONNECTIONS_PER_ORG="6000"
# Spread over which a draining instance tells clients to reconnect elsewhere.
# DRAIN_WINDOW_MS="20000"
# Set by ECS on a task; the drain starts when it reports the task stopping.
# ECS_CONTAINER_METADATA_URI_V4=""
# DD_TRACING_ENABLED="1" opts into span export (DD_OTLP_TRACES_ENDPOINT
# required, and DD_API_KEY unless that endpoint is a loopback collector);
# every span is recorded unless DD_TRACE_SAMPLE_RATE says otherwise.
# DD_TRACING_ENABLED=""
# A loopback forwarder that adds the Datadog key to log batches (the task's
# collector sidecar), so the service needs no DD_API_KEY. On ECS the service
# refuses to boot when logs or traces have no export path.
# DD_LOGS_FORWARDER_URL=""
# The only grant tokens accepted are RS256 (ISS-11966): a JSON object mapping
# each kid, a bare KMS key ID, to its SPKI PEM public key. Locally the kid is
# the one `pnpm env:local` generates beside apps/api's
# REALTIME_TOKEN_LOCAL_PRIVATE_KEY.
# REALTIME_TOKEN_PUBLIC_KEYS=""

# ISS-11966: /internal/* accepts only apps/api's Vercel OIDC token as a bearer,
# which must carry what these name: the issuer
# (https://oidc.vercel.com/<team-slug>), the realtime-only audience apps/api
# sets as its own REALTIME_INTERNAL_OIDC_AUDIENCE (never Vercel's default
# https://vercel.com/<team-slug>), the team id, the api project's id, and its
# environment. All five are required. `development` (the token
# `vercel env pull` gives apps/api) is refused on ECS. local.env.example sets
# the local values.
# REALTIME_INTERNAL_OIDC_ISSUER=""
# REALTIME_INTERNAL_OIDC_AUDIENCE=""
# REALTIME_INTERNAL_OIDC_OWNER_ID=""
# REALTIME_INTERNAL_OIDC_PROJECT_ID=""
# REALTIME_INTERNAL_OIDC_ENVIRONMENT=""
