# apps/api (:3002) — BFF. The only surface that talks to the database.
#
# Prefer the single-file setup: `cp local.env.example local.env && pnpm env:local`
# links one root file into every app instead of six copies you keep in sync.
# That also guarantees INTERNAL_API_SECRET matches across api, mcp, and relay —
# they authenticate to each other with it, and mcp/relay refuse to start without it.

# Server
# Sign-in credentials. Left commented on purpose: a placeholder like
# "sk_test_xxx" satisfies the sk_ prefix check, so the app boots looking
# configured and then fails on the first Clerk call. Unset is the honest state.
# Real values: AWS Secrets Manager -> localhost/env-secrets
# CLERK_SECRET_KEY="sk_..."
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."
# CLERK_WEBHOOK_SECRET="whsec_..."

# Matches POSTGRES_DB in docker-compose.yml, so `docker compose up -d` needs no
# manual createdb. packages/database/.env must carry the same value for the
# Prisma CLI.
DATABASE_URL="postgresql://postgres:password@localhost:5432/closedloop_ai?schema=public"

# RESEND_FROM=""
# RESEND_TOKEN=""
# SVIX_TOKEN=""
# LIVEBLOCKS_SECRET=""
VERCEL_PROJECT_PRODUCTION_URL="http://localhost:3002"

# Shared service-to-service secret. Not a real credential locally, but api, mcp,
# and relay must all see the SAME value.
INTERNAL_API_SECRET="change-me-in-production"

# apps/api -> apps/relay. `just dev` injects this; set it for plain `pnpm start-apps`.
RELAY_API_URL="http://localhost:3020"

# GitHub App Integration
# packages/github/keys.ts requires ALL of these together and throws if only some
# are set — fill the whole group or leave the whole group empty.
# (PLN-1742 M5 retired the OAuth client id/secret — nothing reads them.)
# Walkthrough: docs/github-app-setup.md
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
# owner/repo of the GitHub App installation used for app-authenticated reads
# (e.g. Desktop release lookup). Not a workflow-dispatch target.
GITHUB_APP_DISPATCH_REPO="closedloop-ai/closedloop-ai"
# local | stage | prod. Use "local" on a workstation.
WEBAPP_ENV="local"

# AWS S3 (for artifact storage)
# AWS_ROLE_ARN is used on Vercel (OIDC); locally, use default credential chain or explicit keys
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
FILE_ATTACHMENTS_BUCKET=""

# Client
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-..."
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST=""
# apps/web serves the Fumadocs /docs section; there is no separate docs app.
NEXT_PUBLIC_DOCS_URL="http://localhost:3001/docs"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
# Cron authentication
CRON_SECRET=""

# Pensero integration (FEA-4174 / PRD-545 — Value Numerator 2.0). Optional and
# server-side only; when unset the integration is inert. The token is a single
# DRF TokenAuth credential of the shape tk_<public>:sk_<secret> — treat it as a
# secret, never commit the real value.
# PENSERO_API_TOKEN="tk_xxx:sk_xxx"
# PENSERO_API_BASE_URL="https://pensero.ai/api"

# KMS key for secrets at rest, set by infrastructure in stage/prod. There is no
# local value; leave it empty on a workstation.
KMS_KEY_ARN=""
