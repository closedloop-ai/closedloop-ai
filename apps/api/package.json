{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "npm run server:dev",
    "server:dev": "NODE_ENV=development tsx watch server-dev.ts",
    "server:start": "NODE_ENV=production tsx server.ts",
    "next": "next dev -p 3002",
    "build": "next build && npm run server:import-smoke",
    "start": "npm run server:start",
    "server:import-smoke": "tsx scripts/smoke-desktop-gateway-import.ts",
    "backfill:transcript-search": "tsx scripts/backfill-transcript-search.ts",
    "perf:import-desktop-snapshot": "tsx --conditions=react-server scripts/perf-import-desktop-snapshot.ts",
    "vibe:export": "tsx --conditions=react-server scripts/vibe-seed/export.ts",
    "vibe:seed": "tsx --conditions=react-server scripts/vibe-seed/vibe-seed.ts",
    "seed:branches-web": "tsx --conditions=react-server scripts/seed-branches-web-db.ts",
    "analyze": "ANALYZE=true npm run build",
    "test": "NODE_ENV=test vitest run",
    "test:coverage": "NODE_ENV=test vitest run --coverage --coverage.reporter=json --coverage.reporter=json-summary --coverage.reportOnFailure '--coverage.include=app/**/*.{ts,tsx}' '--coverage.include=lib/**/*.{ts,tsx}' '--coverage.include=*.{ts,tsx}'",
    "test:compatibility": "NODE_ENV=test vitest run --config vitest.config.compatibility.mts",
    "test:integration": "NODE_ENV=test vitest run --config vitest.config.integration.mts --no-file-parallelism",
    "test:coverage:integration": "NODE_ENV=test vitest run --config vitest.config.integration.mts --no-file-parallelism --coverage --coverage.reporter=json --coverage.reportOnFailure --coverage.reportsDirectory=coverage/integration '--coverage.include=app/**/*.{ts,tsx}' '--coverage.include=lib/**/*.{ts,tsx}' '--coverage.include=*.{ts,tsx}'",
    "clean": "git clean -xdf .cache .turbo dist *.tsbuildinfo node_modules",
    "typecheck": "next typegen && tsc --noEmit --emitDeclarationOnly false --incremental --tsBuildInfoFile ./tsconfig.tsbuildinfo",
    "perf:insights-sections": "tsx --conditions=react-server scripts/perf-insights-sections.ts"
  },
  "dependencies": {
    "@closedloop-ai/telemetry-contract": "workspace:*",
    "@closedloop-ai/loops-api": "workspace:*",
    "@aws-sdk/client-kms": "^3.985.0",
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.987.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "~7.10.0",
    "@repo/ai": "workspace:*",
    "@repo/analytics": "workspace:*",
    "@repo/api": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/aws": "workspace:*",
    "@repo/collaboration": "workspace:*",
    "@repo/cost": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/design-system": "workspace:@closedloop-ai/design-system@*",
    "@repo/email": "workspace:*",
    "@repo/github": "workspace:*",
    "@repo/google": "workspace:*",
    "@repo/http-service": "workspace:*",
    "@repo/lib": "workspace:*",
    "@repo/linear": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/pensero": "workspace:*",
    "@repo/realtime-contract": "workspace:*",
    "@repo/realtime-server": "workspace:*",
    "@repo/shared-platform": "workspace:@closedloop-ai/shared-platform@*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/functions": "^3.4.3",
    "@vercel/oidc": "^3.8.9",
    "adm-zip": "^0.6.1",
    "cron-parser": "^4.9.0",
    "import-in-the-middle": "^3.0.1",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "next": "catalog:",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "prisma": "~7.10.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "require-in-the-middle": "8.0.1",
    "sanitize-html": "^2.17.4",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.1",
    "svix": "^1.96.1",
    "tsx": "^4.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "^7.6.1",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": ">=5.7.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "uuid": "^14.0.3",
    "vitest": "^5.0.2",
    "vitest-mock-extended": "^5.1.1",
    "yaml": ">=2.8.3"
  }
}
