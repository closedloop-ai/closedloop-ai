{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@repo/http-service/*": ["../../packages/http-service/src/*"],
      "@repo/realtime-contract/*": ["../../packages/realtime-contract/src/*"],
      "@repo/realtime-server/*": ["../../packages/realtime-server/src/*"],
      "@repo/*": ["../../packages/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
