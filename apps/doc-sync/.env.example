# apps/doc-sync (:3050) — the document sync service (Hocuspocus, PLN-2099).
#
# Prefer the single-file setup: `cp local.env.example local.env && pnpm env:local`
# links one root file into every app.
#
# The service logs `doc_sync.env_invalid` and exits 1 when a required key is
# missing or a key is set to a value outside its range.

# One port for the WebSocket, GET /health and /internal/* (1-65535).
# DOC_SYNC_PORT="3050"
# On SIGTERM or SIGINT the service stops accepting connections, closes every
# connection and flushes pending stores, giving up after this many ms. Keep it
# below the ECS task's stopTimeout.
# DOC_SYNC_SHUTDOWN_DEADLINE_MS="20000"

# Required: the service's own Postgres database, where each document's Yjs
# state is stored. `just setup` creates the local one
# (scripts/ensure-doc-sync-db.sh); the service applies its migrations at boot
# and exits 1 if one fails. `password` locally; `iam` on ECS, where it also
# needs AWS_REGION and connects over TLS.
DOC_SYNC_PG_AUTH="password"
DOC_SYNC_PG_HOST="localhost"
DOC_SYNC_PG_USER="postgres"
DOC_SYNC_PG_PASSWORD="password"
DOC_SYNC_PG_DATABASE="doc_sync"
# DOC_SYNC_PG_PORT="5432"
# Connections the pool may open (1-50).
# DOC_SYNC_PG_POOL_MAX="5"

# Required: the public keys that verify apps/api's POST /doc-sync/token tokens,
# a JSON object mapping each kid to its SPKI PEM (the same value apps/realtime
# takes). `pnpm env:local` generates the local pair.
# REALTIME_TOKEN_PUBLIC_KEYS=""
# Comma-separated exact browser origins whose WebSocket upgrades are admitted;
# an upgrade with no Origin (desktop main process, server clients) always is.
DOC_SYNC_ALLOWED_ORIGINS="http://localhost:3000"

# Required (ISS-12506): /internal/* accepts only apps/api's Vercel OIDC token as
# a bearer, which must carry what these name: the issuer
# (https://oidc.vercel.com/<team-slug>), doc-sync's own audience (never
# Vercel's default https://vercel.com/<team-slug>, and not realtime's, so a
# token minted for realtime is refused here), the team id, the api project's
# id, and its environment. `development` is refused on ECS. local.env.example
# sets the local values.
# DOC_SYNC_INTERNAL_OIDC_ISSUER=""
# DOC_SYNC_INTERNAL_OIDC_AUDIENCE=""
# DOC_SYNC_INTERNAL_OIDC_OWNER_ID=""
# DOC_SYNC_INTERNAL_OIDC_PROJECT_ID=""
# DOC_SYNC_INTERNAL_OIDC_ENVIRONMENT=""
# Set by ECS on a task.
# ECS_CONTAINER_METADATA_URI_V4=""

# Optional (PLN-2200): apps/api's base URL. After each store the service posts
# what changed to its POST /doc-sync/changes, signed as an STS
# GetCallerIdentity request with the task role, so it also needs AWS_REGION.
# Unset turns change callbacks off; locally there is no task role to sign with.
# DOC_SYNC_CALLBACK_URL=""
