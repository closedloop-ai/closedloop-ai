# apps/relay (:3020) — CloudRelay forwarder for Engineer.
#
# Prefer the single-file setup: `cp local.env.example local.env && pnpm env:local`
# links one root file into every app instead of six copies you keep in sync.
#
# This app runs `node --env-file=.env.local`, so the file MUST exist or the
# process exits at startup. Both values below are hard requirements — the relay
# logs the missing name and exits 1 — and INTERNAL_API_SECRET must be the SAME
# value apps/api and apps/mcp see.
CLOSEDLOOP_API_URL="http://localhost:3002"
INTERNAL_API_SECRET="change-me-in-production"

# --- Cross-instance dispatch runtime (optional) ----------------------------
# Read in apps/relay/src/index.ts. Controls how desktop target ownership is
# tracked across relay tasks. Set by infrastructure (ECS task definition) in
# stage/prod; left unset locally.
#
# RELAY_RUNTIME_MODE selects the registry backend:
#   absent / "inmemory" (default): single-instance only; a dispatch can only be
#            delivered by the task that holds the desktop socket.
#   "redis": share a target/instance registry via REDIS_URL so any relay task
#            can proxy a dispatch to the task that owns the socket. Degrades to
#            inmemory if REDIS_URL is unset, no routable private IP can be
#            resolved (see RELAY_INSTANCE_ID below), or the connection fails.
# RELAY_RUNTIME_MODE="redis"
#
# REDIS_URL is the ElastiCache/Valkey connection string (use rediss:// for TLS).
# Required only when RELAY_RUNTIME_MODE="redis".
# REDIS_URL="rediss://host:6379"
#
# RELAY_INTERNAL_ALLOWED_IPS is an optional comma-separated CIDR allowlist. It
# gates the POST /internal/dispatch endpoint (ingress) AND the egress allowlist
# used when proxying to a peer relay. When empty, ingress is authorized by the
# shared INTERNAL_API_SECRET alone and egress is restricted to RFC1918 private
# ranges on the relay port.
# RELAY_INTERNAL_ALLOWED_IPS="10.0.0.0/8"
#
# RELAY_INSTANCE_ID overrides the instance id used in the registry. Read in
# apps/relay/src/instance-discovery.ts; defaults to the ECS task id, else a
# random "local-" id. The instance's routable private IP is read from ECS task
# metadata (ECS_CONTAINER_METADATA_URI_V4).
# RELAY_INSTANCE_ID=""

# --- Keyless telemetry capacity / back-pressure (optional) -----------------
# FEA-1994 / PRD-481 C6. Read in apps/relay/src/index.ts and applied to the
# unauthenticated /telemetry namespace only. All optional; unset/invalid values
# fall back to the built-in defaults below. Set by infrastructure (ECS task
# definition) in stage/prod; left unset locally.
#
# RELAY_OTLP_MAX_INFLIGHT_EXPORTS bounds concurrently in-flight relay→collector
# proxy requests across the whole fleet (default 256, min 1). Exports offered
# past this ceiling are load-shed with a retryable rate_limited ack instead of
# queued, keeping memory and event-loop time (shared with the authenticated
# DB-sync path) bounded under a telemetry spike.
# RELAY_OTLP_MAX_INFLIGHT_EXPORTS="256"
#
# RELAY_OTLP_MAX_CONNECTIONS caps concurrent live /telemetry connections
# (default 3000, min 1) so a keyless connection storm cannot exhaust the engine
# budget the authenticated namespace shares. Sized with headroom over the
# 1,400+ keyless-sender fleet target.
# RELAY_OTLP_MAX_CONNECTIONS="3000"
#
# RELAY_OTLP_TRUSTED_PROXY_HOPS is the number of trusted reverse proxies in
# front of the relay (default 0 = use the immediate TCP peer, min 0). Behind the
# ALB set 1 so the per-IP rate-limit key is the real client IP from
# X-Forwarded-For rather than the shared load-balancer address (otherwise the
# whole fleet collapses into a single per-IP bucket).
# RELAY_OTLP_TRUSTED_PROXY_HOPS="1"
