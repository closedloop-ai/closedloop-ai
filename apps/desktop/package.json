{
  "name": "desktop",
  "version": "0.17.0",
  "description": "Closedloop Desktop",
  "author": "Closedloop AI <support@closedloop.ai>",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-launch.mjs",
    "dev:browser": "node scripts/dev-launch.mjs --browser-bridge",
    "dev:prepare": "node scripts/dev-launch.mjs --prepare-only",
    "dev:static": "node scripts/dev-launch.mjs --static-renderer",
    "dev:static:prepare": "node scripts/dev-launch.mjs --static-renderer --prepare-only",
    "start": "node scripts/main-bundle-launch-preflight.mjs && electron .",
    "start:no-auth": "CL_LOCAL_GATEWAY_NO_AUTH=1 pnpm run start",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:package": "node -e \"require('fs').rmSync('dist-dmg',{recursive:true,force:true})\"",
    "prebuild": "node scripts/write-build-info.mjs && node scripts/generate-migrations-manifest.mjs && node scripts/generate-docs-bundle-manifest.mjs && node scripts/generate-auth-handoff-assets.mjs",
    "build": "pnpm run clean:dist && pnpm run build:prereqs && pnpm run build:main && pnpm run build:renderer",
    "build:main": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "build:main:dev": "node scripts/build-main-dev.mjs",
    "build:deps": "cd ../.. && pnpm exec turbo build --filter=desktop^... --output-logs=errors-only",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:prereqs": "pnpm run build:deps && pnpm run prebuild && pnpm run db:generate",
    "dashboard:reset": "node scripts/reset-dashboard-db.mjs",
    "db:generate": "node scripts/generate-prisma-client.mjs",
    "mutation:prep": "pnpm prebuild && pnpm db:generate",
    "db:dev": "prisma dev",
    "db:migrate:dev": "prisma migrate dev",
    "stage:package": "node scripts/stage-packaging-app.mjs",
    "typecheck": "pnpm prebuild && pnpm db:generate && node scripts/run-typecheck-passes.mjs",
    "lint": "pnpm prebuild && pnpm --dir ../.. -w exec biome check --no-errors-on-unmatched apps/desktop",
    "assert:design-system-boundary": "node scripts/assert-supported-node.mjs && node scripts/assert-design-system-boundary.mjs",
    "assert:test-prereqs": "node scripts/assert-test-prereqs.mjs",
    "measure:agent-dashboard-storage": "node scripts/measure-agent-dashboard-storage.mjs",
    "verify:electron-binary": "node scripts/ensure-electron-binary.mjs",
    "test": "pnpm test:preflight && pnpm test:node && pnpm test:renderer",
    "test:preflight": "pnpm prebuild && pnpm db:generate && pnpm assert:design-system-boundary",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:node": "pnpm assert:test-prereqs && node scripts/run-node-tests.mjs",
    "test:node:stress": "node scripts/stress-node-tests.mjs",
    "test:dist-token-surface": "vitest run --config vitest.dist-token-surface.config.ts",
    "test:renderer": "vitest run --config vitest.renderer.config.ts",
    "test:node:coverage": "DESKTOP_NODE_COVERAGE=1 NODE_TEST_RUNNER_TIMEOUT_MS=2400000 c8 --reporter=json --reports-dir coverage/node --include 'src/**' --include 'scripts/**' node scripts/run-node-tests.mjs",
    "test:renderer:coverage": "vitest run --config vitest.renderer.config.ts --coverage --testTimeout=20000",
    "package": "pnpm clean:package && pnpm build && pnpm stage:package && pnpm package:builder",
    "package:builder": "node scripts/run-electron-builder.mjs",
    "package:turbo": "node scripts/run-electron-builder.mjs",
    "release": "pnpm package",
    "calibrate:autonomy": "tsx scripts/autonomy-calibration.ts",
    "vibe:profile": "tsx scripts/vibe-profile/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/crc64-nvme": "3.972.0",
    "@closedloop-ai/telemetry-contract": "workspace:*",
    "@libsql/client": "0.17.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@prisma/adapter-libsql": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@pydantic/genai-prices": "0.1.9",
    "@repo/api": "workspace:*",
    "@repo/app": "workspace:*",
    "@repo/cost": "workspace:*",
    "@closedloop-ai/design-system": "workspace:*",
    "@repo/lib": "workspace:*",
    "@closedloop-ai/loops-api": "workspace:*",
    "@repo/navigation": "workspace:*",
    "@repo/realtime-client": "workspace:*",
    "@repo/realtime-contract": "workspace:*",
    "@repo/shared-platform": "workspace:@closedloop-ai/shared-platform@*",
    "@tanstack/react-query": "^5.104.5",
    "adm-zip": "^0.6.1",
    "busboy": "^1.6.0",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "glob": "^13.0.6",
    "lucide-react": "^0.556.0",
    "next-themes": "^0.4.6",
    "protobufjs": "^7.5.8",
    "react": "19.2.9",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.9",
    "react-grid-layout": "^2.2.3",
    "react-hook-form": "^7.76.1",
    "react-resizable": "^3.2.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "@playwright/test": "^1.60.0",
    "@repo/analytics": "workspace:*",
    "@repo/collaboration": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.4",
    "@sinonjs/fake-timers": "15.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/busboy": "^1.5.4",
    "@types/node": "24.12.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "10.4.20",
    "axe-core": "^4.12.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "c8": "^10.1.3",
    "dependency-cruiser": "^18.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.10",
    "prisma": "~7.10.0",
    "socket.io": "4.8.3",
    "tailwindcss": "4.3.3",
    "tailwindcss-legacy": "npm:tailwindcss@3.4.17",
    "tsx": "^4.19.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.2",
    "vitest-mock-extended": "^5.1.1",
    "yaml": ">=2.8.3"
  }
}
