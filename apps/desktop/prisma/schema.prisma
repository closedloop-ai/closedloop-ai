// FEA-1962: desktop-local agent-session sync cursor. Co-located in sqlite (not
// electron-store) so it shares the lifecycle of the `sessions` rows. `sourceKey`
// is target-scoped (sync kind + compute target; the compute-target id already
// encodes account + machine, so org/user are deliberately NOT folded in — see
// buildAgentSessionSyncSourceKey) so one account cannot inherit another's
// durable cursor. `observedIdsAtTopUpdatedAt`
// preserves the accepted ids sharing the top timestamp so same-timestamp
// siblings are still selected on restart. `dataRevision` records the
// DATA_REVISION the cursor was written under: a cursor stamped with a stale
// revision is treated as absent on load, so a parser-semantics bump triggers
// exactly one full re-backfill (preserving the pre-FEA-1962 behavior where the
// DATA_REVISION rebuild's re-derived rows reached the cloud, but once instead
// of on every restart).
model SyncState {
  sourceKey                 String  @id @map("source_key")
  observedTopUpdatedAt      String? @map("observed_top_updated_at")
  observedIdsAtTopUpdatedAt Json    @default("[]") @map("observed_ids_at_top_updated_at")
  // Sessions intentionally abandoned this run (oversize / validation_failed /
  // exhausted-retry). Recording them lets the watermark advance past dead rows
  // so the client stops re-walking the whole local corpus on every restart.
  // Nullable for backward compat: a cursor written before migration 0024 has
  // no column value and loads as `[]`.
  deadLetteredIds           Json?   @map("dead_lettered_ids")
  dataRevision              Int     @default(1) @map("data_revision")
  // FEA-3781: the autonomy formula this lane last uploaded under. Nullable with
  // no default: a cursor written before migration 0040 loads as NULL, which is
  // "unknown / pre-FEA-3781" and correctly triggers the one-time re-walk.
  autonomyFormulaVersion    Int?    @map("autonomy_formula_version")
  // ISS-5086: version of the import-watermark invariant last reconciled by this
  // lane. NULL is a pre-fix cursor and forces one idempotent full re-walk so a
  // late historical row stranded below that cursor reaches the cloud.
  syncIntegrityVersion      Int?    @map("sync_integrity_version")
  updatedAt                 String  @map("updated_at")

  @@map("sync_state")
}

// FEA-3473 (PRD-536): durable per-session metadata-sync OUTBOX. One row per
// session that has been enqueued for the local→cloud metadata lane but not yet
// acked by the server, keyed by (sourceKey, externalSessionId) — the same
// target-scoped `sourceKey` space as `SyncState`, so one account never inherits
// another's outbox. Mirrors `TranscriptSyncState`'s crash-correct discipline
// (FEA-2714/2715, Kris Wong): a row is advanced/cleared ONLY on a VERIFIED
// server ack, never on send, so a kill mid-backfill resumes per-item — restart
// re-uploads only the sessions whose rows survive (un-acked), not the whole
// corpus. `status` is `pending` (queued, not yet acked) or `dead_lettered`
// (intentionally abandoned this run: oversize / validation_failed /
// exhausted-retry / unhydratable-after-enqueue). No FK to `sessions`: the row
// may outlive a locally-deleted session (that is exactly the AC-2 straggler the
// outbox records instead of silently dropping), and the store is a pure
// cache/queue over server-authoritative state — losing it is harmless (worst
// case: one re-enumeration, which the server idempotently dedupes). `syncClass`
// records which lane enqueued it (backfill|incremental) for diagnostics.
// Numeric columns are INTEGER counts; timestamps are TEXT ISO strings, matching
// the SyncState / TranscriptSyncState conventions.
model AgentSessionSyncOutbox {
  sourceKey         String  @map("source_key")
  externalSessionId String  @map("external_session_id")
  status            String  @default("pending") @map("status")
  syncClass         String  @default("backfill") @map("sync_class")
  attemptCount      Int     @default(0) @map("attempt_count")
  nextAttemptAt     String? @map("next_attempt_at")
  lastError         String? @map("last_error")
  createdAt         String  @map("created_at")
  updatedAt         String  @map("updated_at")

  @@id([sourceKey, externalSessionId])
  @@index([sourceKey, status, nextAttemptAt], map: "idx_agent_session_sync_outbox_ready")
  // ISS-6031: the retention sweep's undelivered-delivery probe binds
  // `external_session_id` + `status` with NO source key, so neither the PK nor
  // the ready index above can serve it (both lead with `source_key`).
  @@index([externalSessionId, status], map: "idx_agent_session_sync_outbox_session_status")
  @@map("agent_session_sync_outbox")
}

