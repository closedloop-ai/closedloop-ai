/// ISS-6998: one session this device has ALREADY ASKED the sync lane to
/// re-deliver after ISS-6884 made component usage a paginated stream.
///
/// The durable marker exists because the discovery predicate — "this session
/// holds more than `MAX_SYNCED_COMPONENT_USAGE` usage rows" — is NOT convergent:
/// re-queuing a session does not change its local row count, so a pass keyed on
/// the predicate alone would re-bump the same sessions on every boot and churn
/// the sync cursor forever. `billing-mode-heal.ts` needs no such table precisely
/// because its predicate IS convergent; this one is not, so the "already asked"
/// fact has to be persisted.
///
/// A row means "we re-queued this session", NOT "the full set arrived". The
/// delivery itself is the sync lane's business and has its own outbox state;
/// nothing here should be read as an acknowledgement.
model ComponentUsageResyncSeen {
  sessionId  String @id @map("session_id")
  /// Local usage rows counted at re-queue time — evidence for why the row was
  /// selected, never re-read as a delivery total.
  usageRows  Int    @map("usage_rows")
  requeuedAt String @map("requeued_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("component_usage_resync_seen")
}

/// ISS-7229: one session whose 0074-backfilled authoritative cost this device
/// has already asked the sync lane to re-deliver.
///
/// Migration 0074 filled `sessions.authoritative_cost_usd` from local OTel
/// capture without touching `updated_at`, and cloud delivery selects on that
/// cursor — so those figures are invisible to sync, and a finished session's
/// cost never changes again to re-stamp it. The re-queue is what closes that,
/// and this table is what stops the re-queue repeating.
///
/// The durable marker exists because the discovery predicate —
/// "`authoritative_cost_usd IS NOT NULL`" — is NOT convergent: bumping
/// `updated_at` does not change it, so a pass keyed on the predicate alone would
/// re-bump the same sessions on every boot and churn the sync cursor forever.
/// `billing-mode-heal.ts` needs no such table precisely because its predicate IS
/// convergent; this one is not, so the "already asked" fact has to be persisted.
///
/// A row means "we re-queued this session", NOT "the cloud has this figure".
/// The delivery itself is the sync lane's business and has its own outbox state;
/// nothing here should be read as an acknowledgement.
model AuthoritativeCostResyncSeen {
  sessionId  String @id @map("session_id")
  /// The figure observed at re-queue time — evidence for why the row was
  /// selected, never re-read as proof of what the cloud received.
  costUsd    Float  @map("cost_usd")
  requeuedAt String @map("requeued_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("authoritative_cost_resync_seen")
}

/// ISS-7265 AC3: one session whose activity tiling this device shipped STRIPPED
/// and therefore still owes the cloud.
///
/// The ISS-4578 bounded fallback drops the tiling so the rest of an oversized
/// session can reach a server that cannot merge a multi-part tiling. That
/// delivery is acked like any other, so the outbox clears and the session
/// dequeues — and selection walks `sessions.updated_at`, never "the delivery was
/// incomplete", so nothing brings the tiling back. This table is what makes the
/// strip a deferral instead of a discard.
///
/// `requeuedAt` NULL means owed and never asked; a timestamp means this device
/// has already asked the lane to re-deliver. The repair pass selects only the
/// NULL rows, so a re-delivery that strips again cannot re-open its own request
/// and bump `updated_at` forever. The debt re-arms only through a confirmed
/// delivery WITH the tiling, which deletes the row.
///
/// A row means "the cloud is owed this tiling". It is never an acknowledgement,
/// and its absence is not evidence that a tiling arrived.
model ActivityTilingRepairOwed {
  sessionId  String  @id @map("session_id")
  recordedAt String  @map("recorded_at")
  requeuedAt String? @map("requeued_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("activity_tiling_repair_owed")
}

// FEA-2267: persisted per-session activity-segment tiling (state-aware spend
// attribution, PRD-488). The deterministic `id` is a sha256(sessionId|startMs|
// version) slice. `phase` is a free TEXT column (taxonomy stored as data,
// Q-001): adding/renaming a phase is an ACTIVITY_CLASSIFIER_VERSION bump +
// backfill re-derive, never a migration. `evidenceLayers` is a JSON array
// (empty for the stub; FEA-2268 populates the evidence taxonomy), modelled as
// `Json` like `SyncState.observedIdsAtTopUpdatedAt`. No FK to `sessions`:
// segments are re-derived per import and the deletion paths
// (`deleteSessionRow`, `sweepExpiredSessions`) purge them via the typed
// delegate, matching how the other no-cascade child tables are cleaned up.
model SessionActivitySegment {
  id             String  @id
  sessionId      String  @map("session_id")
  phase          String
  startMs        BigInt  @map("start_ms")
  endMs          BigInt  @map("end_ms")
  confidence     Float   @default(1)
  evidenceLayers Json    @default("[]") @map("evidence_layers")
  version        Int
  workItemRef    String? @map("work_item_ref")
  // FEA-2271: parser-stable local subagent id when this segment's spend was
  // re-filed to a subagent's own purpose phase; null for main-agent segments.
  // Additive nullable provenance marker (no phase-column migration); the
  // ACTIVITY_CLASSIFIER_VERSION bump re-derives it over all history.
  subagentId     String? @map("subagent_id")
  observedAt     String  @map("observed_at")

  @@index([sessionId, startMs], map: "idx_session_activity_segments_session_start")
  @@map("session_activity_segments")
}

// FEA-2267: backfill high-water-mark for the activity-segment derivation,
// mirroring `artifact_link_backfill_seen`. A session is re-tiled when its
// transcript mtime changes OR `classifier_version` is below the current
// ACTIVITY_CLASSIFIER_VERSION (a version bump re-derives all history).
model ActivitySegmentBackfillSeen {
  sessionId         String  @id @map("session_id")
  filePath          String? @map("file_path")
  fileMtimeMs       BigInt? @map("file_mtime_ms")
  classifierVersion Int     @map("classifier_version")
  scannedAt         String? @map("scanned_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("activity_segment_backfill_seen")
}

// ISS-7830: whether a user ever navigated INTO this thread. A row means viewed;
// no row means no view is recorded. Its own table rather than a `sessions`
// column because the importer rewrites that row's `metadata` from the transcript
// on every re-import and a `DATA_REVISION` rebuild re-imports the whole corpus —
// and viewership is a product fact that no re-parse can reconstruct. The rules a
// reader must know (navigation is the act, the signal is monotonic, and it must
// outlive a rebuild) are stated once in
// `packages/lib/session-trace/thread-viewership.ts`.
model SessionViewership {
  sessionId     String @id @map("session_id")
  firstViewedAt String @map("first_viewed_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("session_viewership")
}

/// Compact, revisioned facts consumed by the Desktop Sessions list. The source
/// event/token streams remain canonical; database triggers delete this cache in
/// the same transaction whenever one of its inputs changes.
model SessionListTraceProjection {
  sessionId  String @id @map("session_id")
  revision   Int
  payload    Json
  updatedAt  String @map("updated_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("session_list_trace_projection")
}

// FEA-2715 (PRD-512, PLN-1288): per-transcript-file fingerprint + upload-cursor
// for the raw-transcript archive lane. One row per logical transcript file,
// keyed by (externalSessionId, fileKey) where fileKey is "main" or
// "subagent:{fileId}" (mirrors the PLN-1287 control-plane identity). This lane
// is entirely separate from the 256 KiB metadata lane (`SyncState`), so there
// is NO FK to `sessions` — a transcript may be discovered before its session
// row exists, and the store is a pure cache/queue: server state from the
// `sync-plan` endpoint is always authoritative (recovery invariant 2), so
// losing this table is harmless (worst case: re-discovery + noop plans).
//
// `syncedByteOffset` / `syncedSha256` / `storedEtag` cache the server's
// authoritative post-`complete` state; `syncedComputeTargetId` records which
// compute target that cache belongs to, so an account/machine switch never
// reuses another target's offset (the executor re-plans from server truth when
// it differs). `syncedSha256` is the sha256 of `[0, syncedByteOffset)` and is
// sent back as `prefixSha256` on the next `sync-plan` to detect
// compaction/rewrite. Numeric columns are BigInt (byte offsets/sizes, mtime ms)
// per the schema convention; timestamps are TEXT ISO strings.
model TranscriptSyncState {
  externalSessionId            String  @map("external_session_id")
  fileKey                      String  @map("file_key")
  sourceHarness                String  @map("source_harness")
  sourcePath                   String  @map("source_path")
  sourcePathHash               String  @map("source_path_hash")
  lastMtimeMs                  BigInt? @map("last_mtime_ms")
  lastSize                     BigInt? @map("last_size")
  syncedByteOffset             BigInt  @default(0) @map("synced_byte_offset")
  syncedSha256                 String? @map("synced_sha256")
  storedEtag                   String? @map("stored_etag")
  syncedComputeTargetId        String? @map("synced_compute_target_id")
  status                       String  @default("idle") @map("status")
  syncClass                    String  @default("live") @map("sync_class")
  retryCount                   Int     @default(0) @map("retry_count")
  // FEA-3555: consecutive missing-source observations ONLY, isolated from
  // `retryCount` (which also counts transient upload failures) so the terminal
  // `source_gone` threshold cannot be tripped early by an unrelated failure run.
  missingSourceCount           Int     @default(0) @map("missing_source_count")
  nextAttemptAt                String? @map("next_attempt_at")
  lastError                    String? @map("last_error")
  // ISS-7097: the durable half of the upload claim. `status = 'uploading'` is
  // written before the transfer starts and cleared by the settle, but the claim
  // itself was only an in-memory Set, so ANY lost settle (crash, force-quit, a
  // rejected settle write) left the row `uploading` — which neither `listReady`
  // nor `planObservation` selects — until the next app start re-armed it. This
  // stamps WHEN the claim was taken so a recurring reclaim can tell a live
  // upload from a stranded one and re-arm only the latter. NULL means either not
  // uploading, or a pre-migration row whose claim is by definition expired.
  uploadingSince               String? @map("uploading_since")
  // ISS-7097: when this row's current LANE-WIDE stall began — the first failure
  // in an unbroken run of them. A lane-wide failure (the cloud is down, not this
  // row) deliberately does not advance `retryCount`, so it cannot reach the
  // consecutive-failure dead-letter; this timestamp is what keeps that path
  // BOUNDED anyway, via a wall-clock ceiling. Cleared by every successful settle
  // AND by any row-attributable failure, because a 4xx proves the lane is
  // reachable and the stall is over.
  laneStalledSince             String? @map("lane_stalled_since")
  // ISS-4815: the timestamp of an AUTHORITATIVE cloud `uploaded` acknowledgement
  // for a row the local lane could not upload itself (the terminal-skip answer
  // "a verified archive already exists"). It is the DURABLE half of that settle:
  // the queue `status` stays `idle` (there is genuinely no work to do), while
  // this column records WHY it is idle, so the stranded-missing-blob recovery
  // can leave the row settled instead of re-arming it on every launch. NULL on
  // every pre-migration row and on every non-ack settle, which is exactly the
  // pre-ISS-4815 behavior (the row stays eligible for recovery).
  cloudUploadedAt              String? @map("cloud_uploaded_at")
  // ISS-4815: WHICH compute target's cloud gave that acknowledgement. An `uploaded`
  // ack is only ever a statement about the archive held by the target it came
  // from, so the recovery must scope the exclusion to it — otherwise switching
  // accounts/compute targets leaves the row permanently settled while the NEW
  // target's cloud holds nothing, and the transcript never reaches it. Same
  // per-target discipline ISS-4647 applied to the cursor via
  // `syncedComputeTargetId`, but a separate column: this records the ack's origin,
  // not the byte-cursor's domain, so it stores the RAW compute target id with no
  // redacted-archive suffix. NULL when unattributable (acknowledged with no known
  // target), which keeps the row eligible for recovery.
  cloudUploadedComputeTargetId String? @map("cloud_uploaded_compute_target_id")
  // ISS-9884 (migration 0090): WHY this row died, in the wire's own
  // `TranscriptSkipReason` vocabulary. The settle path nulls
  // `laneStalledSince` at the moment a row goes terminal and `lastError` holds
  // an unparseable client message, so before this a `dead` row carried no
  // durable evidence of its cause and the desktop-local Sessions verdict had
  // to call every one of them `failedPermanent` — including an environmental
  // give-up the cloud reports as merely paused. Free text, no CHECK: the enum
  // is grow-only and the read narrows with `toKnownTranscriptSkipReason`. NULL
  // means not terminal, or terminal before 0090.
  terminalSkipReason           String? @map("terminal_skip_reason")
  // ISS-9884 (migration 0093): WHICH compute target's cloud acknowledged the
  // terminal skip `terminalSkipReason` records, as the raw target id, written by
  // the same settle. The lane recovery revives an `environment_unavailable` row
  // only under this target and KEEPS it on the revived row as its upload scope:
  // the ready read and the upload claim refuse that row to every other target
  // until it is caught up or re-terminates. An observation that saw no file
  // change leaves a paused row dead with this column intact, so a compute-target
  // switch alone never opens it to another target. A CHANGED file is not covered:
  // observe re-queues the row with this column cleared, open to whichever target
  // drains it, and the only guard on that path is the ISS-7096 foreign-ownership
  // gate, which withholds the file only when the session's recorded owner pair
  // differs from a known signed-in pair (not when the signed-in identity is
  // unknown, the session has no full owner pair, or both targets belong to the
  // same pair). Same per-target discipline as `cloudUploadedComputeTargetId`.
  // NULL means no terminal and no scope, or a terminal before 0093, and no
  // revival matches it.
  terminalSkipComputeTargetId  String? @map("terminal_skip_compute_target_id")
  createdAt                    String  @map("created_at")
  updatedAt                    String  @map("updated_at")

  @@id([externalSessionId, fileKey])
  @@index([status, nextAttemptAt], map: "idx_transcript_sync_state_status_next")
  @@index([syncClass, status], map: "idx_transcript_sync_state_class_status")
  @@map("transcript_sync_state")
}

// FEA-2923 (T-8.1): first-class component inventory for cloud sync. One row per
// detected component across all kinds. Event-driven existence discovery: the
// first time a component is observed in the event stream its existence is
// registered. Device-scoped (no session FK), tombstone via uninstalled_at,
// mirrors the lifecycle-timestamp pattern of `Skill` / `AgentPack`.
// Deterministic id = sha256(componentKind|harness|externalId).
// Unique dedup on (componentKind, externalId) per §1b design.
model AgentComponent {
  id            String  @id // sha256(kind|harness|externalId)
  componentKind String  @map("component_kind") // skill|command|subagent|mcp|hook|plugin|workflow|config|tool
  externalId    String  @map("external_id") // scanner-stable id (skillId, packId+harness+installPath, …)
  componentKey  String? @map("component_key") // invocation-join key (skill name, /command name, mcp server, subagent_type)
  name          String?
  version       String?
  harness       String?
  source        String? // "user" | "project" | "local" (settings scope)
  description   String?
  sourceUrl     String? @map("source_url")
  installPath   String? @map("install_path")
  packId        String? @map("pack_id") // parent pack when the component ships inside one
  scope         String? // "user" | "project" | "local"
  projectPath   String? @map("project_path") // populated for project-scoped components
  // ISS-12169: the project root whose `.mcp.json` declared an MCP presence row.
  // Desktop-local only: the component sync lane never selects it.
  localProjectPath String? @map("local_project_path")
  metadata      Json? // kind-specific extras (hook event+matcher, mcp transport, config keys)
  content       String? // definition file text (FEA-2923 content pipeline)
  contentHash   String? @map("content_hash") // sha256 of `content`; dedup + version key
  // F1 (FEA-3290 / PRD-527 Slice 4) — honest resolution state (AC-007). One of
  // "resolved" (exact user definition captured), "unresolved" (name/label-only,
  // e.g. event-driven label-minted rows), "inaccessible" (permission-denied at
  // capture, EACCES) or "missing" (deleted/absent, ENOENT). `inaccessible` is
  // DISTINCT from `missing` (AC-5). Label-minted rows default to "unresolved"
  // (AC-4/AC-7); the content collector promotes to "resolved" when it captures
  // exact definition text.
  resolvedState String  @default("unresolved") @map("resolved_state")
  firstSeenAt   String? @map("first_seen_at") // ISO string; set on first upsert (detectedAt equivalent)
  lastSeenAt    String? @map("last_seen_at")
  uninstalledAt String? @map("uninstalled_at") // tombstone, like skills/agent_packs

  componentInvocations AgentComponentInvocation[] @relation("InvocationLocalComponent")

  @@unique([componentKind, externalId], map: "idx_agent_components_kind_ext")
  @@index([componentKind], map: "idx_agent_components_kind")
  @@index([packId], map: "idx_agent_components_pack", where: raw("pack_id IS NOT NULL"))
  @@index([componentKind, componentKey], map: "idx_agent_components_kind_key", where: raw("component_key IS NOT NULL"))
  @@index([lastSeenAt], map: "idx_agent_components_last_seen")
  @@map("agent_components")
}

// FEA-2923 content-hash version history. One row per distinct definition
// revision, keyed by (component, source, content_hash) — NOT the invoking owner.
// The collector appends a row whenever a definition's text hash changes; the
// current revision is the one whose content_hash matches the live
// agent_components row.
model AgentComponentVersion {
  id            String  @id // sha256(kind|key|source|content_hash)
  componentKind String  @map("component_kind")
  componentKey  String  @map("component_key")
  source        String  @default("")
  contentHash   String  @map("content_hash")
  content       String
  format        String?
  firstSeenAt   String? @map("first_seen_at") // ISO; first time this hash was observed
  lastSeenAt    String? @map("last_seen_at")

  componentInvocations AgentComponentInvocation[] @relation("InvocationLocalComponentVersion")

  @@unique([componentKind, componentKey, source, contentHash], map: "idx_agent_component_versions_identity")
  @@index([componentKind, componentKey], map: "idx_agent_component_versions_component")
  @@map("agent_component_versions")
}

// FEA-3294 (PRD-527): one durable Desktop-local row per runtime component
// invocation. These rows are the local source of truth for exact occurrences,
// frozen evidence, and transcript anchors; agent_component_session_usage stays
// the aggregate compatibility projection. Cloud DefinitionVersion and
// SourceOccurrence IDs deliberately do not exist in the Desktop schema.
model AgentComponentInvocation {
  id                        String   @id
  sessionId                 String   @map("session_id")
  externalInvocationId      String   @map("external_invocation_id")
  externalSourceId          String?  @map("external_source_id")
  childSessionId            String?  @map("child_session_id")
  agentId                   String?  @map("agent_id")
  parentAgentId             String?  @map("parent_agent_id")
  componentKind             String   @map("component_kind")
  componentKey              String   @map("component_key")
  rawName                   String?  @map("raw_name")
  normalizedName            String?  @map("normalized_name")
  relationship              String
  invokedAt                 String?  @map("invoked_at")
  sequence                  Int
  anchorKind                String   @map("anchor_kind")
  anchorValue               String   @map("anchor_value")
  providerToolUseId         String?  @map("provider_tool_use_id")
  attributionStatus         String   @map("attribution_status")
  evidenceClass             String   @map("evidence_class")
  evidencePointer           Json?    @map("evidence_pointer")
  definitionHash            String?  @map("definition_hash")
  normalizerContractVersion Int?     @map("normalizer_contract_version")
  definitionContent         String?  @map("definition_content")
  localComponentId          String?  @map("local_component_id")
  localComponentVersionId   String?  @map("local_component_version_id")
  gitBranch                 String?  @map("git_branch")
  repositoryFullName        String?  @map("repository_full_name")
  // FEA-4093: whether a firing SUCCEEDED. NULL for kinds whose success/failure
  // is not a first-class transcript fact (every kind but Hook today); a Hook
  // invocation stores 1/0 from the `attachment` type (hook_success vs
  // hook_error / hook_non_blocking_error). SQLite has no boolean affinity, so
  // this is an INTEGER column carrying 1/0/NULL. The usage rollup counts
  // succeeded = 0 as an error_count for a hook that anchors to a Timestamp.
  succeeded                 Boolean? @map("succeeded")
  // FEA-3981 (PLN-1488) per-component telemetry — additive, all nullable with
  // NO default so legacy rows stay NULL = "not computed". Capture lands in
  // Slice B; Slice A only adds the columns. SQLite dialect: BigInt→INTEGER for
  // token counts, Float→REAL for cost, String→TEXT for model. These live at the
  // per-INVOCATION grain (one row per invocation) so a subagent that runs under
  // multiple models yields one row per model turn — "mixed-model" is naturally
  // representable. The component-level rollup (agent_component_session_usage)
  // DERIVES its totals and its model SET by aggregating these rows.
  //
  // (a) REAL per-invocation token/model/cost. ISS-7795 widened this from
  //     subagent-only: a SKILL or COMMAND invocation now carries the model that
  //     served it and the tokens the harness attributed to its own turns, read
  //     from the per-turn `attributionSkill` stamp. Kinds the producer cannot
  //     measure (tool, mcp, orchestration, hook) still leave them NULL.
  //     `usageMeasurement` says which population a row belongs to and is
  //     mandatory whenever any of these is set — see below.
  model                     String?  @map("model")
  inputTokens               BigInt?  @map("input_tokens")
  outputTokens              BigInt?  @map("output_tokens")
  cacheReadTokens           BigInt?  @map("cache_read_tokens")
  cacheWriteTokens          BigInt?  @map("cache_write_tokens")
  estimatedCost             Float?   @map("estimated_cost")
  // (b) Per-component result-FOOTPRINT tokens — the deterministic "tokens this
  //     component injected into context" metric, computed for ALL kinds:
  //     tool/MCP = tool_result output, skill = SKILL.md body + pulled content,
  //     command = expanded template, hook = stdout.
  /// ISS-10713: measured elapsed milliseconds; NULL when no matched result exists.
  /// The shipped migration (20261020152140) declares INTEGER and DEFAULT 0, and
  /// installed Desktops have applied it, so the schema follows the migration.
  durationMs        Int?    @map("duration_ms")
  durationAmbiguous Boolean @default(dbgenerated("0")) @map("duration_ambiguous")
  footprintTokens           BigInt?  @map("footprint_tokens")
  // ISS-7795: which population the values above belong to — `measured` (counted
  // for this invocation itself) or `estimated` (derived, e.g. a share of a
  // session average). NULL means no telemetry at all, never "measured zero".
  // The producer emits only `measured` today; the column exists so an estimated
  // row can never later be folded into the same total unlabelled.
  usageMeasurement          String?  @map("usage_measurement")
  // ISS-10730: the lines THIS invocation changed, from the tool call's own
  // `diffDelta`. A THIRD population, additive with neither telemetry block
  // above. Only the kinds built from one transcript tool call (tool / mcp /
  // orchestration — LINE_BEARING_INVOCATION_KINDS) carry them, and that set is
  // disjoint from the usage-bearing kinds. NULL means "not computed", never a
  // measured zero; attribution does not nest, so a subagent's lines are a
  // read-time SUM over its own tool rows rather than a second stored copy.
  linesAdded                Int?     @map("lines_added")
  linesRemoved              Int?     @map("lines_removed")
  // ISS-7796 / ISS-10725: the findings funnel at this invocation's grain, the
  // desktop twin of the cloud columns added in the same change. SQLite dialect:
  // BigInt -> INTEGER. Both nullable with NO default — NULL means "not
  // measured", never a measured zero.
  //
  // EXACTLY TWO COLUMNS: `confirmed` and the rate are derived at read, never
  // stored. The sync item reads from here; without these columns the desktop
  // could never emit a v5 part.
  findingsEmitted           BigInt?  @map("findings_emitted")
  findingsInvalidated       BigInt?  @map("findings_invalidated")
  // ISS-11325: WHY those two cells read what they read -- withheld for one of
  // the ingest's three named reasons, carried forward from an earlier run, or
  // measured by this one. NULL means this build recorded no disposition (every
  // row written before this column); the read resolves that to `unrecorded`.
  findingsDisposition       String?  @map("findings_disposition")
  // ISS-10720: WHICH SOURCE attributed this invocation to its component --
  // a second axis beside `evidence_class`, which answers where the DEFINITION
  // came from. NULL means the transcript attributed it, which is every row
  // written before this column and every row the OTel join does not reach.
  attributionSource         String?  @map("attribution_source")
  createdAt                 String   @map("created_at")
  updatedAt                 String   @map("updated_at")

  // SQLite PSL cannot map FK names; migration 0031 pins the corresponding DDL
  // names while these relations pin the same structural delete/update actions.
  session               Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent                 Agent?                 @relation("InvocationAgent", fields: [agentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  parentAgent           Agent?                 @relation("InvocationParentAgent", fields: [parentAgentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  localComponent        AgentComponent?        @relation("InvocationLocalComponent", fields: [localComponentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  localComponentVersion AgentComponentVersion? @relation("InvocationLocalComponentVersion", fields: [localComponentVersionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([sessionId, externalInvocationId], map: "idx_aci_session_external_invocation")
  @@index([sessionId, sequence], map: "idx_aci_session_sequence")
  @@index([externalSourceId], map: "idx_aci_external_source", where: raw("external_source_id IS NOT NULL"))
  @@index([componentKind, componentKey, invokedAt], map: "idx_aci_kind_key_invoked_at")
  // ISS-6843: partial on the component-detail probe's own predicate, so the
  // unresolved-key `SELECT DISTINCT component_key` walks the index alone
  // instead of taking a rowid table lookup per entry in the kind partition to
  // evaluate `local_component_id IS NULL` as a residual.
  @@index([componentKind, componentKey], map: "idx_aci_unlinked_kind_key", where: raw("local_component_id IS NULL"))
  @@index([localComponentId, invokedAt], map: "idx_aci_component_invoked_at", where: raw("local_component_id IS NOT NULL"))
  @@index([localComponentId, gitBranch, invokedAt], map: "idx_aci_component_branch_invoked_at", where: raw("local_component_id IS NOT NULL"))
  @@index([localComponentVersionId, invokedAt], map: "idx_aci_component_version_invoked_at", where: raw("local_component_version_id IS NOT NULL"))
  @@index([attributionStatus, invokedAt], map: "idx_aci_status_invoked_at")
  // ISS-11388: the child side of the two `agents` foreign keys. Without them
  // every deleted `agents` row full-scans this table once per FK.
  @@index([agentId], map: "idx_aci_agent_id", where: raw("agent_id IS NOT NULL"))
  @@index([parentAgentId], map: "idx_aci_parent_agent_id", where: raw("parent_agent_id IS NOT NULL"))
  @@map("agent_component_invocations")
}

// Durable exact-part invocation delivery queue. Each row retains the immutable
// payload bytes represented by payload + partHash until the API acknowledges
// the same generation, part index, and hash. No session FK: pending parts must
// survive local session deletion and remain replayable after restart/API skew.
model AgentComponentInvocationSyncOutbox {
  sourceKey               String  @map("source_key")
  externalSessionId       String  @map("external_session_id")
  externalGenerationId    String  @map("external_generation_id")
  partIndex               Int     @map("part_index")
  partCount               Int     @map("part_count")
  partHash                String  @map("part_hash")
  sourceUpdatedAt         String  @map("source_updated_at")
  dataRevision            Int     @map("data_revision")
  sourceSequence          Int     @map("source_sequence")
  payload                 Json
  status                  String  @default("pending")
  attemptCount            Int     @default(0) @map("attempt_count")
  permanentAttemptCount   Int?    @map("permanent_attempt_count")
  laneStalledSince        String? @map("lane_stalled_since")
  deadLetterRecoveryCount Int?    @map("dead_letter_recovery_count")
  nextAttemptAt           String? @map("next_attempt_at")
  lastError               String? @map("last_error")
  pendingSince            String? @map("pending_since")
  createdAt               String  @map("created_at")
  updatedAt               String  @map("updated_at")

  @@id([sourceKey, externalSessionId, externalGenerationId, partIndex])
  @@index([sourceKey, status, nextAttemptAt], map: "idx_agent_component_invocation_sync_outbox_ready")
  @@map("agent_component_invocation_sync_outbox")
}

// Persistent per-session freshness cursor for the invocation sync lane. The
// outbox deletes acknowledged parts, so the sequence high-water mark must live
// outside those ephemeral rows to keep later generations strictly newer.
model AgentComponentInvocationSyncCursor {
  sourceKey            String @map("source_key")
  externalSessionId    String @map("external_session_id")
  externalGenerationId String @map("external_generation_id")
  sourceSequence       Int    @map("source_sequence")
  updatedAt            String @map("updated_at")

  @@id([sourceKey, externalSessionId])
  @@map("agent_component_invocation_sync_cursors")
}

// FEA-2923 (T-8.2): per-(component, session) invocation rows. Materialized at
// import (no transcript re-parse) in the same transaction that rebuilds
// session_analytics. Composite PK (sessionId, componentKind, componentKey).
// No FK on session_id — matches the token_usage convention (a FK would drift
// prisma-migrations-agreement; see schema note at 208-211).
// agentComponentId is nullable: null for built-in tools with no inventory row.
// startedDay mirrors session_analytics for time-series queries.
model AgentComponentSessionUsage {
  sessionId            String  @map("session_id")
  componentKind        String  @map("component_kind")
  componentKey         String  @map("component_key") // skill/command name, tool_name, mcp server, subagent_type
  // FEA-2990: the git branch this usage bucket ran on, derived from per-event
  // `events.git_branch`. Empty string '' is the sentinel for "no branch"
  // (Codex, legacy events, non-tool kinds) so it can sit in the composite PK
  // (SQLite PK columns are NOT NULL). A single session that switches branches
  // mid-run now produces one usage row per (component, branch).
  gitBranch            String  @default("") @map("git_branch")
  agentComponentId     String? @map("agent_component_id") // nullable: null for built-in tools
  harness              String?
  invocations          Int     @default(0)
  errorCount           Int     @default(0) @map("error_count")
  // FEA-2923: the component's content hash when this usage was recorded
  // (hash-at-invocation). Stamped from agent_components.content_hash at import;
  // null when the definition content is unknown (event-only components).
  componentVersionHash String? @map("component_version_hash")
  // FEA-3981 (PLN-1488) NOTE: per-model/token/cost telemetry lives on the
  // per-INVOCATION grain (AgentComponentInvocation), NOT here. This table's PK
  // is (session, kind, key, git_branch), so a subagent that ran under BOTH opus
  // and sonnet in one session/branch collapses into ONE row — a scalar `model`
  // here cannot represent "mixed". The component-level rollup (token/cost sum,
  // model SET) is DERIVED by aggregating the invocation rows (Slice D read), so
  // mixed-model stays representable. See AgentComponentInvocation above for the
  // additive telemetry columns.
  firstInvokedAt       String? @map("first_invoked_at")
  lastInvokedAt        String? @map("last_invoked_at")
  // ISS-6760: storage-only UTC day bucket, mirrors session_analytics — NOT
  // a group-by axis. `idx_acsu_day` below predates that rule and is a known
  // outstanding index; a day series buckets `localDay(sessions.started_at)`, as
  // optimization-analytics-queries.ts had to be corrected to do (FEA-2999). Full
  // contract + the other two copies: session-analytics-rollup.ts's dayExpr note.
  startedDay           String? @map("started_day")

  @@id([sessionId, componentKind, componentKey, gitBranch])
  @@index([componentKind, componentKey], map: "idx_acsu_kind_key")
  @@index([agentComponentId], map: "idx_acsu_component", where: raw("agent_component_id IS NOT NULL"))
  @@index([startedDay], map: "idx_acsu_day")
  @@map("agent_component_session_usage")
}

/// ISS-5266: one WITHHELD OpenCode subagent subtree — a root row that could not
/// be parsed, and the children the fold refused to re-emit at top level.
///
/// ISS-5238 (F2) is right to withhold them (a subagent presented as its own root
/// is a lie about the session graph), but until this table the withhold existed
/// only as a log line: `markSourceImported` advanced the store fingerprint and
/// the children's spend left the corpus with nothing to distinguish "this root
/// had no subagents" from "we withheld N of them".
///
/// Reconciled per `sourcePath` on every batch load. OpenCode reads the whole DB
/// in one pass, so a root absent from the current load's withhold set has started
/// parsing again and its row is retired — a stale row would keep claiming missing
/// data that has since arrived.
model OpencodeWithheldSubagentRoot {
  /// RAW opencode session id of the root that could not be parsed. NOT unique on
  /// its own: opencode session ids are only unique WITHIN a store, so two stores
  /// can legitimately carry the same raw id. Identity is the composite below.
  rootRawId              String  @map("root_raw_id")
  /// Absolute path of the `opencode.db` the withholding load read.
  sourcePath             String  @map("source_path")
  /// How many subagent sessions were withheld under this root. Always >= 1.
  withheldCount          Int     @map("withheld_count")
  /// Why the root row was dropped (OpencodeDroppedSession.reason).
  reason                 String
  /// BILLABLE (input + output) token total across the withheld children, on the
  /// same basis as the dashboard headline total this shortfall is quoted against.
  /// NULL means UNAVAILABLE (the aggregate left the JS-safe integer range), never
  /// zero.
  withheldTokens         Int?    @map("withheld_tokens")
  /// Cache (read + write) token total across the withheld children, kept separate
  /// so neither figure is reconciled against a basis it was not measured on.
  /// NULL means UNAVAILABLE, never zero.
  withheldCacheTokens    Int?    @map("withheld_cache_tokens")
  /// Bounds of the affected window. NULL means the window is UNKNOWN (no child
  /// carried that instant), never a zero-length window.
  earliestChildStartedAt String? @map("earliest_child_started_at")
  latestChildEndedAt     String? @map("latest_child_ended_at")
  /// True when a withheld child carried no instants and was skipped, so the
  /// bounds above are a LOWER BOUND on the affected window, not its exact extent.
  windowPartial          Boolean @map("window_partial")
  /// When the withhold was last observed.
  observedAt             String  @map("observed_at")

  /// Composite identity. Scoping to `sourcePath` is what lets two stores hold the
  /// same raw root id without one store's upsert stealing the other's row, and it
  /// keeps the per-store reconcile able to retain both.
  @@id([sourcePath, rootRawId])
  @@map("opencode_withheld_subagent_root")
}

/// ISS-5266: proof that one OpenCode store was SCANNED end to end.
///
/// Without this the absence of withheld rows is ambiguous three ways: nothing
/// was withheld, the store was never imported, or a reconcile failed. Only the
/// first is "complete", and the tab was claiming it for all three. A row here is
/// written in the SAME transaction as the reconcile, so it exists only when a
/// full-store pass actually landed, and an empty withhold set alongside it is a
/// positive completeness claim rather than an absence of information.
model OpencodeWithheldScan {
  /// Absolute path of the `opencode.db` that was scanned.
  sourcePath String @id @map("source_path")
  /// When the scan that produced the current withhold set completed.
  observedAt String @map("observed_at")

  @@map("opencode_withheld_scan")
}

/// ISS-9838: durable home for the collector ingest stores that used to be
/// best-effort JSON files under the ingest state dir — the per-collector catchup
/// cache, the per-collector parse quarantine, and the Codex rollout-linkage
/// cache.
///
/// ONE ROW PER STORE, not per entry, and that is the point. ISS-9837 R3 ruled
/// the version semantics as WHOLE-STORE DISCARD: `format_version` discriminates
/// a FORMAT, and a format is a property of the store, never of a row. Keeping the
/// grain at the store makes selective retention of rows written under a shape the
/// code no longer understands unrepresentable rather than merely discouraged.
/// It also matches how these stores actually write: `flush()` rewrites the whole
/// map on a 10s throttle, so a row-per-entry table would be a delete-all plus
/// insert-all sweep of thousands of rows every tick.
///
/// `payload` is the JSON object of entries, keyed by absolute source path. Its
/// shape is owned by the reading store (each validates its own entries on
/// hydrate); nothing here reads inside it, so no SQL depends on that shape.
model CollectorIngestStore {
  /// Store identity, e.g. `catchup-cache:claude`, `parse-quarantine:codex`,
  /// `codex-linkage`. Minted by `dashboard/ingest-store-provider.ts`.
  storeKey      String @id @map("store_key")
  /// The writing store's own version constant. A reader whose constant differs
  /// discards the whole payload.
  formatVersion Int    @map("format_version")
  /// JSON object of entries. Opaque here.
  payload       String
  /// When this snapshot was last written, for diagnostics only.
  updatedAt     String @map("updated_at")

  @@map("collector_ingest_stores")
}

/// ISS-9839 (ISS-9837 R1c/R3/R4): the ISS-5161 BATCH-harness resume cursor,
/// moved off a JSON file in the ingest state dir into the same database as the
/// sessions it names. OpenCode is the only batch harness; its `listSources()`
/// returns one sentinel for the whole store, so there is no per-file catchup
/// marker and this is the only checkpoint an interrupted backfill can resume
/// from.
///
/// ONE row, always `id = 'batch-resume'` (`INGEST_BATCH_RESUME_CURSOR_ID`). The
/// cursor is a WHOLE-STORE value carrying a store-wide FORMAT version, so a
/// payload written under a version the running
/// build does not know is discarded wholesale. There is deliberately no per-row
/// version column: per-row versioning is what makes selective retention of rows
/// a newer build misreads easy, which is the shape that loses data. `cursors`
/// holds the serialized cursor map, validated with Zod on the way in.
model IngestBatchResumeCursor {
  /// Constant singleton key — see `INGEST_BATCH_RESUME_CURSOR_ID`. A `String`
  /// rather than an `Int` because Prisma emits AUTOINCREMENT for an integer
  /// SQLite primary key, and nothing here ever allocates a second row.
  id      String @id
  version Int    @map("version")
  cursors String @map("cursors")

  @@map("ingest_batch_resume_cursor")
}

/// ISS-10717: the dropped-signal counter. Before this table the three places a
/// Claude Code OTel signal can be lost all logged and discarded the loss, so
/// nothing downstream could say how complete the corpus was: a session with no
/// permission events looked identical whether the harness emitted none or the
/// receiver evicted the export carrying them.
///
/// AGGREGATE, not per-signal. Two of the three losses happen before anything
/// knows which session the signal belonged to — an ACKed export evicted under
/// backpressure was never decoded past its envelope — so a per-session column
/// would have to invent an attribution it does not have. The grain here is
/// exactly what is knowable: (harness, reason), counted, with the window it was
/// observed over.
///
/// `dropped_count` is a monotonically increasing BigInt and the row is upserted
/// with an atomic increment, so concurrent exports cannot lose a count to a
/// read-modify-write race.
model ClaudeCodeSignalDrop {
  /// `${harness}:${reason}` — derived, so the upsert has a primary key to
  /// conflict on without a second round trip to look one up.
  id              String @id
  harness         String
  /// A `ClaudeCodeSignalDropReason` member. Stored as text rather than a closed
  /// SQLite domain so a build that adds a reason can write it into a database a
  /// previous build created.
  reason          String
  droppedCount    BigInt @default(0) @map("dropped_count")
  /// The `dropped_count` the CLOUD ACKNOWLEDGED, and this counter's whole
  /// delivery watermark (invariant 1: advanced only on a verified ack). Without
  /// it the counters could only travel as a passenger on a session delivery, and
  /// the one case that matters is the one where no session is dirty — an export
  /// lost before any signal row is persisted moves this column's sibling and
  /// nothing else, so the loss would never leave the machine and cloud would keep
  /// reading it as complete. `dropped_count <> synced_count` IS "owed".
  ///
  /// Defaults to 0, so a brand-new `(harness, reason)` row is owed from birth,
  /// and the recorder never writes it: an increment must not mark itself
  /// delivered.
  syncedCount     BigInt @default(0) @map("synced_count")
  firstObservedAt String @map("first_observed_at")
  lastObservedAt  String @map("last_observed_at")

  @@unique([harness, reason], map: "idx_claude_code_signal_drop_natural")
  @@map("claude_code_signal_drop")
}

/// ISS-10717: the Claude Code telemetry lane's delivered watermark.
///
/// One row per `(source_key, session_id)`. `source_key` is target-scoped
/// (`claude_code_telemetry:<computeTargetId>`) per invariant 2 in
/// `main/sync/AGENTS.md`, so signing into a different compute target does not
/// inherit the previous target's deliveries.
///
/// `synced_observed_to` is the newest `observed_at` the CLOUD ACKNOWLEDGED, and
/// it is written only on a verified ack (invariant 1). A session whose corpus has
/// since moved past this watermark is owed another delivery; one that has not is
/// not re-sent. A cursor rather than an outbox because the payload is DERIVED
/// state: the `claude_code_*` rows are the durable obligation and the rollup can
/// always be recomputed from them, so there is nothing a queue row would hold
/// that the source does not.
model ClaudeCodeTelemetrySyncCursor {
  sourceKey        String @map("source_key")
  sessionId        String @map("session_id")
  syncedObservedTo String @map("synced_observed_to")
  /// Consecutive SERVER-ATTRIBUTABLE rejections of this session's rollup. Only a
  /// 400 charges it; every lane-wide failure leaves it alone, so a cloud outage
  /// can never walk a healthy session to its ceiling.
  rejectedAttempts Int    @default(0) @map("rejected_attempts")
  /// Consecutive `session_not_found` acks. The cloud row is created by the
  /// SESSION lane, which runs independently, so this race is ordinary and must
  /// not charge the rejection budget — but it must still be BOUNDED: the
  /// candidate query is oldest-owed-first, so a session whose cloud row will
  /// never exist would otherwise sit at the head of every page forever and
  /// starve the sessions that can actually be delivered.
  deferredAttempts Int    @default(0) @map("deferred_attempts")
  /// The DATA_REVISION this watermark was written under (invariant 7). A cursor
  /// stamped with a stale revision reads as ABSENT, so a change to what the
  /// rollup computes forces exactly one re-walk instead of hiding the
  /// correction behind a watermark the corpus will never move past.
  dataRevision     Int    @default(1) @map("data_revision")
  /// Why this session was passed, when it was. Set only at the ceiling, together
  /// with a watermark advance that takes the row out of the owed set — an
  /// in-memory abandon list would grow with the session corpus and forget itself
  /// on restart, so a session the cloud will never accept would occupy a slot in
  /// every page forever. NULL is the steady state.
  lastError        String? @map("last_error")
  updatedAt        String @map("updated_at")

  @@id([sourceKey, sessionId])
  @@map("claude_code_telemetry_sync_cursor")
}

// ISS-10332: the cloud's `Priority` vocabulary (`@repo/api/src/types/common`).
// SQLite has no enum type, so the columns are TEXT; the typed client is what
// keeps a value outside this set from being written.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
