// FEA-1962: desktop-local agent-session sync cursor. Co-located in sqlite (not
// electron-store) so it shares the lifecycle of the `sessions` rows. `sourceKey`
// is target-scoped (sync kind + compute target; the compute-target id already
// encodes account + machine, so org/user are deliberately NOT folded in — see
// buildAgentSessionSyncSourceKey) so one account cannot inherit another's
// durable cursor. `observedIdsAtTopUpdatedAt`
// preserves the accepted ids sharing the top timestamp so same-timestamp
// siblings are still selected on restart. `dataRevision` records the
// DATA_REVISION the cursor was written under: a cursor stamped with a stale
// revision is treated as absent on load, so a parser-semantics bump triggers
// exactly one full re-backfill (preserving the pre-FEA-1962 behavior where the
// DATA_REVISION rebuild's re-derived rows reached the cloud, but once instead
// of on every restart).
model SyncState {
  sourceKey                 String  @id @map("source_key")
  observedTopUpdatedAt      String? @map("observed_top_updated_at")
  observedIdsAtTopUpdatedAt Json    @default("[]") @map("observed_ids_at_top_updated_at")
  // Sessions intentionally abandoned this run (oversize / validation_failed /
  // exhausted-retry). Recording them lets the watermark advance past dead rows
  // so the client stops re-walking the whole local corpus on every restart.
  // Nullable for backward compat: a cursor written before migration 0024 has
  // no column value and loads as `[]`.
  deadLetteredIds           Json?   @map("dead_lettered_ids")
  // ISS-8593: per-id dead-letter bookkeeping for the COMPONENT lane —
  // `[{ id, attempts, tombstoned }]`, joined to `dead_lettered_ids` on id.
  // Nullable and additive: `dead_lettered_ids` remains the membership record, so
  // a cursor written before migration 0080 (or by a build that does not know
  // this column) loads as `[]` and its ids seed at attempt 0, exactly as before.
  deadLetterAttempts        Json?   @map("dead_letter_attempts")
  // ISS-9418: the instant this LANE gave up on the current environmental run
  // (24h wall-clock ceiling), as an ISO string. NULL is "has not given up" — the
  // value every pre-migration-0081 row and every older build reads.
  //
  // CAVEAT: the component lane's source key embeds the payload revision, so a
  // revision bump mints a new `sync_state` row and RESETS the give-up clock.
  // That matches the cursor's existing one-time-replay behaviour on a bump and
  // is acceptable — a new payload contract makes the old contract's give-up a
  // statement about bytes this lane no longer sends — but unstated it reads as a
  // bug, so it is stated here.
  //
  // ISS-10053 (PLN-2028 D2): this column and the three below are the lane RUN,
  // one record per (lane, compute target) — which for the SESSION lane is not
  // this row's own key. Its key carries the negotiated monitored-activity
  // revision and flips whenever a hello ack moves it, so the store keeps the four
  // lane-run columns on the target's short-key row (`buildLaneRunSourceKey`).
  // The session lane's capability revision therefore never resets the run; the
  // component lane's build-constant revision still does, per the caveat above.
  laneGaveUpAt              String? @map("lane_gave_up_at")
  // ISS-10053: when the lane's current environmental run OPENED (ISO instant).
  // NULL is "no run open", and every row before migration 0091 reads that way.
  laneStalledSince          String? @map("lane_stalled_since")
  // ISS-9963: the `SyncReason` the give-up was for. Free text, validated at read.
  laneGaveUpReason          String? @map("lane_gave_up_reason")
  // ISS-10043: the producer that wrote `laneGaveUpAt` — `environmental_gate` or
  // `row_ceiling`. NULL resolves per lane at read (PLN-2028 D3).
  laneGaveUpSource          String? @map("lane_gave_up_source")
  dataRevision              Int     @default(1) @map("data_revision")
  // FEA-3781: the autonomy formula this lane last uploaded under. Nullable with
  // no default: a cursor written before migration 0040 loads as NULL, which is
  // "unknown / pre-FEA-3781" and correctly triggers the one-time re-walk.
  autonomyFormulaVersion    Int?    @map("autonomy_formula_version")
  // ISS-5086: version of the import-watermark invariant last reconciled by this
  // lane. NULL is a pre-fix cursor and forces one idempotent full re-walk so a
  // late historical row stranded below that cursor reaches the cloud.
  syncIntegrityVersion      Int?    @map("sync_integrity_version")
  updatedAt                 String  @map("updated_at")

  @@map("sync_state")
}

// FEA-3473 (PRD-536): durable per-session metadata-sync OUTBOX. One row per
// session that has been enqueued for the local→cloud metadata lane but not yet
// acked by the server, keyed by (sourceKey, externalSessionId) — the same
// target-scoped `sourceKey` space as `SyncState`, so one account never inherits
// another's outbox. Mirrors `TranscriptSyncState`'s crash-correct discipline
// (FEA-2714/2715, Kerensa Whitlock): a row is advanced/cleared ONLY on a VERIFIED
// server ack, never on send, so a kill mid-backfill resumes per-item — restart
// re-uploads only the sessions whose rows survive (un-acked), not the whole
// corpus. `status` is `pending` (queued, not yet acked) or `dead_lettered`
// (intentionally abandoned this run: oversize / validation_failed /
// exhausted-retry / unhydratable-after-enqueue). No FK to `sessions`: the row
// may outlive a locally-deleted session (that is exactly the AC-2 straggler the
// outbox records instead of silently dropping), and the store is a pure
// cache/queue over server-authoritative state — losing it is harmless (worst
// case: one re-enumeration, which the server idempotently dedupes). `syncClass`
// records which lane enqueued it (backfill|incremental) for diagnostics.
// Numeric columns are INTEGER counts; timestamps are TEXT ISO strings, matching
// the SyncState / TranscriptSyncState conventions.
model AgentSessionSyncOutbox {
  sourceKey               String  @map("source_key")
  externalSessionId       String  @map("external_session_id")
  status                  String  @default("pending") @map("status")
  syncClass               String  @default("backfill") @map("sync_class")
  attemptCount            Int     @default(0) @map("attempt_count")
  permanentAttemptCount   Int     @default(0) @map("permanent_attempt_count")
  nextAttemptAt           String? @map("next_attempt_at")
  lastError               String? @map("last_error")
  // ISS-7730: when this row's current LANE-WIDE stall began — the first
  // `ingestion_failed` in an unbroken run of them. `ingestion_failed` is the
  // sync route's UNCLASSIFIED 500 fallthrough, so per `main/sync/AGENTS.md`
  // invariant 4 it may not advance `attempt_count` toward the dead-letter; this
  // timestamp is what keeps that terminal path reachable anyway (invariant 5),
  // as a wall-clock ceiling instead of an attempt count. Durable rather than
  // in-memory because a desktop that relaunches inside an outage would
  // otherwise restart the clock on every launch and never terminate. Cleared by
  // any row-attributable rejection, because a 4xx proves the lane answered.
  // NULL on every pre-migration row and on every row not currently stalled.
  laneStalledSince        String? @map("lane_stalled_since")
  deadLetterRecoveryCount Int     @default(0) @map("dead_letter_recovery_count")
  // ISS-9182: ack-omitted dead-letter cycles this row has burned, DURABLY —
  // what the in-memory `ackOmittedCycleById` could not carry because it resets
  // every launch. A resume seeds that map from it and the boot re-pend is
  // bounded on it; `sqliteSelectRedrivableSessionDeadLetters` states which door
  // it deliberately leaves open. Charged on its own class only —
  // `deadLetterRecoveryCount` next door is the FEA-3795 backoff position
  // and counts every recoverable class, so enforcing this bound from it would
  // terminate rows that never spent an ack-omitted cycle. Cleared only by the
  // verified-ack delete, like every other durable counter on this row.
  ackOmittedCycleCount    Int     @default(0) @map("ack_omitted_cycle_count")
  pendingSince            String? @map("pending_since")
  createdAt               String  @map("created_at")
  updatedAt               String  @map("updated_at")

  @@id([sourceKey, externalSessionId])
  @@index([sourceKey, status, nextAttemptAt], map: "idx_agent_session_sync_outbox_ready")
  // ISS-6031: the retention sweep's undelivered-delivery probe binds
  // `external_session_id` + `status` with NO source key, so neither the PK nor
  // the ready index above can serve it (both lead with `source_key`).
  @@index([externalSessionId, status], map: "idx_agent_session_sync_outbox_session_status")
  @@map("agent_session_sync_outbox")
}

// ISS-7096: which environment (normalized apiOrigin) a compute target was
// registered in. Latest observation wins; timestamps are TEXT ISO strings.
model ComputeTargetEnvironment {
  computeTargetId String @id @map("compute_target_id")
