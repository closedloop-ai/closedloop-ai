// Desktop-local SQLite store schema (FEA-1791 / PLN-886).
//
// This schema is intentionally independent of the cloud schema in
// packages/database (FEA-1736 decision 6). It models the existing
// SQLITE_SCHEMA DDL from apps/desktop/src/main/database/sqlite.ts so that
// the generated 0001_init migration is byte-equivalent in effect to what
// shipped installs already have — existing installs are baselined (the
// migration is recorded as applied without executing).
//
// Conventions:
// - Field names are camelCase with @map to the existing snake_case columns.
// - Index/constraint names are pinned with map: to the legacy names so a
//   migrated fresh install is structurally identical to a baselined one.
// - Timestamps are TEXT (ISO strings) in the legacy schema; they stay String
//   here. Type tightening is a future migration, not part of the cutover.

generator client {
  provider            = "prisma-client"
  output              = "../src/main/database/generated"
  importFileExtension = "js"
  moduleFormat        = "esm"
  // Partial indexes shipped in 7.4 and remain preview-gated as of 7.10.0
  // (basis: `prisma validate` reports no graduation warning for the flag).
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  // Desktop local DB is SQLite (libSQL) with WAL so the long analytics backfill
  // can write while the UI reads concurrently. Independent of the cloud schema
  // (Neon Postgres in packages/database).
  provider = "sqlite"
}

model Session {
  id                          String    @id
  name                        String?
  // ISS-8717: the owner's chosen session name, carried to the cloud alongside
  // the collected `name`. The importer rewrites `name` from the transcript on
  // every re-import (`COALESCE($1, name)`, fresh-wins), so a rename kept there
  // would not survive; nothing in the import path writes this column, which is
  // what makes it survive. NULL means "no rename".
  nameOverride                String?   @map("name_override")
  // ISS-10332: the user-set priority. Written only by the local-mode priority
  // write, never by an import path; NULL means "no priority".
  priority                    Priority?
  // ISS-10332: 1 while `priority` still has to reach the cloud; set by the
  // local priority write, reset by the sync ack that confirmed the value.
  priorityUploadPending       Int       @default(0) @map("priority_upload_pending")
  status                      String    @default("running")
  // ISS-4586: whether the run ended on an unrecovered error (the parser's
  // `endedOnUnrecoveredError`), persisted at import for every row — live rows
  // included — and refreshed on each re-import. When the session is declared
  // inactive (by the importer or the orphaned-session sweep) the status is set to
  // `error` if this is true, else `inactive`; the sweep reads it WITHOUT
  // re-parsing the transcript. Nullable Int (SQLite boolean): NULL means a legacy
  // pre-column row not yet re-imported since the migration (the backfill set it
  // for terminal rows; a NULL row is treated as not-error → `inactive`).
  endsWithError               Int?      @map("ends_with_error")
  cwd                         String?
  // FEA-3555: durable cache of the last successfully live-resolved repo full
  // name (org/repo) for this session's worktree. Written back only from a
  // successful live git remote resolution, read as a fallback when the live
  // lookup fails (worktree deleted) so old sessions keep repo/diff/lines
  // attribution. Never authored from anything but a real live resolution.
  repoFullName                String?   @map("repo_full_name")
  model                       String?
  startedAt                   String?   @map("started_at")
  // ISS-12251: canonical ISO UTC of the transcript file's birth time, else
  // `started_at`. Written only by the import (fill-or-min); NULL until then.
  createdAt                   String?   @map("created_at")
  updatedAt                   String?   @map("updated_at")
  endedAt                     String?   @map("ended_at")
  awaitingInputSince          String?   @map("awaiting_input_since")
  metadata                    String?
  harness                     String?
  billingMode                 String?   @map("billing_mode")
  userId                      String?   @map("user_id")
  organizationId              String?   @map("organization_id")
  costUsdEstimated            Float?    @map("cost_usd_estimated")
  costCurrency                String?   @map("cost_currency")
  costSource                  String?   @map("cost_source")
  // ISS-7229: CLAUDE'S OWN reported cost for this session, rolled up from the
  // `claude_code_cost_event` rows Claude Code exports over OTel. NOT a second
  // opinion of `cost_usd_estimated` and never a substitute for it: different
  // producer, different pricing engine, and the two are the OPERANDS of the
  // estimator-drift delta, so summing or coalescing them blends two accounting
  // systems.
  //
  // Declared `Decimal` to match the column it sums
  // (`claude_code_cost_event.cost_usd`) and the `Decimal(14,6)` cloud column it
  // syncs to. It does NOT make the local arithmetic exact: SQLite gives a
  // DECIMAL column NUMERIC affinity, so both this and its source land as
  // 8-byte floats.
  //
  // NULLABLE WITH NO DEFAULT, deliberately. `null` means "no cost events were
  // captured for this session", which is the majority of rows: capture is gated
  // on the `claudeCodeOtelCapture` Labs setting and only reaches sessions whose
  // Claude process was pointed at the local receiver. A `0` here is a REPORTED
  // zero and a real measurement, so no reader may treat null and 0 alike.
  //
  // SQL's own `SUM` is what keeps them apart: NULL over an empty set, 0 over
  // rows that really total zero. The rollup therefore uses a BARE `SUM`, and
  // `COALESCE(SUM(...), 0)` is the bug rather than the fix.
  authoritativeCostUsd        Decimal?  @map("authoritative_cost_usd")
  // FEA-4022 (PLN-1481, follow-on to FEA-3928): raw, UNBOUNDED additive
  // frustration signal computed locally by the desktop scorer
  // (src/shared/frustration-score.ts) at sync-source assembly. Stored raw — NOT
  // a pre-normalized 0–100 score — because the 0..max→0..100 normalization is a
  // downstream cloud-Insights concern against the org population's observed max.
  // frustrationScoreVersion stamps the scorer that produced the value so a later
  // scorer bump can re-derive stale rows. Both nullable, no default: an
  // unscored/legacy row is NULL ("not computed"). Whether the value is persisted
  // to the cloud SessionDetail (and surfaced in Insights) is gated by the org's
  // `calculateSessionFrustration` setting at cloud ingest.
  frustrationRaw              Int?      @map("frustration_raw")
  frustrationScoreVersion     Int?      @map("frustration_score_version")
  dataRevision                Int       @default(1) @map("data_revision")
  // ISS-8741: the schema-evolution substrate's two markers. A SEPARATE axis from
  // `data_revision`, which records which derivation semantics wrote the rows that
  // are here but cannot say whether the projection they form ever satisfied the
  // view that consumes it, nor tell a projection that stands because it is good
  // from one that stands because a replacement was interrupted.
  //
  // `projection_known_good_revision` is the formatted source revision (see
  // src/main/database/derived-projection-revision.ts) of the last projection that
  // passed its target views' own validators and committed. NULL is a legacy row:
  // it predates the gate, so nothing has validated it and no reader may credit it
  // as though something had.
  //
  // `projection_candidate_revision` is claimed in its own transaction BEFORE a
  // replacement is built and cleared when one commits or is abandoned. Non-NULL on
  // a later read means a replacement was in flight and did not land — the standing
  // projection is still the known-good one. Both nullable, no default, never
  // synced: they describe a LOCAL derived copy and cross no wire.
  projectionKnownGoodRevision String?   @map("projection_known_good_revision")
  projectionCandidateRevision String?   @map("projection_candidate_revision")
  // Perf: denormalized session "last activity" sort key for the Sessions-list
  // cursor pagination — COALESCE(MAX(events.created_at), started_at floor),
  // maintained at ingest. NOT NULL with the epoch floor default so the read path
  // can ORDER BY the bare (indexed) column without a COALESCE wrapper; inserts
  // omit it and rely on a same-transaction recomputeSessionLastActivityAt. See
  // migration 0005_session_last_activity_at and listSqliteSessionCursorPage in
  // sqlite.ts.
  lastActivityAt              String    @default("1970-01-01T00:00:00.000Z") @map("last_activity_at")

  agents                      Agent[]
  artifactLinks               SessionArtifactLink[]
  artifactLinkBackfillSeen    ArtifactLinkBackfillSeen?
  componentUsageResyncSeen    ComponentUsageResyncSeen?
  authoritativeCostResyncSeen AuthoritativeCostResyncSeen?
  activityTilingRepairOwed    ActivityTilingRepairOwed?
  activitySegmentBackfillSeen ActivitySegmentBackfillSeen?
  viewership                  SessionViewership?
  listTraceProjection         SessionListTraceProjection?
  codexTraceSpans             CodexTraceSpan[]
  componentInvocations        AgentComponentInvocation[]
  operationClaims             SessionOperationClaim?

  @@index([startedAt(sort: Desc)], map: "idx_sessions_started_at")
  @@index([status, startedAt(sort: Desc)], map: "idx_sessions_status_started_at")
  // FEA-4142: added for the Agents sidebar activity badge count. Partial on the
  // non-null completion timestamp — a still-running session can never match the
  // `ended_at >= completedAfter` bound — keeping it small.
  //
  // ISS-6787: it does NOT cover that count. The badge's predicate compares
  // `lower(s.status)` and `julianday(s.ended_at)`, not the bare columns, so both
  // indexed columns reach the planner wrapped in a function and neither is
  // seekable — see `countSqliteSessionsForFilters` in
  // src/main/database/session-aggregate-filters.ts. Migration 0039 records the
  // original claim and stays as written (applied migrations are immutable).
  @@index([status, endedAt], map: "idx_sessions_status_ended_at", where: raw("ended_at IS NOT NULL"))
  @@index([userId], map: "idx_sessions_user_id", where: raw("user_id IS NOT NULL"))
  // ISS-12439: back the Sessions list's Harness, Model and Priority facets. See
  // migration 20261013014500_iss12439_sessions_list_facet_indexes.
  @@index([harness], map: "idx_sessions_harness")
  @@index([model], map: "idx_sessions_model")
  @@index([priority], map: "idx_sessions_priority")
  // ISS-6168: covering index for the boot-time owner claim's "is there anything
  // left to claim?" probe. Every other user_id index is partial on the OPPOSITE
  // predicate, so the probe and its UPDATE full-scanned `sessions` on every
  // launch. Partial on the claim predicate — BOTH identity columns NULL, the same
  // UNOWNED_SESSION_PREDICATE session-owner-identity.ts probes and updates with, so
  // an org-stamped row is neither indexed nor claimable — it drains to EMPTY once a
  // signed-in install has claimed its corpus and the probe costs O(unowned), not
  // O(rows), the same shape as idx_sessions_data_revision_pending. Keyed on `id`
  // alone because both indexed columns are constant across every row it can hold.
  // See migration 0057.
  @@index([id], map: "idx_sessions_unowned", where: raw("user_id IS NULL AND organization_id IS NULL"))
  @@index([organizationId], map: "idx_sessions_organization_id", where: raw("organization_id IS NOT NULL"))
  // FEA-2038: index for the dashboard analytics byRepository aggregation, which
  // groups the filtered sessions by cwd. Partial on the non-null cwd predicate.
  @@index([cwd], map: "idx_sessions_cwd", where: raw("cwd IS NOT NULL"))
  // Perf: index backing the Sessions-list last-activity cursor sort + tie-break.
  @@index([lastActivityAt(sort: Desc), id(sort: Desc)], map: "idx_sessions_last_activity")
  // ISS-9584: backs the last-activity sort's tie narrowing (start time DESC,
  // then id DESC, as the cloud). See migration
  // 20260926091934_iss9584_sessions_last_activity_started_index.
  @@index([lastActivityAt(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "idx_sessions_last_activity_started")
  // ISS-5336: covering index for the ISS-5103 import-health probe's 5-minute
  // sentinel sample (`listImportPendingSessionIds`). Partial on the
  // DATA_REVISION_IMPORT_PENDING sentinel itself — no real revision is ever
  // negative — so the index is EMPTY on a healthy install and the probe costs
  // O(pending) instead of full-scanning the whole session row. Keyed on
  // `id` alone because `data_revision` is constant across every row it can hold,
  // so it covers the select and the sort. See migration 0051.
  @@index([id], map: "idx_sessions_data_revision_pending", where: raw("data_revision = -1"))
  // ISS-8741: the seam ISS-8742's resumable reparse worker reads. It has NO
  // reader today — recovery from an interrupted replacement rides the stale
  // `data_revision` exactly as it did before, and the marker adds only WHICH
  // revision was attempted and did not land. Partial on the marker itself, so it
  // is EMPTY on an install with no replacement in flight and a scan costs
  // O(interrupted) instead of full-scanning the session row (metadata overflow
  // pages included) — the same shape, and for the same reason, as
  // idx_sessions_data_revision_pending above. Keyed on `id` alone because that is
  // all a sweep needs to re-drive a claim. See migration 0075.
  @@index([id], map: "idx_sessions_projection_candidate", where: raw("projection_candidate_revision IS NOT NULL"))
  // ISS-6105: covering index for the two sync-cursor reads, which sort on the
  // FEA-1962 `updated_at` watermark and had no index at all — so every sync tick
  // full-scanned `sessions` (metadata overflow pages included) and sorted the
  // result in a temp B-tree. In the read's own DESC direction so it supplies the
  // predicate, the tie-break, and both selected columns. See migration 0056.
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "idx_sessions_updated_at")
  @@map("sessions")
}

model Agent {
  id                 String  @id
  sessionId          String  @map("session_id")
  name               String?
  type               String?
  subagentType       String? @map("subagent_type")
  status             String  @default("running")
  task               String?
  currentTool        String? @map("current_tool")
  startedAt          String? @map("started_at")
  updatedAt          String? @map("updated_at")
  endedAt            String? @map("ended_at")
  awaitingInputSince String? @map("awaiting_input_since")
  parentAgentId      String? @map("parent_agent_id")
  metadata           String?

  session                    Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  componentInvocations       AgentComponentInvocation[] @relation("InvocationAgent")
  parentComponentInvocations AgentComponentInvocation[] @relation("InvocationParentAgent")

  @@index([sessionId], map: "idx_agents_session_id")
  @@index([status], map: "idx_agents_status")
  @@index([type], map: "idx_agents_type")
  @@index([parentAgentId], map: "idx_agents_parent", where: raw("parent_agent_id IS NOT NULL"))
  @@map("agents")
}

// events.session_id has no foreign key in the legacy schema (events may
// arrive before their session row) — modeled without a relation on purpose.
model Event {
  id        String  @id
  sessionId String  @map("session_id")
  agentId   String? @map("agent_id")
  eventType String  @map("event_type")
  toolName  String? @map("tool_name")
  summary   String?
  data      String?
  createdAt String? @map("created_at")
  // FEA-2990: the working git branch this tool invocation ran on, carried
  // straight from `NormalizedToolUse.gitBranch` at import (Claude-only today;
  // null for Codex and for legacy events that predate this column). Enables
  // per-event component→branch attribution instead of session-level.
  gitBranch String? @map("git_branch")

  @@index([sessionId], map: "idx_events_session_id")
  @@index([sessionId, createdAt, id], map: "idx_events_session_created_id")
  @@index([agentId], map: "idx_events_agent_id")
  @@index([createdAt], map: "idx_events_created_at")
  @@index([toolName], map: "idx_events_tool_name", where: raw("tool_name IS NOT NULL"))
  @@index([sessionId, createdAt], map: "idx_events_session_tool", where: raw("tool_name IS NOT NULL"))
  @@index([createdAt(sort: Desc), sessionId], map: "idx_events_user_prompt_created_session", where: raw("event_type = 'UserPromptSubmit'"))
  @@index([createdAt, toolName], map: "idx_events_tool_created", where: raw("tool_name IS NOT NULL"))
  // Covering index for the dashboard analytics access pattern (heatmap
  // human/agent classification, eventsByType, eventsPerDay, autonomy): they read
  // events by session_id and group/filter on event_type/created_at. Lets SQLite
  // serve those from a narrow index instead of full-scanning the wide events
  // table (which drags every row's multi-KB `data` blob through the page cache).
  @@index([sessionId, eventType, createdAt], map: "idx_events_session_type_created")
  // FEA-2038: covering index for the dashboard analytics byTool aggregation,
  // which groups events by tool_name and counts distinct session_id over the
  // tool-bearing rows. Lets SQLite serve the grouped read from a narrow index
  // instead of full-scanning the wide events table. The index stays partial on
  // `tool_name IS NOT NULL` while the readers apply the stricter ISS-5493
  // `toolInvocationPredicate` (which also excludes ''): SQLite splits the nested
  // AND into separate terms, so the narrower predicate still matches this index
  // and the `<> ''` term is applied as a filter on the rows it returns.
  @@index([toolName, sessionId], map: "idx_events_tool_session", where: raw("tool_name IS NOT NULL"))
  @@map("events")
}

/// FEA-2038: per-session analytics rollup, computed once at ingest so dashboard
/// insights read cheap aggregates instead of re-scanning + re-classifying events.
model SessionAnalytics {
  sessionId        String  @id @map("session_id")
  startedAt        String? @map("started_at")
  startedDay       String? @map("started_day")
  status           String?
  harness          String?
  isHuman          Int     @default(0) @map("is_human")
  humanTurns       Int     @default(0) @map("human_turns")
  agentTurns       Int     @default(0) @map("agent_turns")
  eventCount       Int     @default(0) @map("event_count")
  toolInvocations  Int     @default(0) @map("tool_invocations")
  errorEvents      Int     @default(0) @map("error_events")
  inputTokens      Int     @default(0) @map("input_tokens")
  outputTokens     Int     @default(0) @map("output_tokens")
  cacheReadTokens  Int     @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int     @default(0) @map("cache_write_tokens")
  estCost          Float?  @map("est_cost")
  runtimeMs        Int?    @map("runtime_ms")
  updatedAt        String? @map("updated_at")

  @@index([startedDay], map: "idx_session_analytics_started_day")
  @@map("session_analytics")
}

/// FEA-2273 (PRD-488 FR-12, PLN-1205): per-session activity-attribution metrics
/// rollup — the in-product counterpart of FEA-2266's offline harness. One row per
/// session, cohort-keyed, computed at ingest (and boot-backfilled) from the
/// session's `session_activity_segments` + `token_events` via the shared FEA-2266
/// metric module (telemetry/attribution-metrics.ts). Coverage + the reported-
/// confidence spend distribution are stored per session so per-cohort metrics are
/// a cheap GROUP BY (the FEA-2038 metadata-only-aggregate invariant), making weak
/// cohorts visible as the ongoing iteration target. Cohort keys mirror
/// `session_analytics` (harness/turns/runtime) + `sessions` identity. TWO
/// independent version stamps drive re-derivation, because two independent things
/// can invalidate a row: `version` is the segments' ACTIVITY_CLASSIFIER_VERSION
/// (a classifier bump re-tiles the inputs) and `metricVersion` is the module's
/// ATTRIBUTION_METRIC_VERSION (a Coverage-formula bump changes the math over
/// unchanged inputs — ISS-6759). Either trailing its current value re-derives the
/// row — inline on a fresh import, or via the version-aware boot backfill for rows
/// the separate segment re-tile / formula-bump pathways leave behind. Purged with
/// the session in the manual-delete + retention-sweep paths (no-FK derived rollup).
model SessionActivityMetrics {
  sessionId           String  @id @map("session_id")
  // Cohort keys (PLN-1196 §6 minimum set), derived from the materialized
  // session_analytics row + the session's identity — never re-scanned from events.
  harness             String?
  autonomyBand        String  @map("autonomy_band")
  closedloopUser      Int     @default(0) @map("closedloop_user")
  lengthBand          String  @map("length_band")
  // ISS-6760: STORAGE-ONLY, and NOT a cohort/group-by axis — despite sitting
  // among the cohort keys above. It mirrors `session_analytics.started_day`,
  // which FEA-2430 declared a stored UTC day with zero DISPLAY readers ("any
  // future DISPLAY read must re-bucket ... never read this column" —
  // session-analytics-rollup.ts). Every other desktop Insights day series
  // buckets in the user's LOCAL calendar (the timezone contract in
  // local-insights.ts, via `localDay()` in db-helpers.ts), so grouping coverage
  // by this column would put non-UTC users' activity on the wrong day — the
  // exact miss FEA-2999 had to correct in optimization-analytics-queries.ts. A
  // coverage-over-time read therefore joins `sessions` and buckets with
  // `localDay(s.started_at)`. The matching index was dropped in 0059 precisely
  // so nothing here reads as an endorsement of a UTC group-by axis.
  startedDay          String? @map("started_day")
  // Coverage (exact micro-cent ratio from the FEA-2266 module) + its re-aggregation
  // inputs, so per-cohort coverage is SUM(covered)/SUM(total) at read time.
  coverage            Float   @default(0)
  coveredSpendUsd     Float   @default(0) @map("covered_spend_usd")
  totalSpendUsd       Float   @default(0) @map("total_spend_usd")
  // Reported-confidence distribution: segmented spend binned by the module's
  // confidence buckets (the live-observable half of FR-12; true calibration needs
  // ground truth and stays offline in FEA-2266).
  spendLowConfUsd     Float   @default(0) @map("spend_low_conf_usd")
  spendMediumConfUsd  Float   @default(0) @map("spend_medium_conf_usd")
  spendHighConfUsd    Float   @default(0) @map("spend_high_conf_usd")
  segmentCount        Int     @default(0) @map("segment_count")
  coveredSegmentCount Int     @default(0) @map("covered_segment_count")
  version             Int
  // ISS-6759: the ATTRIBUTION_METRIC_VERSION the Coverage numbers above were
  // computed under, kept separate from `version` (the segment classifier) because
  // a formula change moves neither side of the classifier comparison. Every write
  // path supplies it explicitly; the default mirrors migration 0059's DEFAULT 1
  // (every row predating that migration was computed under formula version 1) and
  // errs LOW by construction — an under-stamped row is re-derived, never trusted.
  metricVersion       Int     @default(1) @map("metric_version")
  updatedAt           String? @map("updated_at")

  @@index([harness], map: "idx_session_activity_metrics_harness")
  // ISS-6760: no index on `startedDay` — see the contract on the field above.
  @@map("session_activity_metrics")
}

/// FEA-3132: per-(session, message-timestamp, turn_kind) rollup for the Insights
/// autonomy trend + activity heatmap, materialized at ingest so those reads no
/// longer json_each-expand every message of every in-window session on every
/// dashboard load. `ts` is the RAW UTC `$.timestamp` (re-bucketed local on read,
/// timezone-safe); `turnKind` pre-resolves the read's role+headless predicate
/// ('human' | 'agent'); `turnCount` collapses same-(ts,kind) messages so
/// SUM(turnCount) == the old COUNT(*). See rebuildSessionTurnBuckets.
model SessionTurnBucket {
  sessionId String @map("session_id")
  ts        String
  turnKind  String @map("turn_kind")
  turnCount Int    @default(1) @map("turn_count")

  @@id([sessionId, ts, turnKind])
  @@map("session_turn_bucket")
}

model TokenUsage {
  sessionId          String  @map("session_id")
  model              String
  inputTokens        BigInt  @default(0) @map("input_tokens")
  outputTokens       BigInt  @default(0) @map("output_tokens")
  cacheReadTokens    BigInt  @default(0) @map("cache_read_tokens")
  cacheWriteTokens   BigInt  @default(0) @map("cache_write_tokens")
  // FEA-3419: cache-write TTL subdivision. NULL = breakdown never reported
  // (absent provenance); the pair is always set together.
  cacheWrite5mTokens BigInt? @map("cache_write_5m_tokens")
  cacheWrite1hTokens BigInt? @map("cache_write_1h_tokens")
  rawInput           BigInt  @default(0) @map("raw_input")
  rawOutput          BigInt  @default(0) @map("raw_output")
  rawCacheRead       BigInt  @default(0) @map("raw_cache_read")
  rawCacheWrite      BigInt  @default(0) @map("raw_cache_write")
  baselineInput      BigInt  @default(0) @map("baseline_input")
  baselineOutput     BigInt  @default(0) @map("baseline_output")
  baselineCacheRead  BigInt  @default(0) @map("baseline_cache_read")
  baselineCacheWrite BigInt  @default(0) @map("baseline_cache_write")
  usageSource        String  @default("jsonl_parser") @map("usage_source")
  revisionId         Int     @default(4) @map("revision_id")
  createdAt          String? @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt          String? @map("updated_at")
  costUsdEstimated   Float?  @map("cost_usd_estimated")
  costCurrency       String? @map("cost_currency")
  costSource         String? @map("cost_source")
  costObservedAt     String? @map("cost_observed_at")
  // FEA-2085: true when `model` is a fallback placeholder (e.g. Codex's
  // gpt-5-codex default) rather than an id extracted from the transcript.
  inferred           Boolean @default(false)

  // NOTE: token_usage.session_id has no DB foreign key in the legacy DDL (a
  // plain session_id column, like events), so NO Prisma `@relation` is modeled
  // here — adding one would emit a FOREIGN KEY into the schema-derived DDL that
  // the baselined 0001_init lacks, drifting prisma-migrations-agreement and
  // requiring a table-rebuild migration. The branch usage read instead resolves
  // the session→billing_mode scope through the link table's real relation and a
  // second keyed `tokenUsage.findMany` (see readBranchUsageTokenRows).

  @@id([sessionId, model])
  @@index([sessionId], map: "idx_token_usage_session")
  // perf (#2481): partial indexes bounding the boot-time reprice scan
  // (`repriceUnpricedTokenUsage`). Mirrors migration
  // 0016_token_usage_reprice_index; keep both in sync.
  @@index([sessionId], map: "idx_token_usage_unpriced", where: raw("cost_usd_estimated IS NULL"))
  @@index([sessionId], map: "idx_token_usage_compacted", where: raw("baseline_input > 0 OR baseline_output > 0 OR baseline_cache_read > 0 OR baseline_cache_write > 0"))
  @@map("token_usage")
}

model CodexTraceSpan {
  traceId            String  @map("trace_id")
  spanId             String  @map("span_id")
  parentSpanId       String? @map("parent_span_id")
  sessionId          String  @map("session_id")
  name               String
  startTime          String  @map("start_time")
  endTime            String  @map("end_time")
  durationMs         Int     @map("duration_ms")
  status             String
  statusMessage      String? @map("status_message")
  toolName           String? @map("tool_name")
  attributes         Json?
  resourceAttributes Json?   @map("resource_attributes")
  receivedAt         String  @map("received_at")
  revisionId         Int     @default(4) @map("revision_id")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([traceId, spanId])
  @@index([sessionId], map: "idx_codex_trace_span_session")
  @@index([toolName], map: "idx_codex_trace_span_tool", where: raw("tool_name IS NOT NULL"))
  @@index([startTime], map: "idx_codex_trace_span_start_time")
  @@map("codex_trace_span")
}

model ClaudeCodeCostEvent {
  id                String  @id
  sessionId         String  @map("session_id")
  model             String
  costUsd           Decimal @map("cost_usd")
  observedAt        String  @map("observed_at")
  // ISS-7352 item E: the component attribution Claude Code stamps on every
  // cost counter. Each name is its own nullable column so a reader can filter
  // on one dimension, and `attribution_key` is the canonical join of the whole
  // tuple, carried as a SEPARATE non-null column because it is part of the
  // natural key.
  //
  // Non-null with a "" default is load-bearing, not cosmetic. SQLite treats
  // NULLs as DISTINCT in a UNIQUE index, so putting the nullable name columns
  // in the key directly would make every unattributed row unique against
  // itself: the upsert's WHERE would never match and each export would insert
  // a duplicate instead of updating. "" is the one unattributed value, and it
  // is also what the ALTER TABLE gives every row written before this column.
  attributionKey    String  @default("") @map("attribution_key")
  // ISS-7352 step 3: which source produced this row's attribution, recorded
  // per-row so a later disagreement with transcript-derived attribution is
  // diagnosable instead of invisible. See ClaudeCodeAttributionSource.
  attributionSource String  @default("none") @map("attribution_source")
  agentName         String? @map("agent_name")
  skillName         String? @map("skill_name")
  pluginName        String? @map("plugin_name")
  marketplaceName   String? @map("marketplace_name")
  mcpServerName     String? @map("mcp_server_name")
  mcpToolName       String? @map("mcp_tool_name")
  querySource       String? @map("query_source")
  speed             String?
  effort            String?
  dataRevision      Int     @default(1) @map("data_revision")
  createdAt         String? @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt         String? @map("updated_at")

  @@unique([sessionId, model, observedAt, attributionKey], map: "idx_claude_code_cost_event_natural")
  @@index([sessionId], map: "idx_claude_code_cost_event_session")
  @@index([observedAt], map: "idx_claude_code_cost_event_observed")
  @@map("claude_code_cost_event")
}

model ClaudeCodePermissionEvent {
  id            String  @id
  sessionId     String  @map("session_id")
  toolName      String  @map("tool_name")
  decision      String
  source        String
  observedAt    String  @map("observed_at")
  // ISS-7481: the harness's own identifier for the invocation this decision is
  // about, and the join to its `claude_code_tool_result` row. Deliberately NOT
  // in the natural key below -- it is nullable, and SQLite treats NULLs as
  // DISTINCT in a UNIQUE index, so keying on it would make every row without
  // one unique against itself and turn the upsert into a duplicate insert on
  // every export. The normalizer compares it instead, which is what makes two
  // parallel auto-approved `Read`s a COUNTED collision rather than a silent
  // overwrite. This table stays a LOWER BOUND on decisions.
  toolUseId     String? @map("tool_use_id")
  // ISS-7352 item F: the per-event join keys. NULL means the producer did not
  // stamp one -- `workflow.*` exists only for a workflow-launched session.
  promptId      String? @map("prompt_id")
  messageUuid   String? @map("message_uuid")
  workflowRunId String? @map("workflow_run_id")
  workflowName  String? @map("workflow_name")
  dataRevision  Int     @default(1) @map("data_revision")
  createdAt     String? @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt     String? @map("updated_at")

  @@unique([sessionId, toolName, observedAt], map: "idx_claude_code_permission_event_natural")
  @@index([sessionId], map: "idx_claude_code_permission_event_session")
  @@index([observedAt], map: "idx_claude_code_permission_event_observed")
  @@map("claude_code_permission_event")
}

model ClaudeCodeApiRequest {
  id                  String  @id
  sessionId           String  @map("session_id")
  model               String
  tokensInput         BigInt  @default(0) @map("tokens_input")
  tokensOutput        BigInt  @default(0) @map("tokens_output")
  tokensCacheRead     BigInt  @default(0) @map("tokens_cache_read")
  tokensCacheCreation BigInt  @default(0) @map("tokens_cache_creation")
  costUsd             Decimal @map("cost_usd")
  // ISS-7352 item D: the producer's own exact-integer spelling of the same
  // cost, in millionths of a dollar. Nullable because a Claude Code older than
  // the build that added it stamps only `cost_usd`, and because every row
  // written before this column exists is genuinely unknown here rather than 0.
  costUsdMicros       BigInt? @map("cost_usd_micros")
  startedAt           String  @map("started_at")
  durationMs          Int     @map("duration_ms")
  // ISS-7352 item F: Anthropic's own identifiers for this request. They matter
  // more here than on the sibling tables because this one's natural key uses a
  // DERIVED `started_at` (completion less duration, at ms resolution), so they
  // are the strongest evidence a key collision is two requests rather than one
  // re-sent export.
  requestId           String? @map("request_id")
  clientRequestId     String? @map("client_request_id")
  // ISS-7352 item F: the per-event join keys.
  promptId            String? @map("prompt_id")
  messageUuid         String? @map("message_uuid")
  workflowRunId       String? @map("workflow_run_id")
  workflowName        String? @map("workflow_name")
  dataRevision        Int     @default(1) @map("data_revision")
  createdAt           String? @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt           String? @map("updated_at")

  @@unique([sessionId, startedAt, model], map: "idx_claude_code_api_request_natural")
  @@index([sessionId], map: "idx_claude_code_api_request_session")
  @@index([startedAt], map: "idx_claude_code_api_request_started")
  @@map("claude_code_api_request")
}

// ISS-7352 item A: the error/refusal taxonomy, for which nothing equivalent
// existed. One table for all three of Claude Code's failure events
// (`api_error`, `api_refusal`, `internal_error`) because they share a grain —
// one row per failed attempt in a session — and differ only in which taxonomy
// columns they populate; `error_kind` is the discriminant.
//
// The free-text `error` attribute Claude Code also stamps is deliberately NOT
// a column here. It is an error MESSAGE, i.e. content, and ISS-7352 open
// question #4 leaves the content-capture decision unanswered with the redaction
// gates closed. `error_category` is a closed taxonomy value and carries the
// signal this table exists for; adding the message needs that decision first.
model ClaudeCodeErrorEvent {
  id                String   @id
  sessionId         String   @map("session_id")
  errorKind         String   @map("error_kind")
  observedAt        String   @map("observed_at")
  // Two failures can share a millisecond, so the instant alone does not
  // identify a row. This carries whatever the event offers to tell them apart
  // (the attempt number, the request id, the internal error's name/code).
  // Non-null with a "" default for the same SQLite NULL-is-distinct reason
  // documented on ClaudeCodeCostEvent.attributionKey.
  occurrenceKey     String   @default("") @map("occurrence_key")
  model             String?
  statusCode        Int?     @map("status_code")
  attempt           Int?
  errorCategory     String?  @map("error_category")
  durationMs        Int?     @map("duration_ms")
  requestId         String?  @map("request_id")
  clientRequestId   String?  @map("client_request_id")
  refusalCategory   String?  @map("refusal_category")
  serverFallbackHop Int?     @map("server_fallback_hop")
  hasCategory       Boolean? @map("has_category")
  hasExplanation    Boolean? @map("has_explanation")
  errorName         String?  @map("error_name")
  errorCode         String?  @map("error_code")
  // ISS-7352 item F: the per-event join keys. `prompt_id` earns its place here
  // -- `occurrence_key` is built from the attempt and request identifiers, so
  // two failures carrying neither reduce to one key and this is the only thing
  // left saying they came from two different prompts.
  promptId          String?  @map("prompt_id")
  messageUuid       String?  @map("message_uuid")
  workflowRunId     String?  @map("workflow_run_id")
  workflowName      String?  @map("workflow_name")
  dataRevision      Int      @default(1) @map("data_revision")
  createdAt         String?  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt         String?  @map("updated_at")

  @@unique([sessionId, errorKind, observedAt, occurrenceKey], map: "idx_claude_code_error_event_natural")
  @@index([sessionId], map: "idx_claude_code_error_event_session")
  @@index([observedAt], map: "idx_claude_code_error_event_observed")
  @@index([errorKind, observedAt], map: "idx_claude_code_error_event_kind_observed")
  @@map("claude_code_error_event")
}

// ISS-7352 item B, the half that had no home: `permission_mode_changed`. The
// session row stores only the CURRENT permissionMode, so every transition that
// produced it was previously unrecoverable. One row per transition.
model ClaudeCodePermissionModeChange {
  id            String  @id
  sessionId     String  @map("session_id")
  observedAt    String  @map("observed_at")
  fromMode      String  @map("from_mode")
  toMode        String  @map("to_mode")
  trigger       String?
  // ISS-7352 item F: the per-event join keys.
  promptId      String? @map("prompt_id")
  messageUuid   String? @map("message_uuid")
  workflowRunId String? @map("workflow_run_id")
  workflowName  String? @map("workflow_name")
  dataRevision  Int     @default(1) @map("data_revision")
  createdAt     String? @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt     String? @map("updated_at")

  @@unique([sessionId, observedAt, fromMode, toMode], map: "idx_claude_code_permission_mode_change_natural")
  @@index([sessionId], map: "idx_claude_code_permission_mode_change_session")
  @@index([observedAt], map: "idx_claude_code_permission_mode_change_observed")
  @@map("claude_code_permission_mode_change")
}

// ISS-7352 item C: one MCP server connection attempt. Nothing we collect
// otherwise records which MCP servers a session actually reached, over what
// transport, or why a connection failed -- a transcript shows only the tool
// calls that succeeded afterwards.
//
// `server_name` and the free-text `error` message are deliberately absent.
// Claude Code stamps both only under `OTEL_LOG_TOOL_DETAILS=1`, `error` is
// content (ISS-7352 open question #4, still unanswered with the redaction gates
// closed), and the capture list claims neither.
model ClaudeCodeMcpServerConnection {
  id            String   @id
  sessionId     String   @map("session_id")
  observedAt    String   @map("observed_at")
  status        String
  // What tells two attempts in one millisecond apart, since the server's own
  // name is not captured. Non-null with a "" default for the same SQLite
  // NULL-is-distinct reason documented on ClaudeCodeCostEvent.attributionKey.
  connectionKey String   @default("") @map("connection_key")
  transportType String?  @map("transport_type")
  serverScope   String?  @map("server_scope")
  durationMs    Int?     @map("duration_ms")
  errorCode     String?  @map("error_code")
  isPlugin      Boolean? @map("is_plugin")
  pluginIdHash  String?  @map("plugin_id_hash")
  // ISS-7352 item F: the per-event join keys.
  promptId      String?  @map("prompt_id")
  messageUuid   String?  @map("message_uuid")
  workflowRunId String?  @map("workflow_run_id")
  workflowName  String?  @map("workflow_name")
  dataRevision  Int      @default(1) @map("data_revision")
  createdAt     String?  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt     String?  @map("updated_at")

  @@unique([sessionId, observedAt, status, connectionKey], map: "idx_claude_code_mcp_server_connection_natural")
  @@index([sessionId], map: "idx_claude_code_mcp_server_connection_session")
  @@index([observedAt], map: "idx_claude_code_mcp_server_connection_observed")
  @@map("claude_code_mcp_server_connection")
}

// ISS-7352 item C: one `login` / `logout`. The producer documents that
// `error_category` is categorical and the raw error message is NEVER included
// on this event, so there is no content column to decide about here.
model ClaudeCodeAuthEvent {
  id            String   @id
  sessionId     String   @map("session_id")
  observedAt    String   @map("observed_at")
  action        String
  // Every remaining attribute of the event, flattened -- so a collision on this
  // key means two records that agree on everything captured. Non-null with a ""
  // default for the SQLite NULL-is-distinct reason.
  occurrenceKey String   @default("") @map("occurrence_key")
  success       Boolean?
  authMethod    String?  @map("auth_method")
  errorCategory String?  @map("error_category")
  statusCode    Int?     @map("status_code")
  // ISS-7352 item F: the per-event join keys. Every attribute the auth event
  // itself carries is already in `occurrence_key`, so these four are the only
  // thing left that can tell two records at one instant apart.
  promptId      String?  @map("prompt_id")
  messageUuid   String?  @map("message_uuid")
  workflowRunId String?  @map("workflow_run_id")
  workflowName  String?  @map("workflow_name")
  dataRevision  Int      @default(1) @map("data_revision")
  createdAt     String?  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt     String?  @map("updated_at")

  @@unique([sessionId, observedAt, action, occurrenceKey], map: "idx_claude_code_auth_event_natural")
  @@index([sessionId], map: "idx_claude_code_auth_event_session")
  @@index([observedAt], map: "idx_claude_code_auth_event_observed")
  @@map("claude_code_auth_event")
}

// ISS-7352 item C: one plugin install or load. Both events share a grain (one
// row per plugin per moment) and one column set, so `lifecycle` discriminates
// them the way `error_kind` discriminates the three failure events.
//
// `plugin_key` is load-bearing rather than incidental: `plugin_loaded` fires
// once per enabled plugin at session start, so ten plugins emit ten records
// agreeing on session and instant and differing only here.
model ClaudeCodePluginEvent {
  id                    String   @id
  sessionId             String   @map("session_id")
  lifecycle             String
  observedAt            String   @map("observed_at")
  pluginKey             String   @default("") @map("plugin_key")
  pluginName            String?  @map("plugin_name")
  pluginVersion         String?  @map("plugin_version")
  marketplaceName       String?  @map("marketplace_name")
  marketplaceIsOfficial Boolean? @map("marketplace_is_official")
  installTrigger        String?  @map("install_trigger")
  // ISS-7352 item F: the per-event join keys.
  promptId              String?  @map("prompt_id")
  messageUuid           String?  @map("message_uuid")
  workflowRunId         String?  @map("workflow_run_id")
  workflowName          String?  @map("workflow_name")
  dataRevision          Int      @default(1) @map("data_revision")
  createdAt             String?  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt             String?  @map("updated_at")

  @@unique([sessionId, lifecycle, observedAt, pluginKey], map: "idx_claude_code_plugin_event_natural")
  @@index([sessionId], map: "idx_claude_code_plugin_event_session")
  @@index([observedAt], map: "idx_claude_code_plugin_event_observed")
  @@map("claude_code_plugin_event")
}

// ISS-7352 item G: `claude_code.lines_of_code.count`, which splits code churn
// by direction AND by the model that made the change. Our own `diffStats` is
// session-level only, so neither split was recoverable.
model ClaudeCodeLinesOfCode {
  id           String  @id
  sessionId    String  @map("session_id")
  model        String
  observedAt   String  @map("observed_at")
  changeType   String  @map("change_type")
  lineCount    BigInt  @default(0) @map("line_count")
  dataRevision Int     @default(1) @map("data_revision")
  createdAt    String? @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt    String? @map("updated_at")

  @@unique([sessionId, model, observedAt, changeType], map: "idx_claude_code_lines_of_code_natural")
  @@index([sessionId], map: "idx_claude_code_lines_of_code_session")
  @@index([observedAt], map: "idx_claude_code_lines_of_code_observed")
  @@map("claude_code_lines_of_code")
}

// ISS-7352 item G: `claude_code.session.count`, carried for its `start_type`
// (fresh / resume / continue / agents_view). Nothing else we collect
// distinguishes a resumed session from a fresh one.
//
// A side table rather than a column on `sessions`: that row is owned by the
// transcript collectors, and an OTel writer reaching into it would be the same
// silent source-precedence decision `token_usage` is excluded for.
model ClaudeCodeSessionStart {
  id           String  @id
  sessionId    String  @map("session_id")
  observedAt   String  @map("observed_at")
  startType    String  @map("start_type")
  sessionCount BigInt  @default(0) @map("session_count")
  dataRevision Int     @default(1) @map("data_revision")
  createdAt    String? @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt    String? @map("updated_at")

  @@unique([sessionId, observedAt, startType], map: "idx_claude_code_session_start_natural")
  @@index([sessionId], map: "idx_claude_code_session_start_session")
  @@index([observedAt], map: "idx_claude_code_session_start_observed")
  @@map("claude_code_session_start")
}

// ISS-7352 item G: the RESULT side of a tool invocation -- payload sizes, the
// failure category, and the MCP scope. `claude_code_permission_event` records
// only whether a call was allowed.
//
// `success` is stored beside `error_type` deliberately: the producer stamps
// `error_type` only on a FAILED call, so a NULL there alone cannot tell a
// successful invocation from one that failed without a category.
//
// The free-text `error`, `tool_input` and `tool_parameters` attributes are NOT
// columns here -- they are content and ISS-7352 open question #4 is unanswered.
// The two SIZE columns carry the shape of that payload without the payload.
model ClaudeCodeToolResult {
  id                  String   @id
  sessionId           String   @map("session_id")
  toolName            String   @map("tool_name")
  observedAt          String   @map("observed_at")
  // `tool_use_id` when the producer stamped one -- the harness's own identifier
  // for the invocation, and the same value it passes to hooks. Non-null with a
  // "" default for the SQLite NULL-is-distinct reason.
  resultKey           String   @default("") @map("result_key")
  toolUseId           String?  @map("tool_use_id")
  success             Boolean?
  errorType           String?  @map("error_type")
  toolInputSizeBytes  BigInt?  @map("tool_input_size_bytes")
  toolResultSizeBytes BigInt?  @map("tool_result_size_bytes")
  mcpServerScope      String?  @map("mcp_server_scope")
  // ISS-7352 item F: the per-event join keys.
  promptId            String?  @map("prompt_id")
  messageUuid         String?  @map("message_uuid")
  workflowRunId       String?  @map("workflow_run_id")
  workflowName        String?  @map("workflow_name")
  dataRevision        Int      @default(1) @map("data_revision")
  createdAt           String?  @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt           String?  @map("updated_at")

  @@unique([sessionId, toolName, observedAt, resultKey], map: "idx_claude_code_tool_result_natural")
  @@index([sessionId], map: "idx_claude_code_tool_result_session")
  @@index([observedAt], map: "idx_claude_code_tool_result_observed")
  @@map("claude_code_tool_result")
}

// ISS-7352 item D: `claude_code.active_time.total`, the time a session spent
// actually working, split into the human's share and the CLI's. GA despite the
// rest of item D riding the beta span tier.
//
// `activityType` (user / cli) keys the row: an undifferentiated total answers
// nothing our timestamps do not already answer, so the split IS the
// measurement. `seconds` is Decimal, not an integer count, because the metric's
// unit is seconds and sub-second intervals are ordinary here.
model ClaudeCodeActiveTime {
  id           String  @id
  sessionId    String  @map("session_id")
  observedAt   String  @map("observed_at")
  activityType String  @map("activity_type")
  seconds      Decimal @default(0)
  dataRevision Int     @default(1) @map("data_revision")
  createdAt    String? @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt    String? @map("updated_at")

  @@unique([sessionId, observedAt, activityType], map: "idx_claude_code_active_time_natural")
  @@index([sessionId], map: "idx_claude_code_active_time_session")
  @@index([observedAt], map: "idx_claude_code_active_time_observed")
  @@map("claude_code_active_time")
}

// ISS-7352 item F, identity half. Keyed by session_id alone: a session has one
// identity, so this is the one claude_code_* table that is not event-sourced.
// Every identifier is nullable and an unresolved one stays NULL rather than
// taking a placeholder -- an unattributed session must stay distinguishable
// from one attributed to an empty account.
model ClaudeCodeSessionIdentity {
  sessionId       String  @id @map("session_id")
  observedAt      String  @map("observed_at")
  organizationId  String? @map("organization_id")
  userAccountUuid String? @map("user_account_uuid")
  userAccountId   String? @map("user_account_id")
  identitySource  String? @map("identity_source")
  terminalType    String? @map("terminal_type")
  appVersion      String? @map("app_version")
  appEntrypoint   String? @map("app_entrypoint")
  dataRevision    Int     @default(1) @map("data_revision")
  createdAt       String? @default(dbgenerated("(strftime('%Y-%m-%dT%H:%M:%fZ', 'now'))")) @map("created_at")
  updatedAt       String? @map("updated_at")

  @@index([organizationId], map: "idx_claude_code_session_identity_org")
  @@map("claude_code_session_identity")
}

// ISS-7352 item D, beta tier: one `claude_code.llm_request` span — the only
// carrier of `ttft_ms`, `stop_reason`, `gen_ai.response.finish_reasons` and
// `response.has_tool_call`. Spans only arrive when the user has set
// `CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1`; nothing in this lane sets it.
//
// Keyed on `(trace_id, span_id)` — the producer's own identity for a request —
// so a retried OTLP batch upserts instead of doubling the table. Every measured
// column the span carries as an ATTRIBUTE is nullable because the tier is beta:
// an attribute it stops stamping costs that column, not the whole request. The
// four token columns are the exception — they are `BigInt @default(0)`, because
// the normalizer resolves a token count to a number on every path, so absent
// there means zero rather than unknown.
//
// No column holds the span's `status.message` or its span events. Both are
// free-text content and neither is read.
model ClaudeCodeLlmRequest {
  id                  String   @id
  sessionId           String   @map("session_id")
  traceId             String   @map("trace_id")
  spanId              String   @map("span_id")
