{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    // Match the main tsconfig: `packages/api/src` is authored with explicit `.ts`
    // sibling imports (its dual-consumption contract — Turbopack bundles the
    // source, `rewriteRelativeImportExtensions` emits `.js` for `dist`; see
    // packages/api/AGENTS.md). When a renderer value-import pulls one of those
    // modules (e.g. the convert-install-state parity test), tsc descends into its
    // `.ts` sibling imports, which Bundler resolution only accepts with this flag.
    "allowImportingTsExtensions": true,
    // `@repo/*` → packages source: workspace packages with no `exports` field
    // (notably @repo/app, whose self-referencing `@repo/app/<feature>/…`
    // imports don't resolve through node_modules when pulled into this program)
    // resolve from source. The Vite counterpart lives in vite.renderer.config.ts.
    "paths": {
      "@repo/*": ["../../packages/*"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx"]
}
