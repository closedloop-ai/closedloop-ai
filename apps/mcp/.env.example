# apps/mcp (:3010) — agent<->platform MCP server.
#
# Prefer the single-file setup: `cp local.env.example local.env && pnpm env:local`
# links one root file into every app instead of six copies you keep in sync.
#
# This app runs `node --env-file=.env.local`, so the file MUST exist or the
# process exits at startup.
#
# INTERNAL_API_SECRET is the only hard requirement: src/api-client.ts calls
# requireEnv() for it and throws at import when it is unset. It must be the SAME
# value apps/api and apps/relay see, or every internal call is rejected. Replace
# the placeholder below — it is the auth boundary for internal routes, not a
# formality. `pnpm env:local` generates one per machine and shares it correctly
# across all three services; this file is the fallback if you keep per-app envs.
INTERNAL_API_SECRET="change-me-in-production"
# Optional: src/api-client.ts defaults this to http://localhost:3002 when unset.
# apps/relay, unlike apps/mcp, does require it.
CLOSEDLOOP_API_URL="http://localhost:3002"
# local | stage | prod. "local" is what permits 127.0.0.1 OAuth redirects.
WEBAPP_ENV="local"

# --- Cross-task session store (optional) -----------------------------------
# Read in apps/mcp/src/index.ts. Caches verified auth contexts so a POST that
# lands on a different ECS task (ALB without session stickiness) can skip a full
# API-key verification round-trip. Set by infrastructure (ECS task definition)
# in stage/prod; left unset locally.
#
# MCP_SESSION_STORE selects the backend:
#   absent / "memory" (default): per-process in-memory cache; no cross-task sharing.
#   "redis": use REDIS_URL below. Degrades to memory mode if REDIS_URL is unset
#            or the Redis connection fails.
# MCP_SESSION_STORE="redis"
#
# REDIS_URL is the ElastiCache/Valkey connection string (use rediss:// for TLS).
# Required only when MCP_SESSION_STORE="redis"; absent => memory mode. The cached
# bearer API key is AES-256-GCM encrypted (with the OAuth signing keys) before it
# is written to Redis.
# REDIS_URL="rediss://host:6379"
