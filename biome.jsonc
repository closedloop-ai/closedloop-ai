    {
      // FEA-4114 (PRD-564): ban `as unknown as T` and chained `as A as B`
      // double casts in production source, via the GritQL plugin in
      // biome-plugins/. Biome 2.5.2 has no `noRestrictedSyntax` rule, and a
      // plugin declared at the top level cannot be switched off by a later
      // override (`plugins` is additive, not overridable), so the scoping
      // lives here in this override's own `includes`.
      "includes": [
        "**/*",
        // Documented test-fixture exception: partial mocks and fixtures may
        // cast, because building the full shape is often impractical. Mirrors
        // the test globs on the vitest-globals override at the top of this
        // array, plus the fixture/story/e2e dirs that override doesn't need.
        "!**/__tests__/**",
        "!**/test/**",
        "!**/tests/**",
        "!**/e2e/**",
        "!**/type-tests/**",
        "!**/__mocks__/**",
        "!**/*.spec.cts",
        "!**/*.spec.js",
        "!**/*.spec.jsx",
        "!**/*.spec.mjs",
        "!**/*.spec.mts",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/*.test.cts",
        "!**/*.test.js",
        "!**/*.test.jsx",
        "!**/*.test.mjs",
        "!**/*.test.mts",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.stories.ts",
        "!**/*.stories.tsx",
        "!**/vitest.setup.cts",
        "!**/vitest.setup.js",
        "!**/vitest.setup.jsx",
        "!**/vitest.setup.mjs",
        "!**/vitest.setup.mts",
        "!**/vitest.setup.ts",
        "!**/vitest.setup.tsx",
        // Test-only support code that does not match a conventional test
        // filename but is exempt for the same reason (partial fixtures/mocks).
        // Narrow, per-directory entries on purpose: a `**/test-fixtures/**`
        // pattern would silently exempt any future directory that happens to
        // carry the name. Add a line when a new test-support dir appears.
        "!apps/app/vitest-mocks/**",
        "!packages/app/shared/test-fixtures/**",
        // SHRINK-ONLY allowlist — pre-existing double casts predating the gate
        // (28 files / 56 casts at landing). Same discipline as the
        // noExcessiveLinesPerFile grandfather list above: NEVER add an entry to
        // route around the gate; delete a file's entry once its casts are gone
        // (verify with `./node_modules/.bin/biome check <file>` — `npx biome`
        // is a broken wrapper in this repo). Per-file only, no directory globs.
        // Next route segments need escaped brackets (`\\[id\\]`) — Biome globs
        // read `[...]` as a character class, so an unescaped `[id]` matches
        // nothing and silently allowlists nothing.
        "!apps/api/app/compute-targets/service.ts",
        "!apps/api/app/documents/\\[id\\]/context-attachments/validators.ts",
        "!apps/api/app/loops/\\[id\\]/stream/route.ts",
        "!apps/api/app/webhooks/github/handlers/installation-handler.ts",
        "!apps/api/app/webhooks/github/handlers/installation-repositories-handler.ts",
        "!apps/api/lib/desktop-command-store.ts",
        "!apps/api/lib/loops/loop-orchestrator.ts",
        "!apps/app/app/(authenticated)/\\[orgSlug\\]/users/\\[userId\\]/components/documents-by-type-chart.tsx",
        "!apps/desktop/src/main/app.ts",
        "!apps/desktop/src/main/jobs/job-store.ts",
        "!apps/desktop/src/main/settings/settings-migrations.ts",
        "!apps/desktop/src/main/settings/settings-store.ts",
        "!apps/desktop/src/main/telemetry/relay-telemetry-transport.ts",
        "!apps/desktop/src/main/transcript/desktop-transcripts-client.ts",
        "!apps/desktop/src/main/transcript/transcript-read-cache.ts",
        "!apps/desktop/src/main/window.ts",
        "!apps/desktop/src/server/operations/symphony-loop-request.ts",
        "!apps/desktop/src/server/operations/symphony-loop.ts",
        "!apps/mcp/src/index.ts",
        "!apps/web/proxy.ts",
        "!packages/analytics/node.ts",
        "!packages/app/shared/components/date-range-filter.tsx",
        "!packages/database/index.ts",
        "!packages/database/scripts/backfill-definition-versions.ts",
        "!packages/database/scripts/backfill-pack-definition-versions.ts",
        "!packages/database/scripts/backfill-search-documents.ts",
        "!packages/design-system/providers/theme.tsx"
      ],
      "plugins": ["./biome-plugins/no-double-cast.grit"]
    },
    {
      // FEA-4115 (PRD-564): @repo/design-system holds only generic,
      // project-agnostic components — primitives and patterns that could be
      // dropped into any project unchanged. A component that encodes Closedloop
      // domain concepts, or that imports domain types/status configs or the
      // database client, belongs in its feature slice of packages/app.
      //
      // This is a SEPARATE override on purpose. The apps/app navigation override
      // near the top of this array carries the only other noRestrictedImports
      // `options` block that must not be split (PLN-806 `paths` + FEA-1511
      // `patterns` co-habit there because Biome does not deep-merge a rule's
      // options across overlapping overrides). `packages/design-system/**` does
      // not overlap `apps/app/**`, so this stands alone safely — but anything
      // that later widens THIS scope to apps/app must merge into that block
      // rather than adding another override.
      //
      // Coverage caveat: `files.includes` below excludes
      // packages/design-system/{components/ui,lib,hooks} from Biome entirely
      // (shadcn upstream conventions), and those are the bulk of the package —
      // Biome never lints a domain import added there. The AST backstop
      // scripts/lint/check-design-system-domain-imports.ts scans the WHOLE
      // package and is what actually closes the boundary; this rule is the
      // in-editor, fail-fast half.
      //
      // FEA-4296 added the @repo/loops-api group. It carries NO exception here
      // on purpose, even though two files still import that package: both
      // (components/ui/types.ts and components/ui/primitives/metric-card.tsx)
      // sit under components/ui, which the `files.includes` exclusion above
      // already hides from Biome. The exception list they need lives in the AST
      // backstop — the only half that can see them — as LOOPS_API_EXCEPTIONS.
      // Do not "fix" the apparent asymmetry by adding a carve-out override
      // here; it would be dead config, and a real Biome-visible violation
      // (e.g. under storybook/ or providers/) must keep failing.
      //
      // FEA-4116 (`globalThis` over `window`): append your own override after
      // this one. It needs `linter.rules.*.noRestrictedGlobals` — a different
      // rule from this one and from FEA-4114's `plugins` key, so nothing
      // clobbers. Do NOT reuse FEA-4114's GritQL plugin: `window` is a global
      // identifier, not a syntax shape.
      "includes": ["packages/design-system/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                // Groups are disjoint so an import matches exactly one message.
                // Each lists the bare specifier AND the subpath glob, because
                // domain code is imported by subpath far more often than by
                // package root (e.g. @repo/api/src/types/loop).
                "patterns": [
                  {
                    "group": ["@repo/app", "@repo/app/**"],
                    "message": "@repo/design-system is generic and project-agnostic (FEA-4115): it must not import the app layer. A component that knows about branches, sessions, documents, loops, or projects belongs in @repo/app/<feature>/components/, composing this package's primitives — not here. See packages/design-system/AGENTS.md."
                  },
                  {
                    "group": ["@repo/database", "@repo/database/**"],
                    "message": "@repo/design-system is generic, project-agnostic client code (FEA-4115): no @repo/database (incl. /generated). Domain data and its types belong in @repo/app/<feature>/, which reaches apps/api via the shared api client. See packages/design-system/AGENTS.md."
                  },
                  {
                    "group": ["@repo/api", "@repo/api/**"],
                    "message": "@repo/design-system is generic and project-agnostic (FEA-4115): @repo/api/src/types/* are Closedloop domain contracts. A component that needs them is domain code and belongs in @repo/app/<feature>/components/. See packages/design-system/AGENTS.md."
                  },
                  {
                    "group": ["@repo/loops-api", "@repo/loops-api/**"],
                    "message": "@repo/design-system is generic and project-agnostic (FEA-4296): @repo/loops-api owns the Closedloop status vocabularies (SessionStatus, LoopStatus, DocumentStatus, IssueStatus, Priority, LoopErrorCode). A component or fixture that needs them is domain code and belongs in @repo/app/<feature>/ — domain Storybook sample data goes in @repo/app/<feature>/lib/. Two files under components/ui carry a named shrink-only exception (see LOOPS_API_EXCEPTIONS in scripts/lint/check-design-system-domain-imports.ts); do not add a third. See packages/design-system/AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  // ISS-5383. `.gitignore` is the second traversal filter, next to
  // `files.includes` below. Without this block Biome never consults it, so every
  // future `.gitignore` entry for generated output needs a hand-written `!`
  // twin here or Biome walks into it.
  //
  // It is NOT a speed win, and the file count says so: on a clean checkout this
  // moved the full-repo run by 0 files (8,474 -> 8,474) and 0 warnings (0 -> 0),
  // because Biome's own defaults already keep it out of `.next`, `dist`, and
  // `.turbo`.
  //
  // What it actually fixes is a correctness failure on a working checkout. Git
  // worktrees live under `.claude/worktrees/`, which `.gitignore` covers (via
  // `**/.claude/*`) and which Biome, without this block, walks straight into —
  // where it finds each worktree's own root `biome.jsonc` and aborts the entire
  // run with "Found a nested root configuration". Measured on a checkout with
  // four such worktrees: without the block Biome exits 1 having checked nothing;
  // with it the run completes (8,494 files, 0 warnings, exit 0). CI clones have
  // no worktrees, so this never showed up as a red gate — only as a local
  // `pnpm lint` nobody could run.
  //
  // The risk it introduces is the mirror image: `.gitignore` is written for Git,
  // not Biome, so a tracked-but-ignored file would silently stop being linted.
  // `scripts/lint/biome-vcs-ignore-file.test.ts` executes that property against
  // Biome itself rather than trusting it.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*",
      // shadcn/ui upstream conventions: these directories use interface declarations,
      // barrel exports, and patterns that conflict with project Biome rules
      "!packages/design-system/components/ui",
      "!packages/design-system/lib",
      "!packages/design-system/hooks",
      // Generated by apps/storybook/scripts/sync-component-catalog.mjs
      "!packages/design-system/storybook/component-catalog.ts",
      // Generated keyless-telemetry collector artifacts (FEA-2170/FEA-1991): their
      // exact bytes are owned by the contract codegen and asserted by the drift
      // guards — Biome must NOT reformat them or the byte-identity checks break.
      "!packages/telemetry-contract/collector",
      // FEA-2647 Layer 2 golden snapshots: generated by the golden-layer2 runner
      // (GOLDEN_L2_WRITE_SNAPSHOTS=1) and frozen under the human-only amendment
      // policy — Biome must NOT reformat them or every regeneration produces a
      // spurious whole-file diff against the runner's JSON.stringify output.
      "!apps/desktop/test/golden/layer2-snapshots/*.json",
      // PLN-1389 golden web-sync derived payloads: reproduced byte-for-byte by
      // apps/desktop/scripts/regen-golden-sync-payloads.ts (JSON.stringify) and
      // asserted for regen determinism — Biome must NOT reformat them or every
      // regeneration produces a spurious whole-file diff.
      "!apps/api/__tests__/fixtures/golden-web-sync/*.json",
      // ISS-5373 golden-session normalized dossiers (PRD-516): generated oracle
      // data frozen under packages/golden-sessions/AGENTS.md's human-only
      // amendment policy — Biome must NOT reformat them. Four of them exceed
      // Biome's 1 MiB files.maxSize, so every full-repo run read all ~1.3 MiB
      // of each only to reject it and emit a warning. `files.includes` with `!`
      // is the ONLY mechanism that prunes traversal: an `overrides` entry and a
      // suppression comment both still read the file.
      "!packages/golden-sessions/**/normalized.json",
      "!packages/collaboration/config.ts",
      "!docs/components/ui",
      "!docs/lib",
      "!docs/hooks",
      "!apps/app/public/*.svg",
      "!apps/desktop/app-icon.svg",
      "!apps/desktop/resources/*.svg",
      "!apps/desktop/src/renderer/design-system/index.html",
      "!apps/email/.react-email",
      "!apps/storybook/.storybook/preview-head.html",
      // ISS-4550 generated prototype-sandbox handbook export (3.2 MiB) — exceeds
      // Biome's 1 MiB file-size limit; it is a generated HTML asset, not code.
      "!docs/design/prototype-sandbox-handbook.html",
      "!apps/web/public/**/*.html",
      "!apps/web/public/**/*.svg",
      "!packages/design-system/brand/icons/**/*.svg",
      "!packages/design-system/brand/logos/**/*.svg",
      "!**/playwright-report",
      "!**/playwright-report-e2e",
      // .dagger/ is the Dagger CI module (FEA-2289 / FEA-2294). Its TypeScript SDK
      // requires parameter decorators (@argument/@object/@func) that Biome cannot
      // parse, and .dagger/sdk is generated SDK output — exclude the whole dir.
      "!.dagger"
    ]
  }
}
